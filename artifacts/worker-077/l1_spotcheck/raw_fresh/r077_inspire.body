,"page_start":"923","journal_title":"Commun.Math.Phys.","journal_record":{"$ref":"https://inspirehep.net/api/journals/1214791"},"journal_volume":"345"}}},{"record":{"$ref":"https://inspirehep.net/api/literature/768973"},"raw_refs":[{"value":"[14] C. Gundlach, JM Martín-García, \"Critical phenomena in gravitational collapse\", Living Rev.Rel.,10,57, DOI: 10.12942/lrr-2007-5","schema":"text"}],"reference":{"dois":["10.12942/lrr-2007-5"],"label":"14","title":{"title":"Critical phenomena in gravitational collapse"},"authors":[{"full_name":"Gundlach, C."},{"full_name":"Martín-García, JM"}],"publication_info":{"year":2007,"artid":"57","page_start":"57","journal_title":"Living Rev.Rel.","journal_record":{"$ref":"https://inspirehep.net/api/journals/1212837"},"journal_volume":"10"}}},{"record":{"$ref":"https://inspirehep.net/api/literature/1994913"},"raw_refs":[{"value":"[15] , Guo, Y., Hadzic, M., Jang, J.: Naked singularities in the Einstein-Euler system. (2021). , http://arxiv.org/abs/2112.10826","schema":"text"}],"reference":{"arxiv_eprint":"2112.10826"}},{"record":{"$ref":"https://inspirehep.net/api/literature/916978"},"raw_refs":[{"value":"[16] J. Kommemi, \"The global structure of spherically symmetric charged scalar field spacetimes\", Commun.Math.Phys.,323,35-106, DOI: 10.1007/s00220-013-1759-1","schema":"text"}],"reference":{"dois":["10.1007/s00220-013-1759-1"],"label":"16","title":{"title":"The global structure of spherically symmetric charged scalar field spacetimes"},"authors":[{"full_name":"Kommemi, J."}],"publication_info":{"year":2013,"page_end":"106","page_start":"35","journal_title":"Commun.Math.Phys.","journal_record":{"$ref":"https://inspirehep.net/api/journals/1214791"},"journal_volume":"323"}}},{"record":{"$ref":"https://inspirehep.net/api/literature/1629145"},"raw_refs":[{"value":"[17] J. Liu, J. Li, \"A robust proof of the instability of naked singularities of a scalar field in spherical symmetry\", Commun.Math.Phys.,363,561-578, DOI: 10.1007/s00220-018-3157-1","schema":"text"}],"reference":{"dois":["10.1007/s00220-018-3157-1"],"label":"17","title":{"title":"A robust proof of the instability of naked singularities of a scalar field in spherical symmetry"},"authors":[{"full_name":"Liu, J."},{"full_name":"Li, J."}],"publication_info":{"year":2018,"page_end":"578","page_start":"561","journal_title":"Commun.Math.Phys.","journal_record":{"$ref":"https://inspirehep.net/api/journals/1214791"},"journal_volume":"363"}}},{"raw_refs":[{"value":"[18] J. Luk, \"On the local existence for the characteristic initial value problem in general relativity\", Int.Math.Res.Not.,20,4625-4678, DOI: 10.1093/imrn/rnr201","schema":"text"}],"reference":{"dois":["10.1093/imrn/rnr201"],"label":"18","title":{"title":"On the local existence for the characteristic initial value problem in general relativity"},"authors":[{"full_name":"Luk, J."}],"publication_info":{"year":2012,"page_end":"4678","page_start":"4625","journal_title":"Int.Math.Res.Not.","journal_record":{"$ref":"https://inspirehep.net/api/journals/1213662"},"journal_volume":"20"}}},{"record":{"$ref":"https://inspirehep.net/api/literature/1281220"},"raw_refs":[{"value":"[19] J. Luk, S-J Oh, \"Quantitative decay rates for dispersive solutions to the Einstein-scalar field system in spherical symmetry\", Anal. PDE,8,1603, DOI: 10.2140/apde.2015.8.1603","schema":"text"}],"reference":{"dois":["10.2140/apde.2015.8.1603"],"label":"19","title":{"title":"Quantitative decay rates for dispersive solutions to the Einstein-scalar field system in spherical symmetry"},"authors":[{"full_name":"Luk, J."},{"full_name":"Oh, S-J"}],"publication_info":{"year":2015,"artid":"1603","page_start":"1603","journal_title":"Anal. PDE","journal_volume":"8"}}},{"raw_refs":[{"value":"[20] J. Luk, S-J Oh, S. Yang, \"Solutions to the Einstein-scalar-field system in spherical symmetry with large bounded variation norms\", Ann.PDE,4,59, DOI: 10.1007/s40818-017-0038-4","schema":"text"}],"reference":{"dois":["10.1007/s40