":"1912.08478"}},{"record":{"$ref":"https://inspirehep.net/api/literature/2070677"},"raw_refs":[{"value":"[24] , Shlapentokh-Rothman, Y.: Naked singularities for the Einstein vacuum equations: the interior solution. (2022). , http://arxiv.org/abs/2204.09891","schema":"text"}],"reference":{"arxiv_eprint":"2204.09891"}},{"record":{"$ref":"https://inspirehep.net/api/literature/2693075"},"raw_refs":[{"value":"[25] R. Wald, \"Gedanken experiments to destroy a black hole\", Annals Phys.,82,548-556, DOI: 10.1016/0003-4916(74)90125-0","schema":"text"}],"reference":{"dois":["10.1016/0003-4916(74)90125-0"],"label":"25","title":{"title":"Gedanken experiments to destroy a black hole"},"authors":[{"full_name":"Wald, R."}],"publication_info":{"year":1974,"page_end":"556","page_start":"548","journal_title":"Annals Phys.","journal_record":{"$ref":"https://inspirehep.net/api/journals/1214855"},"journal_volume":"82"}}}],"public_notes":[{"value":"v2: Typos fixed, references added. 88 pages, 12 Figures. Comments are\n welcome","source":"arXiv"}],"arxiv_eprints":[{"value":"2210.11325","categories":["gr-qc","math-ph","math.AP","math.MP"]}],"document_type":["article"],"preprint_date":"2022-10-20","control_number":2168006,"number_of_pages":88,"inspire_categories":[{"term":"Gravitation and Cosmology","source":"arxiv"},{"term":"Math and Math Physics","source":"arxiv"}]},"created":"2022-10-21T02:58:46.874020+00:00","id":"2168006","updated":"2026-02-09T12:44:25.786012+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/2168006?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/2168006?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/2168006?format=latex-us","json":"https://inspirehep.net/api/literature/2168006?format=json","json-expanded":"https://inspirehep.net/api/literature/2168006?format=json-expanded","cv":"https://inspirehep.net/api/literature/2168006?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2168006"},