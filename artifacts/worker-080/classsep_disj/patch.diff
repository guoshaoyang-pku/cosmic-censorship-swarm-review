+# (naive "any class_ids container" rule fires on 349 class_id/class_ids key instances in the
+# live map, nearly all of them node/claim/review scope metadata, not disjunctive assertions).
+def _known_class_tokens(value) -> list:
+    """Distinct frozen class tokens declared in one class_id/class_ids container."""
+    if isinstance(value, str):
+        toks = [t for t in re.split(r"[;,]", value) if t.strip()]
+    elif isinstance(value, list):
+        toks = [str(x) for x in value]
+    else:
+        return []
+    known: list = []
+    for tok in toks:
+        u = tok.strip().strip("'\"").upper()
+        if u in KNOWN_CLASSES and u not in known:
+            known.append(u)
+    return known
+
+
+def _scan_class_ids_disjunction(value, where: str, out: list):
+    """HF-02 disjunction: >=2 distinct frozen class ids bound to one asserted container."""
+    known = _known_class_tokens(value)
+    if len(known) >= 2:
+        out.append(f"CLASSSEP: disjunction of class_ids in {where}: {known!r}")
