 "class_definition": {
  "label": "\"Asymptotically flat weak cosmic censorship, massless scalar field, spherical symmetry\"",
  "hypotheses": {
   "H1": "3+1 dimensional; Lambda = 0; Einstein equations coupled to a massless scalar field.",
   "H2": "Spherical symmetry: the data are SO(3)-symmetric with 2-sphere orbits and a regular center, so the data space is symmetry-reduced.",
   "H3": "Initial data (characteristic or Cauchy, as fixed by the source) is asymptotically flat with one end, and has an MGHD.",
   "H4": "Genericity notion for the symmetry-reduced data space (dense-open versus full-measure) is unresolved and must be named before any claim is filed."
  },
  "conclusion_type": "weak_cosmic_censorship",
  "exclusions_raw": [
   "Vacuum data (no scalar field).",
   "Non-spherical data: symmetry release is a different class and is forbidden as a transfer.",
   "Massive or charged scalar fields; Lambda != 0.",
   "Exactly critical/self-similar data presented as generic without a genericity statement."
  ]
 },
