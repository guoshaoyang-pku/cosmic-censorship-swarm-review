  <entry>
    <id>http://arxiv.org/abs/0908.1803v1</id>
    <title>Are Black Hole Starships Possible</title>
    <updated>2009-08-12T21:55:58Z</updated>
    <link href="https://arxiv.org/abs/0908.1803v1" rel="alternate" type="text/html"/>
    <link href="https://arxiv.org/pdf/0908.1803v1" rel="related" type="application/pdf" title="pdf"/>
    <summary>  We investigate whether it is physically possible to build starships or power sources using the Hawking radiation of an artificial black hole as a power source. The proposal seems to be at the edge of possibility, but quantum gravity effects could change the picture.</summary>
    <category term="gr-qc" scheme="http://arxiv.org/schemas/atom"/>
