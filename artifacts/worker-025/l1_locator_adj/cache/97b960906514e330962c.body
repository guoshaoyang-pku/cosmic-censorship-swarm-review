e/540570"}},{"reference":{"arxiv_eprint":"1001.1158","publication_info":{"journal_volume":"692","artid":"32","page_start":"32","journal_title":"Phys.Lett.B"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/842376"}},{"reference":{"arxiv_eprint":"1006.4164","publication_info":{"journal_volume":"695","artid":"376","page_start":"376","journal_title":"Phys.Lett.B"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/859178"}},{"reference":{"arxiv_eprint":"hep-th/0604094","publication_info":{"journal_volume":"73","artid":"084004","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/714408"}},{"reference":{"publication_info":{"journal_volume":"5","artid":"2419","page_start":"2419","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/67635"}}],"number_of_pages":9,"legacy_creation_date":"2010-12-21","preprint_date":"2010-12","author_count":2,"public_notes":[{"source":"arXiv","value":"Latex, 9 pages, 6 figures, version that appears in Physics Letters B"}],"earliest_date":"2010-12","refereed":true,"external_system_identifiers":[{"schema":"MSNET","value":"2748167"},{"schema":"ADS","value":"2011PhLB..694..440B"},{"schema":"SPIRES","value":"SPIRES-8917124"}],"facet_author_name":["998954_Robert B. Mann","1078441_Eric G. Brown"],"core":true,"license":[{"imposing":"arXiv","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:882253","updated":"2023-03-06T14:03:12.568541"},"journal_title_variants":["Phys.Lett.B","Phys. Lett. B"],"arxiv_eprints":[{"categories":["hep-th"],"value":"1012.4787"}],"referenced_authors_bais":["R.H.Price.1","G.Amelino.Camelia.1","M.Arzano.1","R.B.Mann.1","I.D.Novikov.1","Y.Gursel.1","E.Brown.1","Yi.Ling.1","E.Poisson.1","Piero.Nicolini.1","J.Madore.1","V.Sandberg.1","E.Spallucci.1","A.A.Starobinsky.1","D.Batic.1","A.Smailagic.1","W.Israel.1","L.Modesto.1","R.A.Matzner.1","G.Mandanici.1","A.Bonanno.1","Martin.Reuter.1","N.Zamorano.1"],"figures":[{"filename":"f2.png","caption":"\\(M=4\\sqrt{\\theta}\\)","source":"arxiv","key":"ec20726cf57cc49e28434bfd1d0a7745","url":"https://inspirehep.net/files/ec20726cf57cc49e28434bfd1d0a7745"},{"filename":"scat2.png","caption":"Displaying the different scatterings off of the main wave which are of potential interest.","source":"arxiv","key":"e521700e6b9af5784101e7fa42e791d2","url":"https://inspirehep.net/files/e521700e6b9af5784101e7fa42e791d2"},{"filename":"massfunc.png","caption":"A plot of the mass function \\(m(r)\\) and the line \\(r/2\\) for the case of \\(\\theta=1\\) and \\(M=8\\). The intersections determine the values of \\(r_\\pm\\).","source":"arxiv","key":"a5cbf63c1fece60bf3c53a09b960d84b","url":"https://inspirehep.net/files/a5cbf63c1fece60bf3c53a09b960d84b"},{"filename":"kap1.png","caption":"\\(\\theta=1\\)","source":"arxiv","key":"9bf4f0a29d83821f4b2006c1131407f3","url":"https://inspirehep.net/files/9bf4f0a29d83821f4b2006c1131407f3"}],"legacy_version":"20180612215524.0","inspire_categories":[{"term":"Theory-HEP"}],"first_author":{"full_name":"Brown, Eric","last_name":"Brown","first_name":"Eric","recid":1078441},"control_number":882253,"dois":[{"value":"10.1016/j.physletb.2010.10.014"}],"document_type":["article"],"texkeys":["Brown:2010cr"],"abstracts":[{"source":"Elsevier","value":"Noncommutative geometries have been proposed as an approach to quantum gravity and have led to the construction of noncommutative black holes, whose interior singularities are purportedly eliminated due to quantum effects. Here we find evidence that these black holes are in fact unstable, with infalling matter near the Cauchy (inner) horizon being subject to an infinite blueshift of the type that has been repeatedly demonstrated for the Reissner–Nordström black hole. This instability is present even when an ultraviolet cutoff (induced by anticipated noncommutative geometric effects) to a field propagating in that spacetime is included. We demonstrate this by following an analogous argument made for Reissner–Nordström black holes, and conclude that stability is dependent on the surface gravities κ− and κ+ of the inner and outer horizons respectively. In general if κ−>κ+ , as we show to be the case here, then the stability of the Cauchy horizon becomes highly questionable, contrary to recent claims.","abstract_source_suggest":{"input":"Elsevier"}},{"source":"arXiv","value":"Non-commutative geometries have been proposed as an approach to quantum gravity and have led to the construction of non-commutative black holes, whose interior singularities are purportedly eliminated due to quantum effects. Here we find evidence that these black holes are in fact unstable, with infalling matter near the Cauchy (inner) horizon being subject to an infinite blueshift of the type that has been repeatedly demonstrated for the Reissner-Nordstr\\(\\ddot{\\text{o}}\\)m black hole. This instability is present even when an ultraviolet cutoff (induced by anticipated non-commutative geometric effects) to a field propagating in that spacetime is included. We demonstrate this by following an analogous argument made for Reissner-Nordstr\\(\\ddot{\\text{o}}\\)m black holes, and conclude that stability is dependent on the surface gravities \\(\\kappa_-\\) and \\(\\kappa_+\\) of the inner and outer horizons respectively. In general if \\(\\kappa_- > \\kappa_+\\), as we show to be the case here, then the stability of the Cauchy horizon becomes highly questionable, contrary to recent claims.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["hep-th"],"titles":[{"title":"Instability of the Noncommutative Geometry Inspired Black Hole"},{"source":"arXiv","title":"Instability of the Noncommutative Geometry Inspired Black Hole"}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/882253?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/882253?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/882253?format=latex-us","json":"https://inspirehep.net/api/literature/882253?format=json","json-expanded":"https://inspirehep.net/api/literature/882253?format=json-expanded","cv":"https://inspirehep.net/api/literature/882253?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A882253"},"updated":"2023-03-06T14:03:12.568541+00:00","created":"2010-12-21T00:00:00+00:00"},{"id":"451400","metadata":{"publication_info":[{"journal_volume":"13","artid":"462","year":1997,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214130"},"page_start":"462","journal_title":"Annals Israel Phys.Soc."},{"page_end":"502","conference_record":{"$ref":"https://inspirehep.net/api/conferences/970953"},"page_start":"462","parent_record":{"$ref":"https://inspirehep.net/api/literature/454508"},"cnum":"C97-06-29.3"}],"citation_count":7,"authors":[{"full_name_unicode_normalized":"flanagan, eanna e.","full_name":"Flanagan, Eanna E.","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/1009857"},"ids":[{"schema":"INSPIRE BAI","value":"E.E.Flanagan.1"}],"last_name":"Flanagan","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/902755"},"value":"Cornell U., LNS"}],"signature_block":"FLANAGANe","uuid":"121f9342-9660-4353-a45f-ff6bc5218241","first_name":"Eanna E.","recid":1009857}],"citation_count_without_self_citations":6,"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","keywords":[{"schema":"INSPIRE","value":"talk: Haifa 1997/06/29"},{"schema":"INSPIRE","value":"black hole: horizon"},{"schema":"INSPIRE","value":"stability"},{"schema":"INSPIRE","value":"quantum mechanics"},{"schema":"INSPIRE","value":"dimension: 2"},{"schema":"INSPIRE","value":"space-time"},{"schema":"INSPIRE","value":"energy: flux"},{"schema":"INSPIRE","value":"field theory: scalar"},{"schema":"INSPIRE","