$ref":"https://inspirehep.net/api/literature/1626095"}},{"reference":{"dois":["10.1088/0264-9381/33/13/133001"],"label":"92","publication_info":{"journal_volume":"33","artid":"133001","year":2016,"journal_title":"Class.Quant.Grav."},"authors":[{"full_name":"Dias, O.J.C."},{"full_name":"Santos, J.E."},{"full_name":"Way, B."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1397149"}},{"reference":{"dois":["10.1103/PhysRevD.75.124017"],"label":"93","publication_info":{"journal_volume":"75","artid":"124017","year":2007,"journal_title":"Phys.Rev.D"},"authors":[{"full_name":"Berti, E."},{"full_name":"Cardoso, V."},{"full_name":"Gonzalez, J.A."},{"full_name":"Sperhake, U."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/742484"}},{"reference":{"dois":["10.1103/PhysRevD.100.044054"],"label":"94","publication_info":{"journal_volume":"100","artid":"044054","year":2019,"journal_title":"Phys.Rev.D"},"authors":[{"full_name":"Destounis, K."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1750041"}},{"reference":{"dois":["10.1140/epjc/s10052-017-4920-8"],"label":"95","publication_info":{"journal_volume":"77","artid":"351","year":2017,"page_start":"351","journal_title":"Eur.Phys.J.C"},"authors":[{"full_name":"Hod, S."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1599494"}},{"reference":{"arxiv_eprint":"0805.3880","label":"96","authors":[{"full_name":"Christodoulou, D."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/786592"}},{"reference":{"dois":["10.1103/PhysRevLett.80.3432"],"label":"97","publication_info":{"journal_volume":"80","artid":"3432","year":1998,"page_start":"3432","journal_title":"Phys.Rev.Lett."},"authors":[{"full_name":"Brady, P.R."},{"full_name":"Moss, I.G."},{"full_name":"Myers, R.C."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/466167"}},{"reference":{"label":"98","publication_info":{"year":1990},"title":{"title":"The Formation and Evolution of Cosmic Strings.Proceedings, Workshop, Cambridge, UK, 1989"},"authors":[{"inspire_role":"editor","full_name":"Gibbons, G."},{"inspire_role":"editor","full_name":"Hawking, S."},{"inspire_role":"editor","full_name":"Vachaspati, T."}]}}],"number_of_pages":7,"legacy_creation_date":"2020-06-03","preprint_date":"2020-06-01","author_count":3,"public_notes":[{"source":"arXiv","value":"7 pages, 2 figures, minor corrections, accepted for publication in\n  PRD, title changed to match published version"}],"earliest_date":"2020-06-01","refereed":true,"external_system_identifiers":[{"schema":"MSNET","value":"4187799"}],"facet_author_name":["1947979_Rodrigo Dal Bosco Fontana","1043208_Filipe C. Mena","1719058_Kyriakos Destounis"],"core":true,"license":[{"license":"arXiv nonexclusive-distrib 1.0","material":"preprint","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1798924","updated":"2026-02-09T11:34:11.386426"},"journal_title_variants":["Phys.Rev.D","Phys. Rev. D"],"arxiv_eprints":[{"categories":["gr-qc","hep-th"],"value":"2006.01152"}],"referenced_authors_bais":["Emanuele.Berti.1","A.Zhidenko.1","Soumitra.Sengupta.1","I.G.Moss.1","A.Ashtekar.1","S.Dyatlov.1","P.Wang.53","W.Israel.1","M.Zilhao.1","Anjan.Ananda.Sen.1","Christos.Charmousis.1","K.D.Kokkotas.1","R.C.Myers.1","Sumanta.Chakraborty.1","M.Walker.1","M.Demianski.1","Hong.Bao.Zhang.1","Roman.A.Konoplya.1","Qingyu.Gan.1","R.Emparan.1","S.Hod.1","Kyriakos.Destounis.1","W.M.Kinnersley.1","A.K.Mishra.3","P.R.Brady.1","F.C.Mena.1","J.F.Plebanski.1","A.Geralico.1","R.H.Price.1","Peng.Wang.1","B.G.Schmidt.1","Jie.Jiang.1","H.J.Sheinblatt.1","K.M.Simpson.1","H.S.Reall.1","Hai.Tang.Yang.1","J.B.Griffiths.1","T.Kolyvaris.1","Zhen.Zhong.2","G.T.Horowitz.1","Bin.Wang.1","V.Cardoso.1","P.Papadopoulos.1","Yuyu.Mo.1","J.Winicour.1","A.Scoins.1","E.Papantonopoulos.1","Xiaoyi.Liu.1","M.Dafermos.1","E.Poisson.1","P.Hintz.1","J.E.Santos.1","Demetrios.Christodoulou.1","U.Sperhake.1","S.Mitra.8","D.Bini.1","M.Ortaggio.1","M.Casals.2","Roberto.Gomez.1","F.Eperon.1","R.M.Wald.1","Bo.Xuan.Ge.1","Yu.Tian.1","B.Way.1","T.Dray.1","G.Etesi.1","R.B.Mann.1","J.Natario.1","A.Franzen.1","S.Hollands.1","E.W.Leaver.1","Zi.Yu.Tang.1","David.Kubiznak.1","S.Van.Vooren.1","Y.Gim.2","D.M.Eardley.1","Y.Shlapentokh.Rothman.1","A.Vasy.1","Finnian.Gray.1","P.M.Girao.1","D.Kastor.1","J.A.Gonzalez.2","Stephen.W.Hawking.1","Xiao.Mei.Kuang.1","J.A.Pullin.1","J.Lopes.Costa.1","Houwen.Wu.1","B.Gwak.1","Guangzhou.Guo.1","A.O.Starinets.1","I.Rodnianski.1","C.Cherubini.2","Marija.Tomasevic.1","M.Rahman.6","M.Appels.1","R.Penrose.1","Hang.Liu.1","J.Zahn.1","Raimon.Luna.1","C.Gundlach.1","S.F.Ross.1","Ali.Ovgun.1","A.Ori.2","Bin.Wang.2","R.Gregory.1","J.H.Traschen.1","O.J.C.Dias.1","Yiqian.Chen.1","A.Jansen.2","R.Dal.Bosco.Fontana.1","J.Sbierski.1","C.I.S.Marinho.1","Hong.Guo.1","P.Krtous.1","J.Podolsky.1","J.Luk.1","A.Anabalon.1","C.G.Wells.1","J.D.Silva.1","H.Weyl.1"],"figures":[{"filename":"QNM.png","caption":"Left: Imaginary parts of the lowest-lying quasinormal modes for $m_0=0$ and $\\alpha M=0.15$ as a function of $Q/M$. The solid blue curves correspond to photon surface modes, the red dashed curves to acceleration modes and the green dotted curves to near extremal modes. Right: Time evolution of scalar perturbations on the charged $C-$metric with $m_0=10$, $Q/M=0.3$, $\\alpha M=0.1$ (blue curve), $m_0=0$, $Q/M=0.3$, $\\alpha M=0.05$ (red curve) and $m_0=0$, $Q/M=0.9995$, $\\alpha M=0.6$ (green curve). The dominant mode extracted from the blue, red and green curves, at late times, belong to the photon surface, acceleration and near extremal family, respectively.","source":"arxiv","key":"40c49af624bb742e18e5088714a72c67","url":"https://inspirehep.net/files/40c49af624bb742e18e5088714a72c67"},{"filename":"beta.png","caption":"The parameter $\\beta$ calculated from the dominant quasinormal modes of a conformally-coupled scalar field propagating on the fixed near-extremally-charged $C-$metric, for various acceleration parameters $\\alpha M$. The black horizontal lines denote $\\beta=1/2$ (lower) and $\\beta=1$ (upper), respectively. The blue curves correspond to the $m_0=10$ approximation of the dominant photon surface modes, the red, dashed curves correspond to the $m_0=0$ dominant acceleration modes, while the green dotted correspond to the $m_0=0$ dominant near extremal modes.","source":"arxiv","key":"9b646ae2fe5b49951c1136f17986c66b","url":"https://inspirehep.net/files/9b646ae2fe5b49951c1136f17986c66b"}],"legacy_version":"20201120171843.0","inspire_categories":[{"term":"Gravitation and Cosmology","source":"arxiv"},{"term":"Theory-HEP","source":"arxiv"},{"term":"Gravitation and Cosmology"},{"term":"Theory-HEP"}],"first_author":{"emails":["kyriakos.destounis@uni-tuebingen.de"],"full_name":"Destounis, Kyriakos","last_name":"Destounis","first_name":"Kyriakos","recid":1719058},"control_number":1798924,"dois":[{"value":"10.1103/PhysRevD.102.104037"},{"material":"publication","source":"arXiv","value":"10.1103/PhysRevD.102.104037"}],"document_type":["article"],"texkeys":["Destounis:2020yav"],"abstracts":[{"source":"APS","value":"The extendibility of spacetime and the existence of weak solutions to the Einstein field equations beyond Cauchy horizons is a crucial ingredient to examine the limits of general relativity. Strong cosmic censorship serves as a firewall for gravitation by demanding the inextendibility of spacetime beyond the Cauchy horizon. For asymptotically flat spacetimes, the predominance of the blueshift instability and the subsequent formation of a mass-inflation singularity at the Cauchy horizon have, so far, substantiated the conjecture. Accelerating black holes, described by the C metric, are exact solutions of the field equations without a cosmological constant, which possess an acceleration horizon with similar causal properties to the cosmological horizon of de Sitter spacetime. Here, by considering linear scalar field perturbations, we provide numerical evidence for the stability of the Cauchy horizon of charged accelerating black holes. In particular, we show that the stability of Cauchy horizons in accelerating charged black holes is connected to quasinormal modes, discuss the regularity requirement for which weak solutions to the field equations exist at the Cauchy horizon, and show that strong cosmic censorship may be violated near extremality.","abstract_source_suggest":{"input":"APS"}},{"source":"arXiv","value":"The extendibility of spacetime and the existence of weak solutions to the Einstein field equations beyond Cauchy horizons, is a crucial ingredient to examine the limits of General Relativity. Strong Cosmic Censorship serves as a firewall for gravitation by demanding inextendibility of spacetime beyond the Cauchy horizon. For asymptotically flat spacetimes, the predominance of the blueshift instability and the subsequent formation of a mass-inflation singularity at the Cauchy horizon have, so far, substantiated the conjecture. Accelerating black holes, described by the $C-$metric, are exact solutions of the field equations without a cosmological constant, which possess an acceleration horizon with similar causal properties to the cosmological horizon of de Sitter spacetime. Here, by considering linear scalar field perturbations, we provide numerical evidence for the stability of the Cauchy horizon of charged accelerating black holes. In particular, we show that the stability of Cauchy horizons in accelerating charged black holes is connected to quasinormal modes, we discuss the regularity requirement for which weak solutions to the field equations exist at the Cauchy horizon and show that Strong Cosmic Censorship may be violated near extremality.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"source":"APS","title":"Stability of the Cauchy horizon in accelerating black-hole spacetimes"},{"source":"arXiv","title":"Counterexamples to strong cosmic censorship in asymptotically flat black hole spacetimes"}],"imprints":[{"date":"2020-11-13"}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/1798924?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1798924?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1798924?format=latex-us","json":"https://inspirehep.net/api/literature/1798924?format=json","json-expanded":"https://inspirehep.net/api/literature/1798924?format=json-expanded","cv":"https://inspirehep.net/api/literature/1798924?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1798924"},"updated":"2026-02-09T11:34:11.386426+00:00","created":"2020-06-03T00:00:00+00:00"},{"id":"379409","metadata":{"publication_info":[{"journal_volume":"74","page_end":"1283","year":1995,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214495"},"page_start":"1280","journal_title":"Phys.Rev.Lett."}],"citation_count":42,"authors":[{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/03rmrcq20"}],"full_name_unicode_normalized":"markovic, dragoljub","full_name":"Markovic, Dragoljub","record":{"$ref":"https://inspirehep.net/api/authors/2194586"},"ids":[{"schema":"INSPIRE BAI","value":"D.Markovic.4"}],"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/902688"},"value":"British Columbia U."}],"last_name":"Markovic","signature_block":"MARCAVACd","first_name":"Dragoljub","uuid":"108e7814-33a6-4a88-848b-0d0a48d99f11","recid":2194586},{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/05dxps055"}],"full_name_unicode_normalized":"poisson, eric","full_name":"Poisson, Eric","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/993093"},"ids":[{"schema":"INSPIRE BAI","value":"E.Poisson.1"}],"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/902711"},"value":"Caltech"}],"last_name":"Poisson","signature_block":"PASANe","first_name":"Eric","uuid":"6c7f3cfd-00ed-411f-b729-0ae6960741cb","recid":993093}],"citation_count_without_self_citations":41,"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","keywords":[{"schema":"INSPIRE","value":"black hole: horizon"},{"schema":"INSPIRE","value":"stability: classical"},{"schema":"INSPIRE","value":"space-time: de Sitter"},{"schema":"INSPIRE","value":"gravitation: perturbation"},{"schema":"INSPIRE","value":"tensor: energy-momentum"}],"references":[{"reference":{"publication_info":{"journal_volume":"284","artid":"301","page_start":"301","journal_title":"Proc.Roy.Soc.Lond.A"}}},{"reference":{"publication_info":{"journal_volume":"3","artid":"71","page_start":"71","journal_title":"Int.J.Mod.Phys.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/380568"}},{"reference":{"publication_info":{"journal_volume":"70","artid":"13","page_start":"13","journal_title":"Phys.Rev.Lett."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/355369"}},{"reference":{"publication_info":{"journal_volume":"9","artid":"L43","page_start":"L43","journal_title":"Class.Quant.Grav."}}},{"reference":{"publication_info":{"journal_volume":"9","artid":"121","page_start":"121","journal_title":"Class.Quant.Grav."}}},{"reference":{"arxiv_eprint":"gr-qc/9404015","publication_info":{"journal_volume":"11","artid":"1035","page_start":"1035","journal_title":"Class.Quant.Grav."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/37880"}},{"reference":{"publication_info":{"journal_volume":"70","artid":"1739","page_start":"1739","journal_title":"Phys.Rev.Lett."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/33975"}},{"reference":{"publication_info":{"journal_volume":"39","artid":"1067","page_start":"1067","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/25004"}},{"reference":{"publication_info":{"journal_volume":"13","artid":"2720","page_start":"2720","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/114289"}},{"reference":{"publication_info":{"journal_volume":"40","artid":"372","page_start":"372","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/285296"}},{"reference":{"publication_info":{"journal_volume":"43","artid":"332","page_start":"332","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/317025"}},{"reference":{"publication_info":{"journal_volume":"14","artid":"870","page_start":"870","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/117815"}}],"number_of_pages":4,"legacy_creation_date":"1994-11-04","preprint_date":"1994-11","author_count":2,"earliest_date":"1994-11","refereed":true,"external_system_identifiers":[{"schema":"MSNET","value":"1314796"},{"schema":"ADS","value":"1995PhRvL..74.1280M"},{"schema":"SPIRES","value":"SPIRES-3048713"}],"facet_author_name":["2194586_Dragoljub Markovic","993093_Eric Poisson"],"core":true,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:379409","updated":"2023-03-09T18:01:13.867460"},"journal_title_variants":["Phys. Rev. Lett.","Phys.Rev.Lett."],"arxiv_eprints":[{"categories":["gr-qc"],"value":"gr-qc/9411002"}],"referenced_authors_bais":["W.G.Unruh.1","I.G.Moss.1","A.D.Samuel.1","Paul.R.Anderson.1","Stephen.A.Fulling.1","R.Balbinot.1","C.M.Chambers.1","E.Poisson.1","D.Markovic.3","R.Bergamini.2","Paul.C.W.Davies.1","W.Israel.1","W.A.Hiscock.1"],"legacy_version":"20180614221518.0","inspire_categories":[{"term":"Gravitation and Cosmology"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/03rmrcq20"}],"full_name":"Markovic, Dragoljub","last_name":"Markovic","first_name":"Dragoljub","recid":2194586},"control_number":379409,"dois":[{"value":"10.1103/PhysRevLett.74.1280"}],"document_type":["article"],"texkeys":["Markovic:1994gy"],"abstracts":[{"source":"arXiv","value":"For a certain region of the parameter space $\\{M,e,\\Lambda\\}$, the Cauchy horizon of a (charged) black hole residing in de Sitter space is classically stable to gravitational perturbations. This implies that, when left to its own devices, classical theory is unable to retain full predictive power: the evolution of physical fields beyond the Cauchy horizon is not uniquely determined by the initial conditions. In this paper we argue that the Cauchy horizon of a Reissner-Nordstr\\\"om-de Sitter black hole must always be unstable quantum mechanically.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"Classical stability and quantum instability of black hole Cauchy horizons"}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/379409?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/379409?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/379409?format=latex-us","json":"https://inspirehep.net/api/literature/379409?format=json","json-expanded":"https://inspirehep.net/api/literature/379409?format=json-expanded","cv":"https://inspirehep.net/api/literature/379409?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A379409"},"updated":"2023-03-09T18:01:13.867460+00:00","created":"1994-11-04T00:00:00+00:00"},{"id":"324914","metadata":{"publication_info":[{"journal_volume":"8","page_end":"1139","year":1991,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214779"},"page_start":"1127","journal_title":"Class.Quant.Grav."}],"citation_count":14,"authors":[{"full_name_unicode_normalized":"yurtsever, u.","full_name":"Yurtsever, U.","record":{"$ref":"https://inspirehep.net/api/authors/982471"},"ids":[{"schema":"INSPIRE BAI","value":"U.Yurtsever.1"}],"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/902730"},"value":"Chicago U., EFI"}],"last_name":"Yurtsever","signature_block":"YARTSAFARu","first_name":"U.","uuid":"0adcff30-af54-46df-801e-5a1890d4395c","recid":982471}],"citation_count_without_self_citations":14,"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","keywords":[{"schema":"INSPIRE","value":"space-time"},{"schema":"INSPIRE","value":"dimension: 2"},{"schema":"INSPIRE","value":"field theory: scalar"},{"schema":"INSPIRE","value":"quantization"},{"schema":"INSPIRE","value":"stability"},{"schema":"INSPIRE","value":"boundary condition"}],"number_of_pages":13,"legacy_version":"20180204040139.0","legacy_creation_date":"1992-05-10","preprint_date":"1991","author_count":1,"first_author":{"full_name":"Yurtsever, U.","last_name":"Yurtsever","first_name":"U.","recid":982471},"control_number":324914,"dois":[{"value":"10.1088/0264-9381/8/6/011"}],"earliest_date":"1991","document_type":["article"],"texkeys":["Yurtsever:1991nf"],"abstracts":[{"source":"IOP","value":"The author studies a class of two-dimensional model spacetimes with compact Cauchy horizons; these models retain some of the key features of the four-dimensional problem. All of the model Cauchy horizons are classically unstable against scalar perturbations and the mechanism of instability is the infinite blue-shifting of radiation near the horizon. The quantum instability of the horizon is purely non-radiative (particle creation remains bounded), and has exactly the same mechanism as in the classical case (infinite blue-shifting of the Casimir vacuum energy). Some specific conjectures on the four-dimensional problem are given.","abstract_source_suggest":{"input":"IOP"}}],"refereed":true,"titles":[{"title":"Classical and quantum instability of compact Cauchy horizons in two-dimensions"}],"external_system_identifiers":[{"schema":"SPIRES","value":"SPIRES-2537346"}],"facet_author_name":["982471_Ulvi Yurtsever"],"core":true,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:324914","updated":"2023-03-09T19:53:53.209562"},"curated":true,"journal_title_variants":["Class. Quant. Grav.","Class.Quant.Grav."]},"links":{"bibtex":"https://inspirehep.net/api/literature/324914?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/324914?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/324914?format=latex-us","json":"https://inspirehep.net/api/literature/324914?format=json","json-expanded":"https://inspirehep.net/api/literature/324914?format=json-expanded","cv":"https://inspirehep.net/api/literature/324914?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A324914"},"updated":"2023-03-09T19:53:53.209562+00:00","created":"1992-05-10T00:00:00+00:00"},{"id":"1722497","metadata":{"publication_info":[{"journal_volume":"10","artid":"40","year":2020,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1334184"},"page_start":"40","journal_issue":"3","journal_title":"Anal.Math.Phys."}],"citation_count":5,"authors":[{"affiliations_identifiers":[{"schema":"GRID","value":"grid.45349.3f"},{"schema":"GRID","value":"grid.9983.b"}],"raw_affiliations":[{"value":"ISCTE - Instituto Universitário de Lisboa, Lisbon, Portugal"},{"value":"Center for Mathematical Analysis, Geometry and Dynamical Systems, Instituto Superior Técnico, Universidade de Lisboa, Av. Rovisco Pais, 1049-001 Lisbon, Portugal"}],"full_name_unicode_normalized":"costa, joão l.","full_name":"Costa, João L.","record":{"$ref":"https://inspirehep.net/api/authors/1056096"},"last_name":"Costa","ids":[{"schema":"ORCID","value":"0000-0002-2087-2389"},{"schema":"INSPIRE BAI","value":"J.Lopes.Costa.1"}],"signature_block":"CASTj","first_name":"João L.","uuid":"0af908b3-3ed4-4a19-a4c5-68fdbb555939","recid":1056096},{"affiliations_identifiers":[{"schema":"GRID","value":"grid.9983.b"}],"raw_affiliati