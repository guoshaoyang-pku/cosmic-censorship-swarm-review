is":["10.1088/0264-9381/32/1/015017"],"label":"4"},"raw_refs":[{"schema":"text","value":"[4] JL Costa, PM Girão, J Natário, JD Silva: On the global uniqueness for the Einstein–Maxwell-scalar field system with a cosmological constant. Part 1: well posedness and breakdown criterion, ['Class.Quant.Grav.,32,015017'], DOI: 10.1088/0264-9381/32/1/015017"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1303534"}},{"reference":{"dois":["10.1007/s00220-015-2433-6"],"label":"5"},"raw_refs":[{"schema":"text","value":"[5] JL Costa, PM Girão, J Natário, JD Silva: On the global uniqueness for the Einstein–Maxwell-scalar field system with a cosmological constant. Part 2: structure of the solutions and stability of the Cauchy horizon, ['Commun.Math.Phys.,339,903-947'], DOI: 10.1007/s00220-015-2433-6"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1303535"}},{"reference":{"dois":["10.1007/s40818-017-0028-6"],"label":"6"},"raw_refs":[{"schema":"text","value":"[6] JL Costa, PM Girão, J Natário, JD Silva: On the global uniqueness for the Einstein–Maxwell-scalar field system with a cosmological constant. Part 3: mass inflation and extendibility of the solutions, Ann. PDE 3 (2017) 8, DOI: 10.1007/s40818-017-0028-6"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1303536"}},{"reference":{"dois":["10.1007/s00220-018-3122-z"],"label":"7"},"raw_refs":[{"schema":"text","value":"[7] JL Costa, PM Girão, J Natário, JD Silva: On the occurrence of mass inflation for the Einstein–Maxwell-scalar field system with a cosmological constant and an exponential Price law, ['Commun.Math.Phys.,361,289'], DOI: 10.1007/s00220-018-3122-z"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1613504"}},{"reference":{"arxiv_eprint":"1710.01722","label":"8"},"raw_refs":[{"schema":"text","value":"[8] Dafermos, M., Luk, J.: The interior of dynamical vacuum black holes I: the $C^0$-stability of the Kerr Cauchy horizon."}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1628644"}},{"reference":{"dois":["10.1007/s00220-016-2771-z"],"label":"9"},"raw_refs":[{"schema":"text","value":"[9] M Dafermos, Y Shlapentokh-Rothman: Time-translation invariance of scattering maps and blue-shift instabilities on Kerr black hole spacetimes, ['Commun.Math.Phys.,350,985-1016'], DOI: 10.1007/s00220-016-2771-z"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1411430"}},{"reference":{"dois":["10.1088/1361-6382/aadbcf"],"label":"10"},"raw_refs":[{"schema":"text","value":"[10] M Dafermos, Y Shlapentokh-Rothman: Rough initial data and the strength of the blue-shift instability on cosmological black holes with $\\Lambda > 0$, ['Class.Quant.Grav.,35,195010'], DOI: 10.1088/1361-6382/aadbcf"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1674350"}},{"reference":{"dois":["10.1007/s00220-014-2255-y"],"label":"11"},"raw_refs":[{"schema":"text","value":"[11] S Dyatlov: Asymptotics of linear waves and resonances with applications to black holes, ['Commun.Math.Phys.,335,1445-1485'], DOI: 10.1007/s00220-014-2255-y"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1232381"}},{"reference":{"dois":["10.1007/s00220-015-2440-7"],"label":"12"},"raw_refs":[{"schema":"text","value":"[12] AT Franzen: Boundedness of massless scalar waves on Reissner–Nordström interior backgrounds, ['Commun.Math.Phys.,343,601'], DOI: 10.1007/s00220-015-2440-7"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1308494"}},{"reference":{"dois":["10.1007/s00220-016-2800-y"],"label":"13"},"raw_refs":[{"schema":"text","value":"[13] D Gajic: Linear waves in the interior of extremal black holes I, ['Commun.Math.Phys.,353,717'], DOI: 10.1007/s00220-016-2800-y"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1394382"}},{"reference":{"dois":["10.1007/s00023-017-0614-x"],"label":"14"},"raw_refs":[{"schema":"text","value":"[14] D Gajic: Linear waves in the interior of extremal black holes II, Henri Poincaré 18 (2017) 4005, DOI: 10.1007/s00023-017-0614-x"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1411625"}},{"reference":{"arxiv_eprint":"1709.09137","label":"15"},"raw_refs":[{"schema":"text","value":"[15] Gajic, D., Luk, J.: The interior of dynamical extremal black holes in spherical symmetry (2017)."}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1625737"}},{"reference":{"dois":["10.4171/CMH/425"],"label":"16"},"raw_refs":[{"schema":"text","value":"[16] P Hintz: Boundedness and decay of scalar waves at the Cauchy horizon of the Kerr spacetime, ['Comment.Math.Helv.,92,801-837'], DOI: 10.4171/CMH/425"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1411419"}},{"reference":{"dois":["10.1063/1.4996575"],"label":"17"},"raw_refs":[{"schema":"text","value":"[17] P Hintz, A Vasy: Analysis of linear waves near the Cauchy horizon of cosmological black holes, ['J.Math.Phys.,58,081509'], DOI: 10.1063/1.4996575"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1411420"}},{"reference":{"dois":["10.1002/cpa.21470"],"label":"18"},"raw_refs":[{"schema":"text","value":"[18] G Holzegel, J Smulevici: Decay properties of Klein–Gordon fields on Kerr-AdS spacetimes, ['Commun.Pure Appl.Math.,66,1751-1802'], DOI: 10.1002/cpa.21470"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/943713"}},{"reference":{"arxiv_eprint":"1812.06142","label":"19"},"raw_refs":[{"schema":"text","value":"[19] Kehle, C.: Uniform boundedness and continuity at the Cauchy horizon for linear waves on Reissner–Nordström–AdS black holes."}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1709347"}},{"reference":{"dois":["10.1007/s00023-019-00760-z"],"label":"20"},"raw_refs":[{"schema":"text","value":"[20] C Kehle, Y Shlapentokh-Rothman: A scattering theory for linear waves on the interior of Reissner–Nordström black holes, Ann. Henri Poincaré (2019) , DOI: 10.1007/s00023-019-00760-z"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1667892"}},{"reference":{"dois":["10.1215/00127094-3715189"],"label":"21"},"raw_refs":[{"schema":"text","value":"[21] J Luk, S-J Oh: Proof of linear instability of Reissner–Nordström Cauchy horizon under scalar perturbations, ['Duke Math.J.,166,437-493'], DOI: 10.1215/00127094-3715189"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1340082"}},{"reference":{"arxiv_eprint":"1702.05715","label":"22"},"raw_refs":[{"schema":"text","value":"[22] Luk, J., Oh, S.-J.: Strong cosmic censorship in spherical symmetry for two-ended asymptotically flat initial data I. The interior of the black hole region."}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1514231"}},{"reference":{"arxiv_eprint":"1702.05716","label":"23"},"raw_refs":[{"schema":"text","value":"[23] Luk, J., Oh, S.-J.: Strong cosmic censorship in spherical symmetry for two-ended asymptotically flat initial data II. The exterior of the black hole region."}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1514232"}},{"reference":{"dois":["10.1016/j.jfa.2016.06.013"],"label":"24"},"raw_refs":[{"schema":"text","value":"[24] J Luk, J Sbierski: Instability results for the wave equation in the interior of Kerr black holes, ['J.Funct.Anal.,271,1948-1995'], DOI: 10.1016/j.jfa.2016.06.013"}]},{"reference":{"label":"25","misc":[": On the initial value problem in general relativity and wave propagation in black-hole spacetimes. Ph.D. thesis"],"authors":[{"full_name":"Sbierski, J."}]},"raw_refs":[{"schema":"text","value":"[25] Sbierski, J.: On the initial value problem in general relativity and wave propagation in black-hole spacetimes. Ph.D. thesis"}]},{"reference":{"dois":["10.1007/s00220-017-3079-3"],"label":"26"},"raw_refs":[{"schema":"text","value":"[26] M Van de Moortel: Stability and instability of the sub-extremal Reissner–Nordström black hole interior for the Einstein–Maxwell–Klein–Gordon equations in spherical symmetry, ['Commun.Math.Phys.,360,103'], DOI: 10.1007/s00220-017-3079-3"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1592377"}}],"number_of_pages":22,"legacy_creation_date":"2019-03-01","preprint_date":"2019-02-27","author_count":2,"public_notes":[{"source":"arXiv","value":"22 pages, 2 figures"}],"earliest_date":"2019-02-27","refereed":true,"external_system_identifiers":[{"schema":"MSNET","value":"4144345"}],"facet_author_name":["1964560_Pedro M. Girão","1056096_Joao Lopes Costa"],"license":[{"license":"arXiv nonexclusive-distrib 1.0","material":"preprint","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1722497","updated":"2023-10-03T08:33:11.897915"},"journal_title_variants":["Anal.Math.Phys.","Anal. Math. Phys."],"arxiv_eprints":[{"categories":["gr-qc","math-ph","math.AP","math.MP"],"value":"1902.10726"}],"referenced_authors_bais":["M.Dafermos.1","S.Dyatlov.1","J.Luk.1","P.M.Girao.1","J.Lopes.Costa.1","J.D.Silva.1","Y.Shlapentokh.Rothman.1","A.Jansen.2","S.J.Oh.1","V.Cardoso.1","M.Van.de.Moortel.1","S.Aretakis.1","Y.Angelopoulos.1","G.Holzegel.1","J.Smulevici.2","C.Kehle.1","P.Hintz.1","J.Natario.1","A.Franzen.1","D.Gajic.1","Kyriakos.Destounis.1","A.Vasy.1"],"figures":[{"filename":"RNdS.png","caption":"The Penrose diagram of the Reissner-Nordstr\\\"{o}m-de Sitter spacetime.","source":"arxiv","key":"1a3e6ae48f8cb33213772794ce4f62b8","url":"https://inspirehep.net/files/1a3e6ae48f8cb33213772794ce4f62b8"},{"filename":"region.png","caption":"The region $\\cal{R}$.","source":"arxiv","key":"b7efbcb691439dc6243dd058364b7df4","url":"https://inspirehep.net/files/b7efbcb691439dc6243dd058364b7df4"}],"legacy_version":"20210316100349.0","inspire_categories":[{"term":"Gravitation and Cosmology","source":"arxiv"},{"term":"Math and Math Physics","source":"arxiv"}],"first_author":{"affiliations_identifiers":[{"schema":"GRID","value":"grid.45349.3f"},{"schema":"GRID","value":"grid.9983.b"}],"full_name":"Costa, João L.","last_name":"Costa","ids":[{"schema":"ORCID","value":"0000-0002-2087-2389"},{"schema":"INSPIRE BAI","value":"J.Lopes.Costa.1"}],"first_name":"João L.","recid":1056096},"control_number":1722497,"dois":[{"source":"bibmatch","value":"10.1007/s13324-020-00380-5"}],"document_type":["article"],"texkeys":["Costa:2019uny"],"abstracts":[{"source":"Springer","value":"We consider smooth solutions of the wave equation, on a fixed black hole region of a subextremal Reissner–Nordström (asymptotically flat, de Sitter or anti-de Sitter) spacetime, whose restrictions to the event horizon have compact support. We provide criteria, in terms of surface gravities, for the waves to remain in $C^l$, $l\\geqslant 1$, up to and including the Cauchy horizon. We also provide sufficient conditions for the blow up of solutions in $C^1$ and $H^1$.","abstract_source_suggest":{"input":"Springer"}},{"source":"arXiv","value":"We consider smooth solutions of the wave equation, on a fixed black hole region of a subextremal Reissner-Nordstr\\\"om (asymptotically flat, de Sitter or anti-de Sitter) spacetime, whose restrictions to the event horizon have compact support. We provide criteria, in terms of surface gravities, for the waves to remain in $C^l$, $l\\geq 1$, up to and including the Cauchy horizon. We also provide sufficient conditions for the blow up of solutions in $C^1$ and $H^1$.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"source":"Springer","title":"Higher order linear stability and instability of Reissner–Nordström’s Cauchy horizon"},{"source":"arXiv","title":"Higher Order Linear Stability and Instability of Reissner-Nordström's Cauchy Horizon"}],"imprints":[{"date":"2020-08-26"}],"curated":false},"links":{"bibtex":"https://inspirehep.net/api/literature/1722497?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1722497?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1722497?format=latex-us","json":"https://inspirehep.net/api/literature/1722497?format=json","json-expanded":"https://inspirehep.net/api/literature/1722497?format=json-expanded","cv":"https://inspirehep.net/api/literature/1722497?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1722497"},"updated":"2023-10-03T08:33:11.897915+00:00","created":"2019-03-01T00:00:00+00:00"}],"total":90},"links":{"self":"https://inspirehep.net/api/literature/?q=...Stability%20and%20instability%20of%20the%20Cauchy%20horizon...&size=10&page=1","next":"https://inspirehep.net/api/literature/?q=...Stability%20and%20instability%20of%20the%20Cauchy%20horizon...&size=10&page=2","bibtex":"https://inspirehep.net/api/literature/?q=...Stability%20and%20instability%20of%20the%20Cauchy%20horizon...&size=10&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=...Stability%20and%20instability%20of%20the%20Cauchy%20horizon...&size=10&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=...Stability%20and%20instability%20of%20the%20Cauchy%20horizon...&size=10&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=...Stability%20and%20instability%20of%20the%20Cauchy%20horizon...&size=10&page=1&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=...Stability%20and%20instability%20of%20the%20Cauchy%20horizon...&size=10&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=...Stability%20and%20instability%20of%20the%20Cauchy%20horizon...&size=10&page=1&format=cv"}}