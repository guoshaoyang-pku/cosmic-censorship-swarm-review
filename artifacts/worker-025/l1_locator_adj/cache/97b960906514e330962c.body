.Grav."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/562652"}},{"reference":{"arxiv_eprint":"gr-qc/0311014","publication_info":{"journal_volume":"21","artid":"371","page_start":"371","journal_title":"Class.Quant.Grav."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/632497"}},{"reference":{"arxiv_eprint":"gr-qc/0412040","publication_info":{"journal_volume":"607","artid":"8","page_start":"8","journal_title":"Phys.Lett.B"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/666541"}},{"reference":{"publication_info":{"journal_volume":"231","artid":"37","page_start":"37","journal_title":"Mon.Not.Roy.Astron.Soc."}}},{"reference":{"publication_info":{"journal_volume":"260","artid":"317","page_start":"317","journal_title":"Mon.Not.Roy.Astron.Soc."}}},{"reference":{"publication_info":{"journal_volume":"36","artid":"1","page_start":"1","journal_title":"Acta Astron."}}},{"reference":{"arxiv_eprint":"gr-qc/9705012","publication_info":{"journal_volume":"56","artid":"3600","page_start":"3600","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/442862"}},{"reference":{"arxiv_eprint":"gr-qc/9809036","publication_info":{"journal_volume":"59","artid":"064027","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/476026"}},{"reference":{"publication_info":{"journal_volume":"59","artid":"104002","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/497325"}},{"reference":{"publication_info":{"journal_volume":"63","artid":"047502","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/552397"}},{"reference":{"publication_info":{"journal_volume":"64","artid":"044007","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/560655"}},{"reference":{"publication_info":{"journal_volume":"19","artid":"2268","page_start":"2268","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/146034"}},{"reference":{"publication_info":{"journal_volume":"22","artid":"1300","page_start":"1300","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/159228"}}],"number_of_pages":5,"legacy_creation_date":"2005-01-12","preprint_date":"2005-01","author_count":3,"earliest_date":"2005-01","refereed":true,"external_system_identifiers":[{"schema":"MSNET","value":"2138839"},{"schema":"SPIRES","value":"SPIRES-6099408"}],"facet_author_name":["985841_Takashi Torii","999314_Hideki Maeda","1006719_Tomohiro Harada"],"core":true,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:674750","updated":"2023-03-06T15:51:46.753876"},"journal_title_variants":["Phys. Rev. D","Phys.Rev.D"],"arxiv_eprints":[{"categories":["gr-qc"],"value":"gr-qc/0501042"}],"referenced_authors_bais":["I.G.Moss.1","H.Maeda.1","T.Torii.1","C.M.Chambers.1","E.Poisson.1","P.Peldan.1","A.Ori.2","T.Matsumoto.1","U.H.Gerlach.1","W.Israel.1","J.Louko.1","Kengo.Maeda.1","U.K.Sengupta.1","P.R.Brady.1","D.Brill.1","T.Harada.1","D.Ida.1","R.C.Myers.1","Tomoyuki.Hanawa.1","R.Penrose.1","M.Narita.1","L.M.Burko.1","P.Kraus.1"],"legacy_version":"20180614230313.0","inspire_categories":[{"term":"Gravitation and Cosmology"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/00ntfnx83"}],"full_name":"Maeda, Hideki","last_name":"Maeda","ids":[{"schema":"ORCID","value":"0000-0002-7525-1264"},{"schema":"INSPIRE BAI","value":"H.Maeda.1"}],"first_name":"Hideki","recid":999314},"control_number":674750,"dois":[{"value":"10.1103/PhysRevD.71.064015"}],"document_type":["article"],"texkeys":["Maeda:2005yd"],"abstracts":[{"source":"arXiv","value":"The evolution of weak discontinuity is investigated on horizons in the $n$-dimensional static solutions in the Einstein-Maxwell-scalar-$\\Lambda$ system, including the Reissner-Nordstrom-(anti) de Sitter black hole. The analysis is essentially local and nonlinear. We find that the Cauchy horizon is unstable, whereas both the black-hole event horizon and the cosmological event horizon are stable. This new instability, the so-called kink instability, of the Cauchy horizon is completely different from the well-known ``infinite-blueshift'' instability. The kink instability makes the analytic continuation beyond the Cauchy horizon unstable.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"Novel Cauchy-horizon instability"},{"source":"arXiv","title":"Novel Cauchy-horizon instability."}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/674750?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/674750?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/674750?format=latex-us","json":"https://inspirehep.net/api/literature/674750?format=json","json-expanded":"https://inspirehep.net/api/literature/674750?format=json-expanded","cv":"https://inspirehep.net/api/literature/674750?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A674750"},"updated":"2023-03-06T15:51:46.753876+00:00","created":"2005-01-12T00:00:00+00:00"},{"id":"1592377","metadata":{"citation_count":30,"authors":[{"full_name_unicode_normalized":"van de moortel, maxime","full_name":"Van de Moortel, Maxime","record":{"$ref":"https://inspirehep.net/api/authors/1926183"},"ids":[{"schema":"INSPIRE BAI","value":"M.Van.de.Moortel.1"}],"last_name":"Van de Moortel","signature_block":"MARTALm","uuid":"61b00028-82d3-4b1f-8f88-7bf134725a9e","first_name":"Maxime","recid":1926183}],"citation_count_without_self_citations":26,"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","references":[{"reference":{"arxiv_eprint":"1504.04592",