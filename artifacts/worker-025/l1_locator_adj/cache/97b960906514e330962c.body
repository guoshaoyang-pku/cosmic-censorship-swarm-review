2","page_start":"7322","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/398385"}},{"reference":{"arxiv_eprint":"gr-qc/9708028","publication_info":{"journal_volume":"57","artid":"1052","page_start":"1052","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/447215"}},{"reference":{"arxiv_eprint":"gr-qc/9709022"},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/448232"}},{"reference":{"arxiv_eprint":"gr-qc/9709025"},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/448267"}},{"reference":{"arxiv_eprint":"gr-qc/9602052","publication_info":{"journal_volume":"54","artid":"6233","page_start":"6233","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/416262"}},{"reference":{"publication_info":{"journal_volume":"21","artid":"1445","page_start":"1445","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/157696"}},{"reference":{"publication_info":{"journal_volume":"43","artid":"332","page_start":"332","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/317025"}},{"reference":{"publication_info":{"journal_volume":"26","artid":"1225","page_start":"1225","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/183820"}},{"reference":{"arxiv_eprint":"gr-qc/9706006","publication_info":{"journal_volume":"56","artid":"4922","page_start":"4922","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/443751"}}],"number_of_pages":20,"legacy_creation_date":"1997-11-24","preprint_date":"1997-06","author_count":1,"earliest_date":"1997-06","external_system_identifiers":[{"schema":"ADS","value":"1997AnIPS..13..462F"},{"schema":"SPIRES","value":"SPIRES-3658724"}],"facet_author_name":["1009857_Eanna E. Flanagan"],"core":true,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:451400","updated":"2023-03-06T16:16:18.020607"},"journal_title_variants":["Annals Israel Phys. Soc.","Annals Israel Phys.Soc."],"arxiv_eprints":[{"categories":["gr-qc"],"value":"gr-qc/9711066"}],"referenced_authors_bais":["W.G.Unruh.1","M.J.Radzikowski.1","I.G.Moss.1","M.S.Morris.1","H.J.Sheinblatt.1","K.M.Simpson.1","Valeri.P.Frolov.1","C.M.Chambers.1","J.Preskill.1","S.V.Sushkov.1","B.S.Kay.1","T.M.Helliwell.1","G.T.Horowitz.1","S.W.Kim.2","D.Markovic.3","G.Klinkhammer.1","Stephen.W.Hawking.1","T.M.Fiola.1","S.Krasnikov.1","S.P.Trivedi.1","E.Poisson.1","E.E.Flanagan.1","D.Markovic.4","Paul.C.W.Davies.1","W.A.Hiscock.1","Kip.S.Thorne.1","C.R.Cramer.2","D.A.Konkowski.1","R.M.Wald.1","R.Penrose.1","A.Strominger.1","U.Yurtsever.1"],"legacy_version":"20180327134028.0","inspire_categories":[{"term":"Gravitation and Cosmology"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/05bnh6r87"}],"full_name":"Flanagan, Eanna E.","ids":[{"schema":"ORCID","value":"0000-0001-6818-3550"},{"schema":"INSPIRE BAI","value":"E.E.Flanagan.1"}],"last_name":"Flanagan","first_name":"Eanna E.","recid":1009857},"control_number":451400,"document_type":["conference paper"],"texkeys":["Flanagan:1997er"],"abstracts":[{"source":"arXiv","value":"There are several examples known of two dimensional spacetimes which are linearly stable when perturbed by test scalar classical fields, but which are unstable when perturbed by test scalar quantum fields. We elucidate the mechanism behind such instabilities by considering minimally coupled, massless, scalar, test quantum fields on general two dimensional spacetimes with Cauchy horizons which are classically stable. We identify a geometric feature of such spacetimes which is a necessary condition for obtaining a quantum mechanical divergence of the renormalized expected stress tensor on the Cauchy horizon for regular initial states. This feature is the divergence of the affine parameter length of a one parameter family of null geodesics which lie parallel to the Cauchy horizon, where the affine parameter normalization is determined by parallel transport along a fixed, transverse null geodesic which intersects the Cauchy horizon. (By contrast, the geometric feature of such spacetimes which underlies classical blueshift instabilities is the divergence of a holonomy operator). We show that the instability can be understood as a ``delayed blueshift'' instability, which arises from the infinite blueshifting of an energy flux which is created locally and quantum mechanically. The instability mechanism applies both to chronology horizons in spacetimes with closed timelike curves, and to the inner horizon in black hole spacetimes like two dimensional Reissner-Nordstrom-de Sitter.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"Quantum mechanical instabilities of Cauchy horizons in two-dimensions: A Modified form of the blueshift instability mechanism"},{"source":"arXiv","title":"Quantum mechanical instabilities of Cauchy horizons in two dimensions: A modified form of the blueshift instability mechanism."}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/451400?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/451400?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/451400?format=latex-us","json":"https://inspirehep.net/api/literature/451400?format=json","json-expanded":"https://inspirehep.net/api/literature/451400?format=json-expanded","cv":"https://inspirehep.net/api/literature/451400?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A451400"},"updated":"2023-03-06T16:16:18.020607+00:00","created":"1997-11-24T00:00:00+00:00"},{"id":"1798924","metadata":{"publication_info":[{"journal_volume":"102