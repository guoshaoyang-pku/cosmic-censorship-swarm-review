iers":[{"schema":"MSNET","value":"2748319"},{"schema":"ADS","value":"2011PhLB..695..376B"},{"schema":"SPIRES","value":"SPIRES-8692491"}],"facet_author_name":["998954_Robert B. Mann","1032606_Leonardo Modesto","1078441_Eric G. Brown"],"core":true,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:859178","updated":"2023-03-06T17:35:00.750641"},"journal_title_variants":["Phys. Lett. B","Phys.Lett.B"],"arxiv_eprints":[{"categories":["gr-qc"],"value":"1006.4164"}],"referenced_authors_bais":["R.B.Mann.1","A.Ashtekar.1","K.Vandersloot.1","M.Rinaldi.1","R.Gambini.1","S.K.Modak.1","E.Spallucci.1","Jerzy.Lewandowski.1","D.Batic.1","A.Smailagic.1","W.Israel.1","J.Louko.1","Y.W.Kim.2","Martin.Reuter.1","R.Balbinot.1","V.Husain.1","N.Zamorano.1","M.Campiglia.1","M.Bleicher.1","Sabine.Hossenfelder.1","Y.J.Park.1","D.Valev.1","D.R.Terno.1","G.Kunstatter.1","Martin.Bojowald.1","Lee.Smolin.1","A.Peltola.2","J.Ziprick.2","E.Poisson.1","J.A.Pullin.1","Piero.Nicolini.1","V.Sandberg.1","I.PremontSchwarz.2","Y.W.Kim.4","F.Caravelli.1","L.Modesto.1","R.A.Matzner.1","A.Bonanno.1","Bibhas.Ranjan.Majhi.1","S.Ansoldi.1","Saurav.Samanta.1","C.G.Boehmer.1","R.Banerjee.1","Yun.Soo.Myung.1","T.Thiemann.1","D.W.Chiou.1"],"figures":[{"filename":"PenroseDiagram.png","caption":"Penrose diagram for the loop black hole on the right and its Reissner-Nordstr\\(\\ddot{\\text{o}}\\)m analog on the left.","source":"arxiv","key":"f0878e567d35256084a0a93d55b59b35","url":"https://inspirehep.net/files/f0878e567d35256084a0a93d55b59b35"},{"filename":"StabilityG.png","caption":"Displaying the two scatterings off of the main wave which could potentially cause instability at the Cauchy horizon. For scatterings 1 and 2 we must check the forms of \\(g^{(-)'}\\) and \\(g^{(+)'}\\) respectively.","source":"arxiv","key":"9b79a3eaa321df6edb60ffa2bb35ca9e","url":"https://inspirehep.net/files/9b79a3eaa321df6edb60ffa2bb35ca9e"}],"legacy_version":"20180612214847.0","inspire_categories":[{"term":"Astrophysics"},{"term":"Gravitation and Cosmology"},{"term":"Theory-HEP"}],"first_author":{"full_name":"Brown, Eric","last_name":"Brown","first_name":"Eric","recid":1078441},"control_number":859178,"dois":[{"value":"10.1016/j.physletb.2010.11.035"}],"document_type":["article"],"texkeys":["Brown:2010csa"],"abstracts":[{"source":"Elsevier","value":"We study the stability properties of the Cauchy horizon for two different self-dual black hole solutions obtained in a model inspired by Loop Quantum Gravity. The self-dual spacetimes depend on a free dimensionless parameter called a polymeric parameter P . For the first metric the Cauchy horizon is stable for supermassive black holes only if this parameter is sufficiently small. For small black holes, however the stability is easily implemented. The second metric analyzed is not only self-dual but also form-invariant under the transformation r→r⁎2/r and r⁎=2mP . We find that this symmetry protects the Cauchy horizon for any value of the polymeric parameter.","abstract_source_suggest":{"input":"Elsevier"}},{"source":"arXiv","value":"We study the stability properties of the Cauchy horizon for two different self-dual black hole solutions obtained in a model inspired by Loop Quantum Gravity. The self-dual spacetimes depend on a free dimensionless parameter called a polymeric parameter P. For the first metric the Cauchy horizon is stable for supermassive black holes only if this parameter is sufficiently small. For small black holes, however the stability is easily implemented. The second metric analyzed is not only self-dual but also 'form-invariant' under the transformation r -> r*^2/r and r* = 2 m P. We find that this symmetry protects the Cauchy horizon for any value of the polymeric parameter.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"Stability of self-dual black holes"},{"source":"arXiv","title":"Stability of self-dual black holes"}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/859178?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/859178?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/859178?format=latex-us","json":"https://inspirehep.net/api/literature/859178?format=json","json-expanded":"https://inspirehep.net/api/literature/859178?format=json-expanded","cv":"https://inspirehep.net/api/literature/859178?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A859178"},"updated":"2023-03-06T17:35:00.750641+00:00","created":"2010-06-22T00:00:00+00:00"},{"id":"674750","metadata":{"report_numbers":[{"value":"WU-AP-208-05"}],"publication_info":[{"journal_volume":"71","artid":"064015","year":2005,"journal_title":"Phys.Rev.D"}],"citation_count":30,"authors":[{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/00ntfnx83"}],"full_name_unicode_normalized":"maeda, hideki","full_name":"Maeda, Hideki","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/999314"},"last_name":"Maeda","ids":[{"schema":"ORCID","value":"0000-0002-7525-1264"},{"schema":"INSPIRE BAI","value":"H.Maeda.1"}],"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/907916"},"value":"Waseda U., RISE"}],"signature_block":"MADh","uuid":"8b001898-ab6a-4a6a-bf2d-ce0871ec0aeb","first_name":"Hideki","recid":999314},{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/00ntfnx83"}],"full_name_unicode_normalized":"torii, takashi","full_name":"Torii, Takashi","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/985841"},"last_name":"Torii","ids":[{"schema":"INSPIRE BAI","value":"T.Torii.1"}],"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903336"},"value":"Waseda U."}],"signature_block":"TARt","uuid":"6d61ab51-380b-45b5-af2a-7c1a4ec09d1a","first_name":"Takashi","recid":985841},{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/026zzn846"}],"full_name_unicode_norm