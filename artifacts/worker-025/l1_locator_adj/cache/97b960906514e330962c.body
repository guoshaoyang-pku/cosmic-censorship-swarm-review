elation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1380899"}},{"reference":{"label":"35","publication_info":{"journal_volume":"309","page_end":"891","year":2014,"page_start":"859","journal_title":"Commun.Math.Phys."},"misc":["Yakov Shlapentokh-Rothman, Exponentially growing finite energy solutions for the Klein-Gordon equation on sub-extremal Kerr spacetimes"]}},{"reference":{"dois":["10.1007/BF00792069"],"label":"36","publication_info":{"journal_volume":"7","artid":"183","year":1973,"page_start":"183","journal_title":"Int.J.Theor.Phys."},"misc":["Michael Simpson, Roger Penrose Internal instability in a Reissner-Nordström black hole"]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/87999"}},{"reference":{"label":"37","publication_info":{"year":2006},"misc":["Terence Tao, Nonlinear dispersive equations : local and global analysis. CBMS"]}}],"number_of_pages":46,"legacy_creation_date":"2017-04-20","preprint_date":"2017-04-19","author_count":1,"public_notes":[{"source":"arXiv","value":"46 pages, 4 figures Correction of a few typos. Version accepted for publication in Communications in Mathematical Physics"}],"earliest_date":"2017-04-19","external_system_identifiers":[{"schema":"ADS","value":"2018CMaPh.tmp...16V"}],"facet_author_name":["1926183_Maxime Van de Moortel"],"license":[{"imposing":"arXiv","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"},{"license":"CC-BY-4.0","imposing":"Springer"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1592377","updated":"2023-03-07T04:27:58.840970"},"arxiv_eprints":[{"categories":["gr-qc","math-ph","math.AP","math.MP"],"value":"1704.05790"}],"referenced_authors_bais":["P.Bizon.1","Gaurav.Khanna.1","Y.Shlapentokh.Rothman.1","R.Penrose.1","George.F.R.Ellis.1","L.M.Burko.1","A.Zhidenko.1","J.Sbierski.1","M.Dafermos.1","Stephen.W.Hawking.1","J.Kommemi.2","A.Franzen.1","Roman.A.Konoplya.1","P.G.LeFloch.1","K.M.Simpson.1","R.P.Geroch.1","P.Hintz.1","A.Ori.2","V.Schlue.1","A.Wasserman.2","O.Chodosh.1","Demetrios.Christodoulou.1","S.Alexakis.2","Y.Choquet.Bruhat.1","Yue.Ma.1","I.Rodnianski.1"],"figures":[{"filename":"L1.png","caption":"Penrose diagram for the characteristic initial value problem appearing in \\cite{Mihalis1} .","source":"arxiv","key":"977a3b693d8bcbe9e97698b79fc68ac3","url":"https://inspirehep.net/files/977a3b693d8bcbe9e97698b79fc68ac3"},{"filename":"L2.png","caption":"Penrose diagram illustrating the division between a red-shift $\\mathcal{R}$ and a blue-shift region $\\mathcal{B}$.","source":"arxiv","key":"91525051e50bee9f6e61ca9f1c32b9d0","url":"https://inspirehep.net/files/91525051e50bee9f6e61ca9f1c32b9d0"},{"filename":"L3.png","caption":"Penrose diagram of the space-time $\\mathcal{M}=\\mathcal{R} \\cup \\mathcal{N} \\cup \\mathcal{EB} \\cup \\mathcal{LB} $","source":"arxiv","key":"53cd0eef7c8caac6e64a1d87d513ca2b","url":"https://inspirehep.net/files/53cd0eef7c8caac6e64a1d87d513ca2b"},{"filename":"L4.png","caption":"Penrose diagram of the space-time $\\mathcal{M}=\\mathcal{R} \\cup \\mathcal{N} \\cup \\mathcal{EB} \\cup \\mathcal{LB} $ with the inclusion of $\\gamma'$ .","source":"arxiv","key":"136b56e2ed7d88ab67327c9c322593b7","url":"https://inspirehep.net/files/136b56e2ed7d88ab67327c9c322593b7"}],"legacy_version":"20210316100113.0","inspire_categories":[{"term":"Gravitation and Cosmology"},{"term":"Math and Math Physics"}],"first_author":{"full_name":"Van de Moortel, Maxime","last_name":"Van de Moortel","first_name":"Maxime","recid":1926183},"control_number":1592377,"dois":[{"value":"10.1007/s00220-017-3079-3"}],"document_type":["article"],"texkeys":["VandeMoortel:2017ztd"],"abstracts":[{"source":"arXiv","value":"We show non-linear stability and instability results in spherical symmetry for the interior of a charged black hole -approaching a sub-extremal Reissner-Nordstr\\\"om background fast enough at infinity- in presence of a massive and charged scalar field, motivated by the strong cosmic censorship conjecture in that setting : 1. Stability : We prove that spherically symmetric characteristic initial data to the Einstein-Maxwell- Klein-Gordon equations approaching a Reissner-Nordstr\\\"om background with a sufficiently decaying polynomial decay rate on the event horizon gives rise to a space-time possessing a Cauchy horizon in a neighbourhood of time-like infinity. Moreover if the decay is even stronger, we prove that the spacetime metric admits a continuous extension to the Cauchy horizon. This generalizes the celebrated stability result of Dafermos for Einstein-Maxwell-real-scalar-field in spherical symmetry. 2. Instability : We prove that for the class of space-times considered in the stability part, whose scalar field in addition obeys a polynomial averaged-L^2 (consistent) lower bound on the event horizon, the scalar field obeys an integrated lower bound transversally to the Cauchy horizon. As a consequence we prove that the non-degenerate energy is infinite on any null surface crossing the Cauchy horizon and the curvature of a geodesic vector field blows up at the Cauchy horizon near time-like infinity. This generalizes an instability result due to Luk and Oh for Einstein-Maxwell-real-scalar-field in spherical symmetry. This instability of the black hole interior can also be viewed as a step towards the resolution of the C^2 strong cosmic censorship conjecture for one-ended asymptotically initial data.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"source":"arXiv","title":"Stability and instability of the sub-extremal Reissner-Nordström black hole interior for the Einstein-Maxwell-Klein-Gordon equations in spherical symmetry"}],"curated":false},"links":{"bibtex":"https://inspirehep.net/api/literature/1592377?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1592377?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1592377?format=latex-us","json":"https://inspirehep.net/api/literature/1592377?format=json","json-expanded":"https://inspirehep.net/api/literature/1592377?format=json-expanded","cv":"https://inspirehep.net/api/literature/1592377?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1592377"},"updated":"2023-03-07T04:27:58.840970+00:00","created":"2017-04-20T00:00:00+00:00"},{"id":"2821201","metadata":{"publication_info":[{"journal_volume":"857","pubinfo_freetext":"Phys. Lett. B 857 (2024) 138986","artid":"138986","material":"publication","year":2024,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1613966"},"journal_title":"Phys.Lett.B"}],"citation_count":13,"authors":[{"raw_affiliations":[{"source":"Elsevier B.V.","value":"Department of Physics, K. N. Toosi University of Technology, P. O. Box 15875-4416, Tehran, Iran"}],"full_name_unicode_normalized":"khodadi, mohsen","last_name":"Khodadi","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/1240992"},"value":"K.N. Toosi U."}],"uuid":"586c2c1e-4628-45cf-af8d-1d67276cc08b","affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/0433abe34"}],"full_name":"Khodadi, Mohsen","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/1259027"},"ids":[{"schema":"ORCID","value":"0000-0001-7949-0441"},{"schema":"INSPIRE BAI","value":"Mohsen.Khodadi.1"}],"first_name":"Mohsen","recid":1259027},{"raw_affiliations":[{"source":"Elsevier B.V.","value":"Department of Physics, K. N. Toosi University of Technology, P. O. Box 15875-4416, Tehran, Iran"},{"source":"Elsevier B.V.","value":"PDAT Laboratory, Department of Physics, K. N. Toosi University of Technology, P. O. Box 15875-4416, Tehran, Iran"},{"source":"Elsevier B.V.","value":"School of Physics, Institute for Research in Fundamental Sciences (IPM), P.O. Box 19395-5531, Tehran, Iran"}],"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/0433abe34"},{"schema":"ROR","value":"https://ror.org/04xreqs31"}],"full_name_unicode_normalized"