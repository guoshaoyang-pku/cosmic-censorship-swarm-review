tron.Astrophys."}}},{"reference":{"publication_info":{"journal_volume":"152","artid":"58","page_start":"58","journal_title":"Astron.Astrophys."}}},{"reference":{"publication_info":{"journal_volume":"103","artid":"1652","page_start":"1652","journal_title":"Astron.J."}}},{"reference":{"arxiv_eprint":"astro-ph/0209531","publication_info":{"journal_volume":"394","artid":"617","page_start":"617","journal_title":"Astron.Astrophys."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/596533"}}],"number_of_pages":8,"legacy_creation_date":"2012-03-06","preprint_date":"2012-03","author_count":8,"public_notes":[{"source":"arXiv","value":"8 pages, 7 figures published in A&A"}],"earliest_date":"2012-03","refereed":true,"external_system_identifiers":[{"schema":"ADS","value":"2012A&A...539A..56J"},{"schema":"SPIRES","value":"SPIRES-9410643"}],"facet_author_name":["1883533_C.U. Keller","1997646_Ana L. Chies-Santos","2073165_H. Cánovas","2164664_L.B.F.M. Waters","2311821_M. Min","2229368_M. Rodenhuis","1030637_Sandra V. Jeffers","2554644_M.de Juan Ovelar"],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1093023","updated":"2023-03-06T19:47:12.594200"},"journal_title_variants":["Astron. Astrophys.","Astron.Astrophys."],"arxiv_eprints":[{"categories":["astro-ph.SR"],"value":"1203.1265"}],"referenced_authors_bais":["G.Weigelt.5","B.Babler.2","Y.S.Efimov.3","B.A.Whitney.4","N.R.Ikhsanov.2","M.Min.8","R.J.Ivison.1","B.E.K.Sugerman.1","B.Sibthorpe.7","K.D.Gordon.1","S.A.Stanford.7","I.C.Leao.1","T.Bloecker.1","Y.Balega.1","H.L.Gomez.3","G.Olofsson.2","H.E.Bond.4","C.Dominik.8","K.H.Hofmann.2","J.S.Mathis.2","B.F.Yudin.1","P.C.Hargrave.2","T.R.Geballe.3","J.R.De.Medeiros.1","R.Wesson.5","A.de.Koter.12","V.I.Shenavrin.1","J.W.Hovenier.2","N.R.Ikhsanov.4","J.Honor.1","J.D.Fernie.1","O.De.Marco.1","K.H.Nordsieck.1","W.Lawson.1","Luciana.Bianchi.1","J.Andrews.1","A.de.Koter.10","E.T.Polehampton.4","G.Weigelt.10","G.C.Clayton.5","M.Matsuura.2","S.J.Leeks.1","M.J.Barlow.1","W.Rumpl.1","T.L.Lim.2","D.Mekarnia.2","M.Min.7","P.de.Laverny.2","C.P.Dullemond.1","O.Chesneau.8","B.M.Swinyard.1","K.Ohnaka.1"],"legacy_version":"20160419163225.0","inspire_categories":[{"term":"Astrophysics"}],"first_author":{"full_name":"Jeffers, S.V.","last_name":"Jeffers","first_name":"S.V.","recid":1030637},"control_number":1093023,"dois":[{"value":"10.1051/0004-6361/201117138"}],"document_type":["article"],"texkeys":["Jeffers:2012uz"],"abstracts":[{"source":"arXiv","value":"We present recent polarimetric images of the highly variable star R CrB using ExPo and archival WFPC2 images from the HST. We observed R CrB during its current dramatic minimum where it decreased more than 9 mag due to the formation of an obscuring dust cloud. Since the dust cloud is only in the line-of-sight, it mimics a coronograph allowing the imaging of the star's circumstellar environment. Our polarimetric observations surprisingly show another scattering dust cloud at approximately 1.3' or 2000 AU from the star. We find that to obtain a decrease in the stellar light of 9 mag and with 30% of the light being reemitted at infrared wavelengths (from R CrB's SED) the grains in R CrB's circumstellar environment must have a very low albedo of approximately 0.07%. We show that the properties of the dust clouds formed around R CrB are best fitted using a combination of two distinct populations of grains size. The first are the extremely small 5 nm grains, formed in the low density continuous wind, and the second population of large grains (~0.14 {\\mu}m) which are found in the ejected dust clouds. The observed scattering cloud, not only contains such large grains, but is exceptionally massive compared to the average cloud.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["astro-ph.SR"],"titles":[{"title":"Direct imaging of a massive dust cloud around R Coronae Borealis"},{"source":"arXiv","title":"Direct imaging of a massive dust cloud around R Coronae Borealis"}],"curated":false}},{"created":"2012-05-08T00:00:00+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/1113882?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1113882?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1113882?format=latex-us","json":"https://inspirehep.net/api/literature/1113882?format=json","json-expanded":"https://inspirehep.net/api/literature/1113882?format=json-expanded","cv":"https://inspirehep.net/api/literature/1113882?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1113882"},"updated":"2023-03-06T16:11:03.064053+00:00","id":"1113882","metadata":{"authors":[{"full_name_unicode_normalized":"pantellini, f","full_name":"Pantellini, F","record":{"$ref":"https://inspirehep.net/api/authors/2337278"},"last_name":"Pantellini","ids":[{"schema":"INSPIRE BAI","value":"F.Pantellini.1"}],"signature_block":"PANTALANf","first_name":"F","uuid":"9257ab45-ba93-4ad3-92e7-9486d1cfa393","recid":2337278},{"full_name_unicode_normalized":"landi, simone","full_name":"Landi, Simone","record":{"$ref":"https://inspirehep.net/api/authors/2337284"},"last_name":"Landi","ids":[{"schema":"INSPIRE BAI","value":"S.Landi.1"}],"signature_block":"LANDs","first_name":"Simone","uuid":"984a6af7-3ec6-49ac-9301-f96abc6f1c66","recid":2337284},{"full_name_unicode_normalized":"zaslavsky, arnaud","full_name":"Zaslavsky, Arnaud","record":{"$ref":"https://inspirehep.net/api/authors/2337292"},"last_name":"Zaslavsky","ids":[{"schema":"INSPIRE BAI","value":"A.Zaslavsky.2"}],"signature_block":"ZASLAVSCYa","first_name":"Arnaud","uuid":"881f162c-0a39-4e1e-9d1e-ea491132703d","recid":2337292},{"full_name_unicode_normalized":"meyer-vernet, nicole","full_name":"Meyer-Vernet, Nicole","record":{"$ref":"https://inspirehep.net/api/authors/2337299"},"last_name":"Meyer-Vernet","ids":[{"schema":"INSPIRE BAI","value":"N.MeyerVernet.3"}],"signature_block":"VARNATn","first_name":"Nicole","uuid":"613774fc-fb98-41d6-a31d