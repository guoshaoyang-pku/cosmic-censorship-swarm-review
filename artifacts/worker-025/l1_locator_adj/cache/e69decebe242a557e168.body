rtid":"810","page_start":"810","journal_title":"Mon.Not.Roy.Astron.Soc."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/663409"}},{"reference":{"publication_info":{"journal_volume":"239","artid":"L133","page_start":"L133","journal_title":"Astrophys.J."}}},{"reference":{"publication_info":{"journal_volume":"398","artid":"551","page_start":"551","journal_title":"Astron.Astrophys."}}},{"reference":{"publication_info":{"journal_volume":"295","artid":"755","page_start":"755","journal_title":"Astron.Astrophys."}}},{"reference":{"publication_info":{"journal_volume":"536","artid":"831","page_start":"831","journal_title":"Astrophys.J."}}},{"reference":{"publication_info":{"journal_volume":"268","artid":"276","page_start":"276","journal_title":"Mon.Not.Roy.Astron.Soc."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/391152"}}],"number_of_pages":12,"legacy_creation_date":"2005-11-28","preprint_date":"2005-11","author_count":5,"earliest_date":"2005-11","refereed":true,"external_system_identifiers":[{"schema":"ADS","value":"2006A&A...451..961R"},{"schema":"SPIRES","value":"SPIRES-6439624"}],"facet_author_name":["2240349_D. Lemke","1027207_Mika Juvela","1033572_Kimmo Lehtinen","2452876_T. Liljestrom","2579871_Marianna Ridderstad"],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:698867","updated":"2023-03-06T19:22:55.870944"},"journal_title_variants":["Astron.Astrophys.","Astron. Astrophys."],"arxiv_eprints":[{"categories":["astro-ph"],"value":"astro-ph/0511757"}],"referenced_authors_bais":["T.L.Huard.1","J.R.Riedinger.1","R.E.Hills.1","F.X.Desert.4","G.Serra.1","L.Cambresy.3","Joao.F.Alves.1","Thomas.H.Jarrett.1","D.Lemke.4","J.Richer.1","Marco.Lombardi.1","J.Clavel.6","C.A.Beichman.7","J.M.Lamarre.1","L.J.Crews.1","B.Mookerjea.1","J.Faelker.1","J.A.Steinz.1","A.Abergel.2","I.Robson.1","X.Dupac.1","J.F.Drake.3","B.D.Savage.1","L.Cambresy.5","M.Juvela.1","K.Lehtinen.1","C.J.Lada.4","P.Andre.1","M.E.Anderegg.1","N.Boudet.1","Mark.G.Rawlings.1","E.Dwek.1","J.S.Mathis.4","P.Estaria.1","J.P.Torre.1","M.Giard.1","F.Boulanger.1","J.L.Puget.1","P.F.Scott.1","G.Drechsel.1","J.P.Bernard.1","S.Ximenez.de.Ferran.1","I.Ristorcelli.1","B.G.Taylor.1","B.Stepnik.1","C.Meny.1","K.Mattila.3","C.Kramer.2","R.C.Bohlin.1","C.Lada.2","F.Pajot.1","M.F.Kessler.1","G.Lagache.1","D.Ward.Thompson.1"],"legacy_version":"20150710202606.0","inspire_categories":[{"term":"Astrophysics"}],"first_author":{"full_name":"Ridderstad, Marianna","last_name":"Ridderstad","first_name":"Marianna","recid":2579871},"control_number":698867,"dois":[{"source":"ADS","value":"10.1051/0004-6361:20053467"}],"document_type":["article"],"texkeys":["Ridderstad:2005zt"],"abstracts":[{"source":"arXiv","value":"We have analyzed the properties of dust in the high galactic latitude translucent cloud Lynds 1780 using ISOPHOT maps at 100 and 200 micrometers and raster scans at 60, 80, 100, 120, 150 and 200 micrometers. In far-infrared (FIR) emission, the cloud has a single core that coincides with the maxima of visual extinction and 200um optical depth. At the resolution of 3.0 arcmin, the maximum visual extinction is 4.0 mag. At the cloud core, the minimum temperature and the maximum 200um optical depth are 14.9+/-0.4 K and 2.0+/-0.2x10^{-3}, respectively, at the resolution of 1.5 arcmin. The cloud mass is estimated to be 18M_{SUN}. The FIR observations, combined with IRAS observations, suggest the presence of different, spatially distinct dust grain populations in the cloud: the FIR core region is the realm of the 'classical' large grains, whereas the very small grains and the PAHs have separate maxima on the Eastern side of the cold core, towards the 'tail' of this cometary-shaped cloud. The color ratios indicate an overabundance of PAHs and VSGs in L1780. Our FIR observations combined with the optical extinction data indicate an increase of the emissivity of the big grain dust component in the cold core, suggesting grain coagulation or some other change in the properties of the large grains. Based on our observations, we also address the question, to what extent the 80um emission and even the 100um and the 120um emission contain a contribution from the small-grain component.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["astro-ph"],"titles":[{"title":"Properties of dust in the high-latitude translucent cloud l1780. 1. spatially distinct dust populations and increased dust emissivity from iso observations"},{"title":"HIGH LATITUDE"},{"source":"arXiv","title":"Properties of dust in the high-latitude translucent cloud L1780 I: Spatially distinct dust populations and increased dust emissivity from ISO observations"}],"curated":true}},{"created":"2009-05-18T00:00:00+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/820722?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/820722?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/820722?format=latex-us","json":"https://inspirehep.net/api/literature/820722?format=json","json-expanded":"https://inspirehep.net/api/literature/820722?format=json-expanded","cv":"https://inspirehep.net/api/literature/820722?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A820722"},"updated":"2023-03-06T21:41:16.438211+00:00","id":"820722","metadata":{"authors":[{"full_name_unicode_normalized":"bot, c.","full_name":"Bot, C.","record":{"$ref":"https://inspirehep.net/api/authors/2026792"},"ids":[{"schema":"INSPIRE BAI","value":"C.Bot.2"}],"last_name":"Bot","signature_block":"BATc","uuid":"bcf1c5e8-1fb1-46f8-9870-b3fbbb3f70a2","first_name":"C.","recid":2026792},{"full_name_unicode_normalized":"helou, g.","full_name":"Helou, G.","record":{"$ref":"https://inspirehep.net/api/authors/2180525"},"ids":[{"schema":"INSPIRE BAI","value":"G.Helou.8"}],"last_name":"Helou","signature_block":"HALg","uuid":"21b43f2a-bd85-493b-b782-0605b383b0bc","first_name":"G.","recid":21805