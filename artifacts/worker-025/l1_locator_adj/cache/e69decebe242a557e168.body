l_volume":"51","artid":"1664","year":1983,"page_start":"1664","journal_title":"Phys.Rev.Lett."},"misc":["Nonlocal heat transport due to steep temperature gradients"],"authors":[{"full_name":"Luciani, J.F."},{"full_name":"Mora, P."},{"full_name":"Virmont, J."}]}},{"reference":{"label":"37","publication_info":{"journal_volume":"585","artid":"1147","year":2003,"page_start":"1147","journal_title":"Astrophys.J."},"misc":["Electron properties and coulomb collisions in the solar wind at 1 AU: <i>Wind</i> observations"],"authors":[{"full_name":"Salem, C."},{"full_name":"Hubert, D."},{"full_name":"Lacombe, C."},{"full_name":"Bale, S.D."},{"full_name":"Mangeney, A."},{"full_name":"Larson, D.E."},{"full_name":"Lin, R.P."}]}},{"reference":{"label":"38","publication_info":{"journal_volume":"100","artid":"1694","year":1990,"page_start":"1694","journal_title":"Astron.J."},"misc":["Symmetric multistep methods for the numerical integration of planetary orbits"],"authors":[{"full_name":"Quinlan, G.D."},{"full_name":"Tremaine, S."}]}},{"reference":{"label":"39","title":{"title":"Journal of Geophysical Research - Space Physics"},"misc":["Interplanetary dust detection by radio antennas: Mass calibration and fluxes measured by STEREO/WAVES. sumitted to 2011"],"authors":[{"full_name":"Zaslavsky, A."},{"full_name":"Meyer-Vernet, N."},{"full_name":"Mann, I."},{"full_name":"Czechowski, A."},{"full_name":"Issautier, K."},{"full_name":"Le Chat, G."},{"full_name":"Pantellini, F."},{"full_name":"Goetz, K."},{"full_name":"Maksimovic, M."},{"full_name":"Bale, S.D."},{"full_name":"Kasper, J.C."}]}}],"number_of_pages":23,"legacy_creation_date":"2012-05-08","preprint_date":"2012-05","author_count":4,"earliest_date":"2012-05","external_system_identifiers":[{"schema":"HAL","value":"hal-02914009"},{"schema":"ADS","value":"2012PPCF...54d5005P"},{"schema":"SPIRES","value":"SPIRES-9588477"}],"facet_author_name":["2337278_F Pantellini","2337284_Simone Landi","2337292_Arnaud Zaslavsky","2337299_Nicole Meyer-Vernet"],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1113882","updated":"2023-03-06T16:11:03.064053"},"journal_title_variants":["Plasma Phys.Control.Fusion","Plasma Phys. Control. Fusion"],"arxiv_eprints":[{"categories":["physics.plasm-ph"],"value":"1205.1718"}],"referenced_authors_bais":["M.L.Kaiser.1","A.Czechowski.1","N.MeyerVernet.2","I.Mann.2","S.D.Bale.2","O.C.S.Cyr.1","K.C.Goetz.1","Patrick.Mora.1","M.Maksimovic.1","I.Zouganelis.1","J.L.Bougeret.1"],"legacy_version":"20200811233553.0","inspire_categories":[{"term":"Astrophysics"}],"first_author":{"full_name":"Pantellini, F","last_name":"Pantellini","first_name":"F","recid":2337278},"control_number":1113882,"dois":[{"value":"10.1088/0741-3335/54/4/045005"}],"document_type":["article"],"texkeys":["Pantellini:2012ry"],"abstracts":[{"source":"arXiv","value":"Nano and micro meter sized dust particles travelling through the heliosphere at several hundreds of km/s have been repeatedly detected by interplanetary spacecraft. When such fast moving dust particles hit a solid target in space, an expanding plasma cloud is formed through the vaporisation and ionisation of the dust particles itself and part of the target material at and near the impact point. Immediately after the impact the small and dense cloud is dominated by collisions and the expansion can be described by fluid equations. However, once the cloud has reached micro-m dimensions, the plasma may turn collisionless and a kinetic description is required to describe the subsequent expansion. In this paper we explore the late and possibly collisionless spherically symmetric unconstrained expansion of a single ionized ion-electron plasma using N-body simulations. Given the strong uncertainties concerning the early hydrodynamic expansion, we assume that at the time of the transition to the collisionless regime the cloud density and temperature are spatially uniform. We do also neglect the role of the ambient plasma. This is a reasonable assumption as long as the cloud density is substantially higher than the ambient plasma density. In the case of clouds generated by fast interplanetary dust grains hitting a solid target some 10^7 electrons and ions are liberated and the in vacuum approximation is acceptable up to meter order cloud dimensions. ...","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["physics.plasm-ph"],"titles":[{"title":"On the unconstrained expansion of a spherical plasma cloud turning collisionless : case of a cloud generated by a nanometer dust grain impact on an uncharged target in space"},{"source":"arXiv","title":"On the unconstrained expansion of a spherical plasma cloud turning collisionless : case of a cloud generated by a nanometer dust grain impact on an uncharged target in space"}],"curated":false}},{"created":"2005-05-26T00:00:00+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/683409?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/683409?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/683409?format=latex-us","json":"https://inspirehep.net/api/literature/683409?format=json","json-expanded":"https://inspirehep.net/api/literature/683409?format=json-expanded","cv":"https://inspirehep.net/api/literature/683409?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A683409"},"updated":"2023-03-06T19:16:50.113932+00:00","id":"683409","metadata":{"authors":[{"full_name_unicode_normalized":"dirsch, b.","full_name":"Dirsch, B.","record":{"$ref":"https://inspirehep.net/api/authors/2406930"},"ids":[{"schema":"INSPIRE BAI","value":"B.Dirsch.4"}],"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/904435"},"value":"Concepcion U."}],"last_name":"Dirsch","signature_block":"DARSb","first_name":"B.","uuid":"17cd1762-ceb0-4749-a3b3-6ce4b950691e","recid":2406930},{"full_name_unicode_normalized":"richtler, t.","full_name":"Richtler, T.","record":{"$ref":"https://inspirehep.net/api/a