507994"}},{"reference":{"dois":["10.1088/1475-7516/2017/05/050"],"label":"81"},"raw_refs":[{"schema":"text","value":"[81] RA Konoplya, A Zhidenko: The portrait of eikonal instability in Lovelock theories, ['JCAP,1705,050'], DOI: 10.1088/1475-7516/2017/05/050"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1598159"}},{"reference":{"arxiv_eprint":"hep-th/0109122","label":"82"},"raw_refs":[{"schema":"text","value":"[82] Nojiri, S., Odintsov, S.D.: Anti-de Sitter black hole thermodynamics in higher derivative gravity and new confining deconfining phases in dual CFT. Phys. Lett. B521 , 87–95 (2001). [hep-th] [Erratum: Phys. Lett. B542 , 301(2002)]"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/562903"}},{"reference":{"dois":["10.1103/PhysRevD.65.023521"],"label":"83"},"raw_refs":[{"schema":"text","value":"[83] S Nojiri, SD Odintsov, S Ogushi: Cosmological and black hole brane world universes in higher derivative gravity, ['Phys.Rev.,D65,023521'], DOI: 10.1103/PhysRevD.65.023521"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/561904"}},{"reference":{"dois":["10.1140/epjp/i2017-11825-9"],"label":"84"},"raw_refs":[{"schema":"text","value":"[84] A Jansen: Overdamped modes in Schwarzschild–de Sitter and a Mathematica package for the numerical computation of quasinormal modes, ['Eur.Phys.J.Plus,132,546'], DOI: 10.1140/epjp/i2017-11825-9"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1626095"}}],"number_of_pages":18,"legacy_creation_date":"2020-04-06","preprint_date":"2020-04-02","author_count":1,"public_notes":[{"source":"arXiv","value":"19 pages, 3 figures"}],"earliest_date":"2020-04-02","refereed":true,"external_system_identifiers":[{"schema":"MSNET","value":"4172964"}],"facet_author_name":["1687112_Akash K. Mishra"],"core":true,"license":[{"license":"arXiv nonexclusive-distrib 1.0","material":"preprint","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1789568","updated":"2024-10-01T12:52:29.806947"},"journal_title_variants":["Gen.Rel.Grav.","Gen. Rel. Grav."],"arxiv_eprints":[{"categories":["gr-qc","hep-th"],"value":"2004.01243"}],"referenced_authors_bais":["Emanuele.Berti.1","S.G.Ghosh.1","A.Zhidenko.1","Soumitra.Sengupta.1","Nobuyoshi.Ohta.1","Luca.Bombelli.1","P.Wang.53","Da.Ping.Du.1","W.Israel.1","A.F.Zinhailo.1","Yuxiao.Liu.1","Cheng.Yong.Zhang.1","D.Glavan.1","Anjan.Ananda.Sen.1","Minyong.Guo.1","Ru.Keng.Su.1","S.Deser.1","A.Lima.Santos.1","Shao.Wen.Wei.1","S.Nojiri.1","B.Zumino.1","Sumanta.Chakraborty.1","Tsutomu.Kobayashi.1","Hong.Lu.2","M.A.Cuyubamba.1","B.Tekin.1","Hong.Bao.Zhang.1","Z.Stuchlik.1","Roman.A.Konoplya.1","Qingyu.Gan.1","S.Hod.1","Kyriakos.Destounis.1","Fu.Wen.Shu.1","V.T.Zanchin.1","A.K.Mishra.3","T.C.Sisman.1","F.C.Mena.1","Sudipta.Sarkar.1","Amitabh.Virmani.1","D.J.Mulryne.1","A.Lopez.Ortega.1","Peng.Wang.1","S.D.Odintsov.1","S.Vicentini.1","Jie.Jiang.1","H.S.Reall.1","Hai.Tang.Yang.1","Zhen.Zhong.2","E.Calzetta.1","Rong.Gen.Cai.1","Christopher.Pollack.1","Bin.Wang.1","V.Cardoso.1","K.H.C.CastelloBranco.2","Yuyu.Mo.1","D.G.Boulware.1","Shreyas.Punacha.1","Neil.J.Cornish.1","E.Papantonopoulos.1","Xiaoyi.Liu.1","E.Poisson.1","P.Hintz.1","J.E.Santos.1","Demetrios.Christodoulou.1","S.Mitra.8","Chun.Shan.Lin.1","T.Clifton.1","F.Eperon.1","Bo.Xuan.Ge.1","Rahul.Kumar.Walia.1","Yu.Tian.1","D.Lovelock.1","E.Abdalla.1","R.B.Mann.1","T.Padmanabhan.1","J.Natario.1","K.Yang.1","Zi.Yu.Tang.1","P.G.S.Fernandes.1","David.Kubiznak.1","S.Van.Vooren.1","A.S.Miranda.1","Y.Gim.2","Peng.Cheng.Li.1","S.D.Maharaj.1","A.K.M.3","Xiao.Mei.Kuang.1","M.Gurses.1","Wen.Yuan.Ai.1","J.Lopes.Costa.1","Houwen.Wu.1","B.Gwak.1","Guangzhou.Guo.1","A.O.Starinets.1","B.Mashhoon.1","M.Rahman.6","Hang.Liu.1","Yu.Peng.Zhang.1","Janna.J.Levin.1","S.A.Hosseini.Mansoori.1","M.Rinaldi.1","A.Ori.2","Bin.Wang.2","O.J.C.Dias.1","Robie.A.Hennigar.1","S.Bhattacharjee.1","Li.Ming.Cao.1","A.Colleaux.1","V.Ferrari.1","A.Jansen.2","B.Zwiebach.1","R.Dal.Bosco.Fontana.1","M.S.Churilova.1","Pedro.Carrilho.1","A.Casalino.1","Zi.Chao.Lin.1","C.L.Ahmed.Rizwan.1","N.Kumara.A.1","Helvi.Witek.1","S.Ogushi.1","Hong.Guo.1","Yong.Qiang.Wang.1","R.Schiappa.1","M.S.Ali.2","Yi.Pang.1","K.Hegde.1","C.M.Mendes.1","D.Kothawala.1"],"figures":[{"filename":"p11p12.png","caption":": scale=0.34","source":"arxiv","key":"e4baeb86fb6b639c92b21e5ce1f1a52c","url":"https://inspirehep.net/files/e4baeb86fb6b639c92b21e5ce1f1a52c"},{"filename":"p21p22.png","caption":": scale=0.34 : This figure demonstrates the time domain evolution of of a scalar field on the background of a 4d Gauss Bonnet charged black hole in de Sitter space, confirming an exponentially decaying tail at late times for $\\ell=0$ mode. The parameters for these plots chosen are $M=1$ and $(Q/Q_{\\rm max})=0.1$. Straight line on a Log plot represents an exponential behaviour.","source":"arxiv","key":"81be4e38f289f9f2676b7dba36a34301","url":"https://inspirehep.net/files/81be4e38f289f9f2676b7dba36a34301"},{"filename":"l001a01.png","caption":": scale=0.37","source":"arxiv","key":"ccca71f71257ca975fe3ed0397060841","url":"https://inspirehep.net/files/ccca71f71257ca975fe3ed0397060841"},{"filename":"l001a02.png","caption":": scale=0.37 : scale=0.39","source":"arxiv","key":"a3fe8ec388692d9b98b01f9c4880da70","url":"https://inspirehep.net/files/a3fe8ec388692d9b98b01f9c4880da70"},{"filename":"l001a03.png","caption":": scale=0.37","source":"arxiv","key":"ecf3ada59eda57e9e1ed8303563c2eaf","url":"https://inspirehep.net/files/ecf3ada59eda57e9e1ed8303563c2eaf"},{"filename":"l005a01.png","caption":": scale=0.39 : scale=0.37","source":"arxiv","key":"6b075d2779771b3c77d1e3bd9a498f6f","url":"https://inspirehep.net/files/6b075d2779771b3c77d1e3bd9a498f6f"},{"filename":"l005a02.png","caption":": scale=0.37 : scale=0.39","source":"arxiv","key":"cc20f0c661beeb566dac5eb2e1e97624","url":"https://inspirehep.net/files/cc20f0c661beeb566dac5eb2e1e97624"},{"filename":"l005a03.png","caption":": This figure demonstrates the variation of $\\beta$ with the ratio $(Q/Q_{\\rm m})$ for all three family of modes, namely the \\PS modes(blue), the \\DS modes(green) and the \\NE modes(red) for various choice of cosmological constant($\\Lambda$) and the Gauss-Bonnet coupling constant($\\alpha$). The first vertical line in these plots corresponds to the value of $Q/Q_{\\rm m}$ for which the \\scc\\ is violated for the first time. In contrast, the second vertical line represents the value of $Q/Q_{\\rm m}$, where the near extremal mode becomes dominant. Mass of the black hole is taken to be unity. : Caption not extracted","source":"arxiv","key":"cbd115a75ae6548380bab0490abdaf48","url":"https://inspirehep.net/files/cbd115a75ae6548380bab0490abdaf48"},{"filename":"l01a01.png","caption":": Caption not extracted","source":"arxiv","key":"e105cafe753b524e77c66e23b2706c4b","url":"https://inspirehep.net/files/e105cafe753b524e77c66e23b2706c4b"},{"filename":"l01a02.png","caption":": Caption not extracted","source":"arxiv","key":"659b07168dc0bce9214ca39e238783db","url":"https://inspirehep.net/files/659b07168dc0bce9214ca39e238783db"},{"filename":"l01a03.png","caption":": Caption not extracted","source":"arxiv","key":"100d2ac1a11d0a98138980d5b6353a9e","url":"https://inspirehep.net/files/100d2ac1a11d0a98138980d5b6353a9e"},{"filename":"eml001a01.png","caption":": scale=0.37","source":"arxiv","key":"8e2b10f3aefcd491ba164b0620791ea4","url":"https://inspirehep.net/files/8e2b10f3aefcd491ba164b0620791ea4"},{"filename":"eml001a02.png","caption":": scale=0.37 : scale=0.39","source":"arxiv","key":"7a7066b191da0b204f1bc265f634e88a","url":"https://inspirehep.net/files/7a7066b191da0b204f1bc265f634e88a"},{"filename":"eml001a03.png","caption":": scale=0.37","source":"arxiv","key":"41ac1799ef5f9672c7f05fa83253671b","url":"https://inspirehep.net/files/41ac1799ef5f9672c7f05fa83253671b"},{"filename":"eml005a01.png","caption":": scale=0.39 : scale=0.37","source":"arxiv","key":"ed91e7a182ba8501dd2f4be6e8e24730","url":"https://inspirehep.net/files/ed91e7a182ba8501dd2f4be6e8e24730"},{"filename":"eml005a02.png","caption":": scale=0.37 : scale=0.39","source":"arxiv","key":"45a22774ed0c039a1e99107149be1bf1","url":"https://inspirehep.net/files/45a22774ed0c039a1e99107149be1bf1"},{"filename":"eml005a03.png","caption":": The parameter $\\beta$ is presented corresponding to electromagnetic perturbation for the \\DS modes(green) and the \\PS modes(blue) for various choice of cosmological constant($\\Lambda$) and the Gauss-Bonnet coupling constant($\\alpha$). The vertical lines in these plots correspond to the value of $Q/Q_{\\rm m}$ for which the \\scc\\ is violated for the first time, The Mass parameter of the black hole is taken to be unity. : Caption not extracted","source":"arxiv","key":"66671ce14194801f43bb9c2722cc4f4d","url":"https://inspirehep.net/files/66671ce14194801f43bb9c2722cc4f4d"},{"filename":"eml01a01.png","caption":": Caption not extracted","source":"arxiv","key":"b9b3c8791b7e51eb98af18c12e9a799d","url":"https://inspirehep.net/files/b9b3c8791b7e51eb98af18c12e9a799d"},{"filename":"eml01a02.png","caption":": Caption not extracted","source":"arxiv","key":"df7bc2cdb844e7da2cf7960dfbe56c87","url":"https://inspirehep.net/files/df7bc2cdb844e7da2cf7960dfbe56c87"},{"filename":"eml01a03.png","caption":": Caption not extracted","source":"arxiv","key":"2de4e38ed683a922323f424bc19e5dbe","url":"https://inspirehep.net/files/2de4e38ed683a922323f424bc19e5dbe"}],"legacy_version":"20201204111146.0","inspire_categories":[{"term":"Gravitation and Cosmology","source":"arxiv"},{"term":"Theory-HEP","source":"arxiv"},{"term":"Gravitation and Cosmology"},{"term":"Theory-HEP"}],"first_author":{"emails":["akash.mishra@iitgn.ac.in"],"affiliations_identifiers":[{"schema":"GRID","value":"grid.462384.f"},{"schema":"ROR","value":"https://ror.org/0036p5w23"}],"full_name":"Mishra, Akash K.","ids":[{"schema":"ORCID","value":"0000-0001-6416-0298"},{"schema":"INSPIRE BAI","value":"A.K.Mishra.3"}],"last_name":"Mishra","first_name":"Akash K.","recid":1687112},"control_number":1789568,"dois":[{"material":"publication","source":"arXiv","value":"10.1007/s10714-020-02763-2"},{"source":"bibmatch","value":"10.1007/s10714-020-02763-2"}],"document_type":["article"],"texkeys":["Mishra:2020gce"],"abstracts":[{"source":"Springer","value":"The fate of strong cosmic censorship is ultimately linked to the extendibility of perturbation across the Cauchy Horizon and known to be violated in the near extremal region of a charged de Sitter black hole. Similar violations can also be realized in higher curvature theories, with the strength of violation becoming stronger as compared to general relativity. In this work, we extend this analysis further to study the validity of strong cosmic censorship conjecture in the context of the regularised four-dimensional Einstein Gauss–Bonnet theory with respect to both scalar and electromagnetic perturbation. We also study the late time tails of scalar fields.","abstract_source_suggest":{"input":"Springer"}},{"source":"arXiv","value":"The fate of strong cosmic censorship is ultimately linked to the extendibility of perturbation across the Cauchy Horizon and known to be violated in the near extremal region of a charged de Sitter black hole. Similar violations can also be realized in higher curvature theories, with the strength of violation becoming stronger as compared to general relativity. In this work, we extend this analysis further to study the validity of strong cosmic censorship conjecture in the context of the regularised four-dimensional Einstein Gauss-Bonnet theory with respect to both scalar and electromagnetic perturbation. We also study the late time tails of scalar fields.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"source":"Springer","title":"Quasinormal modes and strong cosmic censorship in the regularised 4D Einstein–Gauss–Bonnet gravity"},{"source":"arXiv","title":"Quasinormal modes and Strong Cosmic Censorship in the regularised 4D Einstein-Gauss-Bonnet gravity"},{"source":"arXiv","title":"Quasinormal modes and Strong Cosmic Censorship in the novel 4D Einstein-Gauss-Bonnet gravity"}],"imprints":[{"date":"2020-11-06"}],"curated":true},"id":"1789568"},{"created":"2022-10-11T05:28:55.279498+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/2163291?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/2163291?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/2163291?format=latex-us","json":"https://inspirehep.net/api/literature/2163291?format=json","json-expanded":"https://inspirehep.net/api/literature/2163291?format=json-expanded","cv":"https://inspirehep.net/api/literature/2163291?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2163291"},"updated":"2024-10-01T15:42:15.508192+00:00","metadata":{"publication_info":[{"journal_volume":"11","artid":"028","year":2022,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1212538"},"page_start":"028","journal_title":"JCAP"},{"journal_volume":"11","pubinfo_freetext":"JCAP 11 (2022) 028","artid":"028","material":"publication","year":2022,"page_start":"028","journal_title":"JCAP"}],"citation_count_without_self_citations":30,"authors":[{"raw_affiliations":[{"value":"Research Centre for Theoretical Physics and Astrophysics, Institute of Physics, Silesian University in Opava, Bezručovo náměstí 13, CZ-74601 Opava, Czech Republic"}],"full_name_unicode_normalized":"konoplya, r.a.","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/907680"},"value":"Silesian U., Czech Republic"}],"last_name":"Konoplya","uuid":"06c11a2b-4769-412f-be7d-2c878ad83388","full_name":"Konoplya, R.A.","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/1002228"},"ids":[{"schema":"INSPIRE BAI","value":"Roman.A.Konop