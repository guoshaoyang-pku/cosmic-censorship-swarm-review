http://arxiv.org/licenses/nonexclusive-distrib/1.0/"},{"imposing":"Elsevier","url":"http://creativecommons.org/licenses/by/4.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1662679","updated":"2023-03-07T04:09:12.287680"},"journal_title_variants":["Phys.Lett.B","Phys. Lett. B"],"arxiv_eprints":[{"categories":["gr-qc","astro-ph.HE","hep-th"],"value":"1803.05443"}],"referenced_authors_bais":["Emanuele.Berti.1","A.Zhidenko.1","A.Pesci.1","I.G.Moss.1","J.Natario.1","Nami.Uchikata.1","P.Slany.2","H.S.Reall.1","C.M.Chambers.1","A.Ori.2","T.Futamase.1","Jacob.D.Bekenstein.1","Hiroshi.Umetsu.1","W.Israel.1","S.J.Oh.1","S.A.Teukolsky.1","A.S.Miranda.1","E.Takasugi.1","O.J.C.Dias.1","V.Cardoso.1","R.C.Myers.1","W.H.Press.1","A.V.Gruzinov.1","P.M.Girao.1","Hisao.Suzuki.1","A.Jansen.2","Z.Stuchlik.1","M.Dafermos.1","Stephen.W.Hawking.1","B.Carter.1","T.Piran.1","Roman.A.Konoplya.1","M.Godazgar.1","E.Poisson.1","S.Hod.1","P.Hintz.1","J.E.Santos.1","Helvi.Witek.1","Shijun.Yoshida.1","Kyriakos.Destounis.1","James.M.Bardeen.1","V.T.Zanchin.1","J.D.Smith.2","J.Lopes.Costa.1","P.R.Brady.1","J.Luk.1","A.O.Starinets.1","B.Mashhoon.1","M.L.Gnedin.1","F.Eperon.1","H.P.Nollert.1","Nickolay.Y.Gnedin.1","R.Penrose.1","J.D.Silva.1"],"legacy_version":"20201123211914.0","inspire_categories":[{"term":"Gravitation and Cosmology","source":"arxiv"},{"term":"Astrophysics","source":"arxiv"},{"term":"Theory-HEP","source":"arxiv"},{"term":"Gravitation and Cosmology"},{"term":"Astrophysics"},{"term":"Theory-HEP"}],"first_author":{"emails":["shaharhod@gmail.com"],"full_name":"Hod, Shahar","last_name":"Hod","first_name":"Shahar","recid":1005841},"control_number":1662679,"dois":[{"source":"bibmatch","value":"10.1016/j.physletb.2018.03.020"},{"value":"10.1016/j.physletb.2018.03.020"}],"document_type":["article"],"texkeys":["Hod:2018lmi"],"abstracts":[{"source":"Elsevier","value":"The quasinormal resonant modes of massless neutral fields in near-extremal Kerr–Newman–de Sitter black-hole spacetimes are calculated in the eikonal regime. It is explicitly proved that, in the angular momentum regime a¯>1−2Λ¯4+Λ¯/3 , the black-hole spacetimes are characterized by slowly decaying resonant modes which are described by the compact formula ℑω(n)=κ+⋅(n+12) [here the physical parameters {a¯,κ+,Λ¯,n} are respectively the dimensionless angular momentum of the black hole, its characteristic surface gravity, the dimensionless cosmological constant of the spacetime, and the integer resonance parameter]. Our results support the validity of the Penrose strong cosmic censorship conjecture in these black-hole spacetimes.","abstract_source_suggest":{"input":"Elsevier"}},{"source":"arXiv","value":"The quasinormal resonant modes of massless neutral fields in near-extremal Kerr-Newman-de Sitter black-hole spacetimes are calculated in the eikonal regime. It is explicitly proved that, in the angular momentum regime ${\\bar a}> \\sqrt{{{1-2{\\bar\\Lambda}}\\over{4+{\\bar\\Lambda}/3}}}$, the black-hole spacetimes are characterized by slowly decaying resonant modes which are described by the compact formula $\\Im\\omega(n)=\\kappa_+\\cdot(n+{1\\over2})$ [here the physical parameters $\\{{\\bar a},\\kappa_+,{\\bar\\Lambda},n\\}$ are respectively the dimensionless angular momentum of the black hole, its characteristic surface gravity, the dimensionless cosmological constant of the spacetime, and the integer resonance parameter]. Our results support the validity of the Penrose strong cosmic censorship conjecture in these black-hole spacetimes.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"source":"Elsevier","title":"Quasinormal modes and strong cosmic censorship in near-extremal Kerr–Newman–de Sitter black-hole spacetimes"},{"source":"arXiv","title":"Quasinormal modes and strong cosmic censorship in near-extremal Kerr-Newman-de Sitter black-hole spacetimes"}],"imprints":[{"date":"2018-05-10"}],"curated":true},"id":"1662679"},{"created":"202