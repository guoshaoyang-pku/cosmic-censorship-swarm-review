":"70","artid":"13","year":1993,"page_start":"13","journal_title":"Phys.Rev.Lett."},"authors":[{"full_name":"Balbinot, R."},{"full_name":"Poisson, E."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/355369"}}],"number_of_pages":11,"legacy_creation_date":"2020-05-21","preprint_date":"2020-05-19","author_count":3,"public_notes":[{"source":"arXiv","value":"Minor change in the title. Matches with the version published in\n  Physical Review D"}],"earliest_date":"2020-05-19","refereed":true,"external_system_identifiers":[{"schema":"MSNET","value":"4146594"}],"facet_author_name":["1792346_Shailesh Kumar","1797180_Subhodeep Sarkar","1065349_Srijit Bhattacharjee"],"core":true,"license":[{"license":"arXiv nonexclusive-distrib 1.0","material":"preprint","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1797104","updated":"2023-10-03T08:34:48.397927"},"journal_title_variants":["Phys. Rev. D","Phys.Rev.D"],"arxiv_eprints":[{"categories":["gr-qc","hep-th"],"value":"2005.09705"}],"referenced_authors_bais":["F.Eperon.1","R.M.Wald.1","Pushkal.Shrivastava.1","Suvrat.Raju.1","L.M.Burko.1","Emanuele.Berti.1","A.Zhidenko.1","R.B.Mann.1","I.G.Moss.1","J.Natario.1","Alex.Pandya.1","K.Papadodimas.1","C.Bunster.1","S.Hollands.1","C.M.Chambers.1","W.Israel.1","H.Ooguri.1","M.Zilhao.1","R.Balbinot.1","V.Husain.1","R.C.Myers.1","P.Kraus.1","D.Birmingham.1","K.C.K.Chan.1","F.Pretorius.1","J.S.F.Chan.1","T.Piran.1","S.Carlip.1","Roman.A.Konoplya.1","Hong.Liu.1","R.Emparan.1","S.Hod.1","Vijay.Balasubramanian.1","Kyriakos.Destounis.1","J.Lopes.Costa.1","C.Barrabes.1","P.R.Brady.1","L.B.Szabados.4","J.Zanelli.1","Sudipta.Sarkar.1","A.O.Starinets.1","I.Rodnianski.1","Marija.Tomasevic.1","Amitabh.Virmani.1","R.Penrose.1","V.E.Hubeny.1","R.H.Price.1","S.H.Shenker.1","J.Zahn.1","Raimon.Luna.1","K.M.Simpson.1","H.S.Reall.1","S.F.Ross.1","G.Festuccia.1","A.Ori.2","C.Kehle.1","G.Sarosi.1","G.T.Horowitz.1","G.Holzegel.1","O.J.C.Dias.1","V.Cardoso.1","S.Bhattacharjee.1","M.Henneaux.1","A.Jansen.2","M.Dafermos.1","E.Poisson.1","P.Hintz.1","J.E.Santos.1","M.Banados.1","J.D.Smith.2","J.Smulevici.2","A.Kar.1","Demetrios.Christodoulou.1","J.Luk.1","T.S.Levi.1"],"figures":[{"filename":"btzmf4v2.png","caption":"A schematic diagram of the Ori model for a rotating BTZ black hole: The thick red line corresponds to the null ring $R$ mimicking the outgoing radiation and the red rectangular strip is denoting the influx.  The dashed blue lines denote the inner apparent horizon. The future event horizon ($\\mathcal{H}^+_R$), the right and left future Cauchy horizons ($\\mathcal{CH}^+_R$ and $\\mathcal{CH}^+_L$, respectively) have been also indicated in the diagram. $U, V$ are regular double null coordinates to be introduced later.","source":"arxiv","key":"9e6f9c9989a6191c41da6acbcec301e4","url":"https://inspirehep.net/files/9e6f9c9989a6191c41da6acbcec301e4"}],"legacy_version":"20200831202423.0","inspire_categories":[{"term":"Gravitation and Cosmology","source":"arxiv"},{"term":"Theory-HEP","source":"arxiv"},{"term":"Gravitation and Cosmology"},{"term":"Theory-HEP"}],"first_author":{"emails":["srijuster@gmail.com"],"full_name":"Bhattacharjee, Srijit","ids":[{"schema":"ORCID","value":"0000-0003-1145-2267"}],"last_name":"Bhattacharjee","first_name":"Srijit","recid":1065349},"control_number":1797104,"dois":[{"source":"bibmatch","value":"10.1103/PhysRevD.102.044030"},{"material":"publication","source":"arXiv","value":"10.1103/PhysRevD.102.044030"}],"document_type":["article"],"texkeys":["Bhattacharjee:2020gbo"],"abstracts":[{"source":"APS","value":"We study the phenomena of mass inflation using the Ori model for a rotating Bañados-Teitelboim-Zanelli (BTZ) black hole that is sufficiently far from extremality, and show that the right Cauchy horizon (CHR+) of the BTZ black hole becomes singular. Motivated by the recent analysis of Dias, Reall, Santos [J. High Energy Phys. 12 (2019) 097JHEPFG1029-847910.1007/JHEP12(2019)097], we choose the retrograde quasinormal modes to govern the decay of perturbations exterior to the black hole. The resulting model captures the violation of the strong cosmic censorship conjecture near extremality. On the other hand, far from extremality, the CHR+ of a BTZ black hole develops a weak null singularity. Our analysis shows a slowly rotating BTZ black hole will respect strong cosmic censorship.","abstract_source_suggest":{"input":"APS"}},{"source":"arXiv","value":"We study the phenomena of mass inflation using the Ori model for a rotating BTZ black hole that is sufficiently far from extremality, and show that the right Cauchy horizon ($\\mathcal{CH}^+_R$) of the BTZ black hole becomes singular. Motivated by the recent analysis of Dias, Reall, Santos [J. High Energy Phys. 12 (2019) 097], we choose the retrograde quasinormal modes to govern the decay of perturbations exterior to the black hole. The resulting model captures the violation of the strong cosmic censorship conjecture near extremality. On the other hand, far from extremality, the $\\mathcal{CH}^+_R$ of a BTZ black hole develops a weak null singularity. Our analysis shows a slowly rotating BTZ black hole will respect strong cosmic censorship.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"source":"APS","title":"Mass inflation and strong cosmic censorship in a nonextreme BTZ black hole"},{"source":"arXiv","title":"Mass Inflation in a Non-Extreme Rotating BTZ Black Hole"},{"source":"arXiv","title":"Mass inflation and strong cosmic censorship in a non-extreme BTZ black hole"}],"imprints":[{"date":"2020-08-17"}],"curated":true},"id":"1797104"},{"created":"2019-11-27T00:00:00+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/1767147?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1767147?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1767147?format=latex-us","json":"http