[{"inspire_role":"author","full_name":"Wetterich, C."}]},"raw_refs":[{"schema":"JATS","source":"APS","value":"<ref id=\"c44\"><label>[44]</label><mixed-citation publication-type=\"eprint\"><object-id>44</object-id><person-group person-group-type=\"author\"><string-name>C. Wetterich</string-name></person-group>, <source>Fermion picture for cellular automata</source>, <pub-id pub-id-type=\"arxiv\">arXiv:2203.14081</pub-id>.</mixed-citation></ref>"}],"record":{"$ref":"https://inspirehep.net/api/literature/2058856"}},{"reference":{"arxiv_eprint":"2211.17034","label":"45","publication_info":{"journal_title":"Probabilistic cellular automaton for quantum particle in a potential"},"misc":["[quant-ph]"],"authors":[{"inspire_role":"author","full_name":"Wetterich, C."}]},"raw_refs":[{"schema":"JATS","source":"APS","value":"<ref id=\"c45\"><label>[45]</label><mixed-citation publication-type=\"eprint\"><object-id>45</object-id><person-group person-group-type=\"author\"><string-name>C. Wetterich</string-name></person-group>, <source>Probabilistic cellular automaton for quantum particle in a potential</source>, <pub-id pub-id-type=\"arxiv\">arXiv:2211.17034</pub-id> [quant-ph].</mixed-citation></ref>"}],"record":{"$ref":"https://inspirehep.net/api/literature/2605836"}},{"reference":{"dois":["10.1103/PhysicsPhysiqueFizika.1.195"],"label":"46","publication_info":{"journal_volume":"1","artid":"195","year":1964,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1305561"},"page_start":"195","journal_title":"Physics Physique Fizika"},"title":{"title":"On the Einstein-Podolsky-Rosen paradox"},"authors":[{"inspire_role":"author","full_name":"Bell, J.S."}]},"raw_refs":[{"schema":"JATS","source":"APS","value":"<ref id=\"c46\"><label>[46]</label><mixed-citation publication-type=\"journal\"><object-id>46</object-id><person-group person-group-type=\"author\"><string-name>J. S. Bell</string-name></person-group>, <article-title>On the Einstein-Podolsky-Rosen paradox</article-title>, <source>Phys. Phys. Fiz.</source> <volume>1</volume>, <page-range>195</page-range> (<year>1964</year>)<pub-id pub-id-type=\"doi\" specific-use=\"suppress-display\" assigning-authority=\"crossref\">10.1103/PhysicsPhysiqueFizika.1.195</pub-id>.</mixed-citation></ref>"}],"record":{"$ref":"https://inspirehep.net/api/literature/31657"}},{"reference":{"dois":["10.1103/PhysRevLett.23.880"],"label":"47","publication_info":{"journal_volume":"23","artid":"880","year":1969,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214495"},"page_start":"880","journal_title":"Phys.Rev.Lett."},"title":{"title":"Proposed experiment to test local hidden variable theories"},"authors":[{"inspire_role":"author","full_name":"Clauser, J.F."},{"inspire_role":"author","full_name":"Horne, M.A."},{"inspire_role":"author","full_name":"Shimony, A."},{"inspire_role":"author","full_name":"Holt, R.A."}]},"raw_refs":[{"schema":"JATS","source":"APS","value":"<ref id=\"c47\"><label>[47]</label><mixed-citation publication-type=\"journal\"><object-id>47</object-id><person-group person-group-type=\"author\"><string-name>J. F. Clauser</string-name>, <string-name>M. A. Horne</string-name>, <string-name>A. Shimony</string-name>, and <string-name>R. A. Holt</string-name></person-group>, <article-title>Proposed experiment to test local hidden variable theories</article-title>, <source>Phys. Rev. Lett.</source> <volume>23</volume>, <page-range>880</page-range> (<year>1969</year>)<issn>0031-9007</issn><pub-id pub-id-type=\"doi\" specific-use=\"suppress-display\" assigning-authority=\"crossref\">10.1103/PhysRevLett.23.880</pub-id>.</mixed-citation></ref>"}],"record":{"$ref":"https://inspirehep.net/api/literature/54978"}},{"reference":{"dois":["10.1002/andp.201000088"],"label":"48","publication_info":{"journal_volume":"522","artid":"807","year":2010,"page_start":"807","journal_title":"Ann. Phys. (Berlin, Ger.)"},"title":{"title":"Quantum particles from classical statistics"},"authors":[{"inspire_role":"author","full_name":"Wetterich, C."}]},"raw_refs":[{"schema":"JATS","source":"APS","value":"<ref id=\"c48\"><label>[48]</label><mixed-citation publication-type=\"journal\"><object-id>48</object-id><person-group person-group-type=\"author\"><string-name>C. Wetterich</string-name></person-group>, <article-title>Quantum particles from classical statistics</article-title>, <source>Ann. Phys. (Berlin, Ger.)</source> <volume>522</volume>, <page-range>807</page-range> (<year>2010</year>)<issn>0003-3804</issn><pub-id pub-id-type=\"doi\" specific-use=\"suppress-display\" assigning-authority=\"crossref\">10.1002/andp.201000088</pub-id>.</mixed-citation></ref>"}],"record":{"$ref":"https://inspirehep.net/api/literature/1095466"}},{"reference":{"dois":["10.1016/j.aop.2011.04.005"],"label":"49","publication_info":{"journal_volume":"326","artid":"2243","year":2011,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214855"},"page_start":"2243","journal_title":"Annals Phys."},"title":{"title":"Classical probabilities for Majorana and Weyl spinors"},"authors":[{"inspire_role":"author","full_name":"Wetterich, C."}]},"raw_refs":[{"schema":"JATS","source":"APS","value":"<ref id=\"c49\"><label>[49]</label><mixed-citation publication-type=\"journal\"><object-id>49</object-id><person-group person-group-type=\"author\"><string-name>C. Wetterich</string-name></person-group>, <article-title>Classical probabilities for Majorana and Weyl spinors</article-title>, <source>Ann. Phys. (NY)</source> <volume>326</volume>, <page-range>2243</page-range> (<year>2011</year>)<issn>0003-4916</issn><pub-id pub-id-type=\"doi\" specific-use=\"suppress-display\" assigning-authority=\"crossref\">10.1016/j.aop.2011.04.005</pub-id>.</mixed-citation></ref>"}],"record":{"$ref":"https://inspirehep.net/api/literature/889874"}},{"reference":{"dois":["10.1016/j.aop.2009.12.006"],"label":"50","publication_info":{"journal_volume":"325","artid":"852","year":2010,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214855"},"page_start":"852","journal_title":"Annals Phys."},"title":{"title":"Quantum mechanics from classical statistics"},"authors":[{"inspire_role":"author","full_name":"Wetterich, C."}]},"raw_refs":[{"schema":"JATS","source":"APS","value":"<ref id=\"c50\"><label>[50]</label><mixed-citation publication-type=\"journal\"><object-id>50</object-id><person-group person-group-type=\"author\"><string-name>C. Wetterich</string-name></person-group>, <article-title>Quantum mechanics from classical statistics</article-title>, <source>Ann. Phys. (NY)</source> <volume>325</volume>, <page-range>852</page-range> (<year>2010</year>)<issn>0003-4916</issn><pub-id pub-id-type=\"doi\" specific-use=\"suppress-display\" assigning-authority=\"crossref\">10.1016/j.aop.2009.12.006</pub-id>.</mixed-citation></ref>"}],"record":{"$ref":"https://inspirehep.net/api/literature/1095465"}},{"reference":{"dois":["10.1088/1742-6596/174/1/012008"],"label":"51","publication_info":{"journal_volume":"174","artid":"012008","year":2009,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1212279"},"journal_title":"J.Phys.Conf.Ser."},"title":{"title":"Emergence of quantum mechanics from classical statistics"},"authors":[{"inspire_role":"author","full_name":"Wetterich, C."}]},"raw_refs":[{"schema":"JATS","source":"APS","value":"<ref id=\"c51\"><label>[51]</label><mixed-citation publication-type=\"journal\"><object-id>51</object-id><person-group person-group-type=\"author\"><string-name>C. Wetterich</string-name></person-group>, <article-title>Emergence of quantum mechanics from classical statistics</article-title>, <source>J. Phys.: Conf. Ser.</source> <volume>174</volume>, <page-range>012008</page-range> (<year>2009</year>)<issn>1742-6596</issn><pub-id pub-id-type=\"doi\" specific-use=\"suppress-display\" assigning-authority=\"crossref\">10.1088/1742-6596/174/1/012008</pub-id>.</mixed-citation></ref>"}],"record":{"$ref":"https://inspirehep.net/api/literature/1095467"}},{"reference":{"dois":["10.1007/s10701-012-9675-3"],"label":"52","publication_info":{"journal_volume":"42","artid":"1384","year":2012,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214747"},"page_start":"1384","journal_title":"Found.Phys."},"title":{"title":"Probabilistic Time"},"authors":[{"inspire_role":"author","full_name":"Wetterich, C."}]},"raw_refs":[{"schema":"JATS","source":"APS","value":"<ref id=\"c52\"><label>[52]</label><mixed-citation publication-type=\"journal\"><object-id>52</object-id><person-group person-group-type=\"author\"><string-name>C. Wetterich</string-name></person-group>, <article-title>Probabilistic Time</article-title>, <source>Found. Phys.</source> <volume>42</volume>, <page-range>1384</page-range> (<year>2012</year>)<issn>0015-9018</issn><pub-id pub-id-type=\"doi\" specific-use=\"suppress-display\" assigning-authority=\"crossref\">10.1007/s10701-012-9675-3</pub-id>.</mixed-citation></ref>"}],"record":{"$ref":"https://inspirehep.net/api/literature/845709"}}],"number_of_pages":26,"preprint_date":"2024-05-16","author_count":2,"public_notes":[{"source":"arXiv","value":"26 pages, 9 figures"}],"earliest_date":"2024-05-16","refereed":true,"facet_author_name":["983712_Christof Wetterich","2787414_A. Kreuzkamp"],"license":[{"license":"arXiv nonexclusive-distrib 1.0","material":"preprint","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:2787413","updated":"2025-10-04T16:02:54.798508"},"journal_title_variants":["Phys.Rev.A","Phys. Rev. A"],"arxiv_eprints":[{"categories":["quant-ph","nlin.CG"],"value":"2405.09829"}],"referenced_authors_bais":["R.Laflamme.1","M.Creutz.1","John.Stewart.Bell.1","E.Domany.2","A.Shimony.1","A.Ray.18","C.Wetterich.1","H.T.Elze.1","R.A.Holt.2","W.Kinzel.1","John.F.Clauser.1","M.A.Horne.1","A.Kubica.1","G.tHooft.1","S.Wolfram.1"],"figures":[{"filename":"ism_example_trajectories.png","material":"preprint","caption":"Three possible trajectories of single particles. At scattering points denoted by black squares the particles change direction and color. The (fixed) scattering points have been chosen randomly.","label":"fig:ism_example_trajectories","source":"arxiv","key":"01592a5d159375f74555b1e47294b291","url":"https://inspirehep.net/files/01592a5d159375f74555b1e47294b291"},{"filename":"periodicBrownianModel_timeEvolution.png","material":"preprint","caption":"Evolution of the wave function for a Brownian automaton, model A. Parameters are given by eq. \\labelcref{eq:brownianModelParams}. We start with a plane wave solution of the Dirac equation and display the result of the updating at three different times. Due to the scattering at randomly distributed scattering points the originally smooth wave function becomes rough. The smoothened orange curve only keeps a few lowest Fourier modes of the distribution in space. This may be compared with the absence of scattering points (gray dotted curve), for which the automaton is exactly equivalent to a free massless Dirac particle. We also compare to the evolution of a massive Dirac particle (blue curve).","label":"fig:brownianModel_timeEvolution","source":"arxiv","key":"dc151805ea02036a74e97f9dd1ac6fea","url":"https://inspirehep.net/files/dc151805ea02036a74e97f9dd1ac6fea"},{"filename":"ism_qm_red_occupationNum_timeEvolution.png","material":"preprint","caption":"Time evolution of a stationary state, evolved with a periodic random PCA, model B. Parameters are given by eq. \\labelcref{eq:pRPCA_params}. We display the difference of mean occupation numbers $\\langle n_1(t, x) - n_3(t, x) \\rangle = w_1(t, x) - w_3(t,x)$ after different numbers of time steps. The precise reappearance of the initial distribution (bottom figure) after $1632$ time steps (top figure) is striking.","label":"fig:ism_qm_red_occupationNum_timeEvolution","source":"arxiv","key":"6d9e3ce6e3341a7b883635caeea21466","url":"https://inspirehep.net/files/6d9e3ce6e3341a7b883635caeea21466"},{"filename":"ism_naive_momentumEvolution_p=1.0.png","material":"preprint","caption":"Momentum distribution at four different time steps, evolved with a periodic random PCA, model B \\labelcref{eq:pRPCA_params}. We indicate the probabilities for given momenta, as encoded in the diagonal elements $\\rho(q,q)$ of the density matrix in the momentum basis. The initial plane wave with a sharp momentum distribution evolves into a superposition of momentum states with momenta $(\\overline{N}_x + 1)(2\\pi / L)$, $m$ integer, $\\overline{N}_x = N_x / M_x = 32$. We indicate the momentum values of the prominent momentum peaks at the top of each subfigure.","label":"fig:periodicModel_momentum_timeEvolution","source":"arxiv","key":"eada479c6ddc85e43f11a995626882aa","url":"https://inspirehep.net/files/eada479c6ddc85e43f11a995626882aa"},{"filename":"periodicBrownianModel_autocorrelation.png","material":"preprint","caption":"Transition element $B(t)$ of the Brownian PCA, model A \\labelcref{eq:brownianModelParams}, with an initial plane wave. One observes a type of damped oscillations, rather than a smooth decay towards some equilibrium state.","label":"fig:brownianModel_autocorrelation","source":"arxiv","key":"2a872339367f0dca636f2de7fff95d00","url":"https://inspirehep.net/files/2a872339367f0dca636f2de7fff95d00"},{"filename":"periodicBrownianModel_shortTermEnergySpectrum.png","material":"preprint","caption":"Short term energy spectrum $Re B(\\omega)$ of the Brownian PCA, model A \\labelcref{eq:brownianModelParams}, with an initial plane wave. For $\\overline{N}_t = 1024$ intervals $\\Delta t$ we compare this with the discrete generalization of the $\\delta-$ function, which characterizes a single eigenstate. For the Brownian automaton the initial plane wave is a superposition of different energy eigenstates. The peak of the energy distribution is close to the mean value $\\langle E \\rangle$.","label":"fig:brownianModel_shortTermEnergySpectrum","source":"arxiv","key":"1d526b17f1e7e71b356acd68ced18fd1","url":"https://inspirehep.net/files/1d526b17f1e7e71b356acd68ced18fd1"},{"filename":"ism_orbit_structure.png","material":"preprint","caption":"Orbits for the periodic cellular automaton, model B. The blue and orange orbit can be followed by periodic continuation in $\\Delta x$ and $\\Delta t$. The two orbits shown are shifted by $\\Delta x$ to each other.","label":"fig:ism_orbit_structure","source":"arxiv","key":"1a40496a6c54fcaf140ffd56d635cbda","url":"https://inspirehep.net/files/1a40496a6c54fcaf140ffd56d635cbda"},{"filename":"U_p_reduced_n_p=1_k=1_k_=1.png","material":"preprint","caption":"Reduced mesoscopic evolution operator of model B \\labelcref{eq:pRPCA_params}. We display the submatrix $W_{R, R}(\\overline{q}; Q, Q')$ for the right-moving component for $\\overline{q} / (2\\pi / L) = 1$. The dominant components are the real parts of the elements $(0,0)$ and $(-8, -8)$, which are opposite in sign.","label":"fig:U_p_reduced","source":"arxiv","key":"8c1c08edfe439a1e017c5b200ee33de9","url":"https://inspirehep.net/files/8c1c08edfe439a1e017c5b200ee33de9"},{"filename":"periodicBrownianModel_dispersion.png","material":"preprint","caption":"Mean energy for plane wave initial states with different momenta for the Brownian automaton \\labelcref{eq:brownianModelParams}, however with $N_x=4096, m = 20 \\cdot 2\\pi / L$, which corresponds to an approaching of the large volume limit. The different colors show different automata, corresponding to different distributions of the randomly chosen scattering points. The continuous curve indicates the dispersion relation for the Dirac particle with mass $m=2.5 (2\\pi / L)$, corresponding to the naive continuum limit for the Brownian automaton. For the initial stages of the evolution for $\\overline{N}_t = 64 \\Delta t$-intervals the naive continuum limit appears as a rough approximation.","label":"fig:periodicBrownianModel_dispersion","source":"arxiv","key":"ecc0e8219e362e2a7bd4f94838b97897","url":"https://inspirehep.net/files/ecc0e8219e362e2a7bd4f94838b97897"}],"inspire_categories":[{"term":"Quantum Physics","source":"arxiv"},{"term":"General Physics","source":"arxiv"}],"first_author":{"full_name":"Kreuzkamp, A.","ids":[{"schema":"ORCID","value":"0009-0002-2443-6311"},{"schema":"INSPIRE BAI","value":"A.Kreuzkamp.1"}],"last_name":"Kreuzkamp","first_name":"A.","recid":2787414},"control_number":2787413,"dois":[{"material":"publication","source":"APS","value":"10.1103/PhysRevA.111.042213"}],"document_type":["article"],"texkeys":["Kreuzkamp:2024whx"],"abstracts":[{"source":"APS","value":"Probabilistic cellular automata with deterministic updating are discrete quantum systems. They are characterized by a probability distribution over initial configurations. We employ the quantum formalism for an investigation of random probabilistic cellular automata for which the properties of the deterministic updating are randomly distributed over space and time. We are interested in a possible continuum limit for a very large number of cells or space points. We consider bits with two colors, moving to the left or right on a linear chain. At randomly distributed scattering points they change direction and color. A numerical simulation reveals the typical features of quantum systems. We find particular initial probability distributions which reemerge periodically after a certain number of time steps, as produced by the periodic evolution of energy eigenstates in quantum mechanics. Using a description in terms of wave functions allows us to introduce statistical observables for momentum and energy. They characterize the probabilistic information without taking definite values for a given bit configuration, with a conceptual status similar to temperature in classical statistical thermal equilibrium. Conservation of energy and momentum are essential ingredients for the understanding of the evolution of the stochastic probabilistic automata. This evolution resembles in some aspects a single Dirac fermion in two dimensions with a generalized random potential.","abstract_source_suggest":{"input":"APS"}},{"source":"arXiv","value":"Probabilistic cellular automata with deterministic updating are quantum systems. We employ the quantum formalism for an investigation of random probabilistic cellular automata, which start with a probability distribution over initial configurations. The properties of the deterministic updating are randomly distributed over space and time. We are interested in a possible continuum limit for a very large number of cells. As an example we consider bits with two colors, moving to the left or right on a linear chain. At randomly distributed scattering points, they change direction and color. A numerical simulation reveals the typical features of quantum systems. We find particular initial probability distributions which reemerge periodically after a certain number of time steps, as produced by the periodic evolution of energy eigenstates in quantum mechanics. Using a description in terms of wave functions allows to introduce statistical observables for momentum and energy. They characterize the probabilistic information without taking definite values for a given bit configuration, with a conceptual status similar to temperature in classical statistical thermal equilibrium. Conservation of energy and momentum are essential ingredients for the understanding of the evolution of our stochastic probabilistic automata. This evolution resembles in some aspects a single Dirac fermion in two dimensions with a random potential.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["quant-ph"],"titles":[{"source":"APS","title":"Quantum systems from random probabilistic automata"},{"source":"arXiv","title":"Quantum Systems from Random Probabilistic Automata"}],"imprints":[{"date":"2025-04-18"}],"curated":false},"created":"2024-05-17T03:44:27.200623+00:00","id":"2787413","updated":"2025-10-04T16:02:54.798508+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/2787413?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/2787413?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/2787413?format=latex-us","json":"https://inspirehep.net/api/literature/2787413?format=json","json-expanded":"https://inspirehep.net/api/literature/2787413?format=json-expanded","cv":"https://inspirehep.net/api/literature/2787413?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2787413"}},{"metadata":{"citation_count":1,"citation_count_without_self_citations":0,"authors":[{"raw_affiliations":[{"value":"Central Astronomical Observatory at Pulkovo of the Russian Academy of Sciences - Saint Petersburg, 196140, Russia"},{"value":"Peter the Great Saint Petersburg Polytechnic University - Saint Petersburg, 195251, Russia"}],"full_name_unicode_normalized":"klimchitskaya, g.l.","full_name":"Klimchitskaya, G.L.","record":{"$ref":"https://inspirehep.net/api/authors/1906968"},"ids":[{"schema":"INSPIRE BAI","value":"G.L.Klimchitskaya.2"}],"last_name":"Klimchitskaya","uuid":"d3c042c6-b0ec-469a-98c3-e39d8c8fddf9","first_name":"G.L.","recid":1906968},{"raw_affiliations":[{"value":"Peter the Great Saint Petersburg Polytechnic University - Saint Petersburg, 195251, Russia"}],"full_name_unicode_normalized":"korotkov, a.s.","full_name":"Korotkov, A.S.","record":{"$ref":"https://inspirehep.net/api/authors/2531515"},"ids":[{"schema":"INSPIRE BAI","value":"A.S.Korotkov.1"}],"last_name":"Korotkov","uuid":"b3e57c74-e14d-45da-9f49-8e2a31ea08c3","first_name":"A.S.","recid":2531515},{"raw_affiliations":[{"value":"Peter the Great Saint Petersburg Polytechnic University - Saint Petersburg, 195251, Russia"}],"full_name_unicode_normalized":"loboda, v.v.","full_name":"Loboda, V.V.","record":{"$ref":"https://inspirehep.net/api/authors/2490190"},"ids":[{"schema":"INSPIRE BAI","value":"A.V.Loboda.1"}],"last_name":"Loboda","uuid":"91c41a16-e04f-4c02-bc68-d6b82b86a5f9","first_name":"V.V.","recid":2490190},{"ra