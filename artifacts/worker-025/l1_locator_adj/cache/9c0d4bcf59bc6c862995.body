urnal_volume":"89","artid":"84","year":2016,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1613945"},"page_start":"84","journal_title":"Eur.Phys.J.B"},"authors":[{"full_name":"Phuong, D.D."}]},"raw_refs":[{"schema":"text","value":"[58] D. D. Phuong, Eur.Phys.J.B,89,84"}]},{"reference":{"label":"59","publication_info":{"journal_volume":"15","artid":"40","year":2017,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1212915"},"page_start":"40","journal_title":"Nanotechnol."},"authors":[{"full_name":"Inui, N."},{"full_name":"Iwasaki, S."}]},"raw_refs":[{"schema":"text","value":"[59] N. Inui, S. Iwasaki, Nanotechnol.,15,40"}]},{"reference":{"label":"60","publication_info":{"journal_volume":"205","artid":"111206","year":2022,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1213805"},"journal_title":"Comput.Mater.Sci."},"authors":[{"full_name":"Jacobson, D.W."},{"full_name":"Thompson, G.B."}]},"raw_refs":[{"schema":"text","value":"[60] D. W. Jacobson, G. B. Thompson, Comput.Mater.Sci.,205,111206"}]},{"reference":{"label":"61","publication_info":{"journal_volume":"132","artid":"354","year":1988,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1613965"},"page_start":"354","journal_title":"Phys.Lett.A"},"authors":[{"full_name":"Moiseev, Yu.N."}]},"raw_refs":[{"schema":"text","value":"[61] Yu. N. Moiseev, Phys.Lett.A,132,354"}]},{"reference":{"label":"62","publication_info":{"journal_volume":"10","artid":"2661","year":1995,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1613973"},"page_start":"2661","journal_title":"Int.J.Mod.Phys.A"},"authors":[{"full_name":"Bordag, M."}]},"raw_refs":[{"schema":"text","value":"[62] M. Bordag, Int.J.Mod.Phys.A,10,2661"}],"record":{"$ref":"https://inspirehep.net/api/literature/39645"}}],"number_of_pages":7,"preprint_date":"2024-10-18","author_count":4,"public_notes":[{"source":"arXiv","value":"7 pages, 4 fogures"}],"earliest_date":"2024-10-07","refereed":true,"facet_author_name":["1906968_G.L. Klimchitskaya","1990215_V.M. Mostepanenko","2490190_A.V. Loboda","2531515_A.S. Korotkov"],"license":[{"license":"arXiv nonexclusive-distrib 1.0","material":"preprint","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:2841275","updated":"2026-02-09T14:18:18.862386"},"journal_title_variants":["EPL"],"arxiv_eprints":[{"categories":["cond-mat.mes-hall","quant-ph"],"value":"2410.14377"}],"referenced_authors_bais":["B.J.Kooi.1","Yong.Li.1","T.Tschudi.1","H.Waalkens.1","V.M.Petrov.2","A.W.Rodriguez.1","J.Knoester.1","F.Chen.1","V.M.Mostepaneko.1","G.L.Klimchitskaya.3","R.CastilloGarza.1","L.P.Pitaevskii.1","M.T.H.Reid.1","W.H.Broer.1","Y.Bao.5","H.B.Chan.1","G.Palasantzas.1","U.Mohideen.1","A.V.Loboda.1","V.B.Svetovoy.3","G.Johnson.1","A.P.McCauley.1","Mehdi.Sedighi.1","Jia.Heng.Zou.1","I.Kravchenko.1","E.M.Lifshitz.1","G.L.Klimchitskaya.7","C.C.Chang.5","G.Bimonte.1","F.X.Liu.2","A.S.Korotkov.1","I.E.Dzyaloshinskii.2","Z.Marcet.1","A.A.Banishev.1","M.Bordag.1","Han.Tao.Jing.1","V.M.Mostepanenko.1","G.L.Klimchitskaya.2","Tan.Lu.1"],"figures":[{"filename":"figSwiL1a-1.png","material":"preprint","caption":"The nanoswitch made up of a Si cantilever and two parallel Au or Ni plates. (a) Schematic picture and (b) micrograph of the cantilever bending.","label":"fig.1","source":"arxiv","key":"94189fab5b6e549c57847c1e6c3c7a1d","url":"https://inspirehep.net/files/94189fab5b6e549c57847c1e6c3c7a1d"},{"filename":"figSwiL1a-2.png","material":"preprint","caption":"Schematic picture of the spherical tip of a cantilever at the closest separation $a$ from the plate.","label":"fig.2","source":"arxiv","key":"441b52610483992ed8898b2586d8b55b","url":"https://inspirehep.net/files/441b52610483992ed8898b2586d8b55b"},{"filename":"figSwiL1a-3.png","material":"preprint","caption":"The magnitudes of the van der Waals (Casimir) and contact repulsive forces between the smooth surfaces of a Si cantilever tip and either Au or Ni plates are shown as functions of separation. The region of short separations is shown in the inset on an enlarged scale.","label":"fig.3","source":"arxiv","key":"6360708cc4f3bbcc80575d54b11e7c4d","url":"https://inspirehep.net/files/6360708cc4f3bbcc80575d54b11e7c4d"},{"filename":"figSwiL1b-4.png","material":"preprint","caption":"The magnitudes of the elastic, electric (at the applied voltages of (a) 1.75, (b) 1.76, and 20~V) and the sum of the van der Waals (Casimir) and contact repulsive forces between the surface of a Si cantilever and rough surfaces of (a) Au and (b) Ni plates are shown as functions of separation.","label":"fig.4","source":"arxiv","key":"13bf6d9dc86aa0b7337d2e14cc37e368","url":"https://inspirehep.net/files/13bf6d9dc86aa0b7337d2e14cc37e368"}],"inspire_categories":[{"term":"Condensed Matter","source":"arxiv"},{"term":"Quantum Physics","source":"arxiv"}],"first_author":{"emails":["g.klimchitskaya@gmail.com"],"full_name":"Klimchitskaya, G.L.","last_name":"Klimchitskaya","first_name":"G.L.","recid":1906968},"control_number":2841275,"dois":[{"source":"IOP","value":"10.1209/0295-5075/ad7f83"},{"material":"publication","source":"arXiv","value":"10.1209/0295-5075/ad7f83"}],"document_type":["article"],"texkeys":["Klimchitskaya:2024cgc"],"abstracts":[{"source":"IOP","value":"The cantilever tip of a nanoswitch in close proximity to the ground plate is considered with account of electrostatic, elastic, van der Waals (Casimir), and also contact repulsive forces. The van der Waals (Casimir) and contact repulsive forces are computed for a Si cantilever and either Au or Ni ground plates using the Lifshitz theory and the method of pairwise summation with account of surface roughness. It is shown that at short separations an impact of the van der Waals (Casimir) force leads to the pull-in and collapse of a cantilever onto the ground plate if the contact repulsion is disregarded. Taking into consideration contact repulsion, the nanoswitch is demonstrated to have the stable cyclic behavior with no pull-in when switching voltage on and off.","abstract_source_suggest":{"input":"IOP"}},{"source":"arXiv","value":"The cantilever tip of a nanoswitch in close proximity to the ground plate is considered with account of electrostatic, elastic, van der Waals (Casimir), and also contact repulsive forces. The van der Waals (Casimir) and contact repulsive forces are computed for a Si cantilever and either Au or Ni ground plates using the Lifshitz theory and the method of pairwise summation with account of surface roughness. It is shown that at short separations an impact of the van der Waals (Casimir) force leads to the pull-in and collapse of a cantilever onto the ground plate if the contact repulsion is disregarded. Taking into consideration contact repulsion, the nanoswitch is demonstrated to have the stable cyclic behavior with no pull-in when switching voltage on and off.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["cond-mat.mes-hall"],"titles":[{"source":"IOP","title":"Pull-in features of nanoswitches in the Casimir regime with account of contact repulsion"},{"source":"arXiv","title":"Pull-in features of nanoswitches in the Casimir regime with account of contact repulsion"}],"imprints":[{"date":"2024-10-07"}],"curated":false},"created":"2024-10-21T04:13:17.656006+00:00","id":"2841275","updated":"2026-02-09T14:18:18.862386+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/2841275?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/2841275?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/2841275?format=latex-us","json":"https://inspirehep.net/api/literature/2841275?format=json","json-expanded":"https://inspirehep.net/api/literature/2841275?format=json-expanded","cv":"https://inspirehep.net/api/literature/2841275?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2841275"}},{"metadata":{"citation_count":70,"citation_count_with