ps://inspirehep.net/api/literature/529921"}},{"reference":{"arxiv_eprint":"hep-th/0008102","publication_info":{"journal_volume":"16","artid":"1157","page_start":"1157","journal_title":"Mod.Phys.Lett.A"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/531649"}},{"reference":{"arxiv_eprint":"hep-th/9909205","publication_info":{"journal_volume":"61","artid":"065007","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/507904"}},{"reference":{"arxiv_eprint":"hep-th/9912118","publication_info":{"journal_volume":"62","artid":"043523","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/511555"}},{"reference":{"arxiv_eprint":"hep-th/9905210","publication_info":{"journal_volume":"60","artid":"123506","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/500738"}},{"reference":{"arxiv_eprint":"hep-th/9910219","publication_info":{"journal_volume":"477","artid":"285","page_start":"285","journal_title":"Phys.Lett.B"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/509212"}},{"reference":{"arxiv_eprint":"gr-qc/0302049","publication_info":{"journal_volume":"68","artid":"064004","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/613275"}},{"reference":{"arxiv_eprint":"gr-qc/0108058","publication_info":{"journal_volume":"65","artid":"044011","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/561922"}}],"number_of_pages":16,"legacy_creation_date":"2003-11-04","preprint_date":"2003-11","author_count":2,"earliest_date":"2003-11","refereed":true,"external_system_identifiers":[{"schema":"MSNET","value":"2030871"},{"schema":"ADS","value":"2004CQGra..21..391L"},{"schema":"SPIRES","value":"SPIRES-5713242"}],"facet_author_name":["1012829_Paulo Crawford","1024546_Francisco S.N. Lobo"],"core":true,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:632218","updated":"2023-03-10T14:54:20.371660"},"journal_title_variants":["Class. Quant. Grav.","Class.Quant.Grav."],"arxiv_eprints":[{"categories":["gr-qc"],"value":"gr-qc/0311002"}],"referenced_authors_bais":["R.B.Mann.1","M.S.Morris.1","S.Quinet.de.Oliveira.1","C.Deffayet.1","H.S.Reall.1","Ernesto.F.Eiroa.1","H.Lee.10","W.Israel.1","J.Louko.1","Carlos.Nunez.1","S.W.Kim.2","K.Lake.1","J.P.S.Lemos.1","M.S.R.Delgaty.1","J.M.Yang.5","L.A.Anchordoqui.1","Francisco.S.N.Lobo.1","Raman.Sundrum.1","P.Kraus.1","Jaume.Garriga.1","A.Chamblin.1","Stephen.W.Hawking.1","U.Ellwanger.1","E.Poisson.1","K.Olsen.1","Lisa.Randall.1","Kip.S.Thorne.1","P.R.Brady.1","P.Binetruy.1","Matt.Visser.1","N.Kaloper.1","M.Sasaki.1","S.K.Kim.1","Gustavo.E.Romero.1","D.Langlois.1","G.P.Perry.1","Mustapha.Ishak.Bourshaki.1"],"legacy_version":"20180614230033.0","inspire_categories":[{"term":"Gravitation and Cosmology"}],"first_author":{"full_name":"Lobo, Francisco S.N.","last_name":"Lobo","first_name":"Francisco S.N.","recid":1024546},"control_number":632218,"dois":[{"value":"10.1088/0264-9381/21/2/004"}],"document_type":["article"],"texkeys":["Lobo:2003xd"],"abstracts":[{"source":"arXiv","value":"Spherically symmetric thin-shell wormholes in the presence of a cosmological constant are constructed applying the cut-and-paste technique implemented by Visser. Using the Darmois-Israel formalism the surface stresses, which are concentrated at the wormhole throat, are determined. This construction allows one to apply a dynamical analysis to the throat, considering linearized radial perturbations around static solutions. For a large positive cosmological constant, i.e., for the Schwarzschild-de Sitter solution, the region of stability is significantly increased, relatively to the null cosmological constant case, analyzed by Poisson and Visser. With a negative cosmological constant, i.e., the Schwarzschild-anti de Sitter solution, the region of stability is decreased. In particular, considering static solutions with a generic cosmological constant, the weak and dominant energy conditions are violated, while for $a_0 \\leq 3M$ the null and strong energy conditions are satisfied. The surface pressure of the static solution is strictly positive for the Schwarzschild and Schwarzschild-anti de Sitter spacetimes, but takes negative values, assuming a surface tension in the Schwarzschild-de Sitter solution, for high values of the cosmological constant and the wormhole throat radius.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"Linearized stability analysis of thin shell wormholes with a cosmological constant"},{"source":"arXiv","title":"Linearized stability analysis of thin-shell wormholes with a cosmological constant."}],"curated":true}},{"links":{"bibtex":"https://inspirehep.net/api/literature/2174680?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/2174680?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/2174680?format=latex-us","json":"https://inspirehep.net/api/literature/2174680?format=json","json-expanded":"https://inspirehep.net/api/literature/2174680?format=json-expanded","cv":"https://inspirehep.net/api/literature/2174680?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2174680"},"created":"2022-11-02T03:13:12.559654+00:00","id":"2174680","updated":"2024-09-30T06:01:28.595122+00:00","metadata":{"citation_count":8,"publication_info":[{"journal_volume":"248","artid":"92","year":2024,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214824"},"page_start":"92","journal_issue":"5","journal_title":"Arch.Ration.Mech.Anal."}],"citation_count_without_self_citations":7,"documents":[{"filename":"document","fulltext":true,"source":"Springer","key":"8969571e95e5f4bfaf49ba5f3187c5cf","url":"https://inspirehep.net/files/8969571e95e5f4bfaf49ba5f3187c5cf"}],"authors":[{"raw_affiliations":[{"value":"Princeton Gravity Initiative, Princeton University, Washington Road, 08544 Princeton, NJ, USA"}],"affiliations_identifiers":[{"schema":"GRID","value":"grid.16750.35"}],"full_name_unicode_normalized":"benomio, gabriele","full_name":"Benomio, Gabriele","record":{"$ref":"https://inspirehep.net/api/authors/2030089"},"ids":[{"schema":"INSPIRE BAI","value":"G.Benomio.1"}],"last_name":"Benomio","signature_block":"BANANg","uuid":"a74c4e6f-47ce-42b4-9c12-374a8d8f6447","first_name":"Gabriele","recid":2030089}],"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","references":[{"reference":{"arxiv_eprint":"1903.03859"},"raw_refs":[{"schema":"text","value":"[1] , Andersson, L. , Bäckdahl, T. , Blue, P. , Ma, S. : Stability for linearized gravity on the Kerr spacetime, 2019. , http://arxiv.org/abs/1903.03859"}],"record":{"$ref":"https://inspirehep.net/api/literature/1724549"}},{"reference":{"label":"2","publication_info":{"year":2020},"misc":[": The wave equation on black rings and the linear stability of slowly rotating Kerr spacetimes, PhD thesis, Imperial College London"],"authors":[{"full_name":"Benomio, G."}]},"raw_refs":[{"schema":"text","value":"[2] , Benomio, G. : The wave equation on black rings and the linear stability of slowly rotating Kerr spacetimes, PhD thesis, Imperial College London, 2020"}]},{"reference":{"arxiv_eprint":"2211.00602"},"raw_refs":[{"schema":"text","value":"[3] , Benomio, G. : A new gauge for gravitational perturbations of Kerr spacetimes I: The linearised theory, 2022. Preprint at , http://arxiv.org/abs/2211.00602"}],"record":{"$ref":"https://inspirehep.net/api/literature/2174686"}},{"reference":{"imprint":{"publisher":"Princeton University Press"},"label":"4","publication_info":{"year":1993},"title":{"title":"The Global Nonlinear Stability of the Minkowski Space, Princeton Mathematical Series"},"authors":[{"full_name":"Christodoulou, D."},{"full_name":"Klainerman, S."}]},"raw_refs":[{"schema":"text","value":"[4] D. Christodoulou, S. Klainerman: The Global Nonlinear Stability of the Minkowski Space, Princeton Mathematical Series, Princeton University Press, Princeton, 1993, 1993"}]},{"reference":{"dois":["10.1088/1361-6382/ad0214"]},"raw_refs":[{"schema":"text","value":"[5] SC Collingbourne: Coercivity properties of the canonical energy in double null gauge on the 4-dimensional Schwarzschild exterior, 2023, Class. Quantum Gravity 2023 40 , ADS: https://ui.adsabs.harvard.edu/abs/2023CQGra..40v5013C/abstract, MathSciNet: https://mathscinet.ams.org/mathscinet/article?mr=4667025, DOI: 10.1088/1361-6382/ad0214"}],"record":{"$ref":"https://inspirehep.net/api/literature/2676048"}},{"reference":{"arxiv_eprint":"2307.05458"},"raw_refs":[{"schema":"text","value":"[6] , Collingbourne, S.C. , Holzegel , G.: Uniform Boundedness for Solutions to the Teukolsky Equation on Schwarzschild from Conservation Laws of Linearised Gravity, 2023. , http://arxiv.org/abs/2307.05458"}],"record":{"$ref":"https://inspirehep.net/api/literature/2676035"}},{"reference":{"dois":["10.1007/s40818-018-0058-8"],"label":"7","publication_info":{"journal_volume":"5","artid":"2","year":2019,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1834781"},"page_start":"2","journal_title":"Ann.PDE"},"title":{"title":"Boundedness and decay for the Teukolsky equation on kerr spacetimes I: the case $|a|\\ll M$"},"authors":[{"full_name":"Dafermos, M."},{"full_name":"Holzegel, G."},{"full_name":"Rodnianski, I."}]},"raw_refs":[{"schema":"text","value":"[7] M. Dafermos, G. Holzegel, I. Rodnianski, \"Boundedness and decay for the Teukolsky equation on kerr spacetimes I: the case $|a|\\ll M$\", Ann.PDE,5,2, DOI: 10.1007/s40818-018-0058-8"}]},{"reference":{"dois":["10.4310/ACTA.2019.v222.n1.a1"],"label":"8","publication_info":{"journal_volume":"222","page_end":"214","year":2019,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214886"},"page_start":"1","journal_title":"Acta Math."},"title":{"title":"The linear stability of the Schwarzschild solution to gravitational perturbations"},"authors":[{"full_name":"Dafermos, M."},{"full_name":"Holzegel, G."},{"full_name":"Rodnianski, I."}]},"raw_refs":[{"schema":"text","value":"[8] M. Dafermos, G. Holzegel, I. Rodnianski, \"The linear stability of the Schwarzschild solution to gravitational perturbations\", Acta Math.,222,1-214, DOI: 10.4310/ACTA.2019.v222.n1.a1"}],"record":{"$ref":"https://inspirehep.net/api/literature/1416803"}},{"reference":{"arxiv_eprint":"2104.08222"},"raw_refs":[{"schema":"text","value":"[9] , Dafermos, M. , Holzegel, G. , Rodnianski, I., Taylor, M. : The nonlinear stability of the Schwarzschild family of black holes, 2021. , http://arxiv.org/abs/2104.08222"}],"record":{"$ref":"https://inspirehep.net/api/literature/1858943"}},{"reference":{"dois":["10.1002/cpa.20281"],"label":"10","publication_info":{"journal_volume":"62","page_end":"919","year":2009,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214782"},"page_start":"859","journal_title":"Commun.Pure Appl.Math."},"title":{"title":"The red-shift effect and radiation decay on black hole spacetimes"},"authors":[{"full_name":"Dafermos, M."},{"full_name":"Rodnianski, I."}]},"raw_refs":[{"schema":"text","value":"[10] M. Dafermos, I. Rodnianski, \"The red-shift effect and radiation decay on black hole spacetimes\", Commun.Pure Appl.Math.,62,859-919, DOI: 10.1002/cpa.20281"}],"record":{"$ref":"https://inspirehep.net/api/literature/701089"}},{"reference":{"dois":["10.4007/annals.2016.183.3.2"],"label":"11","publication_info":{"journal_volume":"2","page_end":"913","year":2016,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214864"},"page_start":"787","journal_title":"Annals Math."},"title":{"title":"Decay for solutions of the wave equation on Kerr exterior spacetimes III: the full subextremal case $|a|<M$"},"authors":[{"full_name":"Dafermos, M."},{"full_name":"Rodniansk