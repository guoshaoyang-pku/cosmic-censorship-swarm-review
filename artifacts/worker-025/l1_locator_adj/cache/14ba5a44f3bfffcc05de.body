"MSNET","value":"3555701"},{"schema":"ADS","value":"2016CQGra..33t5004H"}],"facet_author_name":["1274922_Gustav H. Holzegel"],"license":[{"imposing":"arXiv","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1421638","updated":"2023-03-07T04:20:20.856775"},"journal_title_variants":["Class. Quant. Grav.","Class.Quant.Grav."],"arxiv_eprints":[{"categories":["gr-qc","math.AP"],"value":"1602.04524"}],"referenced_authors_bais":["J.A.Wheeler.1","V.Moncrief.1","G.A.Campbell.1","A.Ishibashi.1","K.Martel.2","S.R.Green.1","S.Hollands.1","T.Regge.1","B.S.Kay.1","P.Blue.2","P.Milos.1","S.Aretakis.1","G.A.Burnett.1","G.Holzegel.1","K.Prabhu.1","V.Iyer.1","Y.Shlapentokh.Rothman.1","D.Dold.1","M.Dafermos.1","J.Keir.1","E.Poisson.1","R.Peled.1","A.Soffer.7","R.A.Matzner.1","I.Rodnianski.1","J.Lee.18","B.F.Whiting.1","I.G.de.Austria.1","R.M.Wald.1","S.Dain.1"],"legacy_version":"20200217203059.0","inspire_categories":[{"term":"Gravitation and Cosmology"},{"term":"Math and Math Physics"}],"first_author":{"full_name":"Holzegel, Gustav","last_name":"Holzegel","first_name":"Gustav","recid":1274922},"control_number":1421638,"dois":[{"source":"bibmatch","value":"10.1088/0264-9381/33/20/205004"}],"document_type":["article"],"texkeys":["Holzegel:2016wax"],"abstracts":[{"source":"IOP","value":"We derive an energy conservation law for the system of gravitational perturbations on the Schwarzschild spacetime expressed in a double null gauge. The resulting identity involves only first derivatives of the metric perturbation. Exploiting the gauge invariance up to boundary terms of the fluxes that appear, we are able to establish positivity of the flux on any outgoing null hypersurface to the future of the initial data. This allows us to bound the total energy flux through any such hypersurface, including the event horizon, in terms of initial data. We similarly bound the total energy radiated to null infinity. Our estimates provide a direct approach to a weak form of stability, thereby complementing the proof of the full linear stability of the Schwarzschild solution recently obtained in Dafermos et al (2016 The linear stability of the Schwarzschild solution to gravitational perturbations arXiv:1601.06467).","abstract_source_suggest":{"input":"IOP"}},{"source":"arXiv","value":"We derive an energy conservation law for the system of gravitational perturbations on the Schwarzschild spacetime expressed in a double null gauge. The resulting identity involves only first derivatives of the metric perturbation. Exploiting the gauge invariance up to boundary terms of the fluxes that appear, we are able to establish positivity of the flux on any outgoing null hypersurface to the future of the initial data. This allows us to bound the total energy flux through any such hypersurface, including the event horizon, in terms of initial data. We similarly bound the total energy radiated to null infinity. Our estimates provide a direct approach to a weak form of stability, thereby complementing the proof of the full linear stability of the Schwarzschild solution recently obtained in [M. Dafermos, G. Holzegel and I. Rodnianski \\emph{The linear stability of the Schwarzschild solution to gravitational perturbations}, arXiv:1601.06467].","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"source":"arXiv","title":"Conservation laws and flux bounds for gravitational perturbations of the Schwarzschild metric"}],"imprints":[{"date":"2016-09-21"}],"curated":false}},{"links":{"bibtex":"https://inspirehep.net/api/literature/1662114?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1662114?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1662114?format=latex-us","json":"https://inspirehep.net/api/literature/1662114?format=json","json-expanded":"https://inspirehep.net/api/literature/1662114?format=json-expanded","cv":"https://inspirehep.net/api/litera