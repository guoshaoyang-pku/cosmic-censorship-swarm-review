"$ref":"https://inspirehep.net/api/journals/1834781"},"page_start":"9","journal_title":"Ann.PDE"},"title":{"title":"Decay of the Weyl curvature in expanding black hole cosmologies"},"authors":[{"full_name":"Schlue, V."}]},"raw_refs":[{"schema":"text","value":"[25] V. Schlue, \"Decay of the Weyl curvature in expanding black hole cosmologies\", Ann.PDE,8,9, DOI: 10.1007/s40818-022-00125-6"}],"record":{"$ref":"https://inspirehep.net/api/literature/1491940"}},{"reference":{"label":"26","publication_info":{"year":1998},"misc":[": Spherically symmetric solutions of the vacuum Einstein field equations with positive cosmological constant,,Master Thesis University of Vienna"],"authors":[{"full_name":"Stanciulescu, C."}]},"raw_refs":[{"schema":"text","value":"[26] C. Stanciulescu: Spherically symmetric solutions of the vacuum Einstein field equations with positive cosmological constant, 1998, 1998 Master Thesis University of Vienna"}]},{"reference":{"imprint":{"publisher":"Cambridge University Press"},"label":"27","publication_info":{"year":2016},"title":{"title":"Conformal Methods in General Relativity"},"authors":[{"full_name":"Kroon, J.A. Valiente"}]},"raw_refs":[{"schema":"text","value":"[27] J A Valiente Kroon: Conformal Methods in General Relativity, Cambridge University Press, Cambridge, 2016, 2016"}]},{"reference":{"dois":["10.4310/PAMQ.2019.v15.n3.a1"],"label":"28","publication_info":{"journal_volume":"15","artid":"785","year":2020,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1213906"},"page_start":"785","journal_title":"Pure Appl.Math.Quart."},"title":{"title":"A perturbative approach to the construction of initial data on compact manifolds"},"authors":[{"full_name":"Kroon, J.A. Valiente"},{"full_name":"Williams, J.L."}]},"raw_refs":[{"schema":"text","value":"[28] J A Valiente Kroon, J L Williams, \"A perturbative approach to the construction of initial data on compact manifolds\", Pure Appl.Math.Quart.,15,785, DOI: 10.4310/PAMQ.2019.v15.n3.a1"}],"record":{"$ref":"https://inspirehep.net/api/literature/1649951"}}],"number_of_pages":33,"preprint_date":"2023-02-08","author_count":2,"earliest_date":"2023-02-08","refereed":true,"facet_author_name":["1920205_Marica Minucci","985072_Juan Antonio Valiente-Kroon"],"license":[{"license":"CC-BY-4.0","imposing":"IOP","url":"http://creativecommons.org/licenses/by/4.0"},{"license":"CC BY 4.0","material":"preprint","url":"http://creativecommons.org/licenses/by/4.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:2630540","updated":"2025-07-22T07:25:28.368720"},"journal_title_variants":["Class. Quant. Grav.","Class.Quant.Grav."],"arxiv_eprints":[{"categories":["gr-qc","math-ph","math.MP"],"value":"2302.04004"}],"referenced_authors_bais":["R.Schoen.2","Marica.Minucci.1","V.Schlue.1","D.Hilditch.1","Helmut.Friedrich.1","E.Gasperin.1","J.A.Valiente.Kroon.1","J.L.Williams.1","A.Garicia.Parrado.Gomez.Lobo.1","R.Beig.1","P.Zhao.17","P.Hintz.1","P.T.Chrusciel.1","A.Butscher.1","C.Lubbe.2","A.Vasy.1"],"figures":[{"filename":"SubextremalSchwarzschildDeSitter.png","material":"preprint","caption":"Penrose diagram of the sub-extremal Schwarzschild-de Sitter spacetime. The serrated line denotes the location of the singularity; the continuous black line denotes the conformal boundary; the dashed line shows the location of the black hole and Cosmological horizons denoted by $\\mathcal{H}_{b}$ and $\\mathcal{H}_{c}$ respectively. As described in the main text, these horizons are located at $r=r_{b}$ and $r=r_{c}$. The excluded points $\\mathcal{Q}$ and $\\mathcal{Q'}$ where the singularity seems to meet the conformal boundary correspond to asymptotic regions of the spacetime that does not belong to the singularity nor the conformal boundary.","label":"Figure:SdSPenroseDiagram","source":"arxiv","key":"a41154357ad4606234bdd31c64324bb2","url":"https://inspirehep.net/files/a41154357ad4606234bdd31c64324bb2"},{"filename":"hypersurfaces.png","material":"preprint","caption":"Hypersurfaces with constant $r$ are plotted on the Penrose diagram of the Cosmological region of the sub-extremal Schwarzschild-de Sitter spacetime.","label":"Figure:HypersurfaceswithconstantronPenroseDiagramsSdS","source":"arxiv","key":"9d9fbee1d8a9c1d5c2f4462272ab288d","url":"https://inspirehep.net/files/9d9fbee1d8a9c1d5c2f4462272ab288d"},{"filename":"PenroseDiagramOfTheConformalGeodesicsOfsSdS.png","material":"preprint","caption":"The conformal geodesics are plotted on the Penrose diagram of the Cosmological region of the sub-extremal Schwarzschild-de Sitter spacetime. The purple line represents the initial hypersurface $\\mathcal{S}_\\star$ corresponding to $r=r_\\star$. The red lines represent conformal geodesics with constant time leaving this initial hypersurface. The curves are computed by setting $\\lambda=3$ and $\\phi=\\frac{\\pi}{4}$.","label":"Figure:PenroseDiagramConformalGeodesics","source":"arxiv","key":"d679f66d2ba06c7d8dec2b7dad8e90f0","url":"https://inspirehep.net/files/d679f66d2ba06c7d8dec2b7dad8e90f0"},{"filename":"FutureDomainOfDependenceOfTheSolutionShadedRegion.png","material":"preprint","caption":"The plotted future domain of dependence of the solution $D^+(\\mathcal{R}_\\bullet)$ on the Penrose diagram of the Cosmological region of the sub-extremal Schwarzschild-de Sitter spacetime. The value of $t_\\bullet$ can be chosen as close as possible to the asymptotic points $\\mathcal{Q}$ and $\\mathcal{Q}'$ so as to satisfy condition \\eqref{Boundtbullet}.","label":"Figure:FutureDomainofDependence","source":"arxiv","key":"34e478a2a3ddec399d0380e1c3edc30e","url":"https://inspirehep.net/files/34e478a2a3ddec399d0380e1c3edc30e"},{"filename":"FutureDomainOfDependenceWithExtension.png","material":"preprint","caption":"The red curves identify the timelike hypersurfaces $\\mathcal{T}_{-2t_\\bullet}$ and $\\mathcal{T}_{2t_\\bullet}$. The resulting spacetime manifold $\\bar{M}_\\bullet$ has compact spatial sections, $\\bar{\\mathcal{S}}_z$, with the topology of $\\mathbb{S}^1\\times\\mathbb{S}^2$.","label":"Figure:FutureDomainofDependenceWithExtension","source":"arxiv","key":"6afe6aebcb6ac4ff347881c7945cae9b","url":"https://inspirehep.net/files/6afe6aebcb6ac4ff347881c7945cae9b"}],"inspire_categories":[{"term":"Gravitation and Cosmology","source":"arxiv"},{"term":"Math and Math Physics","source":"arxiv"}],"first_author":{"emails":["m.minucci@qmul.ac.uk"],"full_name":"Minucci, Marica","last_name":"Minucci","ids":[{"schema":"ORCID","value":"0000-0002-7095-5115"},{"schema":"INSPIRE BAI","value":"Marica.Minucci.1"}],"first_name":"Marica","recid":1920205},"control_number":2630540,"dois":[{"source":"IOP","value":"10.1088/1361-6382/acdb3f"},{"material":"publication","source":"arXiv","value":"10.1088/1361-6382/acdb3f"}],"document_type":["article"],"texkeys":["Minucci:2023xcw"],"abstracts":[{"source":"IOP","value":"The non-linear stability of the sub-extremal Schwarzschild-de Sitter spacetime in the stationary region near the conformal boundary is analysed using a technique based on the extended conformal Einstein field equations and a conformal Gaussian gauge. This strategy relies on the observation that the Cosmological stationary region of this exact solution can be covered by a non-intersecting congruence of conformal geodesics. Thus, the future domain of dependence of suitable spacelike hypersurfaces in the Cosmological region of the spacetime can be expressed in terms of a conformal Gaussian gauge. A perturbative argument then allows to prove existence and stability results close to the conformal boundary and away from the asymptotic points where the Cosmological horizon intersects the conformal boundary. In particular, we show that small enough perturbations of initial data for the sub-extremal Schwarzschild-de Sitter spacetime give rise to a solution to the Einstein field equations which is regular at the conformal boundary. The analysis in this article can be regarded as a first step towards a stability argument for perturbation data on the Cosmological horizons.","abstract_source_suggest":{"input":"IOP"}},{"source":"arXiv","value":"The non-linear stability of the sub-extremal Schwarzschild-de Sitter spacetime in the stationary region near the conformal boundary is analysed using a technique based on the extended conformal Einstein field equations and a conformal Gaussian gauge. This strategy relies on the observation that the Cosmological stationary region of this exact solution can be covered by a non-intersecting congruence of conformal geodesics. Thus, the future domain of dependence of suitable spacelike hypersurfaces in the Cosmological region of the spacetime can be expressed in terms of a conformal Gaussian gauge. A perturbative argument then allows us to prove existence and stability results close to the conformal boundary and away from the asymptotic points where the Cosmological horizon intersects the conformal boundary. In particular, we show that small enough perturbations of initial data for the sub-extremal Schwarzschild-de Sitter spacetime give rise to a solution to the Einstein field equations which is regular at the conformal boundary. The analysis in this article can be regarded as a first step towards a stability argument for perturbation data on the Cosmological horizons.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"source":"IOP","title":"On the non-linear stability of the Cosmological region of the Schwarzschild-de Sitter spacetime"},{"source":"arXiv","title":"On the non-linear stability of the Cosmological region of the Schwarzschild-de Sitter spacetime"}],"imprints":[{"date":"2023-06-20"}],"curated":false}},{"links":{"bibtex":"https://inspirehep.net/api/literature/1512767?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1512767?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1512767?format=latex-us","json":"https://inspirehep.net/api/literature/1512767?format=json","json-expanded":"https://inspirehep.net/api/literature/1512767?format=json-expanded","cv":"https://inspirehep.net/api/literature/1512767?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1512767"},"created":"2017-02-10T00:00:00+00:00","id":"1512767","updated":"2023-10-03T08:44:48.794224+00:00","metadata":{"citation_count":66,"publication_info":[{"journal_volume":"116","page_end":"541","year":2020,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214449"},"page_start":"481","journal_issue":"3","journal_title":"J.Diff.Geom."}],"citation_count_without_self_citations":59,"authors":[{"full_name_unicode_normalized":"hung, pei-ken","full_name":"Hung, Pei-Ken","record":{"$ref":"https://inspirehep.net/api/authors/1972117"},"last_name":"Hung","ids":[{"schema":"INSPIRE BAI","value":"P.K.Hung.1"}],"signature_block":"HANGp","first_name":"Pei-Ken","uuid":"97a60f6f-4777-4b2c-b5f8-c321d84a1879","recid":1972117},{"full_name_unicode_normalized":"keller, jordan","full_name":"Keller, Jordan","record":{"$ref":"https://inspirehep.net/api/authors/1922584"},"last_name":"Keller","ids":[{"schema":"INSPIRE BAI","value":"J.Keller.5"}],"signature_block":"CALARj","first_name":"Jordan","uuid":"2b9033a6-a728-4a81-bd1d-9c0edb4771f7","recid":1922584},{"full_name_unicode_normalized":"wang, mu-tao","full_name":"Wang, Mu-Tao","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/1056587"},"last_name":"Wang","ids":[{"schema":"INSPIRE BAI","value":"Mu.Tao.Wang.1"}],"signature_block":"WANGm","first_name":"Mu-Tao","uuid":"c522cfa0-dd64-474d-8eac-5de5e7bec4a3","recid":1056587}],"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","references":[{"reference":{"texkey":"Aksteiner","arxiv_eprint":"1611.08291","label":"1","publication_info":{"year":2016},"misc":["Gauge-invariant perturbations of Schwarzschild spacetime. arXiv preprint,. arXiv"],"authors":[{"full_name":"Aksteiner, S."},{"full_name":"Andersson, L."},{"full_name":"Bäckdahl, T."