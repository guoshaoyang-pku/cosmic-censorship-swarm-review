{"uuid":"f74880f6-d2c5-461a-a902-1a20361b10ee","created":"1992-12-11T00:00:00+00:00","revision_id":95,"updated":"2023-03-07T04:30:36.018657+00:00","metadata":{"citation_count":1376,"report_numbers":[{"value":"FPRINT-92-33"}],"publication_info":[{"year":1993,"page_end":"12","page_start":"9","journal_title":"Phys.Rev.Lett.","journal_record":{"$ref":"https://inspirehep.net/api/journals/1214495"},"journal_volume":"70"}],"citation_count_without_self_citations":1346,"core":true,"dois":[{"value":"10.1103/PhysRevLett.70.9"}],"titles":[{"title":"Universality and scaling in gravitational collapse of a massless scalar field"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"46349a46-63c2-4c64-bb16-0ad647b26a54","record":{"$ref":"https://inspirehep.net/api/authors/1013622"},"full_name":"Choptuik, Matthew W.","affiliations":[{"value":"Texas U.","record":{"$ref":"https://inspirehep.net/api/institutions/903264"}}],"signature_block":"CAPTACm"}],"curated":true,"texkeys":["Choptuik:1992jv"],"citeable":true,"keywords":[{"value":"field theory: scalar","schema":"INSPIRE"},{"value":"massless","schema":"INSPIRE"},{"value":"gravitation","schema":"INSPIRE"},{"value":"universality","schema":"INSPIRE"},{"value":"scaling","schema":"INSPIRE"},{"value":"black hole: mass","schema":"INSPIRE"},{"value":"mass: black hole","schema":"INSPIRE"},{"value":"boundary condition","schema":"INSPIRE"},{"value":"numerical calculations","schema":"INSPIRE"}],"refereed":true,"abstracts":[{"value":"I summarize results from a numerical study of spherically symmetric collapse of a massless scalar field. I consider families of solutions, scrS[p], with the property that a critical parameter value, p*, separates solutions containing black holes from those which do not. I present evidence in support of conjectures that (1) the strong-field evolution in the p→p* limit is universal and generates structure on arbitrarily small spatiotemporal scales and (2) the masses of black holes which form satisfy a power law MBH∝‖p-p*‖γ, where γ≊0.37 is a universal exponent.","source":"APS"}],"references":[{"record":{"$ref":"https://inspirehep.net/api/literature/234090"},"reference":{"publication_info":{"artid":"337","page_start":"337","journal_title":"Commun.Math.Phys.","journal_volume":"105"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/237765"},"reference":{"publication_info":{"artid":"587","page_start":"587","journal_title":"Commun.Math.Phys.","journal_volume":"106"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/249213"},"reference":{"publication_info":{"artid":"591","page_start":"591","journal_title":"Commun.Math.Phys.","journal_volume":"109"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/249214"},"reference":{"publication_info":{"artid":"613","page_start":"613","journal_title":"Commun.Math.Phys.","journal_volume":"109"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/245066"},"reference":{"publication_info":{"artid":"3575","page_start":"3575","journal_title":"Phys.Rev.D","journal_volume":"36"}},"curated_relation":false},{"reference":{"publication_info":{"artid":"11","page_start":"11","journal_title":"J.Comput.Phys.","journal_volume":"98"}}},{"record":{"$ref":"https://inspirehep.net/api/literature/339835"},"reference":{"publication_info":{"artid":"1445","page_start":"1445","journal_title":"J.Math.Phys.","journal_volume":"33"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/212710"},"reference":{"publication_info":{"artid":"484","page_start":"484","journal_title":"J.Comput.Phys.","journal_volume":"53"}},"curated_relation":false}],"document_type":["article"],"preprint_date":"1992-12-11","control_number":33714,"legacy_version":"20160616172704.0","number_of_pages":12,"legacy_creation_date":"1992-12-11","external_system_identifiers":[{"value":"1993PhRvL..70....9C","schema":"ADS"},{"value":"SPIRES-2657724","schema":"SPIRES"}]},"links":{"bibtex":"https://inspirehep.net/api/literature/33714?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/33714?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/33714?format=latex-us","json":"https://inspirehep.net/api/literature/33714?format=json","json-expanded":"https://inspirehep.net/api/literature/33714?format=json-expanded","cv":"https://inspirehep.net/api/literature/33714?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A33714"},"id":"33714"}