e":"736","artid":"455","year":2014,"page_start":"455","journal_title":"Phys.Lett.B"},"misc":["Exact black hole formation in asymptotically (A)dS and flat spacetimes"],"authors":[{"full_name":"Zhang, X."},{"full_name":"Lü, H."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1287616"}},{"reference":{"label":"32","publication_info":{"journal_volume":"50","artid":"7260","year":1994,"page_start":"7260","journal_title":"Phys.Rev.D"},"misc":["Global properties of static spherically symmetric charged dilaton spacetimes with a Liouville potential"],"authors":[{"full_name":"Poletti, S.J."},{"full_name":"Wiltshire, D.L."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/38751"}},{"reference":{"label":"33","publication_info":{"journal_volume":"447","artid":"441","year":1995,"page_start":"441","journal_title":"Nucl.Phys.B"},"misc":["Charged dilaton black holes with unusual asymptotics"],"authors":[{"full_name":"Chan, K.C.K."},{"full_name":"Horne, J.H."},{"full_name":"Mann, R.B."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/393055"}},{"reference":{"label":"34","publication_info":{"journal_volume":"70","artid":"084042","year":2004,"journal_title":"Phys.Rev.D"},"misc":["Nonasymptotically AdS/dS solutions and their higher dimensional origins"],"authors":[{"full_name":"Cai, R.-G."},{"full_name":"Wang, A."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/651745"}},{"reference":{"label":"35","publication_info":{"journal_volume":"6","artid":"987","year":1989,"page_start":"987","journal_title":"Class.Quant.Grav."},"misc":["Spherically symmetric solutions in dimensionally reduced spacetimes"],"authors":[{"full_name":"Mignemi, S."},{"full_name":"Wiltshire, D.L."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/267835"}},{"reference":{"arxiv_eprint":"1509.07956","label":"36","publication_info":{"year":2015},"misc":["Examples of naked singularity formation in higher-dimensional Einstein-vacuum spacetimes"],"authors":[{"full_name":"An, X."},{"full_name":"Zhang, X."},{"full_name":"Lü, H."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1395073"}}],"number_of_pages":24,"legacy_creation_date":"2018-02-06","preprint_date":"2015-09-26","author_count":2,"public_notes":[{"source":"arXiv","value":"24 pages, 6 figures; minor changes, more references added"}],"earliest_date":"2015-09-26","facet_author_name":["1939597_Xingtao An","1942677_Xiao-Feng Zhang"],"core":true,"license":[{"license":"arXiv nonexclusive-distrib 1.0","material":"preprint","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1653105","updated":"2025-09-05T08:23:20.042316"},"arxiv_eprints":[{"categories":["gr-qc","hep-th"],"value":"1509.07954"}],"referenced_authors_bais":["N.Bedjaoui.1","R.B.Mann.1","Jerome.Novak.1","J.H.Horne.1","M.W.Choptuik.1","C.Gundlach.1","D.L.Wiltshire.1","V.V.Frolov.1","C.M.Chambers.1","X.An.1","B.E.W.Nilsson.1","Kengo.Maeda.1","J.M.Overduin.1","Rong.Gen.Cai.1","D.Garfinkle.1","G.T.Horowitz.1","J.M.Martin.Garcia.1","X.F.Zhang.2","S.J.Poletti.1","Michael.J.Duff.1","Hong.Lu.2","A.D.Rendall.1","E.P.Honda.1","P.S.Wesson.1","P.Langfelder.2","P.Kraus.1","K.C.K.Chan.1","M.Dafermos.1","S.Mignemi.1","C.N.Pope.1","P.G.LeFloch.1","B.J.Carr.1","J.J.Halliwell.1","M.Gutperle.1","Paul.K.Townsend.1","S.H.Hawley.2","An.Zhong.Wang.1","Demetrios.Christodoulou.1","P.R.Brady.1","R.M.Wald.1","A.A.Coley.1","T.Hertog.1","R.Penrose.1","S.M.C.V.Goncalves.3"],"figures":[{"filename":"1V.png","caption":"width=0.48\\textwidth","source":"arxiv","key":"3510f08344999b03151120dfd71c0d4c","url":"https://inspirehep.net/files/3510f08344999b03151120dfd71c0d4c"},{"filename":"1Va.png","caption":"width=0.48\\textwidthNumerical integration with $\\kappa=1.2$. The right plot shows the back view of the left. Green ($c_T&gt;\\kappa^2/3$, $V_0=1$, cf. (\\ref{V0_cT})), blue, and cyan ($c_T&lt;\\kappa^2/3$, $V_0=-1$) curves emanating from $\\mathcal{O}$ are members of the 1-parameter family of solutions of the system (\\ref{ode1}-\\ref{ode3}) subject to (\\ref{IV}) and (\\ref{IV1}). The negatively unstable manifold of $\\mathcal{O}$ and the unstable manifold of $\\mathcal{P}_1$ are marked by red curves. The blue curve ($c_T=\\kappa^2/3$, $V_0=0$) ending at $\\mathcal{P}_1$ delineates the unique massless solution. The maroon curve represents the set of singular points $\\mathcal{P}_s(y)$ with $\\zeta=1/2$.","source":"arxiv","key":"7ad812085b4d11ffa9f95f0626ed5a1e","url":"https://inspirehep.net/files/7ad812085b4d11ffa9f95f0626ed5a1e"},{"filename":"2V.png","caption":"width=0.48\\textwidth","source":"arxiv","key":"5a462776f4f6b596a8c45a2b95c7a1ff","url":"https://inspirehep.net/files/5a462776f4f6b596a8c45a2b95c7a1ff"},{"filename":"2Va.png","caption":"width=0.48\\textwidthNumerical integration with $\\kappa=0.5$ (roughly front and back views). Integral curves from $\\mathcal{O}$ may reach the singular curve $\\mathcal{P}_s(y)$ (maroon). Particularly, the blue ($V_0=0$) curve attaining $\\mathcal{P}_{sc}$ is the unique massless interior solution interpolating between green ($V_0=1$) and cyan ($V_0=-1$) curves. In the region $\\zeta&gt;1/2$, curves drawn from $\\mathcal{P}_{\\pm}$ and $\\mathcal{P}_{sc}$ are continuations of the interior solutions. The two purple curves terminating at $\\mathcal{P}_{-1}$ separate naked singularity solutions and black hole solutions. The red curve passing through $\\mathcal{P}_1$ ($\\mathcal{P}_{-1}$) with one end reaching $\\mathcal{P}_0(y)$ represents the unstable manifold of $\\mathcal{P}_1$ ($\\mathcal{P}_{-1}$) in the massless phase subspace (\\ref{eqaml}).","source":"arxiv","key":"3ec974df55a032df433bf3b4d152022e","url":"https://inspirehep.net/files/3ec974df55a032df433bf3b4d152022e"},{"filename":"3V.png","caption":"width=0.48\\textwidth","source":"arxiv","key":"d4a505087923e638fe07248ad97aaff7","url":"https://inspirehep.net/files/d4a505087923e638fe07248ad97aaff7"},{"filename":"3Va.png","caption":"width=0.48\\textwidthNumerical integration with $\\kappa=0.7$ (roughly upper front and back views). Behavior of the green ($V_0=1$) and cyan ($V_0=-1$) curves are similar to those in Fig. \\ref{fig2}. However, for massless solutions, the blue curves and the unstable manifold of $\\mathcal{P}_1$ (red curve) no longer extend to the singular line $\\mathcal{P}_0(y)$, indicating that naked singularities cease to occur.","source":"arxiv","key":"ec1690a1ec7d6797a263236e0ab1c6e5","url":"https://inspirehep.net/files/ec1690a1ec7d6797a263236e0ab1c6e5"}],"legacy_version":"20180602173924.0","inspire_categories":[{"term":"Gravitation and Cosmology","source":"arxiv"},{"term":"Theory-HEP","source":"arxiv"},{"term":"Gravitation and Cosmology"},{"term":"Theory-HEP"}],"first_author":{"emails":["zxf@unm.edu"],"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/022k4wk35"}],"full_name":"Zhang, Xuefeng","last_name":"Zhang","first_name":"Xuefeng","recid":1942677},"control_number":1653105,"document_type":["article"],"texkeys":["Zhang:2015qku"],"abstracts":[{"source":"arXiv","value":"Motivated by cosmic censorship in general relativity and string theory, we extend Christodoulou's celebrated examples of naked singularity formation in the Einstein-massless scalar field system to include a positive or negative scalar potential of exponential forms, i.e., $V(\\phi)=\\pm\\exp(2\\phi/\\kappa)$ with a parameter $\\kappa$. Under spherical symmetry and a self-similar ansatz depending on $\\kappa$, we derive a 3-dimensional autonomous system of first-order ordinary differential equations, which incorporates the equations for massless scalar fields as a special case. Local behavior of the phase space is studied analytically with global solutions constructed numerically. Within the 3-dimensional solution manifold, we observe, for the negative potentials, naked singularity formation from nonsingular initial data for $\\kappa^2<1$. Meanwhile, transitions between solutions containing naked singularities and black holes are also identified. However, when the potential is taken positive, numerical evolutions result in formation of black holes, but not naked singularities.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"source":"arXiv","title":"Naked singularity and black hole formation in self-similar Einstein-scalar fields with exponential potentials"}],"curated":true},"created":"2018-02-06T00:00:00+00:00","id":"1653105","updated":"2025-09-05T08:23:20.042316+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/1653105?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1653105?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1653105?format=latex-us","json":"https://inspirehep.net/api/literature/1653105?format=json","json-expanded":"https://inspirehep.net/api/literature/1653105?format=json-expanded","cv":"https://inspirehep.net/api/literature/1653105?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1653105"}}],"total":23},"links":{"self":"https://inspirehep.net/api/literature/?q=...Examples%20of%20naked%20singularity%20formation...&size=10&page=1","next":"https://inspirehep.net/api/literature/?q=...Examples%20of%20naked%20singularity%20formation...&size=10&page=2","bibtex":"https://inspirehep.net/api/literature/?q=...Examples%20of%20naked%20singularity%20formation...&size=10&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=...Examples%20of%20naked%20singularity%20formation...&size=10&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=...Examples%20of%20naked%20singularity%20formation...&size=10&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=...Examples%20of%20naked%20singularity%20formation...&size=10&page=1&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=...Examples%20of%20naked%20singularity%20formation...&size=10&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=...Examples%20of%20naked%20singularity%20formation...&size=10&page=1&format=cv"}}