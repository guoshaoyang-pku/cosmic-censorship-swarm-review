],"earliest_date":"2024-02-05","refereed":true,"facet_author_name":["1854908_Evita Verheijden","1069642_Netta Engelhardt","1423018_Adam R. Levine","1726194_Åsmund Folkestad","2636092_Lisa Yang"],"core":true,"license":[{"license":"CC-BY-4.0","imposing":"Springer","url":"http://creativecommons.org/licenses/by/4.0/"},{"license":"arXiv nonexclusive-distrib 1.0","material":"preprint","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:2756007","updated":"2026-02-13T04:03:01.435682"},"journal_title_variants":["JHEP"],"arxiv_eprints":[{"categories":["hep-th","gr-qc","quant-ph"],"value":"2402.03425"}],"referenced_authors_bais":["Seth.Lloyd.1","M.W.Choptuik.1","Andrei.D.Linde.1","J.Preskill.1","S.A.Teukolsky.1","R.Mahajan.3","D.N.Page.1","I.S.Madjarov.1","G.Lifschytz.1","L.F.Abbott.1","Thomas.Faulkner.1","A.Kale.1","A.M.Kubicki.1","I.H.Kim.1","J.Szeftel.2","Mark.B.Wise.1","D.A.Linde.1","D.Harlow.1","Hong.Liu.1","Cumrun.Vafa.1","I.M.Khalatnikov.1","S.Choi.13","R.Emparan.1","M.Shigemori.1","H.Gharibyan.1","P.M.Chesler.1","X.Xie.19","A.Strominger.1","D.K.Mark.1","Gaurav.Katoch.1","V.A.Belinsky.2","B.Fefferman.1","M.Tezuka.1","S.H.Shenker.1","A.Nicolis.1","A.C.Wall.1","G.T.Horowitz.1","F.G.S.L.Brandao.3","P.Ananth.1","D.Stanford.1","J.Sully.1","G.Gur.Ari.1","R.E.Kallosh.1","L.Susskind.1","Venkatesa.Chandrasekaran.1","L.Motl.1","M.Hanada.1","E.Giorgi.1","D.PerezGarcia.3","A.J.Hamilton.1","Nicholas.P.Warner.1","J.E.Santos.1","D.M.Marolf.1","B.Ganchev.1","F.Kaleoglu.1","H.Pichler.1","Demetrios.Christodoulou.1","J.Lin.4","F.Eperon.1","S.Chen.9","D.J.Turton.1","Y.B.Zeldovich.1","W.W.Ho.1","P.Hayden.1","Hua.Jia.Wang.1","B.Way.1","Geoffrey.R.Penington.1","M.Endres.3","Juan.M.Maldacena.1","Alex.May.1","S.Leichenauer.1","S.R.Roy.1","Daniel.A.Roberts.1","David.A.Lowe.1","A.Gulati.1","A.L.Shaw.1","U.Vazirani.1","S.Klainerman.1","Stefano.Giusto.1","S.Fischetti.1","A.R.Brown.1","Min.Li.1","R.Laflamme.1","Rodolfo.Russo.1","T.Crisford.1","R.Bousso.1","A.Bouland.1","Stephen.W.Hawking.1","F.Pretorius.1","P.Saad.1","W.van.der.Schee.1","L.Lehner.1","D.N.Kabat.1","N.Engelhardt.1","E.Verheijden.1","Hsin.Yuan.Huang.1","J.Polchinski.1","Iosif.Bena.1","R.Penrose.1","Adam.R.Levine.1","Jie.Ren.2","W.Fang.3","Z.Zhang.124","R.P.Geroch.1","J.J.Liu.2","R.Gregory.1","S.Vardhan.1","J.J.Choi.1","E.Tang.2","L.Yang.114","Nima.Arkani.Hamed.1","E.M.Lifshitz.1","A.Streicher.1","A.Almheiri.1","Asmund.Folkestad.1","A.Shahbazi.Moghaddam.1","S.Shapiro.1","Samuel.Leutheusser.1","M.Ying.1","Kristan.Jensen.1","E.J.Martinec.1","Q.Wang.22","Beni.Yoshida.1","Robert.J.Finkelstein.1","J.P.Covey.1","Ju.Guan.1","Chris.Akers.1","Jordan.Cotler.1","M.Usatyuk.1","K.Chen.9","Zachary.Fisher.1","E.Shaghoulian.1"],"figures":[{"filename":"Endpoint-evap.png","material":"preprint","caption":"The evaporation point of a black hole is, in some sense that we make precise in Sec.~\\ref{sec:size-of-sings}, ``small''.","label":"fig:endpoint-evap","source":"arxiv","key":"81c113b81b8b2f82e26eafd3963cfe1c","url":"https://inspirehep.net/files/81c113b81b8b2f82e26eafd3963cfe1c"},{"filename":"Pythons-Lunch-both-panels.png","material":"preprint","caption":"A spacetime with a Python's Lunch. In the Penrose diagram on the left, the lunch, causal wedge ($\\mathcal{W}_{\\rm C}$) and the wedge of the outermost QES ($\\mathcal{W}_{\\rm O}$) are indicated. The left and right green dots are the minimal and outermost QES, respectively. The right panel depicts a timeslice.","label":"fig:PL","source":"arxiv","key":"06685039466e13d33ccc11528439294e","url":"https://inspirehep.net/files/06685039466e13d33ccc11528439294e"},{"filename":"QES-observer.png","material":"preprint","caption":"A forbidden situation: a QES in causal contact with the boundary.","label":"fig:QES-observer","source":"arxiv","key":"bc49af788b6ad046173dec2da84c2567","url":"https://inspirehep.net/files/bc49af788b6ad046173dec2da84c2567"},{"filename":"Null-geodesic-incompletenss.png","material":"preprint","caption":"An example where null geodesics fired from $\\chi$ are geodesically incomplete, but there is no horizon.","label":"fig:excised-points","source":"arxiv","key":"1bdea781b8255296f8e3f59228accb41","url":"https://inspirehep.net/files/1bdea781b8255296f8e3f59228accb41"},{"filename":"Unitary-invariance.png","material":"preprint","caption":"A QES outside the horizon, leading to a contradiction with the unitary invariance of von Neumann entropy: $S_{\\rm vN}[\\rho_{\\mathscr{I}}] = S_{\\rm vN}[U^{\\dag}\\rho_{\\mathscr{I}} U]$.","label":"fig:Sinv","source":"arxiv","key":"6c4c86adddcda00e1c38f50e0dcaf9fc","url":"https://inspirehep.net/files/6c4c86adddcda00e1c38f50e0dcaf9fc"},{"filename":"DoD.png","material":"preprint","caption":"The setup in the proof of Theorem~\\ref{thm:warmup} where $\\chi$ is nonminimal, and where $H$ is chosen to contain $\\chi$.","label":"fig:DoD","source":"arxiv","key":"71eba9d32064d585a4c8fe32fb9eb4e2","url":"https://inspirehep.net/files/71eba9d32064d585a4c8fe32fb9eb4e2"},{"filename":"HKLL-argument.png","material":"preprint","caption":"In the leftmost and middle panels, the reconstruction of operators inside the green wedge (which is globally hyperbolic) can be done using the HKLL protocol, which should be simple, insofar as we can compute the expectation values of local operators in the boundary theory on the time band $\\Delta t$. We can keep doing this for subsequent time bands until we have reconstructed the full causal wedge, as in the rightmost panel. We use this as an ingredient to motivate the existence of an algorithm that can output an operator $V$ which reproduces the time evolution of operators in the causal wedge.","label":"fig:HKLL-argument","source":"arxiv","key":"9f1fe720ab1c169bc5e7c26d2b5245de","url":"https://inspirehep.net/files/9f1fe720ab1c169bc5e7c26d2b5245de"},{"filename":"cylindrical-sing.png","material":"preprint","caption":"The region of spacetime inside this cylindrical naked singularity does not lie inside of any HKLL wedge. It is possible, however, for a rocket ship to enter the region behind the singularity and come back out to the boundary.","label":"fig:cylindrical-sing","source":"arxiv","key":"cbc00e54563c5a182eb9bcc44e0c5b77","url":"https://inspirehep.net/files/cbc00e54563c5a182eb9bcc44e0c5b77"},{"filename":"thm5-new.png","material":"preprint","caption":"By assumption, the time evolution operator $U_{\\rm fund, N} = e^{-i H_N \\Delta t}$ on $\\Hil_{\\rm code}$ over a time $\\Delta t$ is well approximated by some $U_N \\gets \\PRUens_N$, such that $\\ket{\\psi_N (t')}$ is typical in the PRS ensemble $\\Psi = \\PRUens_N \\ket{\\psi_N (t)}$. In this case, Theorem~\\ref{thm:pseudorandom-horizons} guarantees the existence of a distinguishing operator $Q_*$ that has support outside the causal wedge: there must be a horizon (indicated by the green dotted line).","label":"fig:thm5","source":"arxiv","key":"ff55f39432264e2658da41d310800c4b","url":"https://inspirehep.net/files/ff55f39432264e2658da41d310800c4b"},{"filename":"Tubular-region.png","material":"preprint","caption":"Example spacetime where the colored sheet represents a singularity. The two geodesics $\\gamma_{p, v}$ and $\\gamma_{ \\tilde{p}, \\tilde{v} }$ by definition end on the same singular point, since $\\gamma_{\\tilde{p}, \\tilde{v}}$ must enter any tubular neighborhood of $\\gamma_{p, v}$, and vice versa.","label":"fig:Tubular-region","source":"arxiv","key":"024168b806832b64054349bedba291de","url":"https://inspirehep.net/files/024168b806832b64054349bedba291de"},{"filename":"Timelike-naked-singularity.png","material":"preprint","caption":"Some examples of spacetimes with (naked) singularities. In (a) the singularity is timelike and classically naked. Panel (b) depicts the evaporating black hole. The non-naked part of the singularity is classical and behind a horizon. For the naked part, see Fig.~\\ref{fig:endpoint-evap-non-example}. Panel (c) is Reissner--Nordstr\\\"om-AdS; here $|\\Gamma|_{\\mathscr{I}} = |T_-|$; note, however, that $\\Gamma_{n(\\mathscr{I})} = \\varnothing$, as $I^{\\pm} \\cap \\mathscr{I} = \\varnothing$.","label":"fig:sings-examples","source":"arxiv","key":"7b359038458c5f9acfbd2b0aee899a4c","url":"https://inspirehep.net/files/7b359038458c5f9acfbd2b0aee899a4c"},{"filename":"Schwarzschild-singularity.png","material":"preprint","caption":"Some examples of spacetimes with (naked) singularities. In (a) the singularity is timelike and classically naked. Panel (b) depicts the evaporating black hole. The non-naked part of the singularity is classical and behind a horizon. For the naked part, see Fig.~\\ref{fig:endpoint-evap-non-example}. Panel (c) is Reissner--Nordstr\\\"om-AdS; here $|\\Gamma|_{\\mathscr{I}} = |T_-|$; note, however, that $\\Gamma_{n(\\mathscr{I})} = \\varnothing$, as $I^{\\pm} \\cap \\mathscr{I} = \\varnothing$.","label":"fig:sings-examples","source":"arxiv","key":"7aae3fdf715a6cfa8ee642ce63505ea7","url":"https://inspirehep.net/files/7aae3fdf715a6cfa8ee642ce63505ea7"},{"filename":"RN-AdS-non-example.png","material":"preprint","caption":"Some examples of spacetimes with (naked) singularities. In (a) the singularity is timelike and classically naked. Panel (b) depicts the evaporating black hole. The non-naked part of the singularity is classical and behind a horizon. For the naked part, see Fig.~\\ref{fig:endpoint-evap-non-example}. Panel (c) is Reissner--Nordstr\\\"om-AdS; here $|\\Gamma|_{\\mathscr{I}} = |T_-|$; note, however, that $\\Gamma_{n(\\mathscr{I})} = \\varnothing$, as $I^{\\pm} \\cap \\mathscr{I} = \\varnothing$.","label":"fig:sings-examples","source":"arxiv","key":"438343fdc98619b3675481e609158c39","url":"https://inspirehep.net/files/438343fdc98619b3675481e609158c39"},{"filename":"Small-singularity-v2.png","material":"preprint","caption":"To get all information about the small singularity $\\Gamma$, we only need to evolve the state forwards in a small spatial subregion of the boundary Cauchy slice, such that the Wheeler--de Witt patch now includes the singularity. Note that, as our artistic capabilities are limited, we here only indicate the future boundaries of the Wheeler--de Witt patches for times $t$ and $t+\\delta t$.","label":"fig:small-sing","source":"arxiv","key":"8d11bfc7df97ba13b9b4d3dcf8f56818","url":"https://inspirehep.net/files/8d11bfc7df97ba13b9b4d3dcf8f56818"},{"filename":"Evaporation-endpoint.png","material":"preprint","caption":"Two examples of $\\lim_{\\ell_{\\rm Pl} \\rightarrow 0}|\\hat{\\Gamma}|_{\\mathscr{I}}=0$: (a) For the naked part of the singularity at the endpoint of black hole evaporation, we expect that $T_{\\pm}$ are just timeslices in the $G_N \\to 0$ limit. (b) A `hidden' naked timelike singularity; here, $T_{\\pm} = \\varnothing$.","label":"fig:hidden-sing","source":"arxiv","key":"abfb63e9fde7693806cf739fd992b6ec","url":"https://inspirehep.net/files/abfb63e9fde7693806cf739fd992b6ec"},{"filename":"Hidden-singularity.png","material":"preprint","caption":"Two examples of $\\lim_{\\ell_{\\rm Pl} \\rightarrow 0}|\\hat{\\Gamma}|_{\\mathscr{I}}=0$: (a) For the naked part of the singularity at the endpoint of black hole evaporation, we expect that $T_{\\pm}$ are just timeslices in the $G_N \\to 0$ limit. (b) A `hidden' naked timelike singularity; here, $T_{\\pm} = \\varnothing$.","label":"fig:hidden-sing","source":"arxiv","key":"b3757ef9646805ee2c414784f1276b9e","url":"https://inspirehep.net/files/b3757ef9646805ee2c414784f1276b9e"},{"filename":"Toy-model-2.png","material":"preprint","caption":"From the low-energy perspective, there is an unknown, UV-sensitive boundary condition assigned at the singularity.","label":"fig:toy-model","source":"arxiv","key":"9f789c2d51a1ce3767ca95d8e280d6ec","url":"https://inspirehep.net/files/9f789c2d51a1ce3767ca95d8e280d6ec"},{"filename":"Mode-counting.png","material":"preprint","caption":"To count the ingoing modes sent from $T_-$, which here is the time band $[-\\Delta t, 0]\\times S^{d-1}$, we can simple count the number of modes in the strip indicated by the red dotted line.","label":"fig:mode-counting","source":"arxiv","key":"9da81f1236fd28c2ab088c2fa97c022e","url":"https://inspirehep.net/files/9da81f1236fd28c2ab088c2fa97c022e"},{"filename":"AdS-cosmology.png","material":"preprint","caption":"The AdS-big-crunch cosmology (a) versus the flat big-bang cosmology (b). In the asymptotically flat case, there is no notion of unitary time evolution and no horizon. In the AdS case, we have both.","label":"fig:cosmologies","source":"arxiv","key":"9523cf71073dfdfbfee292c0dedcacc8","url":"https://inspirehep.net/files/9523cf71073dfdfbfee292c0dedcacc8"},{"filename":"flat-space-cosmology.png","material":"preprint","caption":"The AdS-big-crunch cosmology (a) versus the flat big-bang cosmology (b). In the asymptotically flat case, there is no notion of unitary time evolution and no horizon. In the AdS case, we have both.","label":"fig:cosmologies","source":"arxiv","key":"61922575c7d97d00987c19df29037af0","url":"https://inspirehep.net/files/61922575c7d97d00987c19df29037af0"}],"inspire_categories":[{"term":"Theory-HEP","source":"arxiv"},{"term":"Gravitation and Cosmology","source":"arxiv"},{"term":"Quantum Physics","source":"arxiv"}],"first_author":{"emails":["engeln@mit.edu"],"affiliations_identifiers":[{"schema":"GRID","value":"grid.116068.8"},{"schema":"ROR","value":"https://ror.org/042nb2s44"}],"full_name":"Engelhardt, Netta","ids":[{"schema":"ORCID","value":"0000-0003-2601-2950"},{"schema":"INSPIRE BAI","value":"N.Engelhardt.1"}],"last_name":"Engelhardt","first_name":"Netta","recid":1069642},"control_number":2756007,"dois":[{"source":"Springer","value":"10.1007/JHEP01(2025)122"}],"document_type":["article"],"texkeys":["Engelhardt:2024hpe"],"abstracts":[{"source":"Springer","value":"We formulate and take two large strides towards proving a quantum version of the weak cosmic censorship conjecture. We first prove “Cryptographic Censorship”: a theorem showing that when the time evolution operator of a holographic CFT is approximately pseudorandom (or Haar random) on some code subspace, then there must be an event horizon in the corresponding bulk dual. This result provides a general condition that guarantees (in finite time) event horizon formation, with minimal assumptions about the global spacetime structure. Our theorem relies on an extension of a recent quantum learning no-go theorem and is proved using new techniques of pseudorandom measure concentration. To apply this result to cosmic censorship, we separate singularities into classical, semi-Planckian, and Planckian types. We illustrate that classical and semi-Planckian singularities are compatible with approximately pseudorandom CFT time evolution; thus, if such singularities are indeed approximately pseudorandom, by Cryptographic Censorship, they cannot exist in the absence of event horizons. This result provides a sufficient condition guaranteeing that seminal holographic results on quantum chaos and thermalization, whose general applicability relies on typicality of horizons, will not be invalidated by the formation of naked singularities in AdS/CFT.","abstract_source_suggest":{"input":"Springer"}},{"source":"arXiv","value":"We formulate and take two large strides towards proving a quantum version of the weak cosmic censorship conjecture. We first prove \"Cryptographic Censorship\": a theorem showing that when the time evolution operator of a holographic CFT is approximately pseudorandom (or Haar random) on some code subspace, then there must be an event horizon in the corresponding bulk dual. This result provides a general condition that guarantees (in finite time) event horizon formation, with minimal assumptions about the global spacetime structure. Our theorem relies on an extension of a recent quantum learning no-go theorem and is proved using new techniques of pseudorandom measure concentration. To apply this result to cosmic censorship, we separate singularities into classical, semi-Planckian, and Planckian types. We illustrate that classical and semi-Planckian singularities are compatible with approximately pseudorandom CFT time evolution; thus, if such singularities are indeed approximately pseudorandom, by Cryptographic Censorship, they cannot exist in the absence of event horizons. This result provides a sufficient condition guaranteeing that seminal holographic results on quantum chaos and thermalization, whose general applicability relies on typicality of horizons, will not be invalidated by the formation of naked singularities in AdS/CFT.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["hep-th"],"titles":[{"source":"Springer","title":"Cryptographic Censorship"},{"source":"arXiv","title":"Cryptographic Censorship"}],"imprints":[{"date":"2025-01-23"}],"curated":false},"created":"2024-02-07T03:47:28.805489+00:00","id":"2756007","updated":"2026-02-13T04:03:01.435682+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/2756007?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/2756007?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/2756007?format=latex-us","json":"https://inspirehep.net/api/literature/2756007?format=json","json-expanded":"https://inspirehep.net/api/literature/2756007?format=json-expanded","cv":"https://inspirehep.net/api/literature/2756007?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2756007"}},{"metadata":{"citation_count":1,"citation_count_without_self_citations":1,"authors":[{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/022k4wk35"}],"full_name_unicode_normalized":"zhang, xuefeng","full_name":"Zhang, Xuefeng","record":{"$ref":"https://inspirehep.net/api/authors/1942677"},"ids":[{"schema":"INSPIRE BAI","value":"X.F.Zhang.2"}],"last_name":"Zhang","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903922"},"value":"Beijing Normal U."}],"signature_block":"ZANGx","first_name":"Xuefeng","uuid":"01d5f57c-e216-4903-bb0f-d10a4cf1412b","recid":1942677},{"full_name_unicode_normalized":"an, xinliang","full_name":"An, Xinliang","record":{"$ref":"https://inspirehep.net/api/authors/1939597"},"ids":[{"schema":"INSPIRE BAI","value":"X.An.1"}],"last_name":"An","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/1269376"},"value":"Rutgers U., Piscataway, Dept. Math."}],"signature_block":"ANx","first_name":"Xinliang","uuid":"71419a6b-1cfb-4a94-9a03-92b7f7a783fc","recid":1939597}],"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","keywords":[{"schema":"INSPIRE","value":"singularity: formation"},{"schema":"INSPIRE","value":"black hole: formation"},{"schema":"INSPIRE","value":"field theory: scalar"},{"schema":"INSPIRE","value":"potential: negative"},{"schema":"INSPIRE","value":"potential: scalar"},{"schema":"INSPIRE","value":"symmetry: rotation"},{"schema":"INSPIRE","value":"differential equations"},{"schema":"INSPIRE","value":"boundary condition"},{"schema":"INSPIRE","value":"general relativity"},{"schema":"INSPIRE","value":"cosmic censorship"},{"schema":"INSPIRE","value":"string model"},{"schema":"INSPIRE","value":"phase space"}],"references":[{"reference":{"label":"1","publication_info":{"journal_volume":"1","artid":"252","year":1969,"page_start":"252","journal_title":"Riv.Nuovo Cim."},"misc":["Gravitational collapse: The role of general relativity ;","Additional pubnote: Gen.Rel.Grav.,34,1141"],"authors":[{"full_name":"Penrose, R."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/54979"}},{"reference":{"arxiv_eprint":"gr-qc/9710068","label":"2","publication_info":{"year":1997},"misc":["Gravitational collapse and cosmic censorship, arXiv:"],"authors":[{"full_name":"Wald, R.M."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/449642"}},{"reference":{"label":"3","publication_info":{"journal_volume":"20","artid":"233","year":1999,"page_start":"233","jou