p.net/api/literature/382341"}},{"reference":{"publication_info":{"journal_volume":"3","artid":"91","page_start":"91","journal_title":"Annals Phys."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/3210"}},{"reference":{"publication_info":{"journal_volume":"11","artid":"2088","page_start":"2088","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1873"}}],"number_of_pages":30,"legacy_creation_date":"1996-04-12","preprint_date":"1996-04","author_count":2,"earliest_date":"1996-04","refereed":true,"external_system_identifiers":[{"schema":"MSNET","value":"1433071"},{"schema":"ADS","value":"1997NuPhB.487..409V"},{"schema":"SPIRES","value":"SPIRES-3337529"}],"facet_author_name":["983327_Louis Witten","984894_Cenalo Vaz"],"core":true,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:417572","updated":"2023-03-10T00:16:46.301728"},"journal_title_variants":["Nucl. Phys. B","Nucl.Phys.B"],"arxiv_eprints":[{"categories":["hep-th"],"value":"hep-th/9604064"}],"referenced_authors_bais":["S.P.de.Alwis.1","B.S.DeWitt.1","Edward.Witten.1","G.W.Gibbons.1","Stephen.A.Fulling.1","P.S.Joshi.1","L.Witten.1","Leonard.Parker.1","J.Preskill.1","Spenta.Rustom.Wadia.1","Ashoke.Sen.1","Y.Peleg.3","W.Israel.1","D.A.MacIntire.1","A.M.Sengupta.1","D.Garfinkle.1","G.T.Horowitz.1","Jorge.G.Russo.1","C.Vaz.1","W.E.Thirring.1","L.Thorlacius.1","K.S.Soh.1","L.Susskind.1","Sidney.R.Coleman.1","S.Bose.2","C.G.Callan.1","M.S.Alves.1","D.Louis.Martinez.1","Stephen.W.Hawking.1","G.Kunstatter.1","T.M.Fiola.1","S.P.Trivedi.1","A.Bilal.1","J.B.Hartle.1","K.I.Maeda.1","S.M.Christensen.1","S.B.Giddings.1","S.K.Chakrabarti.5","Jeffrey.A.Harvey.1","G.Mandal.1","J.Polchinski.1","S.Shin.2","T.P.Singh.1","R.Penrose.1","A.Strominger.1","I.H.Dwivedi.1"],"legacy_version":"20180611223352.0","inspire_categories":[{"term":"Theory-HEP"}],"first_author":{"full_name":"Vaz, Cenalo","last_name":"Vaz","first_name":"Cenalo","recid":984894},"control_number":417572,"dois":[{"value":"10.1016/S0550-3213(96)00643-8"}],"document_type":["article"],"texkeys":["Vaz:1996kh"],"abstracts":[{"value":"Roughly speaking, naked singularities are singularities that may be seen by timelike observers. The Cosmic Censorship conjecture forbids their existence by stating that a reasonable system of energy will not, under reasonable conditions, collapse into a naked singularity. There are however many counter-examples to this conjecture in the literature. We propose a defense of the conjecture through the quantum theory. We will show that the Hawking effect, when consistently applied to naked singularities in two dimensional models of dilaton gravity with matter and a cosmological constant, prevents their formation by causing them to explode or catastrophically emit radiation, as opposed to black holes which radiate slowly. If this phenomenon is reproduced in the four dimensional world, the explosion of naked singularities should have observable consequences."},{"source":"Elsevier","value":"Roughly speaking, naked singularities are singularities that may be seen by timelike observers. The Cosmic Censorship conjecture forbids their existence by stating that a reasonable system of energy will not, under reasonable conditions, collapse into a naked singularity. There are however many (classical) counter-examples to this conjecture in the literature. We propose a defense of the conjecture through the quantum theory. We will show that the Hawking effect and the accompanying back reaction, when consistently applied to naked singularities in two-dimensional models of dilaton gravity with matter and a cosmological constant, prevent their formation by causing them to explode or to emit radiation catastrophically. This contrasts with black holes which radiate slowly. If this phenomenon is reproduced in the four-dimensional world, the radiation accompanying the formation of naked singularities should have observable consequences.","abstract_source_suggest":{"input":"Elsevier"}}],"primary_arxiv_category":["hep-th"],"titles":[{"title":"Quantum naked singularities in 2-D dilaton gravity"},{"source":"arXiv","title":"Quantum naked singularities in 2D dilaton gravity."}],"curated":true},"created":"1996-04-12T00:00:00+00:00","id":"417572","updated":"2023-03-10T00:16:46.301728+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/417572?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/417572?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/417572?format=latex-us","json":"https://inspirehep.net/api/literature/417572?format=json","json-expanded":"https://inspirehep.net/api/literature/417572?format=json-expanded","cv":"https://inspirehep.net/api/literature/417572?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A417572"}},{"metadata":{"citation_count":3,"citation_count_without_self_citations":3,"authors":[{"raw_affiliations":[{"value":"Department of Mathematics, Rutgers University, Hill Center, 110 Frelinghuysen Road, Piscataway, NJ, USA"}],"full_name_unicode_normalized":"zheng, weihao","full_name":"Zheng, Weihao","record":{"$ref":"https://inspirehep.net/api/authors/1975757"},"last_name":"Zheng","ids":[{"schema":"INSPIRE BAI","value":"W.Zheng.8"}],"first_name":"Weihao","uuid":"e04d73c8-7793-42e1-9be0-b084aa770f22","recid":1975757}],"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","references":[{"reference":{"texkey":"an_highcodim","label":"1","misc":["Xinliang An. Naked singularity censoring with anisotropic apparent horizon. Ann. Math., to appear"]},"raw_refs":[{"schema":"text","source":"arXiv","value":"[1] Xinliang An. Naked singularity censoring with anisotropic apparent horizon. Ann. Math., to appear."}]},{"reference":{"texkey":"bizon2000equivariant","label":"2","publication_info":{"journal_volume":"215","page_end":"56","year":2000,"page_start":"45","journal_title":"Commun.Math.Phys."},"misc"