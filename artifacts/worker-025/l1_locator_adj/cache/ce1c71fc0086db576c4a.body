ference":{"arxiv_eprint":"gr-qc/0010101","publication_info":{"journal_volume":"64","artid":"041501","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/535744"}},{"reference":{"arxiv_eprint":"gr-qc/0005080","publication_info":{"journal_volume":"15","artid":"991","page_start":"991","journal_title":"Mod.Phys.Lett.A"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/527523"}}],"number_of_pages":76,"legacy_creation_date":"2002-04-03","preprint_date":"2001-12","author_count":3,"earliest_date":"2001-12","refereed":true,"external_system_identifiers":[{"schema":"MSNET","value":"1911529"},{"schema":"ADS","value":"2002PThPh.107..449H"},{"schema":"SPIRES","value":"SPIRES-4898982"}],"publication_type":["review"],"facet_author_name":["996153_Ken-ichi Nakao","1005106_Hideo Iguchi","1006719_Tomohiro Harada"],"core":true,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:571373","updated":"2023-03-07T05:15:59.636621"},"journal_title_variants":["Prog. Theor. Phys.","Prog.Theor.Phys."],"arxiv_eprints":[{"categories":["gr-qc"],"value":"gr-qc/0204008"}],"referenced_authors_bais":["E.Poisson.1","S.Adachi.5","Masaru.Shibata.1","N.Dadhich.1","W.A.Hiscock.1","U.K.Sengupta.1","Demetrios.Christodoulou.1","Kip.S.Thorne.1","Hermann.Bondi.1","Jan.Schaeffer.1","Hideo.Iguchi.1","L.Smarr.1","G.Rein.2","S.S.Deshingkar.2","F.J.Tipler.1","R.M.Wald.1","David.W.Neilsen.1","A.A.Coley.1","F.Echeverria.1","I.H.Dwivedi.1","Takashi.Nakamura.2","G.Magli.1","W.G.Unruh.1","M.A.Pelath.1","V.Moncrief.1","C.T.Cunningham.1","I.G.Moss.1","Tatsuhiko.Koike.1","M.W.Choptuik.1","T.A.Apostolatos.1","L.Witten.1","Stephen.James.Coleman.1","Leonard.Parker.1","W.Israel.1","Subrahmanyan.Chandrasekhar.1","S.A.Teukolsky.1","Roberto.Casadio.1","R.Maartens.1","T.Foglizzo.1","A.M.Abrahams.1","T.Harada.1","V.Iyer.1","R.C.Myers.1","Takahiro.Tanaka.1","D.M.Eardley.1","S.L.Detweiler.1","A.D.Rendall.1","H.Muller.zum.Hagen.1","S.Jhingan.1","P.C.Vaidya.1","S.Barve.1","Stephen.W.Hawking.1","P.Yodzis.1","T.Chiba.1","H.Maeda.1","T.Piran.1","B.J.Carr.1","S.Hod.1","Andrzej.Krolak.1","Paul.C.W.Davies.1","P.R.Brady.1","H.Kudoh.1","Lawrence.H.Ford.1","F.C.Mena.1","B.Harms.1","T.P.Singh.1","R.Penrose.1","P.Szekeres.1","R.P.A.C.Newman.1","C.R.Evans.1","R.H.Price.1","H.S.Snyder.1","K.P.Tod.1","T.Hara.6","G.Williams.2","Stephen.A.Fulling.1","P.S.Joshi.1","J.Robert.Oppenheimer.1","C.Gundlach.1","S.S.Deshingkar.3","H.J.Seifert.2","A.Ori.2","R.C.Tolman.1","U.H.Gerlach.1","K.I.Nakao.1","R.N.Henriksen.1","K.Lake.1","C.Vaz.1","G.Lemaitre.1","B.C.Nolan.1","B.Waugh.1","S.Shapiro.1"],"legacy_version":"20180614225620.0","inspire_categories":[{"term":"Gravitation and Cosmology"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/00ntfnx83"}],"full_name":"Harada, Tomohiro","ids":[{"schema":"ORCID","value":"0000-0002-9085-9905"},{"schema":"INSPIRE BAI","value":"T.Harada.1"}],"last_name":"Harada","first_name":"Tomohiro","recid":1006719},"control_number":571373,"dois":[{"value":"10.1143/PTP.107.449"}],"document_type":["article"],"texkeys":["Harada:2001nj"],"abstracts":[{"source":"arXiv","value":"Gravitational collapse is one of the most fruitful subjects in gravitational physics. It is well known that singularity formation is inevitable in complete gravitational collapse. It was conjectured that such a singularity should be hidden by horizons if it is formed from generic initial data with physically reasonable matter fields. Many possible counterexamples to this conjecture have been proposed over the past three decades, although none of them has proved to be sufficiently generic. In these examples, there appears a singularity that is not hidden by horizons. This singularity is called a `naked singularity.' The appearance of a naked singularity represents the formation of an observable high-curvature, strong-gravity region. In this paper we review examples of naked singularity formation and recent progress in research of observable physical processes - gravitational radiation and quantum particle creation - from a forming naked singularity.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"Physical processes in naked singularity formation"},{"source":"arXiv","title":"Physical processes in naked singularity formation."}],"curated":true},"created":"2002-04-03T00:00:00+00:00","id":"571373","updated":"2023-03-07T05:15:59.636621+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/571373?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/571373?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/571373?format=latex-us","json":"https://inspirehep.net/api/literature/571373?format=json","json-expanded":"https://inspirehep.net/api/literature/571373?format=json-expanded","cv":"https://inspirehep.net/api/literature/571373?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A571373"}},{"metadata":{"citation_count":20,"citation_count_without_self_citations":14,"report_numbers":[{"value":"UATP-96-01"}],"authors":[{"full_name_unicode_normalized":"vaz, cenalo","full_name":"Vaz, Cenalo","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/984894"},"ids":[{"schema":"INSPIRE BAI","value":"C.Vaz.1"}],"last_name":"Vaz","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/906183"},"value":"Algarve U."}],"signature_block":"Vc","uuid":"68a3ab54-caba-4b51-8668-28b97336b257","first_name":"Cenalo","recid":984894},{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/01e3m7079"}],"full_name_unicode_normalized":"witten, louis","full_name":"Witten, Louis","record":{"$ref":"https://inspirehep.net/api/authors/983327"},"ids":[{"schema":"INSPIRE BAI","value":"L.Witten.1"}],"last_name":"Witten","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/902734"},"value":"Cincinnati U."}],"signa