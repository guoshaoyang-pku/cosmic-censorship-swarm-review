ull_name":"Campbell, W.C."},{"full_name":"Korenblit, S."},{"full_name":"Smith, J."},{"full_name":"Lee, A."},{"full_name":"Edwards, E.E."},{"full_name":"Wang, C.-C.J."},{"full_name":"Freericks, J.K."},{"full_name":"Monroe, C."}]},"raw_refs":[{"schema":"text","value":"R. Islam, C. Senko, W. C. Campbell, S. Korenblit, J. Smith, A. Lee, E. E. Edwards, C.-C. J. Wang, J. K. Freericks, and C. Monroe, Science 340, 583 (2013), DOI: 10.1126/science.1232296."}],"record":{"$ref":"https://inspirehep.net/api/literature/2735184"}},{"reference":{"publication_info":{"year":2010},"misc":["Technical report, Nicta"],"authors":[{"full_name":"Sanderson, C."}]},"raw_refs":[{"schema":"text","value":"C. Sanderson, Technical report, Nicta, 2010."}]}],"number_of_pages":4,"preprint_date":"2015-10-05","author_count":1,"public_notes":[{"source":"arXiv","value":"4 pages, 3 figures, minor changes, version as published"}],"earliest_date":"2015-10-02","refereed":true,"facet_author_name":["1896211_Markus Heyl"],"core":false,"license":[{"license":"arXiv nonexclusive-distrib 1.0","material":"preprint","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:2934994","updated":"2026-02-09T14:45:00.865683"},"journal_title_variants":["Phys. Rev. Lett.","Phys.Rev.Lett."],"arxiv_eprints":[{"categories":["cond-mat.stat-mech","quant-ph"],"value":"1505.02352"}],"referenced_authors_bais":["J.J.Bollinger.1","M.Rambach.1","P.Schindler.1","Da.Ping.Du.1","M.M.Muller.2","F.Andraschko.1","R.Kubo.1","S.E.Korenblit.1","T.D.Schultz.2","P.Zoller.1","S.Vajna.1","T.Niemeijer.1","Hai.Yuan.Zou.1","C.C.J.Wang.1","M.Hennrich.1","A.Silva.2","A.Polkovnikov.1","Y.Meurice.1","C.Hempel.1","D.W.Nigg.1","D.Schuricht.6","M.E.Fisher.1","J.M.J.Van.Leeuwen.1","M.Fagotti.1","W.C.Campbell.1","M.FossFeig.1","L.Onsager.1","B.P.Lanyon.1","Jacob.Smith.1","A.J.A.James.1","D.R.Nelson.4","F.Zahringer.1","S.Sotiriadis.1","A.A.Lee.1","U.M.Heller.1","S.Kehrein.1","P.Jurcevic.1","C.F.Roos.1","J.T.Barreiro.1","S.Genway.1","Adrian.T.Lee.1","J.W.Britton.1","S.Michalakis.1","P.Hauke.1","D.C.Mattis.2","B.C.Sawyer.1","J.M.Hickey.1","S.B.Kaufman.3","C.Karrasch.1","M.Heyl.2","T.Palmai.1","Z.X.Gong.1","R.Islam.3","E.H.Lieb.1","J.Sirker.1","A.V.Gorshkov.1","G.E.Edwards.1","R.Blatt.1","J.P.Garrahan.2","Yu.Zhi.Liu.1","J.K.Freericks.1","J.C.Budich.1","H.Uys.1","Poul.H.Damgaard.1","B.Dora.1","J.Smith.1","C.Senko.1","Rene.Gerritsma.1","G.Kirchmair.1","J.C.Wang.3","C.Monroe.1","A.Denbleyker.2","C.Monroe.2","A.C.Keith.1","M.J.Biercuk.1","P.Richerme.1","R.M.Konik.1"],"figures":[{"filename":"Fig1.png","material":"preprint","caption":"(color online) Dynamical quantum phase transitions in the Loschmidt echo rate function $\\lambda(t) = -N^{-1} \\log [|\\mathcal{G}(t)|^2]$ after quenches in the 1D Ising chain. The nonanalytic kink structure of $\\lambda(t)$ is a direct consequence of the universal exponents of the underlying fixed point, see Eq.~(\\ref{eq:gScaling1D}).","label":"fig:1","source":"arxiv","key":"267cbe7e4f170e1064d4532b33a669e6","url":"https://inspirehep.net/files/267cbe7e4f170e1064d4532b33a669e6"},{"filename":"Fig2.png","material":"preprint","caption":"(color online) Dynamics of $\\lambda(t)$ in the 2D Ising model. (a) For strong anisotropies $j_\\perp = J_\\perp/J \\ll 1$ the weak coupling $J_\\perp$ represents an irrelevant perturbation and the critical properties, i.e., the kinks, are identical to the 1D case. (b) For the isotropic 2D Ising model the nonanalytic structure changes to a logarithmic singularity which is illustrated in the second derivative shown in (c).","label":"fig:2","source":"arxiv","key":"fe7fa62ac195ff91becd89450b79d972","url":"https://inspirehep.net/files/fe7fa62ac195ff91becd89450b79d972"},{"filename":"Fig3.png","material":"preprint","caption":"(color online) (a) Dynamics of $C_z(t)$ for $h/J =0.1$ on a $N=5\\times 5$ square lattice for different anisotropies $j_\\perp$. (b) Power-law scaling of $\\chi(\\tau)$ in the vicinity of the DQPT. Brown curves are on the NN square lattice for $j_\\perp=1/8$ with $d^\\ast=1$ (upper curve) and the isotropic limit  $j_\\perp=1$ with $d^\\ast=2$ (lower curve). The dashed blue curves for the long-range Ising models relevant for trapped ions in 1D (upper curve) and in 2D (lower curve) are also included. As a reference, quadratic and quartic power-laws are also shown demonstrating the dynamical scaling of Eq.~(\\ref{eq:dCz}).","label":"fig:3","source":"arxiv","key":"b343d50cdbf2f343da3e703901678a50","url":"https://inspirehep.net/files/b343d50cdbf2f343da3e703901678a50"}],"inspire_categories":[{"term":"Quantum Physics","source":"curator"}],"first_author":{"full_name":"Heyl, Markus","last_name":"Heyl","first_name":"Markus","recid":1896211},"control_number":2934994,"dois":[{"source":"APS","value":"10.1103/PhysRevLett.115.140602"},{"material":"publication","source":"arXiv","value":"10.1103/PhysRevLett.115.140602"}],"document_type":["article"],"texkeys":["Heyl:2015wfe"],"abstracts":[{"source":"APS","value":"Dynamical quantum phase transitions (DQPTs) at critical times appear as nonanalyticities during nonequilibrium quantum real-time evolution. Although there is evidence for a close relationship between DQPTs and equilibrium phase transitions, a major challenge is still to connect to fundamental concepts such as scaling and universality. In this work, renormalization group transformations in complex parameter space are formulated for quantum quenches in Ising models showing that the DQPTs are critical points associated with unstable fixed points of equilibrium Ising models. Therefore, these DQPTs obey scaling and universality. On the basis of numerical simulations, signatures of these DQPTs in the dynamical buildup of spin correlations are found with an associated power-law scaling determined solely by the fixed point’s universality class. An outlook is given on how to explore this dynamical scaling experimentally in systems of trapped ions.","abstract_source_suggest":{"input":"APS"}},{"source":"arXiv","value":"Dynamical quantum phase transitions (DQPTs) at critical times appear as non-analyticities during nonequilibrium quantum real-time evolution. Although there is evidence for a close relationship between DQPTs and equilibrium phase transitions, a major challenge is still to connect to fundamental concepts such as scaling and universality. In this work, renormalization group transformations in complex parameter space are formulated for quantum quenches in Ising models showing that the DQPTs are critical points associated with unstable fixed points of equilibrium Ising models. Therefore, these DQPTs obey scaling and universality. On the basis of numerical simulations, signatures of these DQPTs in the dynamical buildup of spin correlations are found with an associated power-law scaling determined solely by the fixed point's universality class. An outlook is given on how to explore this dynamical scaling experimentally in systems of trapped ions.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["cond-mat.stat-mech"],"titles":[{"source":"APS","title":"Scaling and Universality at Dynamical Quantum Phase Transitions"},{"source":"arXiv","title":"Dynamical quantum phase transitions: scaling and universality"}],"imprints":[{"date":"2015-10-02"}],"curated":false},"links":{"bibtex":"https://inspirehep.net/api/literature/2934994?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/2934994?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/2934994?format=latex-us","json":"https://inspirehep.net/api/literature/2934994?format=json","json-expanded":"https://inspirehep.net/api/literature/2934994?format=json-expanded","cv":"https://inspirehep.net/api/literature/2934994?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2934994"},"id":"2934994","updated":"2026-02-09T14:45:00.865683+00:00"},{"created":"1996-02-01T00:00:00+00:00","metadata":{"citation_count":44,"