ors":[{"full_name":"Polkovnikov, A."}]},"raw_refs":[{"schema":"text","source":"arXiv","value":"20. A. Polkovnikov, Phys. Rev. B, 72, p. 161201 (2005); A. Polkovnikov and V. Gritsev, cond-mat/0706.0212 (2007)."}],"record":{"$ref":"https://inspirehep.net/api/literature/2707835"}},{"reference":{"arxiv_eprint":"0706.0212","label":"20","publication_info":{"year":2007},"misc":["cond-mat/"],"authors":[{"full_name":"Polkovnikov, A."},{"full_name":"Gritsev, V."}]},"raw_refs":[{"schema":"text","source":"arXiv","value":"20. A. Polkovnikov, Phys. Rev. B, 72, p. 161201 (2005); A. Polkovnikov and V. Gritsev, cond-mat/0706.0212 (2007)."}],"record":{"$ref":"https://inspirehep.net/api/literature/752144"}}],"number_of_pages":11,"referenced_authors_bais":["F.Verstraete.1","D.M.StamperKurn.1","H.Barnum.3","B.Damski.3","T.W.Haensch.1","E.Knill.1","W.H.Zurek.1","Gerardo.Ortiz.1","S.R.Leslie.1","P.Pfeuty.1","F.M.Cucchietti.2","I.Bloch.1","M.Greiner.2","L.E.Sadler.1","J.I.Cirac.1","U.Dorner.2","M.Kindermann.2","T.Esslinger.2","J.Dziarmaga.1","P.Zoller.1","Luigi.Amico.1","D.Porras.1","B.M.McCoy.1","Rosario.Fazio.1","V.Gritsev.4","Guifre.Vidal.1","J.M.Higbie.1","M.Dresden.1","A.Polkovnikov.1","A.Osterloh.1","L.Viola.3","M.Vengalattore.1","J.Eisert.1","Vlatko.Vedral.1","R.D.Somma.1","E.Barouch.1","O.Mandel.2"],"figures":[{"filename":"figure1.png","material":"preprint","caption":"Phase diagram of the spin-$1/2$ XY alternating Hamiltonian given in Eq.~(\\ref{altH1}) with $\\gamma=0.5$.","label":"fig1","source":"arxiv","key":"a6503511ba81331fd287c58c777213a5","url":"https://inspirehep.net/files/a6503511ba81331fd287c58c777213a5"},{"filename":"figure2.png","material":"preprint","caption":"$P_{\\mathfrak{u}(N)}$ as a static QPT indicator. Left panel: Purity and rescaled purity derivative vs magnetic field strength. Inset: second derivative for $N=1000, 2000, 4000, 8000$ (top to bottom). Right panel: Determination of $\\nu$ for both the alternating and Ising (inset) universality class.","label":"fig2","source":"arxiv","key":"0b186680d818748b7d004aa0cee9ad25","url":"https://inspirehep.net/files/0b186680d818748b7d004aa0cee9ad25"},{"filename":"figure3.png","material":"preprint","caption":"$P_{\\mathfrak{u}(N)}$ as a static QPT indicator. Left panel: Purity and rescaled purity derivative vs magnetic field strength. Inset: second derivative for $N=1000, 2000, 4000, 8000$ (top to bottom). Right panel: Determination of $\\nu$ for both the alternating and Ising (inset) universality class.","label":"fig2","source":"arxiv","key":"1aace49f871aca7239119d8a92d865f5","url":"https://inspirehep.net/files/1aace49f871aca7239119d8a92d865f5"},{"filename":"figure4.png","material":"preprint","caption":"Dynamical scaling of the excitation density. Left panel: log-log plot for Ising universality class (FM to PM). Right panel: alternating universality class (FM to FM), with log-log scaling plot in the inset.","label":"fig3","source":"arxiv","key":"479baee31b1d65fc719331208225089f","url":"https://inspirehep.net/files/479baee31b1d65fc719331208225089f"},{"filename":"figure5.png","material":"preprint","caption":"Dynamical scaling of the excitation density. Left panel: log-log plot for Ising universality class (FM to PM). Right panel: alternating universality class (FM to FM), with log-log scaling plot in the inset.","label":"fig3","source":"arxiv","key":"071cdf07f433582ae1e61c9f0fcda0ce","url":"https://inspirehep.net/files/071cdf07f433582ae1e61c9f0fcda0ce"},{"filename":"figure6.png","material":"preprint","caption":"Dynamical scaling of $P_{\\mathfrak{u}(N)}$ for the alternating and the Ising (inset) universality class.","label":"fig4","source":"arxiv","key":"5930abd74577cd5059edbae167484786","url":"https://inspirehep.net/files/5930abd74577cd5059edbae167484786"}],"inspire_categories":[{"term":"Condensed Matter","source":"arxiv"},{"term":"Quantum Physics","source":"arxiv"}],"preprint_date":"2008-02-27","author_count":3,"first_author":{"full_name":"Deng, Shusa","last_name":"Deng","first_name":"Shusa","recid":1389231},"public_notes":[{"source":"arXiv","value":"11 pages, 4 eps color figures. Invited talk at the 14th International Conference on Recent Progress in Many Body Theories (RPMBT14), July 2007, Barcelona"}],"control_number":3037597,"dois":[{"material":"publication","source":"arXiv","value":"10.1142/9789812779885_0050"}],"earliest_date":"2008-02-27","document_type":["conference paper"],"texkeys":["Deng:2008gvr"],"abstracts":[{"source":"arXiv","value":"We investigate a class of one-dimensional, exactly solvable anisotropic XY spin-1/2 models in an alternating transverse magnetic field from an entanglement perspective. We find that a physically motivated Lie-algebraic generalized entanglement measure faithfully portraits the static phase diagram -- including second- and fourth-order quantum phase transitions belonging to distinct universality classes. In the simplest time-dependent scenario of a slow quench across a quantum critical point, we identify parameter regimes where entanglement exhibits universal dynamical scaling relative to the static limit.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["cond-mat.stat-mech"],"titles":[{"source":"arXiv","title":"Generalized entanglement in static and dynamic quantum phase transitions"}],"facet_author_name":["1988640_Lorenza Viola","994757_Gerardo Ortiz","1389231_Shusen Deng"],"license":[{"license":"arXiv nonexclusive-distrib 1.0","material":"preprint","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:3037597","updated":"2025-10-03T08:24:49.631436"},"curated":false,"arxiv_eprints":[{"categories":["cond-mat.stat-mech","quant-ph"],"value":"0802.3941"}]},"links":{"bibtex":"https://inspirehep.net/api/literature/3037597?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/3037597?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/3037597?format=latex-us","json":"https://inspirehep.net/api/li