":false,"record":{"$ref":"https://inspirehep.net/api/literature/9589"}},{"reference":{"imprint":{"publisher":"Springer Berlin"},"label":"25","publication_info":{"year":1992},"title":{"title":"Stochastic Quantization"},"authors":[{"full_name":"Namiki, M."}]}},{"reference":{"label":"26","publication_info":{"year":1993},"title":{"title":"Stochastic Quantization"},"misc":["Supplement No. 111, Kyoto","Prog.Theor.Phys."],"authors":[{"full_name":"Okano, K."},{"full_name":"Schülke, L."},{"full_name":"Zheng, B."}]}},{"reference":{"label":"27","publication_info":{"journal_volume":"424","artid":"675","year":1994,"page_start":"675","journal_title":"Nucl.Phys.B"},"authors":[{"full_name":"Fujimura, K."},{"full_name":"Okano, K."},{"full_name":"Schülke, L."},{"full_name":"Yamagishi, K."},{"full_name":"Zheng, B."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/36555"}},{"reference":{"label":"28","misc":["Zhongshan Univ., preprint"],"authors":[{"full_name":"Li, Z."},{"full_name":"Liu, X."}]}},{"reference":{"label":"29","misc":["Univ. of Essen, preprint"],"authors":[{"full_name":"Ritschel, U."},{"full_name":"Czemer, P."}]}}],"number_of_pages":20,"legacy_creation_date":"2016-05-19","preprint_date":"1996-01-11","author_count":4,"public_notes":[{"source":"arXiv","value":"14 pages, 14 figures"}],"earliest_date":"1996-01-11","refereed":true,"facet_author_name":["2302959_Kentarou Yamagishi","2366854_L. Schülke","995012_Keisuke Okano","1027462_Bo Zheng"],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1460898","updated":"2023-03-07T05:05:12.217695"},"journal_title_variants":["Nucl. Phys. B","Nucl.Phys.B"],"arxiv_eprints":[{"categories":["cond-mat"],"value":"cond-mat/9601037"}],"referenced_authors_bais":["D.P.Landau.3","K.Binder.1","Bo.Zheng.2","Keisuke.Okano.1","G.Parisi.1","Yong.Shi.Wu.1","L.Schulke.4","S.Tang.45","D.A.Huse.1","K.Fujimura.2","Zhi.Bing.Li.1","K.Yamagishi.6","A.J.Bray.2"],"legacy_version":"20190518041749.0","inspire_categories":[{"term":"Theory-Nucl"},{"term":"Experiment-Nucl"},{"term":"Condensed Matter","source":"arxiv"}],"first_author":{"full_name":"Okano, K.","last_name":"Okano","first_name":"K.","recid":995012},"control_number":1460898,"dois":[{"source":"Elsevier","value":"10.1016/S0550-3213(96)00615-3"},{"value":"10.1016/S0550-3213(96)00615-3"}],"document_type":["article"],"texkeys":["Okano:1996cpm","Okano:1997qza"],"abstracts":[{"source":"Elsevier","value":"The short-time scaling behaviour of the critical dynamics for the two-dimensional Ising model and Potts model are investigated with both the heat-bath and the Metropolis algorithm. Special attention is drawn to universality. We observed that the microscopic time scale t mic after which the universal scaling behaviour appears is not always negligibly small. Taking carefully the effect of t mic into account, the critical exponents are extracted from the power law behaviour of the observables in the beginning of the time evolution. All the results are consistent and therefore universality and scaling are confirmed.","abstract_source_suggest":{"input":"Elsevier"}},{"source":"arXiv","value":"Numerically we simulate the short-time behaviour of the critical dynamics for the two dimensional Ising model and Potts model with an initial state of very high temperature and small magnetization. Critical initial increase of the magnetization is observed. The new dynamic critical exponent $\\theta$ as well as the exponents $z$ and $2\\beta/\\nu$ are determined from the power law behaviour of the magnetization, auto-correlation and the second moment. Furthermore the calculation has been carried out with both Heat-bath and Metropolis algorithms. All the results are consistent and therefore universality and scaling are confirmed.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["cond-mat"],"titles":[{"title":"Universality and scaling in short-time critical dynamics"},{"source":"arXiv","title":"Universality and Scaling in Short-time Critical Dynamics"}],"imprints":[{"date":"1997"}],"curated":false},"links":{"bibtex":"https://inspirehep.net/api/literature/1460898?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1460898?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1460898?format=latex-us","json":"https://inspirehep.net/api/literature/1460898?format=json","json-expanded":"https://inspirehep.net/api/literature/1460898?format=json-expanded","cv":"https://inspirehep.net/api/literature/1460898?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1460898"},"id":"1460898","updated":"2023-03-07T05:05:12.217695+00:00"}],"total":2883},"links":{"self":"https://inspirehep.net/api/literature/?q=...Universality%20and%20scaling...&size=10&page=1","next":"https://inspirehep.net/api/literature/?q=...Universality%20and%20scaling...&size=10&page=2","bibtex":"https://inspirehep.net/api/literature/?q=...Universality%20and%20scaling...&size=10&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=...Universality%20and%20scaling...&size=10&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=...Universality%20and%20scaling...&size=10&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=...Universality%20and%20scaling...&size=10&page=1&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=...Universality%20and%20scaling...&size=10&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=...Universality%20and%20scaling...&size=10&page=1&format=cv"}}