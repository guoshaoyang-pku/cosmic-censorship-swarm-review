f":"https://inspirehep.net/api/literature/142628"}},{"reference":{"publication_info":{"journal_volume":"54","artid":"2671","page_start":"2671","journal_title":"Phys.Rev.Lett."}}},{"reference":{"publication_info":{"journal_volume":"41","artid":"273","page_start":"273","journal_title":"J.Statist.Phys."}}},{"reference":{"publication_info":{"journal_volume":"30","artid":"322","page_start":"322","journal_title":"Phys.Rev.B"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/212620"}},{"reference":{"publication_info":{"journal_volume":"10","artid":"658","page_start":"658","journal_title":"SIAM J.Math.Anal."}}},{"reference":{"publication_info":{"journal_volume":"85","artid":"808","page_start":"808","journal_title":"Phys.Rev."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/43373"}}],"number_of_pages":24,"legacy_creation_date":"1986-12-01","preprint_date":"1986-08","author_count":1,"earliest_date":"1986-08","refereed":true,"external_system_identifiers":[{"schema":"ADS","value":"1987JPhA...20.3969H"},{"schema":"SPIRES","value":"SPIRES-1603213"}],"facet_author_name":["1006220_Malte Henkel"],"core":true,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:235183","updated":"2023-03-06T18:30:15.925464"},"journal_title_variants":["J. Phys. A","J.Phys.A"],"referenced_authors_bais":["J.Zinn.Justin.1","K.Binder.1","R.B.Pearson.3","J.B.Kogut.1","M.N.Barber.2","Chen.Ning.Yang.1","P.A.Young.2","M.E.Fisher.1","J.C.Le.Guillou.7","M.Nauenberg.1","V.Privman.1","M.Henkel.1","John.L.Richardson.1","D.Toussaint.1"],"legacy_version":"20160616121711.0","inspire_categories":[{"term":"General Physics","source":"curator"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/041nas322"}],"full_name":"Henkel, Malte","last_name":"Henkel","ids":[{"schema":"ORCID","value":"0000-0002-5048-7852"},{"schema":"INSPIRE BAI","value":"M.Henkel.1"}],"first_name":"Malte","recid":1006220},"control_number":235183,"dois":[{"value":"10.1088/0305-4470/20/12/041"}],"document_type":["article"],"texkeys":["Henkel:1986ia"],"abstracts":[{"source":"IOP","value":"The energy and magnetisation density of the (2+1)D Ising model are investigated. For the thermal exponent the author finds xepsilon =1.42+or-0.02, in agreement with hyperscaling. The Privman-Fisher universality hypothesis is confirmed by two methods. First, the author presents, at the critical point, numerical data for the finite-size scaling amplitudes of the (singular) free energy, magnetisation, susceptibility and surface tension and checks them for universality. Second, using the explicitly computed eigenvectors of the Hamiltonian, it is shown that the ratios of matrix elements of the energy and magnetisation density are universal.","abstract_source_suggest":{"input":"IOP"}}],"titles":[{"title":"Finite Size Scaling and Universality in the (2+1)-dimensions Ising Model"},{"title":"FINITE SIZE SCALING AND UNIVERSALITY IN THE (2+1)-dimensions ISING MODEL"}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/235183?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/235183?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/235183?format=latex-us","json":"https://inspirehep.net/api/literature/235183?format=json","json-expanded":"https://inspirehep.net/api/literature/235183?format=json-expanded","cv":"https://inspirehep.net/api/literature/235183?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A235183"},"id":"235183","updated":"2023-03-06T18:30:15.925464+00:00"},{"created":"1990-01-30T00:00:00+00:00","metadata":{"citation_count":30,"authors":[{"raw_affiliations":[{"value":"Institute for Theoretical Physics, University of Bern, Sidlerstrasse 5, CH-3012 Bern, Switzerland"}],"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/02k7v4d05"}],"full_name_unicode_normalized":"hasenfratz, p.","full_name":"Hasenfratz, P.","record":{"$ref":