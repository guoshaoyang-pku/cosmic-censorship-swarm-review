","journal_title":"J.Phys.A"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/536064"}}],"number_of_pages":13,"legacy_creation_date":"2000-11-02","preprint_date":"2000-10","author_count":2,"public_notes":[{"source":"arXiv","value":"16 pages, Latex, 2 figures, final version, to appear in J. Phys. A Subj-class: Statistical Mechanics Journal-ref: J. Phys. A34, 3333-3350 (2001)"}],"earliest_date":"2000-10","refereed":true,"external_system_identifiers":[{"schema":"ADS","value":"2001JPhA...34.3333H"},{"schema":"SPIRES","value":"SPIRES-4493087"},{"schema":"MSNET","value":"1838049"}],"facet_author_name":["1941524_Ulrich Schollwöck","1006220_Malte Henkel"],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:536063","updated":"2023-12-07T19:04:54.883055"},"journal_title_variants":["J. Phys. A","J.Phys.A"],"arxiv_eprints":[{"categories":["cond-mat"],"value":"cond-mat/0010061"}],"referenced_authors_bais":["M.N.Barber.2","M.E.Fisher.1","V.Fridkin.1","G.Schutz.1","H.Simon.2","H.Hinrichsen.1","L.P.Kadanoff.1","Y.G.Stroganov.3","M.A.Shpot.1","V.Privman.1","J.Swift.1","M.Droz.2","U.Schollwock.1","D.Zagier.1","H.W.Diehl.1","E.Carlon.1","V.Rittenberg.1","Rodney.J.Baxter.1","G.R.W.Quispel.1","F.C.Alcaraz.1","S.R.White.1","M.Weigel.1","M.N.Barber.1","W.Janke.13","Kwan.Tai.Leung.1","J.L.Cardy.1","Murray.T.Batchelor.1","M.Henkel.1"],"legacy_version":"20190508153213.0","inspire_categories":[{"term":"General Physics"},{"term":"Condensed Matter","source":"arxiv"}],"first_author":{"full_name":"Henkel, Malte","ids":[{"schema":"ORCID","value":"0000-0002-5048-7852"},{"schema":"INSPIRE BAI","value":"M.Henkel.1"}],"last_name":"Henkel","first_name":"Malte","recid":1006220},"control_number":536063,"dois":[{"value":"10.1088/0305-4470/34/16/301"}],"document_type":["article"],"texkeys":["Henkel:2000bd"],"abstracts":[{"source":"arXiv","value":"Phenomenological scaling arguments suggest the existence of universal amplitudes in the finite-size scaling of certain correlation lengths in strongly anisotropic or dynamical phase transitions. For equilibrium systems, provided that translation invariance and hyperscaling are valid, the Privman-Fisher scaling form of isotropic equilibrium phase transitions is readily generalized. For non-equilibrium systems, universality is shown analytically for directed percolation and is tested numerically in the annihilation-coagulation model and in the pair contact process with diffusion. In these models, for both periodic and free boundary conditions, the universality of the finite-size scaling amplitude of the leading relaxation time is checked. Amplitude universality reveals strong transient effects along the active-inactive transition line in the pair contact process.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["cond-mat"],"titles":[{"title":"Universal finite size scaling amplitudes in anisotropic scaling"},{"source":"arXiv","title":"Universal finite-size scaling amplitudes in anisotropic scaling"}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/536063?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/536063?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/536063?format=latex-us","json":"https://inspirehep.net/api/literature/536063?format=json","json-expanded":"https://inspirehep.net/api/literature/536063?format=json-expanded","cv":"https://inspirehep.net/api/literature/536063?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A536063"},"id":"536063","updated":"2023-12-07T19:04:54.883055+00:00"},{"created":"2016-05-19T00:00:00+00:00","metadata":{"citation_count":13,"authors":[{"raw_affiliations":[{"value":"Tokuyama University, Tokuyama-shi, Yamaguchi 754, Japan"}],"full_name_unicode_normalized":"okano, k.","full_name":"Okano, K.","record":{"$ref":"https://inspirehep.net/api/authors/995012"},"last_name":"Okano","ids":[{"schema":"INSPIRE BAI","value":"Keisuke.Okano.1"}],"signatur