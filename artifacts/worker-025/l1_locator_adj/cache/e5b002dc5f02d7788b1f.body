ef":"https://inspirehep.net/api/literature/315107"}},{"reference":{"publication_info":{"journal_volume":"129","artid":"611","page_start":"611","journal_title":"Nucl.Phys.B Proc.Suppl."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/654398"}},{"reference":{"arxiv_eprint":"hep-lat/0108014","publication_info":{"journal_volume":"09","artid":"010","year":2001,"page_start":"010","journal_title":"JHEP"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/561439"}},{"reference":{"arxiv_eprint":"hep-lat/0207003","publication_info":{"journal_volume":"07","artid":"049","year":2002,"page_start":"049","journal_title":"JHEP"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/589933"}},{"reference":{"publication_info":{"journal_volume":"07","artid":"049","year":1991,"page_start":"049","journal_title":"JHEP"}}}],"number_of_pages":17,"legacy_creation_date":"2007-11-06","preprint_date":"2007-11","author_count":1,"earliest_date":"2007-11","refereed":true,"external_system_identifiers":[{"schema":"OSTI","value":"939085"},{"schema":"ADS","value":"2008IJMPC..19.1079V"},{"schema":"SPIRES","value":"SPIRES-7501064"}],"facet_author_name":["1021335_Alexander Velytsky"],"core":true,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:766794","updated":"2023-03-06T19:42:48.801257"},"journal_title_variants":["Int.J.Mod.Phys.C","Int. J. Mod. Phys. C"],"arxiv_eprints":[{"categories":["hep-lat"],"value":"0711.0748"}],"referenced_authors_bais":["B.J.Pendleton.1","L.G.Yaffe.1","K.Pinn.2","S.Vinti.2","R.V.Gavai.1","O.Haan.2","U.M.Heller.1","V.K.Mitrjushkin.1","M.Mathur.1","I.L.Bogolubsky.4","M.Hasenbusch.1","J.Fingberg.1","B.Svetitsky.1","E.Luijten.2","A.D.Kennedy.1","H.Stuben.8","M.Luscher.1","A.Sergeev.1","K.Fabricius.4","D.E.Miller.1","P.Weisz.1","F.Karsch.1","S.Solomon.1","K.Binder.1","R.Ben.Av.1","Juergen.Engels.1","H.G.Evertz.1","M.S.Weber.1","M.Muller.Preussker.1","M.Marcu.3"],"legacy_version":"20170329154905.0","inspire_categories":[{"term":"Lattice"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/024mw5h28"},{"schema":"ROR","value":"https://ror.org/05gvnxz63"}],"full_name":"Velytsky, Alexander","last_name":"Velytsky","first_name":"Alexander","recid":1021335},"control_number":766794,"dois":[{"value":"10.1142/S0129183108012741"}],"document_type":["article"],"texkeys":["Velytsky:2007gj"],"abstracts":[{"source":"arXiv","value":"We examine SU(2) gauge theory in 3+1 dimensions at finite temperature in the vicinity of critical point. For various lattice sizes in time direction ($N_\\tau=1,2,4,8$) we extract high precision values of the inverse critical coupling and critical values of the 4-th order cumulant of Polyakov loops (Binder cumulant). We check the universality class of the theory by comparing the cumulant values to that of the 3D Ising model and find very good agreement. The Polyakov loop correlators for the indicated lattices are also measured and the string tension values extracted. The high precision values of critical coupling and string tension allow us to study the scaling of dimensionless $T_c/\\sqrt{\\sigma}$ ratio. The violation of scaling by <10% is observed as the coupling is varied from weak to strong coupling regime.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["hep-lat"],"titles":[{"title":"Finite temperature SU(2) gauge theory: Critical coupling and universality class"},{"source":"arXiv","title":"Finite temperature SU(2) gauge theory: critical coupling and universality class"}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/766794?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/766794?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/766794?format=latex-us","json":"https://inspirehep.net/api/literature/766794?format=json","json-expanded":"https://inspirehep.net/api/literature/766794?format=json-expanded","cv":"http