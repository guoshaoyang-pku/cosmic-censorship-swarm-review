:{"label":"106","publication_info":{"journal_volume":"68","artid":"30","year":2015,"page_start":"30","journal_title":"Phys.Today"},"misc":["Eric Lutz and Sergio Ciliberto. From maxwells demon to landauers eraser"]},"raw_refs":[{"schema":"text","source":"arXiv","value":"[106] Eric Lutz and Sergio Ciliberto. From maxwells demon to landauers eraser. Physics Today, 68(9):30, 2015."}]},{"reference":{"label":"107","publication_info":{"journal_volume":"88","artid":"052121","year":2013,"journal_title":"Phys.Rev.E"},"misc":["Ken Funo, Yu Watanabe, and Masahito Ueda. Integral quantum fluctuation theorems under measurement and feedback control","137"]},"raw_refs":[{"schema":"text","source":"arXiv","value":"[107] Ken Funo, Yu Watanabe, and Masahito Ueda. Integral quantum fluctuation theorems under measurement and feedback control. Physical Review E, 88(5):052121, 2013. 137"}],"record":{"$ref":"https://inspirehep.net/api/literature/3011353"}}],"number_of_pages":137,"legacy_creation_date":"2020-11-16","preprint_date":"2019-04-19","author_count":1,"public_notes":[{"source":"arXiv","value":"137 pages, 85 figures, comments/corrections are welcome"}],"earliest_date":"2019-04-19","facet_author_name":["2011041_Mahdi Naghiloo"],"core":true,"license":[{"license":"arXiv nonexclusive-distrib 1.0","material":"preprint","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1830380","updated":"2026-02-09T11:43:32.713423"},"arxiv_eprints":[{"categories":["quant-ph"],"value":"1904.09291"}],"referenced_authors_bais":["A.Megrant.1","H.E.Tureci.2","E.Muneyuki.1","Y.Masuyama.1","J.P.Bird.1","F.Deppe.1","F.Lei.1","A.Brodutch.1","Venktesh.Singh.1","L.Frunzio.1","R.Thew.2","A.N.Jordan.3","C.Gogolin.1","I.S.M.Khalil.1","C.Vigliar.1","A.W.Cross.1","M.E.Gershenson.1","E.P.Menzel.1","M.Malekakhlagh.1","I.S.Oliveira.1","J.Eisert.1","M.S.Gladchenko.1","F.G.S.L.Brandao.1","N.Roch.1","J.J.Kelly.1","A.Petrescu.1","C.Quintana.1","C.Sunderhauf.1","J.J.GarciaRipoll.2","K.Modi.1","A.H.Kiilerich.1","K.Funo.1","Adrian.Parra.Rodriguez.1","M.Ueda.2","E.Mlinar.2","A.D.Corcoles.1","A.N.Korotkov.1","A.N.Cleland.1","K.W.Murch.1","A.Romito.1","B.R.Johnson.3","L.L.Yang.2","M.Mirrahimi.1","J.M.Gambetta.1","M.J.A.Stoutimore.1","R.J.Schoelkopf.1","S.Fan.3","E.Lucero.1","Y.H.Kim.8","I.A.Steele.1","Jonathan.Oppenheim.1","C.Eichler.1","Bo.Peng.1","J.Wenner.1","Y.Nakamura.1","N.Gisin.1","R.S.Sarthour.1","J.K.Anders.1","R.Ruskov.1","G.J.Pryde.2","E.Magesan.1","B.Doucot.1","P.CampagneIbarcq.1","E.Solano.5","A.Dunsworth.1","F.Nori.1","F.Motzoi.1","A.W.Eddins.1","T.O.White.1","P.Talkner.1","H.Cable.1","S.D.Bartlett.1","Hong.Su.Kim.1","T.Niemczyk.1","P.Six.1","M.Horodecki.1","C.Degen.1","Alireza.Beygi.1","D.G.Ferguson.1","L.Sun.32","J.Dressel.1","Gui.Lu.Long.1","J.C.Lee.1","Y.Castin.1","H.Huebl.1","P.Lewalle.1","A.M.Souza.1","M.Khezri.1","J.Zopes.1","V.F.Maisi.1","M.Naghiloo.1","P.M.Harrington.1","Alexander.Felski.1","Y.M.Blanter.1","M.Mariantoni.1","A.Orieux.1","J.Dalibard.1","D.Sank.1","Y.Tabuchi.1","S.Toyabe.1","Y.X.Watanabe.2","K.Molmer.2","R.Azouit.1","A.G.White.1","M.E.Schwartz.1","Y.Y.Chen.1","Todd.A.Brun.1","S.K.Manikandan.2","J.P.Pekola.1","R.Yamazaki.1","Carl.M.Bender.1","J.M.Schwarz.2","L.Mancino.1","D.W.Hook.1","Z.Chen.49","Y.Joglekar.1","M.D.Reed.1","S.Wehner.1","E.Jeffrey.1","M.A.Ciampini.1","C.J.Palmstrom.1","S.Filipp.2","J.M.R.Parrondo.1","J.P.S.Peterson.1","J.M.Horowitz.1","A.Noguchi.1","K.J.Resch.2","S.Sarkar.6","A.Auffeves.5","M.Neeley.1","C.A.Marx.1","Vlatko.Vedral.1","M.Sano.2","D.R.Tan.1","S.J.Bosman.1","P.A.Camati.1","R.Barends.1","Y.Murashita.1","Paola.Cappellaro.1","J.D.Osborn.1","John.M.Martinis.1","M.Boissonneault.1","C.C.Lang.1","L.DiCarlo.1","Y.Yin.2","Daicui.Zhou.1","R.Gross.1","T.Paterek.2","A.Sarlette.1","C.Jarzynski.1","R.ElGanainy.1","C.M.Caves.1","D.Olaya.3","J.M.Chow.1","J.Koch.1","D.A.Steck.1","M.Sarovar.1","Stephen.Weber.1","T.M.Yu.1","F.Monifi.1","B.P.Lanyon.1","E.Lutz.1","U.Vool.1","A.F.Kockum.1","G.Johansson.5","F.C.Wellstood.1","A.Blais.1","Z.H.Musslimani.1","P.Mataloni.2","K.Jacobs.2","A.Chantasri.1","P.Rouchon.1","R.B.Dalton.1","B.Campbell.6","T.B.Batalhao.1","Q.Ficheux.1","A.Bruno.1","K.B.Whaley.2","L.Feigl.1","A.G.Fowler.2","C.K.Ng.1","L.Bretheau.1","N.Hassanpour.1","Z.Wen.2","P.Hanggi.1","J.L.OBrien.2","P.Roushan.1","H.M.Wiseman.2","G.Gillett.1","B.Huard.1","K.Herb.1","M.Gianfreda.1","N.Cottet.1","A.Houck.1","C.Macklin.1","David.Schuster.1","J.Dempster.1","M.Steffen.2","D.Tan.3","B.L.Ioffe.1","J.P.OMalley.1","O.K.Kwon.1","K.S.Cujia.1","A.Wallraff.1","B.Chiaro.1","J.V.Koski.1","T.Hummer.1","G.Wendin.2","J.M.Fink.1","K.Keane.1","J.Y.Mutus.1","K.Micadei.1","S.Kono.1","C.Neill.1","M.Khajavikhan.1","N.Foroozani.1","J.M.P.Almeida.1","R.Serra.2","D.Zueco.1","C.Elouard.1","Jose.Alonso.1","M.Paternostro.1","J.Govenius.1","Irfan.Siddiqi.1","T.Sagawa.1","M.F.Gely.1","S.K.Ozdemir.2","S.Rotter.1","S.M.Girvin.1","J.Majer.1","Michel.H.Devoret.1","D.Bothner.1","F.Hocke.1","J.A.Schreier.1","A.Vainsencher.1","J.Zhao.47","M.Ueda.1","I.Rotter.7","K.G.Makris.1","F.Reinhard.1","S.Jezouin.1","S.P.Klevansky.1","A.Bolund.1","M.Barbieri.2","B.Fu.12","J.M.Boss.1","E.DupontFerrier.1","E.Solano.2","R.Vijay.1","A.M.Abbasi.1","S.J.Srinivasan.1","D.N.Christodoulides.3"],"figures":[{"filename":"catcher.png","material":"preprint","caption":"\\footnotesize \\textbf{Photon detection vs. homodyne detection (discussed in Chapter~5):} The behavior of a quantum emitter depends on how we detect its emission. If we hire a catcher as a detector which is sensitive to the energy quanta (addresses the particle notion of light), the emitter behaves like a pitcher (spontaneous jump behavior). However, if we instead ``listen\" to the emitter, it behaves according to the wave nature of its emitted energy (diffusive behavior).","label":"catcher","source":"arxiv","key":"4b28ccbf6c449570553d6027cd57c662","url":"https://inspirehep.net/files/4b28ccbf6c449570553d6027cd57c662"},{"filename":"maxwells_demon.png","material":"preprint","caption":"\\footnotesize \\textbf{ Quantum Maxwell's demon (discussed in Chapter~6):} We experimentally study a quantum version of Maxwell's demon who sorts particles that are in a quantum superposition of both hot and cold. We will see that the information obtained by the demon can be lost due to the decoherence and inefficient detection. Image adopted from Li's group.","label":"fig:test2","source":"arxiv","key":"35890d9affd3a39d540d3dad5028560f","url":"https://inspirehep.net/files/35890d9affd3a39d540d3dad5028560f"},{"filename":"cavity_1d.png","material":"preprint","caption":"\\footnotesize \\textbf{One dimensional cavity:} Two infinite superconducting walls separated by distance $L$ form a cavity that supports a discrete number of electromagnetic modes in the $z$-dimension (the second mode is shown). Due to the translational symmetry in $x$ and $y$ directions, the electromagnetic fields are only functions of $z$. For simplicity, we assume the electric field (red lines) has polarization along $x$ axis and consequently the magnetic field (blue lines) is along $y$ axis.","label":"fig:1Dcavity","source":"arxiv","key":"dfadde967ea2cb916688c21e8c287746","url":"https://inspirehep.net/files/dfadde967ea2cb916688c21e8c287746"},{"filename":"wigner0_1.png","material":"preprint","caption":"\\footnotesize \\textbf{Wigner distribution for photon-number states:} \\textbf{a}, The vacuum state $|0\\rangle$ has a Gaussian distribution centered at the origin of the phase space. \\textbf{b},  The single photon state $|1\\rangle$ exhibits negative probabilities around the origin.","label":"fig:wigner_fock","source":"arxiv","key":"443feccc382eec7438fa8e4faf808008","url":"https://inspirehep.net/files/443feccc382eec7438fa8e4faf808008"},{"filename":"coherent_c_n2.png","material":"preprint","caption":"\\footnotesize \\textbf{Photon number distributions for coherent states:} The blue (red) distribution shows the photon number distribution for a coherent state which has an average photon number $\\bar{n}=1/4\\  (\\bar{n}=16)$. The photon number distribution for the higher average number of photons is more like a Gaussian distribution.","label":"fig:coh_c_n","source":"arxiv","key":"b566b0f99440e053a03dc979f847aed9","url":"https://inspirehep.net/files/b566b0f99440e053a03dc979f847aed9"},{"filename":"wigner0_coh.png","material":"preprint","caption":"\\footnotesize \\textbf{Winger function for a coherent state:} \\textbf{a}, The Wigner function for a coherent state is a Gaussian distribution displaced from the origin by amount of $\\alpha$. The coherent state has minimum uncertainty in each quadrature like a vacuum state. \\textbf{b}, The evolution of coherent state under harmonic oscillator Hamiltonian  is simply a rotation around the origin.","label":"fig:wigner_coherent","source":"arxiv","key":"598327d99869728b860dc3c3ce65aac1","url":"https://inspirehep.net/files/598327d99869728b860dc3c3ce65aac1"},{"filename":"signal_kick_phase_shift.png","material":"preprint","caption":"\\footnotesize \\textbf{Phase shifts for coherent state in the rotating frame:} The phase shift of a coherent signal is easily detectable in the rotating frame.","label":"fig:sig_kick_rf","source":"arxiv","key":"3e593a13934c3483a909c303da6c68fc","url":"https://inspirehep.net/files/3e593a13934c3483a909c303da6c68fc"},{"filename":"toolbox.png","material":"preprint","caption":"\\footnotesize \\textbf{Circuit QED toolbox:} Quantum circuit technology relies on these three elements. The required nonlinearity comes from the JJ which is basically a dissipationless nonlinear inductor.","label":"fig:QED_toolbox","source":"arxiv","key":"6d9beafcb3770097bacfd9eb483d4e2d","url":"https://inspirehep.net/files/6d9beafcb3770097bacfd9eb483d4e2d"},{"filename":"jj.png","material":"preprint","caption":"\\footnotesize \\textbf{Josephson junction:} The JJ consists of two superconductors separated by a thin layer of insulator. The Cooper pairs on each side can tunnel through the insulator and create a super-current $I$. Remarkably, the current can be non-zero even when $V=0$. The highly nonlinear $I$-$V$ characteristics of the JJ can be exploited for quantum circuits.","label":"fig:jj","source":"arxiv","key":"7818686c81f483006424258c0ae1a0ea","url":"https://inspirehep.net/files/7818686c81f483006424258c0ae1a0ea"},{"filename":"transmon_simple.png","material":"preprint","caption":"\\footnotesize \\textbf{Transmon circuit:} The transmon circuit consists of a JJ shunted by a relatively large capacitor so that $E_J\\gg E_C$.","label":"fig:transmon_simple","source":"arxiv","key":"5818eb902f432cf8dfaabe114bb3801c","url":"https://inspirehep.net/files/5818eb902f432cf8dfaabe114bb3801c"},{"filename":"anharm_energylevel.png","material":"preprint","caption":"\\footnotesize \\textbf{Transmon energy levels:} A typical transmon ($E_J/E_C=40$) potential (Eq~\\eqref{eq:trans_H0} in solid black curve) in comparison with a nonlinear oscillator (Eq.~\\eqref{eq:trans_H1} in the solid red curve) and a harmonic oscillator (dashed parabola). The first three energy levels are also depicted for the transmon (nonlinear oscillator) in comparison to the harmonic oscillator. The typical values for transition energies/frequencies are shown. Note $E_{01}=\\hbar \\omega_{01} $ and we set $\\hbar=1$.","label":"fig:anharm_energylevel","source":"arxiv","key":"13bd011ff7dff18071435cfa93cb8329","url":"https://inspirehep.net/files/13bd011ff7dff18071435cfa93cb8329"},{"filename":"qubit_cavity.png","material":"preprint","caption":"\\footnotesize \\textbf{The qubit-cavity interaction:} The qubit is placed at the center of the cavity where the electromagnetic field is maximum for the first mode of the cavity. The qubit interacts with the electric field via its electric dipole $d$.","label":"fig:qubit_cavity","source":"arxiv","key":"7ac33fe932c9ba11eabf8b80b5f41c10","url":"https://inspirehep.net/files/7ac33fe932c9ba11eabf8b80b5f41c10"},{"filename":"avoidcross3.png","material":"preprint","caption":"\\footnotesize \\textbf{Dressed states vs bare states:} The panels illustrate the dressed states of the qubit-cavity system for different qubit-cavity detunings in comparison with the bare states (refer to the main text for a more detailed description). Note that this illustration is not accurate and lacks some details but we rather to avoid them here.","label":"fig:avoidcross2","source":"arxiv","key":"75065fed4d070fc3418bac3e415110ab","url":"https://inspirehep.net/files/75065fed4d070fc3418bac3e415110ab"},{"filename":"avoidcross1.png","material":"preprint","caption":"{\\footnotesize \\textbf{Avoided crossing:} The transition energy from higher and lower dressed states to the ground state versus the detuning $\\Delta$. The transition energy is scaled by the energy of the cavity $\\omega_c$ and the detuning is scaled by the coupling rate $g$}. The dashed lines indicate the bare states' transition. Note that you can somehow see a similar avoided-crossing curve in Figure~\\ref{fig:avoidcross2} by connecting the upper (lower) dressed states in different detunings together.","label":"fig:avoidcross1","source":"arxiv","key":"f8cdb5552f8c597ea3083ee09a2c1a48","url":"https://inspirehep.net/files/f8cdb5552f8c597ea3083ee09a2c1a48"},{"filename":"pe_classic_shevron.png","material":"preprint","caption":"\\footnotesize \\textbf{Rabi oscillations:} \\textbf{a}, The chevron plot. The excited state population $P_e$ versus time for different detunings $\\Delta_q$.  \\textbf{b}, Three cuts from the chevron plot at different detuning values. The on-resonant drive gives the maximum contrast for the oscillations.","label":"fig:pe_rabi_classic","source":"arxiv","key":"13b585eacdbd220b4e61aa8c230c283d","url":"https://inspirehep.net/files/13b585eacdbd220b4e61aa8c230c283d"},{"filename":"Vpm_bloch_rabi.png","material":"preprint","caption":"\\footnotesize  \\textbf{Eigenstates on the Bloch sphere for a driven qubit:} The eigenstates $|V_\\pm \\rangle$ for a detuned driven qubit make angle $\\theta$ respect to the equator in the Bloch sphere. This picture gives a better understanding of  why the population doesn't reach to the maximum value for a detuned drive.","label":"fig:Vpm_bloch","source":"arxiv","key":"a03c7bedbd129c58d9d6049b799a2626","url":"https://inspirehep.net/files/a03c7bedbd129c58d9d6049b799a2626"},{"filename":"sum_up_rabi.png","material":"preprint","caption":"\\footnotesize \\textbf{Driven qubit state evolution in the Bloch sphere:} The red (blue) line shows the evolution of a driven qubit in the lab frame (rotating frame of the drive) \\textbf{a}, for an on-resonant drive and \\textbf{b}, for a detuned drive.","label":"fig:sum_up_rabi","source":"arxiv","key":"b9b9e3b8f42524e6163b0eceaa117d4b","url":"https://inspirehep.net/files/b9b9e3b8f42524e6163b0eceaa117d4b"},{"filename":"t1_t2.png","material":"preprint","caption":"\\footnotesize  Relaxation and dephasing of a qubit.","label":"fig:T2_time","source":"arxiv","key":"07581c4ea8717af52b228957ced25609","url":"https://inspirehep.net/files/07581c4ea8717af52b228957ced25609"},{"filename":"sumupdephasrelax.png","material":"preprint","caption":"\\footnotesize \\textbf{Dephasing and relaxation for the qubit:} The solution of the Lindblad equation for a driven qubit in presence of dephasing and relaxation.","label":"fig:sum_up_depha_relax","source":"arxiv","key":"2a30e04914ed3c27bb26cd5ae2bbc5e2","url":"https://inspirehep.net/files/2a30e04914ed3c27bb26cd5ae2bbc5e2"},{"filename":"rectang_cavity_TE.png","material":"preprint","caption":"101","label":"fig:rect_cav","source":"arxiv","key":"aa245e504e7a2aae91fc77988e97e48d","url":"https://inspirehep.net/files/aa245e504e7a2aae91fc77988e97e48d"},{"filename":"cavity_sim.png","material":"preprint","caption":"\\footnotesize \\textbf{HFSS simulation for cavity transmission:} The cavity transmission is simulated by HFSS (red curve) which is in agreement with actual measurement (blue curve).","label":"fig:cavity_3d","source":"arxiv","key":"2230b5a3855132877ca82db6f58814f4","url":"https://inspirehep.net/files/2230b5a3855132877ca82db6f58814f4"},{"filename":"cavity_kappa.png","material":"preprint","caption":"\\footnotesize \\textbf{The cavity linewidth characterization:} The cavity linewidth $\\kappa$ can be quantified by measuring the scattering parameters of the cavity. \\textbf{a},\\textbf{b} In the transmission measurement S21, the cavity linewidth can be estimated by the bandwidth that the transmission signal drops by 3 dB. \\textbf{c}, More carefully, one can scale the transmission in the linear form and fit to the Lorentzian function. The FWHM of the Lorentzian function would be the cavity linewidth.","label":"fig:cavity_kappa","source":"arxiv","key":"884ae774389941223529d0b4a7acd472","url":"https://inspirehep.net/files/884ae774389941223529d0b4a7acd472"},{"filename":"cavity_xhi_shift.png","material":"preprint","caption":"\\footnotesize \\textbf{The cavity phase shift across the resonance:} The transmitted signal through the cavity experiences a $\\pi$ phase shift across the resonance of the cavity. Near resonance, the phase shift is approximately linear with a slope of $2/\\kappa$.","label":"fig:cavity_chi_shift","source":"arxiv","key":"f9704b0cb055daff15d247f6e3bbf051","url":"https://inspirehep.net/files/f9704b0cb055daff15d247f6e3bbf051"},{"filename":"liftoff.png","material":"preprint","caption":"\\footnotesize \\textbf{Double stack e-beam resist:} \\textbf{a}, With a single layer of resist, it is often difficult to get small and clean patterns. Mainly because the wall of the resist may also get deposited which connects top layers to the bottom layers which make it difficult to properly lift-off the resist without peeling off the actual pattern. \\textbf{b}, This issue can be avoided by using two layers of the resist. The top layer provides sharp edges as a mask and the bottom layer act as a spacer. The proper amount of undercut aids the liftoff process. \\textbf{c}, Moreover, the undercut of the lower resist can be used to created suspended resist (free-standing bridge) which is used for the JJ fabrication in double angle evaporation.","label":"fig:liftoff","source":"arxiv","key":"a3c2c1e1960ac2dd837705f0949d3445","url":"https://inspirehep.net/files/a3c2c1e1960ac2dd837705f0949d3445"},{"filename":"designcad.png","material":"preprint","caption":"\\footnotesize \\textbf{A simple design for transmon qubit:} A qubit design consists of few polygons in different layers in DesignCAD software. The free-standing bridge design for a JJ and few micrometer extremities are shown in red (Layer~0). The connector lines in the two steps (Layer~1,2) shown in blue and capacitor pads (Layer~3) in green. The corresponding e-beam dosage for each layer is displayed in Table~\\ref{table:SEMdose}.","label":"fig:designcad","source":"arxiv","key":"b1dde9e06e23c2f8d0cbaef2a1b0a62c","url":"https://inspirehep.net/files/b1dde9e06e23c2f8d0cbaef2a1b0a62c"},{"filename":"icebath.png","material":"preprint","caption":"\\footnotesize \\textbf{e-beam resist development recipe:} \\textbf{Step~1}, ZEP developer in ice bath, wait for developer to cool down to T$\\sim 1^\\circ$C. Plunge the sample into the beaker for 30 seconds, then blow dry immediately. \\textbf{Step~2}, MMA developer for 160 seconds and blow dry afterward. \\textbf{Step~3}, Rinse with IPA for 15 seconds. The left panel shows the JJ area in the simple transmon design (Fig.~\\ref{fig:designcad}) before and after development. Note the undercut and the suspended bridge in the middle.","label":"fig:icebath","source":"arxiv","key":"766ecd63bfd92584a4a0f2ae70b42c3a","url":"https://inspirehep.net/files/766ecd63bfd92584a4a0f2ae70b42c3a"},{"filename":"jj_fab2.png","material":"preprint","caption":"\\footnotesize \\textbf{Double-angle evaporation and Josephson junction fabrication:} Considering the indicated cross-section of the freestanding bridge in Figure~\\ref{fig:liftoff} we use double angle evaporation to fabricate the JJ. \\textbf{a}, The first layer of aluminum evaporation is about 30 nm. \\textbf{b}, Introducing the oxygen mixture to form a thin layer of aluminum oxide $\\sim 1$ nm as the insulator. \\textbf{c}, The second layer of aluminum evaporation is about 60 nm at the opposite angle {normal to the substrate surface}. \\textbf{d}, Removing the resists and the {deposited aluminum} in a lift-off process.","label":"fig:qubit_fab_2angle","source":"arxiv","key":"f6761629ff3b9d7e67fc3fabc8bade96","url":"https://inspirehep.net/files/f6761629ff3b9d7e67fc3fabc8bade96"},{"filename":"jj_patern.png","material":"preprint","caption":"\\footnotesize \\textbf{Qubit pattern SEM}.","label":"fig:qubit_fab","source":"arxiv","key":"b266190deaf18628ef2cf854111f4573","url":"https://inspirehep.net/files/b266190deaf18628ef2cf854111f4573"},{"filename":"transmon_pad.png","material":"preprint","caption":"transmon_pad.pdf","label":"fig:qubit_fab","source":"arxiv","key":"8d5f73129ba24e9cad670e9df8ae70ef","url":"https://inspirehep.net/files/8d5f73129ba24e9cad670e9df8ae70ef"},{"filename":"qubit_cap1.png","material":"preprint","caption":"\\footnotesize \\textbf{The HFSS simulation for the transmon shunting capacitor:} Using HFSS, the shunting capacitance is calculated to be $C=0.057$ pF (for the simple design shown in Figure~\\ref{fig:designcad}) which results in $E_J \\sim 340$ MHz.","label":"fig:td1","source":"arxiv","key":"b435958bf0e962d27d7e93d6fc1aaeac","url":"https://inspirehep.net/files/b435958bf0e962d27d7e93d6fc1aaeac"},{"filename":"exp_setup_char.png","material":"preprint","caption":"\\footnotesize \\textbf{The minimum experimental setup for basic qubit characterization:} The input lines can be used for qubit manipulation signals and cavity probe signals. Note that we don't get any signal back from input lines (because of $\\sim 2\\times 50$ dB of attenuation). However, because we have a circulator connected to the strong port, the reflection off of the strong port can be measured by sending the signal from the input~\\#2 and receiving it back from the output. We will refer to the fridge circuitry (depicted in left) by the short version (depicted in right) throughout this document.","label":"fig:exp_setup_char","source":"arxiv","key":"5a3acf46a7680acf329df0be46990c63","url":"https://inspirehep.net/files/5a3acf46a7680acf329df0be46990c63"},{"filename":"punch_out.png","material":"preprint","caption":"\\footnotesize {\\textbf{The ``punch-out\" measurement:} The low (high) power transmission of the cavity indicated by the blue (red) trace. For low power probe signal, the qubit remains in the ground state and we essentially measure the dressed cavity transition indicated by the blue double-sided arrow. In high power case, the is qubit ``washed out\" and we essentially measure the bare cavity transition as depicted by the red double-sided arrow.}","label":"fig:punch_out","source":"arxiv","key":"1e5e7710e4cbdb31e0af042dc0c54d43","url":"https://inspirehep.net/files/1e5e7710e4cbdb31e0af042dc0c54d43"},{"filename":"spectroscopy2.png","material":"preprint","caption":"\\footnotesize \\textbf{Two-tone spectroscopy:} \\textbf{a}, The schematics for experimental setup for two-tone spectroscopy. A constant fixed frequency signal from the VNA at the cavity low power probes the cavity while a signal from the BNC sweeps across different frequencies from 4 to 6 GHz. \\textbf{b}, The cavity transmission versus BNC frequency shows a dip at qubit frequency. \\textbf{c}, With higher power for BNC the two-photon transition is also detectable (red trace). Note that the qubit transition is power broadened.","label":"fig:spectroscopy","source":"arxiv","key":"21d37dbafc5d83cda6e432a8723bc43f","url":"https://inspirehep.net/files/21d37dbafc5d83cda6e432a8723bc43f"},{"filename":"mixer.png","material":"preprint","caption":"\\footnotesize \\textbf{$I/Q$ mixer:} \\textbf{a}, An $I/Q$ mixer can be used as a modulator. Note that the outputs correspond to $I$ and $Q$ pulses are out of phase by 90 degrees. \\textbf{b}, The  DC pulse in $I/Q$ ports can be used to control (switch) a continuous signal. The blue (red) DC pulse is the input for port $I$ (port $Q$) and its corresponding output is in-phase (90 out-of-phase) with respect to the local oscillator.","label":"fig:mixer","source":"arxiv","key":"278945d875b907a8e90d3fc5a3ed82b9","url":"https://inspirehep.net/files/278945d875b907a8e90d3fc5a3ed82b9"},{"filename":"mixer_rotation_x_y.png","material":"preprint","caption":"\\footnotesize \\textbf{Qubit rotation pulses:} Pulses in the $I,Q$ ports results in rotation in $x,y$ directions in the Bloch sphere. \\textbf{a}, A $\\pi/2$ pulse in port $I$ rotates the qubit along the $x$ direction and prepares a superposition state along $y$ axis. \\textbf{b}, $\\pi$ pulse prepares the qubit in the excited state. \\textbf{c}, A $\\pi/2$ pulse on $Q$ rotates the qubit around the $y$ axis and prepares the qubit in a superposition along $x$ axis.","label":"fig:rabi_along_x_y","source":"arxiv","key":"34526c4fc07ee6b3f7e0af651699fb1e","url":"https://inspirehep.net/files/34526c4fc07ee6b3f7e0af651699fb1e"},{"filename":"SSB.png","material":"preprint","caption":"\\footnotesize \\textbf{Single Sideband Modulation (SSB):} By up-converting the LO signal by $\\Omega_{\\mathrm{SSB}}$ the mixer outputs at qubit frequency. The relative phase of SSB pulses determines the phase of the output signal thus the direction of the rotation for the qubit.","label":"fig:SSB","source":"arxiv","key":"c20bf6f835f46943255fb6f37cd85fde","url":"https://inspirehep.net/files/c20bf6f835f46943255fb6f37cd85fde"},{"filename":"readout.png","material":"preprint","caption":"\\footnotesize \\textbf{Qubit state readout, homophone detection:} The qubit-state-dependent phase shift is detected by comparing the signal which passes the cavity with the reference signal.","label":"fig:readout","source":"arxiv","key":"b79cdb8dda168bb7e1aef587602c61d9","url":"https://inspirehep.net/files/b79cdb8dda168bb7e1aef587602c61d9"},{"filename":"phasor_readout.png","material":"preprint","caption":"\\footnotesize \\textbf{Readout in phase space representation:} A coherent signal with a minimum uncertainty in each quadrature probes the cavity whose frequency shifts by $\\pm \\chi$ depends on the state of the qubit. The transmitted (reflected) signal acquires a state-dependent-phase shift $\\pm 2\\chi/\\kappa$ as discussed in Section~\\ref{section:cavity}.","label":"fig:phasor_readout","source":"arxiv","key":"a403c1efac097a5fa6d5f12718e59ff3","url":"https://inspirehep.net/files/a403c1efac097a5fa6d5f12718e59ff3"},{"filename":"rabi_exp_1.png","material":"preprint","caption":"\\footnotesize \\textbf{Rabi measurement:} The sequence for the measurement of Rabi oscillations and the typical room temperature circuitry are shown.","label":"fig:rabi","source":"arxiv","key":"2980c8870e640412e9af7707510cb3b2","url":"https://inspirehep.net/files/2980c8870e640412e9af7707510cb3b2"},{"filename":"rabi100ns.png","material":"preprint","caption":"\\footnotesize \\textbf{Chevron plot:} \\textbf{a}, A typical result of Rabi oscillation measurements. \\textbf{b}, By repeating the Rabi measurement for different qubit frequencies we obtain the ``chevron plot\" which can be used to calibrate the qubit frequency. \\textbf{c}, The Rabi oscillation frequency versus qubit pulse frequency. As we discussed in Chapter~2, the minimum oscillation rate corresponds to the maximum contrast for Rabi oscillations which happens when the qubit pulse is on-resonance with qubit frequency.","label":"fig:rabi100ns","source":"arxiv","key":"b01672ceb7ae9ca38457e2e3215b9335","url":"https://inspirehep.net/files/b01672ceb7ae9ca38457e2e3215b9335"},{"filename":"T1_exp_1.png","material":"preprint","caption":"\\footnotesize \\textbf{$T_1$ Measurement:} The $T_1$ measurement sequence (consider the experimental setup depicted in Figure~\\ref{fig:rabi}) and a typical result. The qubit lifetime (relaxation time $T_1$) can be measured by fitting the result  to an exponential decay function.","label":"fig:T1_measurement","source":"arxiv","key":"d159d729f08b25302319fdafa1819c55","url":"https://inspirehep.net/files/d159d729f08b25302319fdafa1819c55"},{"filename":"ramsey_exp_1.png","material":"preprint","caption":"\\footnotesize \\textbf{Ramsey measurement:} The sequence for the Ramsey measurement (consider the experimental setup depicted in Figure~\\ref{fig:rabi}) and the typical Ramsey result. The blue (red) curve is when the pulses are on-resonance (0.3 MHz off-resonance) with the qubit frequency. The dephasing time $T_2^*$ can be determined by fitting the data to exponentially decaying sine function $F(t)=A+B\\sin(2 \\pi \\Delta_d t+\\phi) \\exp(t/T_2^*)$.","label":"fig:ramsey","source":"arxiv","key":"9c51054befcbdac59106254a8f79fb83","url":"https://inspirehep.net/files/9c51054befcbdac59106254a8f79fb83"},{"filename":"state_tomog.png","material":"preprint","caption":"\\footnotesize \\textbf{Full state tomography readout pulses:} A readout pulse without any tomographic pulse gives the expectation value for $\\sigma_z$ since it projects the qubit in ground or excited state. A readout pulse augmented by tomographic pulse can be used to measure the expectation values for $\\sigma_x, \\sigma_y$ or any arbitrary basis in the Bloch sphere.","label":"fig:state_tomog","source":"arxiv","key":"c32161eaea37fa4332c8a38c8dbe60b1","url":"https://inspirehep.net/files/c32161eaea37fa4332c8a38c8dbe60b1"},{"filename":"LJPA_simple.png","material":"preprint","caption":"\\footnotesize \\textbf{JPA Schematic:}  A Josephson parametric amplifier can be considered as a nonlinear LC oscillator (shaded region) connected to a current source via impedance $Z_0$ .","label":"fig:JPA_simple","source":"arxiv","key":"70f3edb9fb2e12ffc73ce7ee763ac057","url":"https://inspirehep.net/files/70f3edb9fb2e12ffc73ce7ee763ac057"},{"filename":"JPA_tilt2.png","material":"preprint","caption":"\\footnotesize \\textbf{Duffing resonator response:} \\textbf{a}. Solutions to Equations~\\ref{eq:Duffing_JPA4}. \\textbf{a} The resonance frequency decreases by increasing the power and ultimately the system enters the bi-stable regime where there are more that one solution to the Equation~\\ref{eq:Duffing_JPA4}. \\textbf{b}, This bifurcation behavior also can be seen in the phase response of the oscillator. Right before the bifurcation, the system exhibits sharp response respect to the detuning and power. The sensitivity for power is more clearly shown in Figure~\\ref{fig:JPA_pup_transfer}","label":"fig:JPA_tilt2","source":"arxiv","key":"a1f5be50b906c45e267c0bd65019f311","url":"https://inspirehep.net/files/a1f5be50b906c45e267c0bd65019f311"},{"filename":"JPA_pup_transfer.png","material":"preprint","caption":"\\footnotesize \\textbf{JPA transfer function:} The change in phase of the oscillations in JPA versus the power of the drive. This curve is a cross section from Figure~\\ref{fig:JPA_tilt2}b at $\\tilde{\\Delta}=1.72$ (red dashed line), shwing a sharp response of the phase to the small changes in the power which is the essence of the JPA amplification.","label":"fig:JPA_pup_transfer","source":"arxiv","key":"8b5230b463412ae095401289b1b1cdbf","url":"https://inspirehep.net/files/8b5230b463412ae095401289b1b1cdbf"},{"filename":"paramp_added.png","material":"preprint","caption":"\\footnotesize \\textbf{The minimum experimental measurement setup with paramp:} The input lines can be used for qubit manipulation signals and cavity probe signals. An additional input line is dedicated to the paramp pump. The pump signal passes by a directional coupler and circulator to reach the paramp and the reflected signal (which have acquired a phase shift) goes to the output line. A DC line also is used to flux bias the paramp.","label":"fig:paramp_added","source":"arxiv","key":"cd15a731805b75aafef3bbe7b7c28b51","url":"https://inspirehep.net/files/cd15a731805b75aafef3bbe7b7c28b51"},{"filename":"single_pump.png","material":"preprint","caption":"\\footnotesize \\textbf{The paramp single pump operation:} \\textbf{a}, By looking at the phase response of the JPA, we obtain a rough estimation of proper power and flux bias to have sharp behavior at a desired frequency. \\textbf{b}, Then we add a pump and set the power and frequency to the estimated values. We should be able to see a small amount of gain by adjusting the power. Then we fine tune the power, flux bias, pump frequency, and pump phase to obtain a reasonable amount of gain $\\sim 20$ dB and bandwidth $\\sim 100$ MHz.","label":"fig:single_pump","source":"arxiv","key":"205c156bde49041a5581a0c4ac7cbf33","url":"https://inspirehep.net/files/205c156bde49041a5581a0c4ac7cbf33"},{"filename":"double_pump.png","material":"preprint","caption":"\\footnotesize \\textbf{The paramp double pump operation.} ","label":"fig:double_pump","source":"arxiv","key":"02357eeb15aa329658dc25b80351951e","url":"https://inspirehep.net/files/02357eeb15aa329658dc25b80351951e"},{"filename":"amp_vs_phase_JPA.png","material":"preprint","caption":"\\footnotesize \\textbf{Phase sensitive amplification:} The upper (lower) panel demonstrates the paramp operation for amplification when the information encoded in the amplitude (phase) of the signal.","label":"fig:amp_vs_phase_JPA","source":"arxiv","key":"06fcc7ccbc5040d98d5d146ebd22ae8f","url":"https://inspirehep.net/files/06fcc7ccbc5040d98d5d146ebd22ae8f"},{"filename":"bloch.png","material":"preprint","caption":"\\footnotesize \\textbf{Bloch sphere:} Projective measurement of the state $|\\psi\\rangle$ in the i-basis. The red and blue arrows indicates the backaction of the measurement.  ","label":"fig:bloch","source":"arxiv","key":"65f60c151b921eb854c19c4d99d83d50","url":"https://inspirehep.net/files/65f60c151b921eb854c19c4d99d83d50"},{"filename":"QM_simple_model.png","material":"preprint","caption":"\\footnotesize \\textbf{Quantum measurement, simple model:} A free particle passes by and interacts with a qubit. The interaction is in the form of a push or pull depending on the state of the qubit. The position of the particle when it hits the screen tells us about the state of the qubit. The free particle has its natural Gaussian distribution. The separation between the two distributions is proportional to the interaction strength and the interaction time.","label":"fig:QM_simple_model","source":"arxiv","key":"69b84e930e3b48d063411baad9884926","url":"https://inspirehep.net/files/69b84e930e3b48d063411baad9884926"},{"filename":"QM_simple_model_s.png","material":"preprint","caption":"\\footnotesize \\textbf{Strong measurement:} If the particle strongly interacts with the qubit, the separation between two distributions would be large enough so that we can readout the qubit state just by knowing in which distribution the particle has landed.","label":"fig:QM_simple_model_s","source":"arxiv","key":"a43cd1944f3855a84705325a2e5d78b3","url":"https://inspirehep.net/files/a43cd1944f3855a84705325a2e5d78b3"},{"filename":"QM_simple_model_w.png","material":"preprint","caption":"\\footnotesize \\textbf{Weak measurement:} In the limit that the particle weakly interacts with the qubit, the separation between the two distributions would be smaller. This gives partial information about the state of the qubit.","label":"fig:QM_simple_model_w","source":"arxiv","key":"87f83ef9a3a51db267ec0140f9daf4ce","url":"https://inspirehep.net/files/87f83ef9a3a51db267ec0140f9daf4ce"},{"filename":"POVM_cQED.png","material":"preprint","caption":"\\footnotesize \\textbf{Weak measurement cQED:} \\textbf{a}, The qubit-state-dependent phase shift of the cavity probe signal. \\textbf{b}, A more realistic schematic for the phase shift detection.","label":"fig:povm_QED","source":"arxiv","key":"00d52a7744b54581b4f8ccfd52d2825c","url":"https://inspirehep.net/files/00d52a7744b54581b4f8ccfd52d2825c"},{"filename":"overlap_PV.png","material":"preprint","caption":"\\footnotesize \\textbf{Measurement signal distribution in the weak limit:} In the limit of weak measurement, the separation between the two distributions is much smaller than the variance of distributions. In such a case, we can approximate the two distributions by a distribution centered at $\\langle \\sigma_z \\rangle$ as shown in Exercise~1.","label":"fig:overlap_PV","source":"arxiv","key":"7eb1d4234684bff02be01162fd7a10a5","url":"https://inspirehep.net/files/7eb1d4234684bff02be01162fd7a10a5"},{"filename":"SSE_update.png","material":"preprint","caption":"\\footnotesize \\textbf{SSE update trajectory:} The measurement signal $V_i$ is used to infer $d\\mathcal{W}_i$. The pure state evolution can then be reconstructed with the SSE. In the right panel, the evolution is represented in terms of Bloch coordinates.","label":"fig:SSE_update","source":"arxiv","key":"a213d2ed9cc5eb311cf194b15427a719","url":"https://inspirehep.net/files/a213d2ed9cc5eb311cf194b15427a719"},{"filename":"x_measurement_simple.png","material":"preprint","caption":"\\footnotesize \\textbf{$x$-measurement schematic:} A qubit decays into a modeof the transmission line where we perform homodyne measurement.","label":"fig:x_measurement_simple","source":"arxiv","key":"2df94f898890bf58a7dafc554662f822","url":"https://inspirehep.net/files/2df94f898890bf58a7dafc554662f822"},{"filename":"overlap_PVx.png","material":"preprint","caption":"font=footnotesize : \\textbf{Homodyne measurement signal distribution in the weak limit, $x$-measurement:} Note that $\\gamma_1 dt \\ll 1$ therefore $\\sqrt{\\gamma_1 dt} \\gg \\gamma_1 dt$","label":"fig:overlap_PVx","source":"arxiv","key":"a0b60eb11b934d2aafcc2656e0a00019","url":"https://inspirehep.net/files/a0b60eb11b934d2aafcc2656e0a00019"},{"filename":"dum_sig_cancelation.png","material":"preprint","caption":"\\footnotesize \\textbf{Dumb-signal cancellation:} A copy of the readout pulse with proper amplitude and phase cancels the readout signal in $I$ quadrature while maintaining the information along the $Q$ quadrature (separation $\\mathrm{Amp}\\times \\delta \\theta$ is preserved) since the paramp works efficiently in the weak signal regime.","label":"fig:dum_sig_cancelation","source":"arxiv","key":"ea3a579066865df0fb1707d974527808","url":"https://inspirehep.net/files/ea3a579066865df0fb1707d974527808"},{"filename":"chi_nbar1.png","material":"preprint","caption":"\\footnotesize \\textbf{Quantum efficiency calibration setup}. ","label":"fig:chi_nbar1","source":"arxiv","key":"97c3862327a0629f3e61e502fe06fe5f","url":"https://inspirehep.net/files/97c3862327a0629f3e61e502fe06fe5f"},{"filename":"chi_nbar2.png","material":"preprint","caption":"\\footnotesize \\textbf{The $\\chi$ calibration result:} \\textbf{a}, The Ramsey experiment result for different offset values of Ch3. \\textbf{b}, Two cuts from the sweep data in \\textbf{a} indicated by dashed lines. \\textbf{c}, The frequency and the damping rate for the Ramsey data of panel (a) versus the DC offset of Ch3. By fitting the red curve to a parabola we get coefficients $K_0$, and $K_1$, and $K_2$, which will be used to find the optimal quadrature for the measurement \\textbf{d}, The damping rate versus the frequency is ideally a line with a slope of $4\\chi/\\kappa$.","label":"fig:chi_nbar2","source":"arxiv","key":"357e24f41fe69a6d41c61890912d7373","url":"https://inspirehep.net/files/357e24f41fe69a6d41c61890912d7373"},{"filename":"Mixer_anngle.png","material":"preprint","caption":"\\footnotesize \\textbf{ Mixer output:} The output of the mixer is a coherent signal whose phase and amplitude depend on Ch3/Ch4 amplitude and offset. The parameter $f_k$ quantifies the strength of measurement and $\\theta$ is the measurement quadrature.","label":"fig:Mixer_anngle","source":"arxiv","key":"564bdbf3edba54c2e5c7af42ea16468c","url":"https://inspirehep.net/files/564bdbf3edba54c2e5c7af42ea16468c"},{"filename":"sweep_theta_Ramsey.png","material":"preprint","caption":"\\footnotesize  \\textbf{Ramsey measurements for a sweep of different angles.}","label":"fig:sweep_theta_Ramsey","source":"arxiv","key":"1314126619476dd2d67d31e28f420ed2","url":"https://inspirehep.net/files/1314126619476dd2d67d31e28f420ed2"},{"filename":"sweep_theta_histo.png","material":"preprint","caption":"font=normalsize : \\footnotesize \\textbf{Calibration of $\\eta$:} Comparison of the measurement histograms for $|g\\rangle$ and $|e\\rangle$ for different $\\theta$.","label":"fig:sweep_theta_histo","source":"arxiv","key":"35578784ee46205fe7d5157f5e401b98","url":"https://inspirehep.net/files/35578784ee46205fe7d5157f5e401b98"},{"filename":"rabi_tomog_diagnosis.png","material":"preprint","caption":"\\footnotesize  \\textbf{Rabi tomography diagnosis:}  \\textbf{a}, A perfect calibration. \\textbf{b} The $\\pi/2$ pulses needed to be weaker, either shorter pulses or lower amplitude. \\textbf{c} The $\\pi/2$ pulse for $x\\  (y)$ needed lower (higher) amp/duration. \\textbf{d}, Mixer orthogonality is slightly higher that 90 degrees. \\textbf{d}, Mixer orthogonality is slightly lower that 90 degrees.  ","label":"fig:rabi_tomog_diagnosis","source":"arxiv","key":"2a48f1a7e38f821a6aee344d2b8e5b15","url":"https://inspirehep.net/files/2a48f1a7e38f821a6aee344d2b8e5b15"},{"filename":"driven_z_measur_seq.png","material":"preprint","caption":"\\footnotesize  \\textbf{Driven $z$-measurement sequence}. ","label":"fig:driven_z_measur_seq","source":"arxiv","key":"2db81ef0af7b2ff6073df113b0543da7","url":"https://inspirehep.net/files/2db81ef0af7b2ff6073df113b0543da7"},{"filename":"scaled_v.png","material":"preprint","caption":"\\footnotesize  \\textbf{Digitized weak measurement signal scaling}. ","label":"fig:scaled_v","source":"arxiv","key":"fcf017dc22522c14cd5e571cd59bc4d9","url":"https://inspirehep.net/files/fcf017dc22522c14cd5e571cd59bc4d9"},{"filename":"SME_traj_update.png","material":"preprint","caption":"font=footnotesize :  \\textbf{Quantum trajectory updated by SME:} \\textbf{a.} A typical homodyne measurement signal $V(t)$ corresponding to $z$-measurement of a driven qubit, $\\Omega_R/2\\pi=0.6, k=1,\\eta=0.35,dt=20$ ns. \\textbf{b.} The corresponding updated quantum trajectory using Equations~(\\ref{eq:SME_zx_i}) for solid lines and Equations~(\\ref{eq:SME_zx_ii}) for dashed line. As you can see, for these drive parameters both methods are practically the same.","label":"fig:SME_traj_update","source":"arxiv","key":"c424aec069e5524cc3ae849ad56e5713","url":"https://inspirehep.net/files/c424aec069e5524cc3ae849ad56e5713"},{"filename":"tomog_validation.png","material":"preprint","caption":"\\footnotesize  \\textbf{Tomographic reconstruction}.","label":"fig:tomog_verification","source":"arxiv","key":"747fbb907739f006c71dff1813a60382","url":"https://inspirehep.net/files/747fbb907739f006c71dff1813a60382"},{"filename":"photon_detection.png","material":"preprint","caption":" \\footnotesize \\textbf{Photon detection:} \\textbf{a}, The qubit is initially prepared in the excited state and interacts with an electromagnetic mode. The qubit state and its emission to the mode are entangled via the interaction Hamiltonian~\\eqref{eq:int_hamch5}. \\textbf{b}, The detection of a photon results is a sudden jump for the emitter state. \\textbf{c}, The average of many jump detections results in an exponential decay for the state of the qubit.","label":"fig:photon_detection","source":"arxiv","key":"26f3f67e9821d083dd6b2e06a2a65595","url":"https://inspirehep.net/files/26f3f67e9821d083dd6b2e06a2a65595"},{"filename":"homodyne_detection.png","material":"preprint","caption":"\\footnotesize \\textbf{Homodyne detection:} \\textbf{a}, The spontaneous emission of the emitter is detected by homodyne measurement. The local oscillator has a well defined relative phase $\\phi$ with respect to the qubit rotating frame which determines the amplification quadrature shown in \\textbf{b}. The measurement happens only in one quadrature along $\\phi$-axis. The fluctuations in the orthogonal quadrature are de-amplified, which means we do not learn about fluctuations in that quadrature. This allows for noiseless amplification for the $\\phi$-quadrature~\\cite{caves1982quantum}","label":"fig:homodyne_detection","source":"arxiv","key":"772d9f844482bf7d81d90304082bf244","url":"https://inspirehep.net/files/772d9f844482bf7d81d90304082bf244"},{"filename":"seq_spon2.png","material":"preprint","caption":"\\footnotesize {\\bf The experimental setup and sequence:} The emitter is initialized in the excited state or in a superposition state by a preparation pulse. Right after the preparation, the homodyne signal is collected. Finally, we apply a tomographic rotation pulses along different axes followed by a high-power readout pulse to projectively measure the final state of the emitter.","label":"seq_spon","source":"arxiv","key":"d53c60ffb5c2e4dedbcc508f6f607e5a","url":"https://inspirehep.net/files/d53c60ffb5c2e4dedbcc508f6f607e5a"},{"filename":"result_1_spon.png","material":"preprint","caption":"\\footnotesize {\\bf Conditional dynamics of spontaneous decay:} The tomographic result is the averaged tomographic readout conditioned on the outcome of the homodyne measurement to determine $x \\equiv \\langle \\sigma_x \\rangle |_{\\bar{V}}$, and $z\\equiv \\langle \\sigma_z \\rangle |_{\\bar{V}}$ . These correlated tomography results are displayed on the $X$-$Z$ plane of the Bloch sphere for three different initial states: $-z$ ({\\bf a}), $+x$ ({\\bf b}), and $+y$ ({\\bf c}). The gray scale indicates the relative occurrence of each measurement value. Note that different backaction between ({\\bf b}), and $+y$ ({\\bf c}) is the result of the phase-sensitive amplification on different quadratures of the homodyne signal.","label":"fig2_spon","source":"arxiv","key":"a4fc7ccc0c0c9a4e122ec822e59f8ba9","url":"https://inspirehep.net/files/a4fc7ccc0c0c9a4e122ec822e59f8ba9"},{"filename":"vectormap.png","material":"preprint","caption":"\\footnotesize {\\bf Backaction vector maps~\\cite{naghiloo2016mapping}.} {\\bf a}, We use the deterministic relation between the average homodyne signal $\\bar{V}$ and the emitter's state to herald a nearly arbitrary initial state in the $X$-$Z$ plane of the Bloch sphere. The conditional backaction is obtained by quantum state tomography based on a small portion of the signal $dV$. {\\bf b}, Histogram of the signals $dV$ which we separate into positive or negative $dV$. The corresponding backaction imparted on the emitter for negative ({\\bf c}) or positive ({\\bf d}) values of $dV$ are depicted by arrows at different locations in the $X$-$Z$ plane of the Bloch sphere.","label":"fig3_spon","source":"arxiv","key":"3f3c15618f8bda39d4347a797935070c","url":"https://inspirehep.net/files/3f3c15618f8bda39d4347a797935070c"},{"filename":"trajectories_v2.png","material":"preprint","caption":"\\footnotesize \\textbf{Quantum trajectories for decaying atom:} {\\bf a,b}, Quantum trajectories of spontaneous decay calculated by the stochastic master equation, initiated from $-z$ ({\\bf a}) and $+x$ ({\\bf b}).  Several trajectories are depicted in gray, and a few individual trajectories are highlighted in black. {\\bf c,d}  Individual trajectories ($\\tilde{x}, \\tilde{z}$) that originate from  $-z$ ({\\bf c}) and $+x$ ({\\bf d}) are shown as dashed lines and the tomographic reconstruction (see Chapter~4) based on projective measurements are shown as solid lines.","label":"fig4_map_spon","source":"arxiv","key":"ee6a65ae16c89c19950eff1c971cc156","url":"https://inspirehep.net/files/ee6a65ae16c89c19950eff1c971cc156"},{"filename":"fluctu.png","material":"preprint","caption":" \\footnotesize \\textbf{Work fluctuations in the macroscopic and microscopic limit:} \\textbf{a}. The work distribution for a system (gas inside a cylinder) in the thermodynamic limit (number of particles $N \\to \\infty$). The fluctuations are absolutely negligible $\\propto N^{-\\frac{1}{2}} \\sim 0$ in this limit. \\textbf{b}. The corresponding system in the limit of a finite number of particles ($N \\to 1$). The work distribution fluctuates substantially $\\propto N^{-\\frac{1}{2}} \\sim N$ due to thermal fluctuations.","label":"fig:fluctu","source":"arxiv","key":"47545270e406ffe3a7b3965d990b1dda","url":"https://inspirehep.net/files/47545270e406ffe3a7b3965d990b1dda"},{"filename":"demon.png","material":"preprint","caption":" \\footnotesize \\textbf{Maxwell's demon:} By knowing the position and the velocity of the particles, a demon sorts hot and cold particle in a box in apparent violation of the 2nd law.","label":"fig:demon","source":"arxiv","key":"cb7e1b2a6923bb9b1a53b9be56a056db","url":"https://inspirehep.net/files/cb7e1b2a6923bb9b1a53b9be56a056db"},{"filename":"demon_c_q.png","material":"preprint","caption":" \\footnotesize \\textbf{Classical demon vs. quantum demon:} \\textbf{a}, A classical demon's knowledge about a quantum system is limited to the populations in the definite states. \\textbf{b}, A quantum demon also has knowledge about the quantum coherence in the system.","label":"fig:demon_c_q","source":"arxiv","key":"b42ace453eee496b561edf6eac12a929","url":"https://inspirehep.net/files/b42ace453eee496b561edf6eac12a929"},{"filename":"seq_demon.png","material":"preprint","caption":" \\footnotesize \\textbf{Experimental sequence}.","label":"fig:seq_demon","source":"arxiv","key":"b11bdb94b82123488f32b480deb5e270","url":"https://inspirehep.net/files/b11bdb94b82123488f32b480deb5e270"},{"filename":"scatter_demon.png","material":"preprint","caption":" \\footnotesize \\textbf{The act of the demon in Step~4:} The red (blue) dots are the state of the qubit before (after) rotation feedback. The circular markers shows the average of the states before and after feedback. All data are from weak measurement and quantum trajectory reconstructions except the black cross which comes from the projective measurement after feedback. The agreement between the cross and green circular markers indicates that the trajectory update and feedback rotations are faithfully executed.","label":"fig:scatter_demon","source":"arxiv","key":"7b1da8e8729952db6f16ea32201c83db","url":"https://inspirehep.net/files/7b1da8e8729952db6f16ea32201c83db"},{"filename":"trans_demon.png","material":"preprint","caption":" \\footnotesize \\textbf{Transition probabilities:} The projective measurement results are used to calculate the transition probabilities. The initial probabilities $P_0(0)$ and $P_1(0)$  are simply calculated based on the relative occurrence of outcome 0 or 1 in the first projective measurement. For the transition probabilities $P_{nm}(\\tau)$, we calculate the relative occurrence of the result $n \\in \\{0,1\\}$ in the second projective measurement conditioned that the result $m \\in \\{0,1\\}$ is obtained in the first projective measurement.","label":"fig:trans_demon","source":"arxiv","key":"59be547106fc4108acbbfaaa8694beb6","url":"https://inspirehep.net/files/59be547106fc4108acbbfaaa8694beb6"},{"filename":"jar_demon.png","material":"preprint","caption":" \\footnotesize \\textbf{Violation of the 2nd law:} The experimental results violates the Jarzynski equality. This violation is because we have ignored the demon's information.","label":"fig:jar_demon","source":"arxiv","key":"377e2d55165d081c6be7f0f729906dbe","url":"https://inspirehep.net/files/377e2d55165d081c6be7f0f729906dbe"},{"filename":"info_demon.png","material":"preprint","caption":" \\footnotesize \\textbf{Information dynamics for the quantum Maxwell's demon:} \\textbf{a}. The information is quantified by considering the probabilities in the diagonal basis to account for information encoded in the coherences. \\textbf{b}. The information exchange dynamics along quantum trajectories; the dashed line shows a typical trace from the ensemble of data (shaded background color). The black solid line is the average of the information exchange.","label":"fig:info_demon","source":"arxiv","key":"6ea3bebe7831a9d7a9438345887f4f2f","url":"https://inspirehep.net/files/6ea3bebe7831a9d7a9438345887f4f2f"},{"filename":"gen_jar_demon.png","material":"preprint","caption":" \\footnotesize \\textbf{Generalized Jarzynski equality for the quantum Maxwell's demon:} The blue round markers are the experimental result for the generalized Jarzynski equality for different time durations. The agreement between the dashed line and markers indicates that the GJE is verified, as opposed to the JE (red square markers).","label":"fig:gen_jar_demon","source":"arxiv","key":"805bb4e595eeb4ba2a46ab8cc851f865","url":"https://inspirehep.net/files/805bb4e595eeb4ba2a46ab8cc851f865"},{"filename":"info_transition_demon.png","material":"preprint","caption":" \\footnotesize \\textbf{Information gain and loss for the quantum Maxwell's demon:} \\textbf{a}, The inefficient detection can be modeled by averaging over unknown degrees of freedom for the detector. This basically lowers the signal-to-noise ratio. \\textbf{b}, By adjusting the initial preparation for the qubit, we change the effective temperature for the system. The average of information exchange is negative for lower temperature (initially purer states) but it is positive for higher temperatures (initially more mixed states). Considering that only information encoded in coherences are susceptible to the loss, the more coherences involved in the dynamics, the more information will be lost.","label":"fig:info_transition_demon","source":"arxiv","key":"2201edcc341716a5dfa39803aa66bf27","url":"https://inspirehep.net/files/2201edcc341716a5dfa39803aa66bf27"}],"legacy_version":"20201116172530.0","inspire_categories":[{"term":"General Physics"},{"term":"Quantum Physics","source":"arxiv"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/01yc7t268"}],"full_name":"Naghiloo, Mahdi","last_name":"Naghiloo","first_name":"Mahdi","recid":2011041},"control_number":1830380,"dois":[{"material":"preprint","value":"10.48550/arXiv.1904.09291"}],"document_type":["article"],"texkeys":["Naghiloo:2019qxn"],"abstracts":[{"source":"arXiv","value":"Quantum technology has been rapidly growing due to its potential revolutionary applications. In particular, superconducting qubits provide a strong light-matter interaction as required for quantum computation and in principle can be scaled up to a high level of complexity. However, obtaining the full benefit of quantum mechanics in superconducting circuits requires a deep understanding of quantum physics in such systems in all aspects. One of the most crucial aspects is the concept of measurement and the dynamics of the quantum systems under the measurement process. This document is intended to be a pedagogical introduction to the concept of quantum measurement from an experimental perspective. We study the dynamics of a single superconducting qubit under continuous monitoring. We demonstrate that weak measurement is a versatile tool to investigate fundamental questions in quantum dynamics and quantum thermodynamics for open quantum systems.","abstract_source_suggest":{"input":"arXiv"}},{"source":"submitter","value":"Quantum technology has been rapidly growing due to its potential revolutionary applications. In particular, superconducting qubits provide a strong light-matter interaction as required for quantum computation and in principle can be scaled up to a high level of complexity. However, obtaining the full benefit of quantum mechanics in superconducting circuits requires a deep understanding of quantum physics in such systems in all aspects. One of the most crucial aspects is the concept of measurement and the dynamics of the quantum systems under the measurement process. This document is intended to be a pedagogical introduction to the concept of quantum measurement from an experimental perspective. We study the dynamics of a single superconducting qubit under continuous monitoring. We demonstrate that weak measurement is a versatile tool to investigate fundamental questions in quantum dynamics and quantum thermodynamics for open quantum systems.","abstract_source_suggest":{"input":"submitter"}}],"primary_arxiv_category":["quant-ph"],"titles":[{"source":"arXiv","title":"Introduction to Experimental Quantum Measurement with Superconducting Qubits"},{"source":"submitter","title":"Introduction to Experimental Quantum Measurement with Superconducting Qubits"}],"curated":true}},{"links":{"bibtex":"https://inspirehep.net/api/literature/1285919?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1285919?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1285919?format=latex-us","json":"https://inspirehep.net/api/literature/1285919?format=json","json-expanded":"https://inspirehep.net/api/literature/1285919?format=json-expanded","cv":"https://inspirehep.net/api/literature/1285919?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1285919"},"created":"2014-03-17T00:00:00+00:00","updated":"2023-12-13T11:07:32.843521+00:00","id":"1285919","metadata":{"authors":[{"full_name_unicode_normalized":"paranjape, aseem","full_name":"Paranjape, Aseem","record":{"$ref":"https://inspirehep.net/api/authors/1034821"},"last_name":"Paranjape","ids":[{"schema":"INSPIRE BAI","value":"A.Paranjape.1"}],"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903369"},"value":"Zurich, ETH"}],"signature_block":"PARANJAPa","first_name":"Aseem","uuid":"b16aba83-e7d4-4e52-aa49-05454ee58f83","recid":1034821}],"citation_count":10,"citation_count_without_self_citations":8,"publication_info":[{"journal_volume":"90","artid":"023520","year":2014,"journal_issue":"2","journal_title":"Phys.Rev.D"}],"citeable":true,"copyright":[{"material":"publication","year":2014,"holder":"American Physical Society"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","keywords":[{"schema":"PACS","value":"98.80.-k"},{"schema":"PACS","value":"95.35.+d"},{"schema":"PACS","value":"98.65.Dx"}],"references":[{"reference":{"arxiv_eprint":"astro-ph/0007333","label":"1","publication_info":{"journal_volume":"86","artid":"3475","year":2001,"page_start":"3475","journal_title":"Phys.Rev.Lett."},"authors":[{"full_name":"Jaffe, A.H."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/541738"}},{"reference":{"arxiv_eprint":"1303.5076","label":"2","publication_info":{"year":2013},"misc":["Planck Collaboration, ArXiv e-prints"]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1224741"}},{"reference":{"imprint":{"publisher":"Springer"},"arxiv_eprint":"astro-ph/0605575","label":"3","publication_info":{"year":2008},"misc":["in A Pan-Chromatic View of Clusters of Galaxies and the Large-Scale Structure, Lecture Notes in Physics, Berlin Verlag, Vol. 740, M. Plionis, O. López-Cruz, and D. Hughes (eds.) p. 287"],"authors":[{"full_name":"Borgani, S."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/717544"}},{"reference":{"arxiv_eprint":"1103.4829","label":"4","publication_info":{"journal_volume":"49","artid":"409","year":2011,"page_start":"409","journal_title":"Ann.Rev.Astron.Astrophys."},"authors":[{"full_name":"Allen, S.W."},{"full_name":"Evrard, A.E."},{"full_name":"Mantz, A.B."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/893762"}},{"reference":{"arxiv_eprint":"astro-ph/0105396","label":"5","publication_info":{"journal_volume":"560","artid":"L111","year":2001,"page_start":"L111","journal_title":"Astrophys.J."},"authors":[{"full_name":"Holder, G."},{"full_name":"Haiman, Z."},{"full_name":"Mohr, J.J."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/572816"}},{"reference":{"arxiv_eprint":"astro-ph/0305568","label":"6","publication_info":{"journal_volume":"68","artid":"083506","year":2003,"journal_title":"Phys.Rev.D"},"authors":[{"full_name":"Battye, R.A."},{"full_name":"Weller, J."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/619811"}},{"reference":{"arxiv_eprint":"astro-ph/0605746","label":"7","publication_info":{"journal_volume":"73","artid":"123