"},{"full_name":"Thewalt, M.L.W."},{"full_name":"Morton, J.J.L."}]},"raw_refs":[{"schema":"text","value":"R. E. George, W. Witzel, H. Riemann, N. V. Abrosimov, N. Nötzel, M. L. W. Thewalt, and J. J. L. Morton, Phys. Rev. Lett. 105, 067601 (2010), DOI: 10.1103/PhysRevLett.105.067601."}],"record":{"$ref":"https://inspirehep.net/api/literature/3016199"}},{"reference":{"dois":["10.1038/nmat2828"],"publication_info":{"journal_volume":"9","artid":"725","year":2010,"page_start":"725","journal_title":"Nature Materials"},"authors":[{"full_name":"Morley, G.W."},{"full_name":"Warner, M."},{"full_name":"Stoneham, A. Marshall"},{"full_name":"Greenland, P. Thornton"},{"full_name":"van Tol, J."},{"full_name":"Kay, C.W.M."},{"full_name":"Aeppli, G."}]},"raw_refs":[{"schema":"text","value":"G. W. Morley, M. Warner, A. Marshall Stoneham, P. Thornton Greenland, J. van Tol, C. W M Kay, and G. Aeppli, Nat. Mater. 9, 725 (2010), DOI: 10.1038/nmat2828."}]},{"reference":{"dois":["10.1103/PhysRevLett.102.237601"],"publication_info":{"journal_volume":"102","artid":"237601","year":2009,"journal_title":"Phys.Rev.Lett."},"authors":[{"full_name":"Dobrovitski, V.V."},{"full_name":"Feiguin, A.E."},{"full_name":"Hanson, R."},{"full_name":"Awschalom, D.D."}]},"raw_refs":[{"schema":"text","value":"V. V. Dobrovitski, A. E. Feiguin, R. Hanson, and D. D. Awschalom, Phys. Rev. Lett. 102, 237601 (2009), DOI: 10.1103/PhysRevLett.102.237601."}]},{"reference":{"dois":["10.1103/PhysRevB.75.125314"],"publication_info":{"journal_volume":"75","artid":"125314","year":2007,"journal_title":"Phys.Rev.B"},"authors":[{"full_name":"Saikin, S.K."},{"full_name":"Yao, W."},{"full_name":"Sham, L.J."}]},"raw_refs":[{"schema":"text","value":"S. K. Saikin, W. Yao, and L. J. Sham, Phys. Rev. B 75, 125314 (2007), DOI: 10.1103/PhysRevB.75.125314."}]},{"reference":{"dois":["10.1103/PhysRevB.78.094303"],"publication_info":{"journal_volume":"78","artid":"094303","year":2008,"journal_title":"Phys.Rev.B"},"authors":[{"full_name":"Maze, J.R."},{"full_name":"Taylor, J.M."},{"full_name":"Lukin, M.D."}]},"raw_refs":[{"schema":"text","value":"J. R. Maze, J. M. Taylor, and M. D. Lukin, Phys. Rev. B 78, 094303 (2008), DOI: 10.1103/PhysRevB.78.094303."}]},{"reference":{"dois":["10.1103/PhysRevB.78.085315"],"publication_info":{"journal_volume":"78","artid":"085315","year":2008,"journal_title":"Phys.Rev.B"},"authors":[{"full_name":"Yang, W."},{"full_name":"Liu, R.-B."}]},"raw_refs":[{"schema":"text","value":"W. Yang and R.-B. Liu, Phys. Rev. B 78, 085315 (2008), DOI: 10.1103/PhysRevB.78.085315."}],"record":{"$ref":"https://inspirehep.net/api/literature/2933633"}},{"reference":{"dois":["10.1103/PhysRevB.79.115320"],"publication_info":{"journal_volume":"79","artid":"115320","year":2009,"journal_title":"Phys.Rev.B"},"authors":[{"full_name":"Yang, W."},{"full_name":"Liu, R.-B."}]},"raw_refs":[{"schema":"text","value":"W. Yang and R.-B. Liu, Phys. Rev. B 79, 115320 (2009), DOI: 10.1103/PhysRevB.79.115320."}],"record":{"$ref":"https://inspirehep.net/api/literature/2933659"}},{"reference":{"dois":["10.1103/PhysRevB.82.201201"],"publication_info":{"journal_volume":"82","artid":"201201","year":2010,"journal_title":"Phys.Rev.B"},"authors":[{"full_name":"Stanwix, P.L."},{"full_name":"Pham, L.M."},{"full_name":"Maze, J.R."},{"full_name":"Le Sage, D."},{"full_name":"Yeung, T.K."},{"full_name":"Cappellaro, P."},{"full_name":"Hemmer, P.R."},{"full_name":"Yacoby, A."},{"full_name":"Lukin, M.D."},{"full_name":"Walsworth, R.L."}]},"raw_refs":[{"schema":"text","value":"P. L. Stanwix, L. M. Pham, J. R. Maze, D. Le Sage, T. K. Yeung, P. Cappellaro, P. R. Hemmer, A. Yacoby, M. D. Lukin, and R. L. Walsworth, Phys. Rev. B 82, 201201 (2010), DOI: 10.1103/PhysRevB.82.201201."}],"record":{"$ref":"https://inspirehep.net/api/literature/2733058"}},{"reference":{"dois":["10.1126/science.1131871"],"publication_info":{"journal_volume":"314","artid":"281","year":2006,"page_start":"281","journal_title":"Science"},"authors":[{"full_name":"Childress, L."},{"full_name":"Dutt, M.V. Gurudev"},{"full_name":"Taylor, J.M."},{"full_name":"Zibrov, A.S."},{"full_name":"Jelezko, F."},{"full_name":"Wrachtrup, J."},{"full_name":"Hemmer, P.R."},{"full_name":"Lukin, M.D."}]},"raw_refs":[{"schema":"text","value":"L. Childress, M. V. Gurudev Dutt, J. M. Taylor, A. S. Zibrov, F. Jelezko, J. Wrachtrup, P. R. Hemmer, and M. D. Lukin, Science 314, 281 (2006), DOI: 10.1126/science.1131871."}],"record":{"$ref":"https://inspirehep.net/api/literature/2733805"}},{"reference":{"dois":["10.1016/0301-0104(90)85013-M"],"publication_info":{"journal_volume":"143","artid":"131","year":1990,"page_start":"131","journal_title":"Chem.Phys."},"authors":[{"full_name":"Van Oort, E."},{"full_name":"Glasbeek, M."}]},"raw_refs":[{"schema":"text","value":"E. Van Oort and M. Glasbeek, Chem. Phys. 143, 131 (1990), DOI: 10.1016/0301-0104(90)85013-M."}]},{"reference":{"arxiv_eprint":"1110.0331","misc":["e-print"],"authors":[{"full_name":"Pan, X.-Y."},{"full_name":"Liu, G.-Q."},{"full_name":"Liu, D.-Q."},{"full_name":"Jiang, Z.-F."},{"full_name":"Zhao, N."},{"full_name":"Liu, R.-B."}]},"raw_refs":[{"schema":"text","value":"X.-Y. Pan, G.-Q. Liu, D.-Q. Liu, Z.-F. Jiang, N. Zhao, and R.-B. Liu, e-print arXiv:1110.0331v1."}],"record":{"$ref":"https://inspirehep.net/api/literature/3001407"}},{"reference":{"misc":["Here, we neglect the possible state mixing between and induced by strain or transverse magnetic field (see Ref. 12). Otherwise, the noise felt by the NV center spin would be modified by the state mixing, and the decoherence could be different. The state-mixing effect will be discussed in a separate paper"]},"raw_refs":[{"schema":"text","value":"Here, we neglect the possible state mixing between and induced by strain or transverse magnetic field (see Ref. 12). Otherwise, the noise felt by the NV center spin would be modified by the state mixing, and the decoherence could be different. The state-mixing effect will be discussed in a separate paper."}]},{"reference":{"dois":["10.1073/pnas.1003052107"],"publication_info":{"journal_volume":"107","artid":"8513","year":2010,"page_start":"8513","journal_title":"Proc.Nat.Acad.Sci."},"authors":[{"full_name":"Weber, J.R."},{"full_name":"Koehl, W.F."},{"full_name":"Varley, J.B."},{"full_name":"Janotti, A."},{"full_name":"Buckley, B.B."},{"full_name":"Van de Walle, C.G."},{"full_name":"Awschalom, D.D."}]},"raw_refs":[{"schema":"text","value":"J. R. Weber, W. F. Koehl, J. B. Varley, A. Janotti, B. B. Buckley, C. G. Van de Walle, and D. D. Awschalom, Proc. Natl. Acad. Sci. USA 107, 8513 (2010), DOI: 10.1073/pnas.1003052107."}],"record":{"$ref":"https://inspirehep.net/api/literature/2743762"}}],"number_of_pages":18,"preprint_date":"2011-08-11","author_count":3,"public_notes":[{"source":"arXiv","value":"18 pages, 17 figures"}],"earliest_date":"2011-08-11","refereed":true,"facet_author_name":["1917691_Ya-Nan Zhao","1664064_Ren-Bao Liu","2950597_Sai-Wah Ho"],"core":false,"license":[{"license":"arXiv nonexclusive-distrib 1.0","material":"preprint","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:2950595","updated":"2026-02-09T14:50:28.231903"},"journal_title_variants":["Phys. Rev. B","Phys.Rev.B"],"arxiv_eprints":[{"categories":["cond-mat.mes-hall","quant-ph"],"value":"1108.2343"}],"referenced_authors_bais":["C.Wittmann.1","N.Mizuochi.1","Seth.Lloyd.1","O.Gywat.1","Jing.Liang.Hu.1","G.de.Lange.1","Paola.Cappellaro.1","M.D.Lukin.2","Francisco.Caruso.1","L.M.Pham.1","J.Yang.36","L.Jiang.98","Wen.Li.Yang.1","Yu.Xi.Pan.1","R.L.Walsworth.1","D.L.Sage.1","N.V.Abrosimov.1","B.B.Buckley.1","M.W.Doherty.1","I.Popa.3","E.M.Purcell.1","M.J.Taylor.1","H.Riemann.1","P.R.Hemmer.2","L.T.Hall.1","A.Drabenstedt.1","E.Togan.1","M.V.G.Dutt.1","R.B.Liu.1","W.M.Witzel.1","Jiang.Feng.Du.1","J.R.Rabeau.1","L.Viola.3","T.K.Wen.1","D.A.Lidar.1","D.G.Cory.1","C.Tietz.1","L.J.Sham.2","G.Balasubramanian.1","D.Q.Liu.3","L.Jiang.100","E.R.George.1","Andrea.Morello.1","S.Prawer.6","D.Riste.1","F.Shi.2","B.J.Varley.10","J.K.R.Weber.1","R.Kolesov.1","D.D.Awschalom.1","S.W.Ho.2","L.Childress.1","Z.F.Jiang.1","D.Budker.1","A.Carroll.1","A.Janotti.1","Peng.Fei.Wang.1","T.K.Yeung.1","C.D.Hill.1","J.Twamley.1","B.Stadler.1","R.Bratschitsch.1","T.Nobauer.1","F.Rempp.1","J.Wrachtrup.1","C.von.Borczyskowski.1","A.Leitenstorfer.1","J.R.Maze.1","Li.Li.Jiang.1","J.Isoya.1","Xing.Rong.1","T.Wolf.3","G.Q.Liu.4","T.Hanke.1","A.S.Zibrov.1","J.van.Tol.1","A.D.Greentree.1","M.L.W.Thewalt.1","S.Das.Sarma.1","J.Fleury.1","L.C.L.Hollenberg.1","D.R.Gill.2","T.Gaebel.1","P.Mulvaney.1","S.Meiboom.1","J.Tisler.1","A.Wojcik.1","B.Naydenov.1","I.Y.Chan.1","Chris.G.Van.de.Walle.1","J.S.Hodges.1","H.Y.Carr.1","R.de.Sousa.1","J.E.Cole.1","Y.N.Zhao.1","M.AlHmoud.1","L.Cywinski.1","A.S.Sorensen.1","K.Khodjasteh.1","M.H.Mohammady.1","F.Jelezko.1","W.Yao.2","J.Achard.1","N.Notzel.1","X.Kong.3","A.Yacoby.1","F.Dolde.1","G.S.Uhrig.2","E.Knill.1","T.S.Monteiro.1","W.F.Koehl.1","Z.H.Wang.3","N.Stavrias.1","J.Tissler.1","S.Takahashi.1","V.Jacques.1","C.Kim.2","P.Huang.2","A.Feiguin.1","F.Reinhard.1","J.J.L.Morton.1","D.J.Twitchen.1","M.S.Sherwin.1","J.Meijer.1","R.Hanson.1","C.D.Shin.2","M.Markham.1","G.W.Morley.1","S.S.Hong.1","X.Y.Wang.1","C.A.Ryan.1","M.Domhan.1","H.Fedder.1","P.Stanwix.1","Andreas.Gruber.1","A.Krueger.2","S.P.Neumann.1","Y.Z.Wang.1","J.L.Beck.1","V.V.Dobrovitski.1"],"figures":[{"filename":"Fig1.png","material":"preprint","caption":"NV center electron spin decoherence in an electron spin bath. With only the electron spin bath considered, the FID decay time $T_{2,\\text{e-e}}^{*}$ is inversely proportional to the concentration of the bath electron spins, and exceeds $\\sim 1$~ms for the concentration lower than 0.01~ppm (the shadowed region).","label":"FIG:fig0_ebath","source":"arxiv","key":"4f9e55b6f16b126de06119fedb147531","url":"https://inspirehep.net/files/4f9e55b6f16b126de06119fedb147531"},{"filename":"Fig2.png","material":"preprint","caption":"(a) Schematic of the NV center structure. The magnetic field is assumed to be applied along the direction pointing from the nitrogen to the vacancy (the $[111]$ direction). (b) Schematic of the NV center in a $^{13}$C nuclear spin bath. The $^{13}$C atoms with nuclear spins (the red arrows) are randomly located on the diamond lattice (the gray circles). A nuclear spin dimer is encircled. (c) Schematic of the DD control sequence. The coherence is generated by the initial $\\pi/2$ pulse (red squares). The electron spin is repeatedly flipped at times $t_k$ by the $\\pi$ pulses (blue squares). Finally, the coherence is converted to the level population by the last $\\pi/2$ pulse.","label":"FIG:fig1_schem","source":"arxiv","key":"ab43ea1fd94a372e6593f5b6d81dc483","url":"https://inspirehep.net/files/ab43ea1fd94a372e6593f5b6d81dc483"},{"filename":"Fig3.png","material":"preprint","caption":"(a) Effective fields $\\mathbf{h}_{j}^{(m)}$ for the $j$th single nuclear spin in a magnetic field $\\mathbf{B}$ and a hyperfine field $\\mathbf{A}_j^{(m)}$ conditioned on the electron spin state $|m\\rangle$. (b) Bloch sphere representation of the bifurcated evolution of the $j$th nuclear spin under a single pulse control (Hahn echo). The single nuclear spin is driven by the effective fields $\\mathbf{h}_j^{(0)}$ and $\\mathbf{h}_j^{(+1)}$. The distance $\\delta_j$ between the trajectories measures the decoherence due to the $j$th nuclear spin.","label":"FIG:singlespin","source":"arxiv","key":"7f92cb568cc19c8897034ce9b662e0ff","url":"https://inspirehep.net/files/7f92cb568cc19c8897034ce9b662e0ff"},{"filename":"Fig4.png","material":"preprint","caption":"(a) Energy levels and eigenstates of two-nuclear spin Hamiltonian $H_{\\{i,j\\}}^{(0)}$ under zero magnetic field for the NV center spin in state $|0\\rangle$. (b) The energy shift and the transitions induced by the hyperfine fields. The transitions induced by the average hyperfine field $\\mathbf{A}^{(\\pm1)}$ (the red thick arrows) are much stronger than those induced by the hyperfine field difference $\\mathbf{a}^{(\\pm1)}$ (the blue dashed arrows).","label":"FIG:fig3_nonSecular","source":"arxiv","key":"deb1d74445166f501e05bbfc29ba312a","url":"https://inspirehep.net/files/deb1d74445166f501e05bbfc29ba312a"},{"filename":"Fig5.png","material":"preprint","caption":"(a) The electron spin decoherence between $|+1\\rangle$ and $|-1\\rangle$ states induced by a nuclear spin dimer under PDD-50 control and zero magnetic field. The black line is the exact calculation result using Eq.~(\\ref{Eq:CCE_Lc}), and the red line with symbols is obtained by the pseudo-spin model [Eq.(\\ref{Eq:SpinJ})]. (b) The same as (a), but for the two nuclear spins separated by 2.52~$\\text{\\AA}$ (the next nearest neighboring pair). Notice the different timescales of the horizontal axes. The separated pair has much slower dynamics than the dimer.","label":"FIG:fig3_nonSecular_data","source":"arxiv","key":"ce69e4f0b58e09b46ba8e07d1186cde6","url":"https://inspirehep.net/files/ce69e4f0b58e09b46ba8e07d1186cde6"},{"filename":"Fig6.png","material":"preprint","caption":"(a) Energy levels of two-spin cluster under a strong magnetic field. The two polarized states are decoupled and the dynamics of the two unpolarized states is described by a pseudo-spin. (b) The bifurcated evolution paths of the pseudo-spin on the Bloch sphere. The pseudo-spin is driven by the pseudo-fields $\\mathbf{h}_{jk}^{(0)}$ and $\\mathbf{h}_{jk}^{(+1)}$. The distance $\\delta_{jk}$ between the trajectories measures the decoherence due to the nuclear spin pair.","label":"FIG:fig4_BlochSphere","source":"arxiv","key":"45cd93e050be5630b453a02a09cbedbd","url":"https://inspirehep.net/files/45cd93e050be5630b453a02a09cbedbd"},{"filename":"Fig7.png","material":"preprint","caption":"(a) FID of an NV center in a typical nuclear spin configuration under various magnetic field strength. (b) The contributions to FID of different cluster sizes (CCE orders). (c) The exact FID coherence and the coherence obtained by applying the isotropic approximation in zero and strong fields. (d) Histogram of FID coherence time $T_2^{*}$ distribution under zero and strong fields.","label":"FIG:FID","source":"arxiv","key":"39b5d542540a32d2812b9ef95b8756ed","url":"https://inspirehep.net/files/39b5d542540a32d2812b9ef95b8756ed"},{"filename":"Fig8.png","material":"preprint","caption":"(a) Hahn echo of NV center spin coherence between $|0\\rangle$ and $|+1\\rangle$ as a function of total evolution time $t$ and magnetic field $B$. The strong, medium and weak magnetic field regimes, in which the NV center spin has different decoherence behavior, are separated by the horizontal lines. The solid (dashed) line indicates the time at which the NV center spin coherence decays to the $1/e$ value for the first peak (envelope), i.e. the time $T_{\\text{W}}$ ($T_2$) defined in (b). (b)-(f) Cross-sections of (a) for various magnetic field strength. (b) The collapse and revival effect under $30$~Gauss magnetic field with three different timescales indicated. The red dashed line is the envelope of the revival peaks, which decays to $1/e$ at time $T_2$. Inset: close-up of the first several peaks. The half peak width $T_{\\text{W}}$ and the revival period $T_{\\text{R}}$ are indicated. (c) In a weak magnetic field of 0.3~Gauss (approximately the earth magnetic field strength), the NV center spin coherence decays in a timescale $T_{\\text{W}}$, and does not revive. (d)-(f) The suppression of the collapse and revival effect by increasing the magnetic field strength. For $B=100$~Gauss in (d), the revival peaks get closer to each other. The coherence does not collapse to zero and the revival peaks are not well resolved under $B=500$~Gauss in (e). For $B=3000$~Gauss in (f), the collapse and revival effect is completely suppressed.","label":"FIG:HahnEcho3D","source":"arxiv","key":"5a371bf1e2a0936ec483bf8840c3082c","url":"https://inspirehep.net/files/5a371bf1e2a0936ec483bf8840c3082c"},{"filename":"Fig9.png","material":"preprint","caption":"The magnetic field dependence of $T_{\\text{W}}$, $T_{\\text{R}}$ and $T_{2}$. The black line with square symbols is the calculated peak width, and the red solid line is obtained by fitting the data in the region $1~\\text{Gauss}<B<100~\\text{Gauss}$. The peak width $T_{\\text{W}}$ depends on $B$ as $B^{-k}$ with $k=0.63$. The value of $k$ slightly depends on the specific nuclear spin positions around the NV center. For $B< 1$~Gauss, the peak width $T_{\\text{w}}$ deviates from the $B^{-k}$ law, which defines the weak magnetic field regime. The revival time $T_{\\text{R}}$ is inversely proportional to the magnetic field strength $B$ (circle symbols and blue dashed line). The rough boundary between the medium and strong magnetic field regimes is defined by the approaching of $T_{\\text{R}}$ to $T_{\\text{W}}$ about $B= 300$~Gauss. The envelope decay time $T_2$ (black line with diamond symbols) in the strong magnetic field ($>300$~Gauss) is constant, and decreases as the magnetic field is decreased to $\\sim 10$~Gauss. For $B<10$~Gauss, there are too few revival peaks to determine the envelope decay time, and $T_W$ should be taken as the relevant decoherence time.","label":"FIG:CoherenceTime","source":"arxiv","key":"15cd8078a19105845ed0508230fb785e","url":"https://inspirehep.net/files/15cd8078a19105845ed0508230fb785e"},{"filename":"Fig10.png","material":"preprint","caption":"Decoherence mechanisms of Hahn echo in different magnetic field regimes. (a) The contributions to decoherence of different cluster sizes (CCE orders) in $B=0.3$~Gauss. (b) The contributions to decoherence of different types of interaction in $B=0.3$~Gauss. The red line with square symbols is the coherence calculated with the isotropic approximation of the hyperfine interaction. The green line with diamond symbols is the coherence calculated with the secular approximation. The blue dashed line is the coherence obtained with both isotropic and secular approximations. The black solid line indicates the exact results without approximations. (c) and (d) are the same as (a) and (b), respectively, but for $B=15$~Gauss. (e) and (f) are the same as (a) and (b), respectively, but for $B=3000$~Gauss.","label":"FIG:Hahn2","source":"arxiv","key":"ad971028b333617578fd4f111d8d2571","url":"https://inspirehep.net/files/ad971028b333617578fd4f111d8d2571"},{"filename":"Fig11.png","material":"preprint","caption":"(a) Electron spin coherence between $|0\\rangle$ and $|+1\\rangle$ under PDD-10 control in the medium magnetic field regime ($B=60$~Gauss). Similar collapse and revival effect is observed, but with a longer timescale than the Hahn echo case. (b) The decoherence within the first (half) peak under PDD controls of various pulse numbers indicated by the integers associated with each curves. For the sake of clarity, the subsequent revivals are not shown. The inset shows that the decay time, at which the coherence decays to $1/e$ value, increases linearly with increasing pulse number. (c) The magnetic field dependence of the decay time (at $1/e$ height) for various PDD pulse numbers. (d) The CCE convergence of the PDD-100 result under $B=60$~Gauss. The single spin dynamics (CCE-1) is the dominating decoherence mechanism in this magnetic field regime.","label":"FIG:fig8_MediumField","source":"arxiv","key":"46f3a514bf38405b7ae81fb8b1f8c22e","url":"https://inspirehep.net/files/46f3a514bf38405b7ae81fb8b1f8c22e"},{"filename":"Fig12.png","material":"preprint","caption":"(a) and (b) The contributions to overall decoherence of different cluster sizes (CCE orders) in $B=20$~Gauss and PDD-10 control. CCE-1 give rise to the collapse and revival effect. The envelope decay is caused mainly by CCE-2. The calculation is converged at CCE-6. (c) The contributions to decoherence of different types of interaction in $B=20$~Gauss and PDD-10 control.","label":"FIG:fig8_MediumField1","source":"arxiv","key":"a855d1be98e9aefbc05c9902d7864f4c","url":"https://inspirehep.net/files/a855d1be98e9aefbc05c9902d7864f4c"},{"filename":"Fig13.png","material":"preprint","caption":"Electron spin coherence between $|+1\\rangle$ and $|-1\\rangle$ under weak magnetic field (0.3~Gauss) and PDD controls. The integer numbers associated with each curves are the pulse numbers of the PDD controls. Inset: the coherence time $T_{\\text{W}}$ (at $1/e$ height), increases linearly with increasing pulse number.","label":"FIG:fig9_DDzeroB","source":"arxiv","key":"7d4711c39f738c4a4cca66883378cfd3","url":"https://inspirehep.net/files/7d4711c39f738c4a4cca66883378cfd3"},{"filename":"Fig14.png","material":"preprint","caption":"(a) The CCE convergence for PDD-50 under weak magnetic field $B=0.3$~Gauss. The 2-spin clusters give the dominating contribution (CCE-2), and the result converges by including up to 6-spin clusters (CCE-6). (b) Contributions to NV center spin decoherence from $\\sim 12$ nuclear spin dimers (red solid line) and the large number of separated pairs (blue dashed line) in the bath. The decoherence in the weak field regime is mainly caused by the dimers. (c) Decoherence caused by different types of interaction in $B=0.3$~Gauss and PDD-50 control.","label":"FIG:DDzeroB2","source":"arxiv","key":"47ca882215cfed49f6b6e4ee59b84a9f","url":"https://inspirehep.net/files/47ca882215cfed49f6b6e4ee59b84a9f"},{"filename":"Fig15.png","material":"preprint","caption":"(a) Electron spin coherence between $|0\\rangle$ and $|+1\\rangle$ under strong magnetic field $B=3000$~Gauss and PDD controls. The integer numbers associated with each curves are the pulse numbers of the DD controls. Inset: the coherence time $T_2$ linearly increases as increasing the pulse number. (b) The close-up of the initial stage of the decoherence under PDD-5 and PDD-10 controls. Sharp coherence dips are caused by the noise from the nuclear spins close to NV center.","label":"FIG:fig10_DDhighB","source":"arxiv","key":"e8578784a358a23d8ebeffe1834cd566","url":"https://inspirehep.net/files/e8578784a358a23d8ebeffe1834cd566"},{"filename":"Fig16.png","material":"preprint","caption":"(a) The CCE convergence for PDD-4 under strong magnetic field $B=3000$~Gauss. The 2-spin clusters give the main contribution (CCE-2), and the result converges by including up to 6-spin clusters (CCE-6). Inset: close-up for the CCE-1 and CCE-2 contributions to the coherence dips in short time. (b) Contributions to the decoherence from $\\sim 12$ nuclear spin dimers (red solid line) and the large number of separated pairs (blue dashed line) in the bath. The electron spin decoherence under strong magnetic field is mainly caused by the separated pairs. (c) Decoherence caused by different types of interaction under $B=3000$~Gauss and PDD-4 control. Inset: close-up for the contributions to the coherence dips of different interactions.","label":"FIG:DDhighB","source":"arxiv","key":"13e1a872e1525ac502e2b41ee3332f37","url":"https://inspirehep.net/files/13e1a872e1525ac502e2b41ee3332f37"},{"filename":"Fig17.png","material":"preprint","caption":"Geometric picture of the effective bath spin precession about the axes along $\\hat{\\mathbf{n}}_k^{(\\pm)}$ with precession angles $\\theta_k^{(\\pm)}$, under PDD-$k$ ($k\\ge 1$) control. The angle between the precession axes is $2\\alpha_k$. The vectors $\\sin(\\boldsymbol{\\theta}_k^{(\\pm)}/2)$ are decomposed into the common part $\\mathbf{R}_k$ and the difference part $\\mathbf{r}_k$.","label":"FIG:Appendix","source":"arxiv","key":"ed7ed737bdbe3686f032f03b8e85915d","url":"https://inspirehep.net/files/ed7ed737bdbe3686f032f03b8e85915d"}],"inspire_categories":[{"term":"Condensed Matter"}],"first_author":{"full_name":"Zhao, Nan","last_name":"Zhao","first_name":"Nan","recid":1917691},"control_number":2950595,"dois":[{"source":"APS","value":"10.1103/PhysRevB.85.115303"},{"material":"publication","source":"arXiv","value":"10.1103/PhysRevB.85.115303"}],"document_type":["article"],"texkeys":["Zhao:2011kyk","Zhao:2012tof"],"abstracts":[{"source":"APS","value":"We theoretically study the decoherence and the dynamical decoupling control of nitrogen vacancy center electron spins in high-purity diamond, where the hyperfine interaction with 13C nuclear spins is the dominating decoherence mechanism. The decoherence is formulated as the entanglement between the electron spin and the nuclear spins, which is induced by nuclear spin bath evolution conditioned on the electron spin state. The nuclear spin bath evolution is driven by elementary processes such as single spin precession and pairwise flip flops. The importance of different elementary processes in the decoherence depends on the strength of the external magnetic field.","abstract_source_suggest":{"input":"APS"}},{"source":"arXiv","value":"We theoretically study the decoherence and the dynamical decoupling control of nitrogen-vacancy center electron spins in high-purity diamond, where the hyperfine interaction with $^{13}$C nuclear spins is the dominating decoherence mechanism. The decoherence is formulated as the entanglement between the electron spin and the nuclear spins, which is induced by nuclear spin bath evolution conditioned on the electron spin state. The nuclear spin bath evolution is driven by elementary processes such as single spin precession and pairwise flip-flops. The importance of different elementary processes in the decoherence depends on the strength of the external magnetic field.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["cond-mat.mes-hall"],"titles":[{"source":"APS","title":"Decoherence and dynamical decoupling control of nitrogen vacancy center electron spins in nuclear spin baths"},{"source":"arXiv","title":"Decoherence and dynamical decoupling control of nitrogen-vacancy center electron spins in nuclear spin baths"}],"imprints":[{"date":"2012-03-08"}],"curated":false}},{"links":{"bibtex":"https://inspirehep.net/api/literature/2009800?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/2009800?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/2009800?format=latex-us","json":"https://inspirehep.net/api/literature/2009800?format=json","json-expanded":"https://inspirehep.net/api/literature/2009800?format=json-expanded","cv":"https://inspirehep.net/api/literature/2009800?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2009800"},"created":"2022-01-13T03:19:48.015904+00:00","updated":"2023-11-23T11:48:02.748503+00:00","id":"2009800","metadata":{"authors":[{"raw_affiliations":[{"value":"Department of Physics, ETH Zurich, Wolfgang-Pauli-Strasse 27, CH-8093 Zurich, Switzerland; enci.wang@phys.ethz.ch, simon.lilly@phys.ethz.ch"}],"full_name_unicode_normalized":"wang, enci","full_name":"Wang, Enci","record":{"$ref":"https://inspirehep.net/api/authors/2034629"},"last_name":"Wang","ids":[{"schema":"INSPIRE BAI","value":"E.Wang.10"}],"signature_block":"WANGe","first_name":"Enci","uuid":"e1760a21-7a31-49c7-8152-45ce41f55724","recid":2034629},{"raw_affiliations":[{"value":"Department of Physics, ETH Zurich, Wolfgang-Pauli-Strasse 27, CH-8093 Zurich, Switzerland; enci.wang@phys.ethz.ch, simon.lilly@phys.ethz.ch"}],"full_name_unicode_normalized":"lilly, simon j.","full_name":"Lilly, Simon J.","record":{"$ref":"https://inspirehep.net/api/authors/1033460"},"last_name":"Lilly","ids":[{"schema":"ORCID","value":"0000-0002-6423-3597"},{"schema":"INSPIRE BAI","value":"S.J.Lilly.1"}],"signature_block":"LALYs","first_name":"Simon J.","uuid":"9e2adfdc-3e63-4e2a-bb70-7e9f583219a3","recid":1033460}],"documents":[{"filename":"document","fulltext":true,"key":"128f32ea1f8089ae4ffba087734b781b","url":"https://inspirehep.net/files/128f32ea1f8089ae4ffba087734b781b"}],"citation_count":6,"citation_count_without_self_citations":4,"publication_info":[{"journal_volume":"927","artid":"217","year":2022,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214843"},"page_start":"217","journal_issue":"2","journal_title":"Astrophys.J."}],"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","references":[{"reference":{"dois":["10.1093/mnras/281.2.L21"],"publication_info":{"journal_volume":"281","artid":"L21","year":1996,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214577"},"page_start":"L21","journal_title":"Mon.Not.Roy.Astron.Soc."},"authors":[{"full_name":"Abramowicz, M."},{"full_name":"Brandenburg, A."},{"full_name":"Lasota, J.-P."}]},"raw_refs":[{"schema":"text","value":"M. Abramowicz, A. Brandenburg, J.-P. Lasota, Mon.Not.Roy.Astron.Soc.,281,L21, DOI: 10.1093/mnras/281.2.L21"}]},{"reference":{"publication_info":{"journal_volume":"13","artid":"137","year":1986,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214425"},"page_start":"137","journal_title":"Rev.Mex.Astron.Astrofis."},"authors":[{"full_name":"Allen, C."},{"full_name":"Martos, M.A."}]},"raw_refs":[{"schema":"text","value":"C. Allen, M. A. Martos, Rev.Mex.Astron.Astrofis.,13,137"}]},{"reference":{"dois":["10.1051/0004-6361:200810964"],"publication_info":{"journal_volume":"494","artid":"21","year":2009,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214902"},"page_start":"21","journal_title":"Astron.Astrophys."},"authors":[{"full_name":"Arshakian, T.G."},{"full_name":"Beck, R."},{"full_name":"Krause, M."},{"full_name":"Sokoloff, D."}]},"raw_refs":[{"schema":"text","value":"T. G. Arshakian, R. Beck, M. Krause, D. Sokoloff, Astron.Astrophys.,494,21, DOI: 10.1051/0004-6361:200810964"}],"record":{"$ref":"https://inspirehep.net/api/literature/799790"}},{"reference":{"dois":["10.1051/0004-6361/201834382"],"publication_info":{"journal_volume":"622","artid":"A64","year":2019,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214902"},"page_start":"A64","journal_title":"Astron.Astrophys."},"authors":[{"full_name":"Bacchini, C."},{"full_name":"Fraternali, F."},{"full_name":"Iorio, G."},{"full_name":"Pezzulli, G."}]},"raw_refs":[{"schema":"text","value":"C. Bacchini, F. Fraternali, G. Iorio, G. Pezzulli, Astron.Astrophys.,622,A64, DOI: 10.1051/0004-6361/201834382"}]},{"reference":{"dois":["10.1051/0004-6361/202038223"],"publication_info":{"journal_volume":"641","artid":"A70","year":2020,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214902"},"page_start":"A70","journal_title":"Astron.Astrophys."},"authors":[{"full_name":"Bacchini, C."},{"full_name":"Fraternali, F."},{"full_name":"Iorio, G."}]},"raw_refs":[{"schema":"text","value":"C. Bacchini, F. Fraternali, G. Iorio, Astron.Astrophys.,641,A70, DOI: 10.1051/0004-6361/202038223"}]},{"reference":{"dois":["10.1086/170270"],"publication_info":{"journal_volume":"376","artid":"214","year":1991,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214843"},"page_start":"214","journal_title":"Astrophys.J."},"authors":[{"full_name":"Balbus, S.A."},{"full_name":"Hawley, J.F."}]},"raw_refs":[{"schema":"text","value":"S. A. Balbus, J. F. Hawley, Astrophys.J.,376,214, DOI: 10.1086/170270"}],"record":{"$ref":"https://inspirehep.net/api/literature/330903"}},{"reference":{"dois":["10.1103/RevModPhys.70.1"],"publication_info":{"journal_volume":"70","artid":"1","year":1998,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214422"},"page_start":"1","journal_title":"Rev.Mod.Phys."},"authors":[{"full_name":"Balbus, S.A."},{"full_name":"Hawley, J.F."}]},"raw_refs":[{"schema":"text","value":"S. A. Balbus, J. F. Hawley, Rev.Mod.Phys.,70,1, DOI: 10.1103/RevModPhys.70.1"}],"record":{"$ref":"https://inspirehep.net/api/literature/486032"}},{"reference":{"dois":["10.1086/307594"],"publication_info":{"journal_volume":"521","artid":"650","year":1999,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214843"},"page_start":"650","journal_title":"Astrophys.J."},"authors":[{"full_name":"Balbus, S.A."},{"full_name":"Papaloizou, J.C.B."}]},"raw_refs":[{"schema":"text","value":"S. A. Balbus, J. C. B. Papaloizou, Astro