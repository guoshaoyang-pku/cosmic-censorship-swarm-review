{"id":"1235595","created":"2013-05-28T00:00:00+00:00","revision_id":78,"metadata":{"citation_count":182,"publication_info":[{"year":1983,"page_end":"413","page_start":"387","journal_issue":"3","journal_title":"Commun.Math.Phys.","journal_record":{"$ref":"https://inspirehep.net/api/journals/1214791"},"journal_volume":"89"}],"citation_count_without_self_citations":177,"dois":[{"value":"10.1007/BF01214662"}],"titles":[{"title":"Symmetries of cosmological Cauchy horizons"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"4cac3bfb-e0f6-4df9-8be0-c9be464db6e8","record":{"$ref":"https://inspirehep.net/api/authors/997016"},"full_name":"Moncrief, Vincent","affiliations":[{"value":"Yale U.","record":{"$ref":"https://inspirehep.net/api/institutions/903357"}}],"signature_block":"MANCRAFv"},{"uuid":"7e107048-437f-49df-9a4a-3e0cea8e613c","record":{"$ref":"https://inspirehep.net/api/authors/1004888"},"full_name":"Isenberg, James","affiliations":[{"value":"Oregon U., Dept. Math.","record":{"$ref":"https://inspirehep.net/api/institutions/909941"}}],"signature_block":"ISANBARGj"}],"curated":true,"texkeys":["Moncrief:1983xua"],"citeable":true,"refereed":true,"abstracts":[{"value":"We consider analytic vacuum and electrovacuum spacetimes which contain a compact null hypersurface ruled byclosed null generators. We prove that each such spacetime has a non-trivial Killing symmetry. We distinguish two classes of null surfaces, degenerate and non-degenerate ones, characterized by the zero or non-zero value of a constant analogous to the “surface gravity” of stationary black holes. We show that the non-degenerate null surfaces are always Cauchy horizons across which the Killing fields change from spacelike (in the globally hyperbolic regions) to timelike (in the acausal, analytic extensions).","source":"Springer"}],"document_type":["article"],"control_number":1235595,"legacy_version":"20160405105730.0","number_of_pages":27,"inspire_categories":[{"term":"Math and Math Physics"}],"legacy_creation_date":"2013-05-28"},"updated":"2023-03-07T05:19:18.554755+00:00","uuid":"d1b70409-2cb2-4823-b861-d69d4526eb60","links":{"bibtex":"https://inspirehep.net/api/literature/1235595?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1235595?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1235595?format=latex-us","json":"https://inspirehep.net/api/literature/1235595?format=json","json-expanded":"https://inspirehep.net/api/literature/1235595?format=json-expanded","cv":"https://inspirehep.net/api/literature/1235595?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1235595"}}