smology"],"authors":[{"full_name":"Wainwright, J."},{"full_name":"Ellis, G.F."}]},"raw_refs":[{"schema":"text","value":"J. Wainwright and G. F. Ellis, Dynamical systems in cosmology, 1997.DOI : 10.1017/CBO9780511524660"}]}],"number_of_pages":234,"referenced_authors_bais":["M.Weaver.2","Annegret.Y.Burtscher.1","P.G.LeFloch.1","P.D.Lax.1"],"inspire_categories":[{"term":"Quantum Physics"}],"author_count":1,"urls":[{"value":"https://tel.archives-ouvertes.fr/tel-01832314"}],"first_author":{"full_name":"Xiang, Shuyang","last_name":"Xiang","first_name":"Shuyang","recid":2329231},"control_number":3136035,"earliest_date":"2017-07-05","document_type":["thesis"],"texkeys":["Xiang:2017xyf"],"languages":["fr"],"abstracts":[{"source":"TEL","value":"This thesis is devoted to fluid dynamics evolving in the domain of outer communication of a Schwarzschild black hole. In the first chapter, we formulate the initial value problem of the relativistic Euler model within a class of weak solutions with bounded variation, possibly containing shock waves. We then introduce a version of the random choice method founded on the global steady state solutions and the generalized Riemann problem and we establish a global-in-time existence theory for the initial value problem within the proposed class of weakly regular fluid flows. In the second chapter, we consider the relativistic Burgers model. We have introduced a version of the total variation which is decreasing with respect to time in the Cauchy problem. We also use the generalized characteristics to prove the nonlinear stability of a piecewise steady state solution. In the third chapter, we present some numerical methods based on the Schwarzschild geometry and study numerically the nonlinear stability of steady state solutions and the asymptotic behavior of a general solutions. The proposed schemes provide a numerical tool capable to preserve exactly the equilibria and allow us to analyse the evolution of fluids with the geometry effects.","abstract_source_suggest":{"input":"TEL"}}],"titles":[{"source":"TEL","title":"Sur la dynamique des fluides dans le domaine de communication extérieur d'un espace-temps de Schwarzschild"}],"facet_author_name":["2329231_M. -S. Xiang"],"core":false,"imprints":[{"date":"2017-07-05"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:3136035","updated":"2026-03-28T16:46:18.065629"},"thesis_info":{"date":"2017","institutions":[{"name":"Laboratoire Jacques-Louis Lions, France"}],"degree_type":"PhD"},"curated":false}},{"links":{"bibtex":"https://inspirehep.net/api/literature/3139847?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/3139847?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/3139847?format=latex-us","json":"https://inspirehep.net/api/literature/3139847?format=json","json-expanded":"https://inspirehep.net/api/literature/3139847?format=json-expanded","cv":"https://inspirehep.net/api/literature/3139847?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A3139847"},"created":"2026-04-07T12:01:27.032766+00:00","id":"3139847","updated":"2026-04-15T09:32:41.804533+00:00","metadata":{"citation_count":6,"publication_info":[{"journal_volume":"1026","artid":"117421","material":"publication","year":2026,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1613964"},"journal_title":"Nucl.Phys.B"}],"citation_count_without_self_citations":3,"authors":[{"raw_affiliations":[{"source":"Elsevier B.V.","value":"Physics Department, Eastern Mediterranean University, Famagusta, 99628, Cyprus"}],"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/00excyz84"}],"full_name_unicode_normalized":"sucu, erdem","full_name":"Sucu, Erdem","record":{"$ref":"https://inspirehep.net/api/authors/2693009"},"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/907912"},"value":"Eastern Mediterranean U."}],"last_name":"Sucu","ids":[{"schema":"INSPIRE BAI","value":"E.Sucu.1"}],"first_name