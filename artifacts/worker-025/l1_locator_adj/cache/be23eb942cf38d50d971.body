ion_info":{"journal_volume":"135","page_end":"401","year":2013,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214873"},"page_start":"361","journal_title":"Am.J.Math."},"title":{"title":"Local decay of waves on asymptotically flat stationary space-times"},"authors":[{"full_name":"Tataru, D."}]},"raw_refs":[{"schema":"text","value":"78. D. Tataru, “Local decay of waves on asymptotically flat stationary space-times,” Am. J. Math. 135(2), 361–401 (2013). , DOI: 10.1353/ajm.2013.0012,"}]},{"reference":{"dois":["10.1063/1.524181"],"label":"79","publication_info":{"journal_volume":"20","page_end":"1058","year":1979,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214658"},"page_start":"1056","journal_title":"J.Math.Phys."},"title":{"title":"Note on the stability of the Schwarzschild metric"},"authors":[{"full_name":"Wald, R.M."}]},"raw_refs":[{"schema":"text","value":"79. R. M. Wald, “Note on the stability of the Schwarzschild metric,” J. Math. Phys. 20(6), 1056–1058 (1979). , DOI: 10.1063/1.524181, ,"}],"record":{"$ref":"https://inspirehep.net/api/literature/2949678"}},{"reference":{"dois":["10.1007/s002200050767"],"label":"80","publication_info":{"journal_volume":"208","page_end":"520","year":1999,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214791"},"page_start":"507","journal_title":"Commun.Math.Phys."},"title":{"title":"The Wk,p-continuity of the Schrödinger wave operators on the line"},"authors":[{"full_name":"Weder, R."}]},"raw_refs":[{"schema":"text","value":"80. R. Weder, “The Wk,p-continuity of the Schrödinger wave operators on the line,” Commun. Math. Phys. 208(2), 507–520 (1999). , DOI: 10.1007/s002200050767,"}]},{"reference":{"dois":["10.2969/jmsj/04730551"],"label":"81","publication_info":{"journal_volume":"47","page_end":"581","year":1995,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214649"},"page_start":"551","journal_title":"J.Math.Soc.Jap."},"title":{"title":"The Wk,p-continuity of wave operators for Schrödinger operators"},"authors":[{"full_name":"Yajima, K."}]},"raw_refs":[{"schema":"text","value":"81. K. Yajima, “The Wk,p-continuity of wave operators for Schrödinger operators,” J. Math. Soc. Jpn. 47(3), 551–581 (1995). , DOI: 10.2969/jmsj/04730551,"}]},{"reference":{"label":"82","publication_info":{"year":1995},"title":{"title":"The Wk,p-continuity of wave operators for Schrödinger operators. III. Even-dimensional cases m ≥ 4"},"misc":["J. Math","Sci. Univ. Tokyo 2(2), 311-346"],"authors":[{"full_name":"Yajima, K."}]},"raw_refs":[{"schema":"text","value":"82. K. Yajima, “The Wk,p-continuity of wave operators for Schrödinger operators. III. Even-dimensional cases m ≥ 4,” J. Math. Sci. Univ. Tokyo 2(2), 311–346 (1995)."}]},{"reference":{"dois":["10.1007/s00220-005-1375-9"],"label":"83","publication_info":{"journal_volume":"259","page_end":"509","year":2005,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214791"},"page_start":"475","journal_title":"Commun.Math.Phys."},"title":{"title":"Dispersive estimate for Schrödinger equations with threshold resonance and eigenvalue"},"authors":[{"full_name":"Yajima, K."}]},"raw_refs":[{"schema":"text","value":"83. K. Yajima, “Dispersive estimate for Schrödinger equations with threshold resonance and eigenvalue,” Commun. Math. Phys. 259(2), 475–509 (2005). , DOI: 10.1007/s00220-005-1375-9,"}]}],"legacy_creation_date":"2021-01-01","preprint_date":"2020-12-28","author_count":1,"public_notes":[{"source":"arXiv","value":"This article is dedicated to the memory of Jean Bourgain. 5 figures\n are included. Revised version, to appear in Journal Math. Phys"}],"earliest_date":"2020-12-28","refereed":true,"external_system_identifiers":[{"schema":"MSNET","value":"4276283"}],"facet_author_name":["1881372_Wilhelm Schlag"],"core":false,"license":[{"license":"CC BY 4.0","material":"preprint","url":"http://creativecommons.org/licenses/by/4.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1838966","updated":"2025-07-18T19:21:17.827615"},"journal_title_variants":["J. Math. Phys.","J.Math.Phys."],"arxiv_eprints":[{"categories":["math.AP"],"value":"2012.14448"}],"referenced_authors_bais":["M.Dafermos.1","N.Kamran.1","J.Luk.1","B.S.Kay.1","R.M.Wald.1","F.Finster.1","Shing.Tung.Yau.1","A.Soffer.3","S.Tanveer.1","J.Sbierski.1","W.Schlag.2","E.Mourre.1","S.Aretakis.1","A.Soffer.5","Y.Angelopoulos.1","R.Donninger.5","J.Smoller.3","I.Rodnianski.1","O.Costin.1","P.Hintz.1","P.Blue.2","D.Gajic.1"],"figures":[{"filename":"contours.png","material":"preprint","caption":"Deforming the contour","source":"arxiv","key":"1f84b69d362bce1176263e97a09b1510","url":"https://inspirehep.net/files/1f84b69d362bce1176263e97a09b1510"},{"filename":"surfaces.png","material":"preprint","caption":"Unstable versus stable geodesic flow","source":"arxiv","key":"87ecb5d094588f4518c011e522a8724e","url":"https://inspirehep.net/files/87ecb5d094588f4518c011e522a8724e"},{"filename":"twoplanes.png","material":"preprint","caption":"Two planes joined by a neck","source":"arxiv","key":"4fc58bc3f248ff22534ae5469fef3c8f","url":"https://inspirehep.net/files/4fc58bc3f248ff22534ae5469fef3c8f"},{"filename":"potentials.png","material":"preprint","caption":"Potentials corresponding to the surfaces in Figure~2","source":"arxiv","key":"b69f3ed375764a560d88f05544efae27","url":"https://inspirehep.net/files/b69f3ed375764a560d88f05544efae27"},{"filename":"RT.png","material":"preprint","caption":"Reflection and transmission coefficients","source":"arxiv","key":"5069e0365e3af738a7159bc28d02e579","url":"https://inspirehep.net/files/5069e0365e3af738a7159bc28d02e579"}],"legacy_version":"20210623064357.0","inspire_categories":[{"term":"Math and Math Physics","source":"arxiv"}],"first_author":{"emails":["wilhelm.schlag@yale.edu"],"full_name":"Schlag, Wilhelm","ids":[{"schema":"ORCID","value":"0000-0002-6418-1715"},{"schema":"INSPIRE BAI","value":"W.Schlag.2"}],"last_name":"Schlag","first_name":"Wilhelm","recid":1881372},"control_number":1838966,"dois":[{"source":"AIP","value":"10.1063/5.0042767"},{"material":"publication","source":"arXiv","value":"10.1063/5.0042767"}],"document_type":["article"],"texkeys":["Schlag:2020que"],"abstracts":[{"source":"AIP","value":"This paper introduces some of the basic mechanisms relating the behavior of the spectral measure of Schrödinger operators near zero energy to the long-term decay and dispersion of the associated Schrödinger and wave evolutions. These principles are illustrated by means of the author’s work on decay of Schrödinger and wave equations under various types of perturbations, including those of the underlying metric. In particular, we consider local decay of solutions to the linear Schrödinger and wave equations on curved backgrounds that exhibit trapping. A particular application is waves on a Schwarzschild black hole spacetime. We elaborate on Price’s law of local decay that accelerates with the angular momentum, which has recently been settled by Hintz, also in the much more difficult Kerr black hole setting. While the author’s work on the same topic was conducted ten years ago, the global semiclassical representation techniques developed there have recently been applied by Krieger, Miao, and the author [“A stability theory beyond the co-rotational setting for critical wave maps blow up,” arXiv:2009.08843 (2020)] to the nonlinear problem of stability of blowup solutions to critical wave maps under non-equivariant perturbations.","abstract_source_suggest":{"input":"AIP"}},{"source":"arXiv","value":"This article serves as an introduction to the linear aspects of the recent submission by Krieger, Miao, and the author, see arXiv:2009.08843. It also surveys some of the results obtained on the decay of linear waves on various backgrounds or in the presence of a potential over the past 15 years. Particular emphasis is placed on the role of 0 energy. The techniques are based on spectral and scattering theory. Note that this is not a systematic review, as this would require a book.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["math.AP"],"titles":[{"source":"AIP","title":"On pointwise decay of waves"},{"source":"arXiv","title":"On pointwise decay of waves"}],"imprints":[{"date":"2021-06-23"}],"curated":false}}],"total":14},"links":{"self":"https://inspirehep.net/api/literature/?q=...Global%20nonlinear%20stability%20of%20Schwarzschild%20spacetime...&size=10&page=1","next":"https://inspirehep.net/api/literature/?q=...Global%20nonlinear%20stability%20of%20Schwarzschild%20spacetime...&size=10&page=2","bibtex":"https://inspirehep.net/api/literature/?q=...Global%20nonlinear%20stability%20of%20Schwarzschild%20spacetime...&size=10&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=...Global%20nonlinear%20stability%20of%20Schwarzschild%20spacetime...&size=10&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=...Global%20nonlinear%20stability%20of%20Schwarzschild%20spacetime...&size=10&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=...Global%20nonlinear%20stability%20of%20Schwarzschild%20spacetime...&size=10&page=1&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=...Global%20nonlinear%20stability%20of%20Schwarzschild%20spacetime...&size=10&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=...Global%20nonlinear%20stability%20of%20Schwarzschild%20spacetime...&size=10&page=1&format=cv"}}