page_start":"39","journal_title":"Nuovo Cim.A"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/179417"}},{"reference":{"publication_info":{"journal_volume":"65","artid":"27","page_start":"27","journal_title":"Proc.Roy.Irish Acad.A"}}},{"reference":{"publication_info":{"journal_volume":"15","artid":"774","page_start":"774","journal_title":"J.Math.Phys."}}},{"reference":{"arxiv_eprint":"gr-qc/9310019","publication_info":{"journal_volume":"48","artid":"5706","page_start":"5706","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/36083"}}],"number_of_pages":45,"legacy_creation_date":"2004-03-19","preprint_date":"2004-03","author_count":2,"public_notes":[{"source":"arXiv","value":"45 pages, Revtex4, some refinements added"}],"earliest_date":"2004-03","refereed":true,"external_system_identifiers":[{"schema":"MSNET","value":"2215538"},{"schema":"ADS","value":"2006GReGr..38..187L"},{"schema":"SPIRES","value":"SPIRES-5827450"}],"facet_author_name":["999523_Luca Lusanna","1035192_Massimo Pauri"],"core":true,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:646621","updated":"2025-07-20T10:24:30.327943"},"journal_title_variants":["Gen.Rel.Grav.","Gen. Rel. Grav."],"arxiv_eprints":[{"categories":["gr-qc"],"value":"gr-qc/0403081"}],"referenced_authors_bais":["C.G.Torre.1","A.A.Komar.1","A.Sen.12","M.Chaichian.1","Albert.Einstein.1","J.A.Wheeler.1","B.S.DeWitt.1","L.Lusanna.1","V.Moncrief.1","Edward.Witten.1","J.E.Marsden.1","J.F.Woodward.1","J.C.Smallwood.1","Bala.R.Iyer.1","R.A.dInverno.2","D.C.Salisbury.1","R.Sugano.1","M.Pauri.1","J.W.York.1","Toshiei.Kimura.1","P.Carini.2","P.Crawford.1","C.V.Vishveshwara.1","J.M.Arms.1","N.O.Murchadha.1","S.Russo.3","S.Deser.1","I.Goldberg.1","D.Alba.1","L.Martucci.1","A.D.Rendall.1","P.G.Bergmann.1","J.P.Carini.1","J.Agresti.1","Michele.Vallisneri.1","P.Carini.3","R.T.Jantzen.1","C.W.Misner.1","Y.Kagraoka.1","M.Henneaux.1","H.W.Crater.1","D.Louis.Martinez.1","A.Barducci.1","R.L.Arnowitt.1","R.F.Baierlein.1","Ismael.Tereno.1","J.Bicak.1","R.De.Pietri.1","J.M.Pons.1","Helmut.Friedrich.1","J.Isenberg.1","S.Shanmugadhasan.1","D.H.Sharp.1","L.C.Shepley.5","D.Bini.1","J.L.Anderson.1"],"legacy_version":"20200608091639.0","inspire_categories":[{"term":"Gravitation and Cosmology"}],"first_author":{"full_name":"Lusanna, Luca","last_name":"Lusanna","first_name":"Luca","recid":999523},"control_number":646621,"dois":[{"value":"10.1007/s10714-005-0217-6"}],"document_type":["article"],"texkeys":["Lusanna:2004ta"],"abstracts":[{"source":"arXiv","value":"This is the first of a couple of papers in which, by exploiting the capabilities of the Hamiltonian approach to general relativity, we get a number of technical achievements that are instrumental both for a disclosure of \\emph{new} results concerning specific issues, and for new insights about \\emph{old} foundational problems of the theory. The first paper includes: 1) a critical analysis of the various concepts of symmetry related to the Einstein-Hilbert Lagrangian viewpoint on the one hand, and to the Hamiltonian viewpoint, on the other. This analysis leads, in particular, to a re-interpretation of {\\it active} diffeomorphisms as {\\it passive and metric-dependent} dynamical symmetries of Einstein's equations, a re-interpretation which enables to disclose the (nearly unknown) connection of a subgroup of them to Hamiltonian gauge transformations {\\it on-shell}; 2) a re-visitation of the canonical reduction of the ADM formulation of general relativity, with particular emphasis on the geometro-dynamical effects of the gauge-fixing procedure, which amounts to the definition of a \\emph{global (non-inertial) space-time laboratory}. This analysis discloses the peculiar \\emph{dynamical nature} that the traditional definition of distant simultaneity and clock-synchronization assume in general relativity, as well as the {\\it gauge relatedness} of the \"conventions\" which generalize the classical Einstein's convention.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"The Physical role of gravitational and gauge degrees of freedom in general relativity. 1. Dynamical synchronization and generalized inertial effects"},{"source":"arXiv","title":"The physical role of gravitational and gauge degrees of freedom in general relativity. I: Dynamical synchronization and generalized inertial effects."},{"source":"arXiv","title":"The Physical Role of Gravitational and Gauge Degrees of Freedom in General Relativity - I: Dynamical Synchronization and Generalized Inertial Effects"}],"curated":true},"updated":"2025-07-20T10:24:30.327943+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/646621?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/646621?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/646621?format=latex-us","json":"https://inspirehep.net/api/literature/646621?format=json","json-expanded":"https://inspirehep.net/api/literature/646621?format=json-expanded","cv":"https://inspirehep.net/api/literature/646621?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A646621"}},{"id":"1262930","created":"2013-11-01T00:00:00+00:00","metadata":{"citation_count":0,"publication_info":[{"journal_volume":"153","page_end":"152","year":2007,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1213635"},"page_start":"137","journal_title":"Fundam.Theor.Phys."}],"authors":[{"full_name_unicode_normalized":"bojowald, martin","full_name":"Bojowald, Martin","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/1015941"},"last_name":"Bojowald","ids":[{"schema":"INSPIRE BAI","value":"Martin.Bojowald.1"}],"signature_block":"BAJALDm","uuid":"6c976ad6-34ce-4672-937a-961952c57dbe","first_name":"Martin","recid":1015941}],"citation_count_without_self_citations":0,"citeable":true,"$schema":"https://inspirehep.