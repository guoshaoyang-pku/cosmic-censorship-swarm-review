:"509","journal_title":"Phys.Rev.D"},"title":{"title":"Quantum creation of universes"},"authors":[{"full_name":"Vilenkin, A."}]},"raw_refs":[{"schema":"text","value":"A. Vilenkin: Quantum creation of universes, Phys. Rev. D 30, 509-511 (1984)"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/207363"}},{"reference":{"dois":["10.1103/PhysRevD.28.2960"],"label":"32","publication_info":{"journal_volume":"28","page_end":"2975","year":1983,"page_start":"2960","journal_title":"Phys.Rev.D"},"title":{"title":"Wave Function of the Universe"},"authors":[{"full_name":"Hartle, J.B."},{"full_name":"Hawking, S.W."}]},"raw_refs":[{"schema":"text","value":"J. B. Hartle and S. W. Hawking: Wave Function of the Universe, Phys. Rev. D 28, 2960-2975 (1983)"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/192909"}},{"reference":{"dois":["10.1103/PhysRevLett.87.121301"],"arxiv_eprint":"gr-qc/0104072","label":"33","publication_info":{"journal_volume":"87","page_end":"301","year":2001,"page_start":"121","journal_title":"Phys.Rev.Lett."},"title":{"title":"Dynamical Initial Conditions in Quantum Cosmology"},"authors":[{"full_name":"Bojowald, M."}]},"raw_refs":[{"schema":"text","value":"M. Bojowald: Dynamical Initial Conditions in Quantum Cosmology, Phys. Rev. Lett. 87, 121-301 (2001), gr-qc/0104072"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/555714"}},{"reference":{"dois":["10.1023/A:1026257806654"],"arxiv_eprint":"gr-qc/0305069","label":"34","publication_info":{"journal_volume":"35","page_end":"1883","year":2003,"page_start":"1877","journal_title":"Gen.Rel.Grav."},"title":{"title":"Initial Conditions for a Universe"},"authors":[{"full_name":"Bojowald, M."}]},"raw_refs":[{"schema":"text","value":"M. Bojowald: Initial Conditions for a Universe, Gen. Rel. Grav. 35, 1877-1883 (2003), gr-qc/0305069"}],"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/619005"}}],"number_of_pages":16,"referenced_authors_bais":["Carlo.Rovelli.1","R.Penrose.1","Jan.Ambjorn.1","T.Thiemann.1","Alexander.Vilenkin.1","R.S.Tate.2","M.P.Reisenberger.1","L.Lusanna.1","A.Komar.2","J.Jurkiewicz.1","A.Ashtekar.1","K.Vandersloot.1","O.Lauscher.1","Jerzy.Lewandowski.1","C.Uggla.1","Bianca.Dittrich.1","G.T.Horowitz.1","Martin.Reuter.1","D.Alba.1","Renate.Loll.1","R.C.Myers.1","A.D.Rendall.1","P.G.Bergmann.1","George.F.R.Ellis.1","M.Dafermos.1","G.Date.1","Stephen.W.Hawking.1","Martin.Bojowald.1","Lee.Smolin.1","J.B.Hartle.1","D.M.Marolf.1","Helmut.Friedrich.1","S.B.Giddings.1","L.Modesto.1","J.M.Mourao.1"],"legacy_version":"20161225032058.0","inspire_categories":[{"term":"Gravitation and Cosmology"}],"legacy_creation_date":"2013-11-01","author_count":1,"first_author":{"full_name":"Bojowald, Martin","last_name":"Bojowald","first_name":"Martin","recid":1015941},"control_number":1262930,"dois":[{"value":"10.1007/978-1-4020-6318-3_8"}],"earliest_date":"2007","document_type":["book chapter"],"texkeys":["Bojowald:2007gga"],"abstracts":[{"value":"Different aspects of relativity, mainly in a canonical formulation, relevant for the question “Is spacetime nothing more than a mathematical space (which describes the evolution in time of the ordinary three-dimensional world) or is it a mathematical model of a real 4D world with time entirely given as the fourth dimension?” are presented. The availability as well as clarity of the arguments depends on which framework is being used, for which currently special relativity, general relativity and some schemes of quantum gravity are available. Canonical gravity provides means to analyze the field equations as well as observable quantities, the latter even in coordinate independent form. This allows a unique perspective on the question of dimensionality since the space-time manifold does not play a prominent role. After reintroducing a Minkowski background into the formalism, one can see how distinguished coordinates of special relativity arise, where also the nature of time is different from that in the general perspective. Just as it is of advantage to extend special to general relativity, general relativity itself has to be extended to some theory of quantum gravity. This suggests that a final answer has to await a thorough formulation and understanding of a fundamental theory of space-time. Nevertheless, we argue that current insights into quantum gravity do not change the picture of the role of time obtained from general relativity"}],"titles":[{"title":"Canonical Relativity and the Dimensionality of the World"}],"facet_author_name":["1015941_Martin Bojowald"],"imprints":[{"date":"2007"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1262930","updated":"2023-09-16T16:21:03.425545"},"curated":true,"journal_title_variants":["Fundam.Theor.Phys.","Fundam. Theor. Phys."]},"updated":"2023-09-16T16:21:03.425545+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/1262930?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1262930?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1262930?format=latex-us","json":"https://inspirehep.net/api/literature/1262930?format=json","json-expanded":"https://inspirehep.net/api/literature/1262930?format=json-expanded","cv":"https://inspirehep.net/api/literature/1262930?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1262930"}},{"id":"781314","created":"2008-03-13T00:00:00+00:00","metadata":{"citation_count":2,"publication_info":[{"journal_volume":"1023","page_end":"206","conference_record":{"$ref":"https://inspirehep.net/api/conferences/978875"},"year":2008,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1213302"},"page_start":"202","journal_issue":"1","journal_title":"AIP Conf.Proc.","parent_record":{"$ref":"https://inspirehep.net/api/literature/1389510"},"cnum":"C07-09-05.3"}],"authors":[{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/04njjy449"}],"full_name_unicode_normalized":"sanchez-rodriguez, ignacio","full_name":"Sanchez-Rodriguez, Ignacio","record":{"$ref":"https://inspirehep.net/api/authors/2469103"},"last_name":"Sanchez-Rodriguez","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/909078"},"value":"Granada U."}],"ids":[{"schema":"INSPIRE BAI","value":"I.SanchezRodriguez.2"}],"signature_block":"RADRAGi","uuid":"c727d43c-bca3-4351-8f5d-9a8f07b7dd11","first_name":"Ignacio","recid":2469103}],"citation_count_without_self_citations":2,"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","keywords":[{"schema":"PACS","value":"02.40.Hw"},{"schema":"PACS","value":"02.20.Qs"},{"schema":"PACS","value":"04.20.Cv"},{"source":"author","value":"geometry"},{"source":"author","value":"general relativity"},{"source":"author","value":"Lie algebras"},{"source":"author","value":"General relativity"},{"source":"author","value":"Einstein Maxwell equations"}],"references":[{"reference":{"publication_info":{"journal_volume":"22","artid":"2598","page_start":"2598","journal_title":"J.Math.Phys."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/156255"}},{"reference":{"publication_info":{"journal_volume":"57","artid":"691","page_start":"691","journal_title":"J.Geom.Phys."}}},{"reference":{"publication_info":{"journal_volume":"47","artid":"227","page_start":"227","journal_title":"Rend.Sem.Mat.Padova"}}},{"reference":{"publication_info":{"journal_volume":"17","artid":"84","page_start":"84","journal_title":"J.Math.Soc.Jap."}}},{"reference":{"publication_info":{"journal_volume":"16","artid":"271","page_start":"271","journal_title":"Topology"}}},{"reference":{"publication_info":{"journal_volume":"100","artid":"775","page_start":"775","journal_title":"Am.J.Math."}}}],"number_of_pages":5,"legacy_creation_date":"2008-03-13","preprint_date":"2008-03","author_count":1,"earliest_date":"2008-03","external_system_identifiers":[{"schema":"ADS","value":"2008AIPC.1023..202S"},{"schema":"SPIRES","value":"SPIRES-7688350"}],"facet_author_name":["2469103_Ignacio Sánchez-Rodríguez"],"core":false,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:781314","updated":"2023-03-06T14:58:12.312074"},"journal_title_variants":["AIP Conf. Proc.","AIP Conf.Proc."],"arxiv_eprints":[{"categories":["gr-qc"],"value":"0803.1929"}],"referenced_authors_bais":["Robert.Alan.Coleman.1","H.Korte.1"],"legacy_version":"20190225121810.0","inspire_categories":[{"term":"Gravitation and Cosmology"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/04njjy449"}],"full_name":"Sanchez-Rodriguez, Ignacio","last_name":"Sanchez-Rodriguez","first_name":"Ignacio","recid":2469103},"control_number":781314,"dois":[{"value":"10.1063/1.2958176"}],"document_type":["conference paper"],"texkeys":["Sanchez-Rodriguez:2008hwk","SanchezRodriguez:2008uu"],"abstracts":[{"source":"AIP","value":"Space‐Time in general relativity is a dynamical entity because it is subject to the Einstein field equations. The space‐time metric provides different geometrical structures: conformal, volume, projective and linear connection. A deep understanding of them has consequences on the dynamical role played by geometry. We present a unified description of those geometrical structures, with a standard criterion of naturalness, and then we establish relationships among them and try to clarify the meaning of associated geometric magnitudes.","abstract_source_suggest":{"input":"AIP"}},{"source":"arXiv","value":"Space-Time in general relativity is a dynamical entity because it is subject to the Einstein field equations. The space-time metric provides different geometrical structures: conformal, volume, projective and linear connection. A deep understanding of them has consequences on the dynamical role played by geometry. We present a unified description of those geometrical structures, with a standard criterion of naturalness, and then we establish relationships among them and try to clarify the meaning of associated geometric magnitudes.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"Geometrical Structures of Space-Time in General Relativity"},{"source":"arXiv","title":"Geometrical Structures of Space-Time in General Relativity"}],"imprints":[{"date":"2008-06-30"}],"curated":true},"updated":"2023-03-06T14:58:12.312074+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/781314?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/781314?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/781314?format=latex-us","json":"https://inspirehep.net/api/literature/781314?format=json","json-expanded":"https://inspirehep.net/api/literature/781314?format=json-expanded","cv":"https://inspirehep.net/api/literature/781314?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A781314"}},{"id":"663778","created":"2004-11-09T00:00:00+00:00","metadata":{"citation_count":0,"publication_info":[{"page_end":"11","conference_record":{"$ref":"https://inspirehep.net/api/conferences/976316"},"page_start":"3","parent_record":{"$ref":"https://inspirehep.net/api/literature/719517"},"cnum":"C04-09-26.2"}],"authors":[{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/05tkyf982"}],"full_name_unicode_normalized":"carmeli, moshe","full_name":"Carmeli, Moshe","record":{"$ref":"https://inspirehep.net/api/authors/1014469"},"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/902663"},"value":"Ben Gurion U. of Negev"}],"ids":[{"schema":"INSPIRE BAI","value":"M.Carmeli.1"}],"last_name":"Carmeli","signature_block":"CARNALm","uuid":"d12e6281-584d-4171-97e5-61eeb6d02425","first_name":"Moshe","recid":1014469}],"citation_count_without_self_citations":0,"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","references":[{"reference":{"publication_info":{"journal_volume":"25","artid":"1029","page_start":"1029","journal_title":"Found.Phys."}}},{"reference":{"publication_info":{"journal_volume":"26","artid":"413","page_start":"413","journal_title":"Found.Phys."}}},{"reference":{"publication_info":{"journal_volume":"5","artid":"159","page_start":"159","journal_title":"Commun.Theor.Phys."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/233096"}}],"number_of_pages":9,"referenced_authors_bais":["Qi.Xing.Shen.1","Bing.An.Li.1"],"legacy_version":"20160217180150.0","inspire_categories":[{"term":"Astrophysics"}],"legacy_creation_date":"2004-11-09","preprint_date":"2004-11","author_count":1,"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/05tkyf982"}],"full_name":"Carmeli, Moshe","last_name":"Carmeli","first_name":"Moshe","recid":1014469},"control_number":663778,"earliest_date":"2004-11","document_type":["conference paper"],"texkeys":["Carmeli:2004vd"],"abstracts":[{"source":"arXiv","value":"In the standard cosmological theory one uses the Einstein concepts of space and time as were originally introduced for the special theory of relativity and the general relativity theory. According to this approach all physical quantities are described in terms of the continuum spatial coordinates and time. Using general relativity theory a great progress has been made in understanding the evolution of the Universe. Cosmologists usually measure spatial distances and redshifts of faraway galaxies as expressed by the Hubble expansion. In recent years this fact was undertaken to develop new theories in terms of distances and velocities (redshift). While in Einstein's relativity the propagation of light plays the major role, in the new theory it is the expansion of the Universe that takes that role and appears at the outset. The cosmic time becomes crucial in these recent theories, which in the standard theory is considered to be absolute but here it is relative. In this lecture this new approach to cosmology is presented.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["astro-ph"],"titles":[{"title":"Cosmological theories of special and general relativity - 1"},{"source":"arXiv","title":"Cosmological theories of special and general relativity - 1."}],"external_system_identifiers":[{"schema":"SPIRES","value":"SPIRES-6041086"}],"facet_author_name":["1014469_Moshe Carmeli"],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:663778","updated":"2023-03-06T14:05:28.386278"},"curated":true,"arxiv_eprints":[{"categories":["astro-ph"],"value":"astro-ph/0411180"}]},"updated":"2023-03-06T14:05:28.386278+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/663778?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/663778?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/663778?format=latex-us","json":"https://inspirehep.net/api/literature/663778?format=json","json-expanded":"https://inspirehep.net/api/literature/663778?format=json-expanded","cv":"https://inspirehep.net/api/literature/663778?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A663778"}},{"id":"1208090","created":"2012-12-19T00:00:00+00:00","metadata":{"citation_count":64,"publication_info":[{"journal_volume":"87","artid":"044044","year":2013,"journal_issue":"4","journal_title":"Phys.Rev.D"}],"authors":[{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/04p491231"}],"full_name_unicode_normalized":"bojowald, martin","full_name":"Bojowald, Martin","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/1015941"},"last_name":"Bojowald","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903125"},"value":"Penn State U."}],"ids":[{"schema":"ORCID","value":"0000-0002-7271-5617"},{"schema":"INSPIRE BAI","value":"Martin.Bojowald.1"}],"signature_block":"BAJALDm","uuid":"611cfe86-f8e0-46e8-bbdc-d76e1a9bc09f","first_name":"Martin","recid":10159