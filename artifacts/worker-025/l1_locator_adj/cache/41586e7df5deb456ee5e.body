ets":["Literature"],"id":"oai:inspirehep.net:1499039","updated":"2023-03-09T17:46:47.306280"},"journal_title_variants":["Adv.Math.Phys.","Adv. Math. Phys."],"arxiv_eprints":[{"categories":["gr-qc","math.DG"],"value":"1611.06075"}],"referenced_authors_bais":["M.Tegmark.1","V.de.Souza.2","Y.Mao.4","M.E.Kahil.1","M.I.Wanas.1","S.A.Ammar.1","S.Cabi.1","R.Opher.1","W.A.Elsayed.1","A.A.Sousa.5","J.W.Maluf.1","A.M.SidAhmed.2","N.L.Youssef.1","M.Melek.3","W.El.Hanafy.1","A.H.Guth.1","R.S.de.Souza.1","S.L.Bazanski.1"],"legacy_version":"20180817110030.0","inspire_categories":[{"term":"Gravitation and Cosmology"},{"term":"Math and Math Physics"}],"first_author":{"full_name":"Wanas, M.I.","last_name":"Wanas","first_name":"M.I.","recid":984188},"control_number":1499039,"dois":[{"value":"10.1155/2016/1037849"}],"document_type":["article"],"texkeys":["Wanas:2016boh"],"abstracts":[{"source":"HINDAWI","value":"The importance of Einstein’s geometrization philosophy, as an alternative to the least action principle, in constructing general relativity (GR), is illuminated. The role of differential identities in this philosophy is clarified. The use of Bianchi identity to write the field equations of GR is shown. Another similar identity in the absolute parallelism geometry is given. A more general differential identity in the parameterized absolute parallelism geometry is derived. Comparison and interrelationships between the above mentioned identities and their role in constructing field theories are discussed.","abstract_source_suggest":{"input":"HINDAWI"}},{"source":"arXiv","value":"The importance of Einstein's geometrization philosophy, as an alternative to the least action principle, in constructing general relativity (GR), is illuminated. The role of differential identities in this philosophy is clarified. The use of Bianchi identity to write the field equations of GR is shown. Another similar identity in the absolute parallelism geometry is given. A more general differential identity in the parameterized absolute parallelism geometry is derived. Comparison and interrelationships between the above mentioned identities and their role in constructing field theories are discussed.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"source":"arXiv","title":"Einstein Geometrization Philosophy and Differential Identities in PAP-Geometry"}],"imprints":[{"date":"2016-11-28"}],"curated":false},"updated":"2023-03-09T17:46:47.306280+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/1499039?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1499039?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1499039?format=latex-us","json":"https://inspirehep.net/api/literature/1499039?format=json","json-expanded":"https://inspirehep.net/api/literature/1499039?format=json-expanded","cv":"https://inspirehep.net/api/literature/1499039?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1499039"}},{"id":"646621","created":"2004-03-19T00:00:00+00:00","metadata":{"citation_count":39,"publication_info":[{"journal_volume":"38","page_end":"227","year":2006,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214738"},"page_start":"187","journal_title":"Gen.Rel.Grav."}],"authors":[{"full_name_unicode_normalized":"lusanna, luca","full_name":"Lusanna, Luca","record":{"$ref":"https://inspirehep.net/api/authors/999523"},"last_name":"Lusanna","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/902880"},"value":"INFN, Florence"}],"ids":[{"schema":"INSPIRE BAI","value":"L.Lusanna.1"}],"signature_block":"LASANl","first_name":"Luca","uuid":"525cdc52-8279-4e20-9f09-0e9c89f42b6e","recid":999523},{"full_name_unicode_normalized":"pauri, massimo","full_name":"Pauri, Massimo","record":{"$ref":"https://inspirehep.net/api/authors/1035192"},"last_name":"Pauri","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903120"