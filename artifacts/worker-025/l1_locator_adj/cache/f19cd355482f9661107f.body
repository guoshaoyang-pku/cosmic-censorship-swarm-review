{"uuid":"5e05245d-0ddc-4dd7-abd7-d2cfcb279819","revision_id":97,"metadata":{"citation_count":399,"citation_count_without_self_citations":398,"publication_info":[{"year":1984,"page_end":"195","page_start":"171","journal_title":"Commun.Math.Phys.","journal_record":{"$ref":"https://inspirehep.net/api/journals/1214791"},"journal_volume":"93"}],"dois":[{"value":"10.1007/BF01223743"}],"titles":[{"title":"Violation of cosmic censorship in the gravitational collapse of a dust cloud"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"aef7a2f1-d619-44f1-a2a4-373c9fb1303a","record":{"$ref":"https://inspirehep.net/api/authors/1057433"},"full_name":"Christodoulou, Demetrios","affiliations":[{"value":"New York U., Courant Inst.","record":{"$ref":"https://inspirehep.net/api/institutions/903068"}}],"signature_block":"CHRASTADALd"}],"curated":true,"texkeys":["Christodoulou:1984mz"],"citeable":true,"refereed":true,"abstracts":[{"value":"The behaviour of the outgoing light rays in the gravitational collapse of an inhomogeneous spherically symmetric dust cloud is analyzed. It is shown that, for an open subset of initial density distributions, the first singular event, which occurs at the center of symmetry, is the vertex of an infinity of future null geodesic cones which intersect future null infinity. The frequency of the corresponding light rays is infinitely redshifted.","source":"Springer"}],"references":[{"record":{"$ref":"https://inspirehep.net/api/literature/4511"},"reference":{"publication_info":{"artid":"169","page_start":"169","journal_title":"Proc.Nat.Acad.Sci.","journal_volume":"20"}},"curated_relation":false},{"reference":{"publication_info":{"artid":"176","page_start":"176","journal_title":"Proc.Nat.Acad.Sci.","journal_volume":"10"}}},{"record":{"$ref":"https://inspirehep.net/api/literature/3898"},"reference":{"publication_info":{"artid":"455","page_start":"455","journal_title":"Phys.Rev.","journal_volume":"56"}},"curated_relation":false},{"reference":{"publication_info":{"artid":"343","page_start":"343","journal_title":"Ann.Inst.H.Poincare Phys.Theor.","journal_volume":"6"}}}],"document_type":["article"],"preprint_date":"1984","control_number":211917,"legacy_version":"20180228133517.0","number_of_pages":25,"inspire_categories":[{"term":"Math and Math Physics"},{"term":"Gravitation and Cosmology"}],"legacy_creation_date":"2003-05-09","external_system_identifiers":[{"value":"euclid.cmp/1103941053","schema":"EUCLID"},{"value":"SPIRES-4000323","schema":"SPIRES"}]},"created":"2003-05-09T00:00:00+00:00","id":"211917","updated":"2023-03-07T03:37:37.395397+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/211917?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/211917?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/211917?format=latex-us","json":"https://inspirehep.net/api/literature/211917?format=json","json-expanded":"https://inspirehep.net/api/literature/211917?format=json-expanded","cv":"https://inspirehep.net/api/literature/211917?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A211917"}}