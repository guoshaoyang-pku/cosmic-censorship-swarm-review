{"uuid":"730b8b25-7207-4b2d-9ed4-c1ba4de3b874","created":"2009-12-30T00:00:00+00:00","revision_id":92,"updated":"2023-03-06T14:19:40.520292+00:00","metadata":{"citation_count":15,"publication_info":[{"year":2012,"artid":"211","page_start":"211","journal_title":"Acta Mat.","journal_record":{"$ref":"https://inspirehep.net/api/journals/1214888"},"journal_volume":"208"}],"citation_count_without_self_citations":12,"titles":[{"title":"On the formation of trapped surfaces"},{"title":"On the formation of trapped surfaces","source":"arXiv"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"8ee92380-b617-4ec4-9d1e-7b658c10c6e0","record":{"$ref":"https://inspirehep.net/api/authors/1050880"},"full_name":"Klainerman, S.","affiliations":[{"value":"Princeton U., Math. Dept.","record":{"$ref":"https://inspirehep.net/api/institutions/903402"}}],"signature_block":"CLANARNANs"},{"uuid":"ae95b908-e192-4caa-a54a-7fb131cf58d6","record":{"$ref":"https://inspirehep.net/api/authors/1050881"},"full_name":"Rodnianski, I.","affiliations":[{"value":"Princeton U., Math. Dept.","record":{"$ref":"https://inspirehep.net/api/institutions/903402"}}],"signature_block":"RADNANSCi"}],"curated":true,"texkeys":["Klainerman:2009ga"],"citeable":true,"refereed":true,"abstracts":[{"value":"In a recent important breakthrough D. Christodoulou has solved a long standing problem of General Relativity of evolutionary formation of trapped surfaces in the Einstein-vacuum space-times. He has identified an open set of regular initial conditions on an outgoing null hypersurface (both finite and at past null infinity) leading to a formation a trapped surface in the corresponding vacuum space-time to the future of the initial outgoing hypersurface and another incoming null hypersurface with the prescribed Minkowskian data. In this paper we give a simpler proof for a finite problem by enlarging the admissible set of initial conditions and, consistent with this, relaxing the corresponding propagation estimates just enough that a trapped surface still forms. We also reduce the number of derivatives needed in the argument from two derivatives of the curvature to just one. More importantly, the proof, which can be easily localized with respect to angular sectors, has the potential for further developments.","source":"arXiv"}],"references":[{"reference":{"misc":["The Formation of Black Holes in General Relativity, Monographs in Mathematics, European Mathematical Soc"],"label":"Chr","authors":[{"full_name":"Christodoulou, D."}],"publication_info":{"year":2009}}},{"reference":{"misc":["The global nonlinear stability of he Minkowski space"],"label":"Chr-Kl","authors":[{"full_name":"Christodoulou, D."},{"full_name":"Klainerman, S."}],"publication_info":{"artid":"1993","page_start":"1993","journal_title":"Princeton Math.Ser.","journal_volume":"41"}}},{"reference":{"misc":["The evolution problem in General Relativity, Progress in Mathematical Physics, Birkha ̈user"],"label":"K-Ni","authors":[{"full_name":"Klainerman, S."},{"full_name":"Nicolo, F."}]}},{"reference":{"misc":["Causal geometry of Einstein-Vacuum spacetimes with finite curvature flux, Inventiones Math.,159, 437-529"],"label":"K-R:causal","authors":[{"full_name":"Klainerman, S."},{"full_name":"Rodnianski, I."}],"publication_info":{"year":2005}}},{"reference":{"misc":["A geometric approach to the Littlewood-Paley theory, GAFA,16, no. 1,126-163"],"label":"K-R:LP","authors":[{"full_name":"Klainerman, S."},{"full_name":"Rodnianski, I."}]}},{"record":{"$ref":"https://inspirehep.net/api/literature/823721"},"reference":{"misc":["focused gravitational waves. preprint"],"label":"R-T","authors":[{"full_name":"Reiterer, M."},{"full_name":"Strongly, E. Trubowitz"}],"arxiv_eprint":"0906.3812","publication_info":{"year":2009}},"curated_relation":false}],"arxiv_eprints":[{"value":"0912.5097","categories":["gr-qc"]}],"document_type":["article"],"preprint_date":"2009-12","control_number":841287,"legacy_version":"20170828200313.0","number_of_pages":117,"inspire_categories":[{"term":"Gravitation and Cosmology"},{"term":"Math and Math Physics"}],"legacy_creation_date":"2009-12-30","external_system_identifiers":[{"value":"SPIRES-8508976","schema":"SPIRES"}]},"links":{"bibtex":"https://inspirehep.net/api/literature/841287?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/841287?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/841287?format=latex-us","json":"https://inspirehep.net/api/literature/841287?format=json","json-expanded":"https://inspirehep.net/api/literature/841287?format=json-expanded","cv":"https://inspirehep.net/api/literature/841287?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A841287"},"id":"841287"}