}]}},{"reference":{"dois":["10.1103/PhysRevD.41.1796"],"label":"5","publication_info":{"journal_volume":"41","artid":"1796","year":1990,"page_start":"1796","journal_title":"Phys.Rev.D"},"authors":[{"full_name":"Poisson, E."},{"full_name":"Israel, W."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/301259"}},{"reference":{"dois":["10.1002/cpa.20071"],"label":"6","publication_info":{"journal_volume":"58","artid":"445","year":2005,"page_start":"445","journal_title":"Commun.Pure Appl.Math."},"authors":[{"full_name":"Dafermos, M."}]},"record":{"$ref":"https://inspirehep.net/api/literature/622602"}},{"reference":{"dois":["10.1007/s00220-016-2771-z"],"label":"7","publication_info":{"journal_volume":"350","artid":"985","year":2017,"page_start":"985","journal_title":"Commun.Math.Phys."},"authors":[{"full_name":"Dafermos, M."},{"full_name":"Shlapentokh-Rothman, Y."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1411430"}},{"reference":{"dois":["10.1215/00127094-3715189"],"label":"8","publication_info":{"journal_volume":"166","artid":"437","year":2017,"page_start":"437","journal_title":"Duke Math.J."},"authors":[{"full_name":"Luk, J."},{"full_name":"Oh, S.-J."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1340082"}},{"reference":{"dois":["10.1103/PhysRevD.41.403"],"label":"9","publication_info":{"journal_volume":"41","artid":"403","year":1990,"page_start":"403","journal_title":"Phys.Rev.D"},"authors":[{"full_name":"Mellor, F."},{"full_name":"Moss, I."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/26138"}},{"reference":{"dois":["10.1103/PhysRevLett.120.031103"],"label":"10","publication_info":{"journal_volume":"120","artid":"031103","year":2018,"journal_title":"Phys.Rev.Lett."},"authors":[{"full_name":"Cardoso, V."},{"full_name":"Costa"},{"full_name":"J.a.L."},{"full_name":"Destounis, K."},{"full_name":"Hintz, P."},{"full_name":"Ja