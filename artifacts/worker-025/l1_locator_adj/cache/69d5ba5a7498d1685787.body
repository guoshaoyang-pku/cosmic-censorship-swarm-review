l_name":"Natário, J."},{"full_name":"Silva, J.D."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1613504"}},{"reference":{"dois":["10.1007/JHEP10(2018)001"],"label":"17","publication_info":{"journal_volume":"10","artid":"001","year":2018,"page_start":"001","journal_title":"JHEP"},"authors":[{"full_name":"Dias, O.J."},{"full_name":"Reall, H.S."},{"full_name":"Santos, J.E."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1685783"}},{"reference":{"dois":["10.1088/1361-6382/aafcf2"],"label":"18","publication_info":{"journal_volume":"36","artid":"045005","year":2019,"journal_title":"Class.Quant.Grav."},"authors":[{"full_name":"Dias, O.J."},{"full_name":"Reall, H.S."},{"full_name":"Santos, J.E."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1687464"}},{"reference":{"dois":["10.1103/PhysRevD.97.104060"],"label":"19","publication_info":{"journal_volume":"97","artid":"104060","year":2018,"journal_title":"Phys.Rev.D"},"authors":[{"full_name":"Dias, O.J."},{"full_name":"Eperon, F.C."},{"full_name":"Reall, H.S."},{"full_name":"Santos, J.E."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1651241"}},{"reference":{"dois":["10.1007/JHEP12(2019)097"],"label":"20","publication_info":{"journal_volume":"12","artid":"097","year":2019,"page_start":"097","journal_title":"JHEP"},"authors":[{"full_name":"Dias, O.J."},{"full_name":"Reall, H.S."},{"full_name":"Santos, J.E."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1740693"}},{"reference":{"dois":["10.1103/PhysRevLett.69.1849"],"label":"21","publication_info":{"journal_volume":"69","artid":"1849","year":1992,"page_start":"1849","journal_title":"Phys.Rev.Lett."},"authors":[{"full_name":"Banados, M."},{"full_name":"Teitelboim, C."},{"full_name":"Zanelli, J."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/32290"}},{"reference":{"dois":["10.1103/PhysRevD.103.024008"],"label":"22","publication_info":{"journal_volume":"103","artid":"024008","year":2021,"journal_title":"Phys.Rev.D"},"authors":[{"full_name":"Bhattacharjee, S."},{"full_name":"Sarkar, S."},{"full_name":"Bhattacharyya, A."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1830603"}},{"reference":{"arxiv_eprint":"2011.03499","label":"23","authors":[{"full_name":"Moitra, U."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1828817"}},{"reference":{"dois":["10.1088/1361-6382/aadbcf"],"label":"24","publication_info":{"journal_volume":"35","artid":"195010","year":2018,"journal_title":"Class.Quant.Grav."},"authors":[{"full_name":"Dafermos, M."},{"full_name":"Shlapentokh-Rothman, Y."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1674350"}},{"reference":{"dois":["10.1088/1361-6382/ab8052"],"label":"25","publication_info":{"journal_volume":"37","artid":"115009","year":2020,"journal_title":"Class.Quant.Grav."},"authors":[{"full_name":"Hollands, S."},{"full_name":"Wald, R.M."},{"full_name":"Zahn, J."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1770475"}},{"reference":{"dois":["10.1103/PhysRevD.102.085004"],"label":"26","publication_info":{"journal_volume":"102","artid":"085004","year":2020,"journal_title":"Phys.Rev.D"},"authors":[{"full_name":"Hollands, S."},{"full_name":"Klein, C."},{"full_name":"Zahn, J."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1802169"}},{"reference":{"dois":["10.1007/JHEP06(2020)038"],"label":"27","publication_info":{"journal_volume":"06","artid":"038","year":2020,"page_start":"038","journal_title":"JHEP"},"authors":[{"full_name":"Emparan, R."},{"full_name":"Tomašević, M."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1778916"}},{"reference":{"imprint":{"publisher":"Chicago Univ. Pr., Chica