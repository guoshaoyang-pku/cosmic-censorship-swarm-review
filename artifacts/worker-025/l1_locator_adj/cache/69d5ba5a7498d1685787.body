ull_name":"Figueras, P."},{"full_name":"Monteiro, R."},{"full_name":"Reall, H.S."},{"full_name":"Santos, J.E."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/843550"}},{"reference":{"imprint":{"publisher":"Society for Industrial and Applied Mathematics"},"label":"35","publication_info":{"year":2000},"title":{"title":"Spectral Methods in MatLab"},"misc":["USA,"],"authors":[{"full_name":"Trefethen, L.N."}]}},{"reference":{"imprint":{"publisher":"Dover Publications"},"label":"36","publication_info":{"year":2000},"misc":["New York,"],"authors":[{"full_name":"Boyd, J."},{"full_name":"Marilyn, T."},{"full_name":"Eliot, P."}]}},{"reference":{"dois":["10.1137/S0036144500381988"],"label":"37","publication_info":{"journal_volume":"43","artid":"235","year":2001,"page_start":"235","journal_title":"SIAM Rev."},"authors":[{"full_name":"Tisseur, F."},{"full_name":"Meerbergen, K."}]}},{"reference":{"dois":["10.1007/JHEP03(2019)178"],"label":"38","publication_info":{"journal_volume":"03","artid":"178","year":2019,"page_start":"178","journal_title":"JHEP"},"authors":[{"full_name":"Rahman, M."},{"full_name":"Chakraborty, S."},{"full_name":"SenGupta, S."},{"full_name":"Sen, A.A."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1704506"}},{"reference":{"dois":["10.1088/1361-6382/aba17d"],"label":"39","publication_info":{"journal_volume":"37","artid":"195004","year":2020,"journal_title":"Class.Quant.Grav."},"authors":[{"full_name":"Rahman, M."},{"full_name":"Mitra, S."},{"full_name":"Chakraborty, S."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1773990"}},{"reference":{"dois":["10.1103/PhysRevD.101.064041"],"label":"40","publication_info":{"journal_volume":"101","artid":"064041","year":2020,"journal_title":"Phys.Rev.D"},"authors":[{"full_name":"Mishra, A.K."},{"full_name":"Chakraborty, S."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1766633"}}],"number_of_pages":14,"legacy_creation_date":"2020-12-22","preprint_date":"2020-12-18","author_count":1,"public_notes":[{"source":"arXiv","value":"15 pages, 9 figures"}],"earliest_date":"2020-12-18","refereed":true,"external_system_identifiers":[{"schema":"MSNET","value":"4247555"}],"facet_author_name":["1701376_Filipe Miguel"],"license":[{"license":"CC BY 4.0","material":"preprint","url":"http://creativecommons.org/licenses/by/4.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1837621","updated":"2023-10-03T09:12:09.840655"},"journal_title_variants":["Phys. Rev. D","Phys.Rev.D"],"arxiv_eprints":[{"categories":["gr-qc"],"value":"2012.10455"}],"referenced_authors_bais":["J.Zanelli.1","S.Mitra.8","J.Luk.1","A.O.Starinets.1","Christiane.Klein.1","Marija.Tomasevic.1","F.Eperon.1","M.Rahman.6","R.M.Wald.1","R.Penrose.1","J.D.Silva.1","Arpan.Bhattacharyya.1","Emanuele.Berti.1","B.Way.1","Soumitra.Sengupta.1","B.G.Schmidt.1","J.Zahn.1","I.G.Moss.1","J.Natario.1","A.Franzen.1","C.Bunster.1","R.Monteiro.1","K.M.Simpson.1","S.Hollands.1","H.S.Reall.1","W.Israel.1","S.J.Oh.1","Anjan.Ananda.Sen.1","Upamanyu.Moitra.1","O.J.C.Dias.1","V.Cardoso.1","K.D.Kokkotas.1","Subhodeep.Sarkar.1","Sumanta.Chakraborty.1","S.Bhattacharjee.1","Y.Shlapentokh.Rothman.1","A.Vasy.1","F.Mellor.1","P.M.Girao.1","A.Jansen.2","M.Dafermos.1","P.Figueras.1","E.Poisson.1","R.Emparan.1","P.Hintz.1","J.E.Santos.1","Kyriakos.Destounis.1","M.Banados.1","A.K.Mishra.3","J.Lopes.Costa.1"],"figures":[{"filename":"causalstruct.png","caption":"Penrose diagram for the RNdS and Kerr-dS black holes (truncated to the physical regions I and II). Each point denotes an $S_2$ ($S_1$) in the case of the RNdS (Kerr-dS black hole).","source":"arxiv","key":"bbcccc3753d8585502eb8ce48ce50675","url":"https://inspirehep.net/files/bbcccc3753d8585502eb8ce48ce50675"},{"filename":"RNdSCond.png","caption":"Parameter space of the RNdS black hole.","source":"arxiv","key":"273f338b5ad249d1b41271e9e018d821","url":"https://inspirehep.net/files/273f338b5ad249d1b41271e9e018d821"},{"filename":"NariaiModes.png","caption":": Nariai limite spectrum","source":"arxiv","key":"3bea69c049a5b816cb7850f23c4848b2","url":"https://inspirehep.net/files/3bea69c049a5b816cb7850f23c4848b2"},{"filename":"InteriorModeSpectrum.png","caption":": Interior near extremal spectrum","source":"arxiv","key":"31b03922677197eb8a1388b1a6ba1b47","url":"https://inspirehep.net/files/31b03922677197eb8a1388b1a6ba1b47"},{"filename":"intVsExtLinePlotPhiMinus2.png","caption":"In these images we plot $\\gamma$ as a function of $Q^2/Q^2_{max}$ for $y_+ = 0.47$. On the left panel, we study quasinormal modes corresponding to $\\Phi_-$, with l=2, whereas on the right panel we have $\\Phi_+$, with $l=1$. In both plots, we zoomed the circled region into a subplot on the top right corner. As we can see, the value of $\\gamma$ takes very small values, oscillating around 0. We can see that $\\gamma$  tends to 0 in the $Q^2\\rightarrow Q^2_{max}$ limit, as predicted in section \\ref{sec:AnalApprox}.","source":"arxiv","key":"fcde3da099f16cd65c5a7d11464c078c","url":"https://inspirehep.net/files/fcde3da099f16cd65c5a7d11464c078c"},{"filename":"intVsExtLinePlotPhiPos1.png","caption":"In these images we plot $\\gamma$ as a function of $Q^2/Q^2_{max}$ for $y_+ = 0.47$. On the left panel, we study quasinormal modes corresponding to $\\Phi_-$, with l=2, whereas on the right panel we have $\\Phi_+$, with $l=1$. In both plots, we zoomed the circled region into a subplot on the top right corner. As we can see, the value of $\\gamma$ takes very small values, oscillating around 0. We can see that $\\gamma$  tends to 0 in the $Q^2\\rightarrow Q^2_{max}$ limit, as predicted in section \\ref{sec:AnalApprox}.","source":"arxiv","key":"bfdbca7a8e183026f0801ac8628818ff","url":"https://inspirehep.net/files/bfdbca7a8e183026f0801ac8628818ff"},{"filename":"intVsExtDensityPlotPhi2Neg.png","caption":"As in figure \\ref{fig:LinePlots}, we plot the value of $\\gamma$ in a non-trivial region of parameter space. On the left panel we study $\\Phi_-$, with l=2, whereas on the right panel we have $\\Phi_+$, with $l=1$. To produce these plots, we used the Newton-Raphson algorithm to find the frequency of $\\omega_{\\text{int}}$ and $\\omega_{\\text{ext}}$ discretely varying the parameter space in a 200x200 grid. As described in section \\ref{sec:NumComp}, we repeated the calculation twice for each black hole with different grid sizes, to estimate the numerical precision of our method. We checked that in the whole plot, the numerical precision was always above the difference between interior and exterior frequencies. We remark, that as seen in the one dimensional plot, $\\gamma$ goes to 0 as $Q^2\\rightarrow Q^2_{max}$.","source":"arxiv","key":"70e4719a18394de2a349e70762785ec3","url":"https://inspirehep.net/files/70e4719a18394de2a349e70762785ec3"},{"filename":"intVsExtDensityPlotPhi1Pos.png","caption":"As in figure \\ref{fig:LinePlots}, we plot the value of $\\gamma$ in a non-trivial region of parameter space. On the left panel we study $\\Phi_-$, with l=2, whereas on the right panel we have $\\Phi_+$, with $l=1$. To produce these plots, we used the Newton-Raphson algorithm to find the frequency of $\\omega_{\\text{int}}$ and $\\omega_{\\text{ext}}$ discretely varying the parameter space in a 200x200 grid. As described in section \\ref{sec:NumComp}, we repeated the calculation twice for each black hole with different grid sizes, to estimate the numerical precision of our method. We checked that in the whole plot, the numerical precision was always above the difference between interior and exterior frequencies. We remark, that as seen in the one dimensional plot, $\\gamma$ goes to 0 as $Q^2\\rightarrow Q^2_{max}$.","source":"arxiv","key":"297f17f1485c9adea40bbf58217597bf","url":"https://inspirehep.net/files/297f17f1485c9adea40bbf58217597bf"},{"filename":"convergence.png","caption":"In this figure we show the exponential convergence of the Newton-Raphson method. We plot the normalized difference between $\\beta = \\omega / \\kappa_-$ computed using a given Chebyshev grid size $(N_c)$ and $\\beta$ computed using very high resolution $(N_c = 601)$. We see that the relative numerical error decays exponentially with $N_c$ as expected. Here, $\\omega$ is the lowest lying NE mode, of $\\Phi_-$ with $l=1$, for a BH with $y_+\\,=\\,0.35$ and $Q^2/Q^2_{max} = 0.99$.","source":"arxiv","key":"10609097828f77b18aff99b0fcf4fbe7","url":"https://inspirehep.net/files/10609097828f77b18aff99b0fcf4fbe7"},{"filename":"DoubleRoot.png","caption":"In this figure we study the double roots of $\\gamma$ found in figures \\ref{fig:LinePlots} and \\ref{fig:DensityPlots}. As an example we establish that ($y_+ \\approx 0.47$, $Q^2/Q^2_{\\text{max}} \\approx 0.908$) is indeed a double root of $\\gamma$, from $\\Phi_+$ QNMs. We fixed $y_+$ and varied $Q^2/Q^2_{\\text{max}}$ in a grid of 20 entries, with values in $\\overline r_0 \\pm \\delta_0/2$, ($\\overline r_0 = 0.0075$, $\\delta_0 = 0.005$). We sampled $\\gamma$ there and found the grid point with smallest $\\gamma$. Setting this as $\\overline r_1$ we created a new grid centred at this point with width $\\delta_1 = 10^{-1}\\delta_0$. We sampled values of $\\gamma$ in this new grid and iterated the process 10 times. In the plot we see the value of the minimum as a function of the sampling density $\\rho = 20 / \\delta$. The value decreases exponentially with sampling density, hinting that $y_+ \\approx 0.47$, $Q^2/Q^2_{\\text{max}} \\approx 0.908$ is indeed a double root of $\\gamma$.","source":"arxiv","key":"8b218b9874479d0b485048209fcb0b23","url":"https://inspirehep.net/files/8b218b9874479d0b485048209fcb0b23"}],"legacy_version":"20210419174549.0","inspire_categories":[{"term":"Gravitation and Cosmology","source":"arxiv"}],"first_author":{"emails":["fsdrm2@cam.ac.uk"],"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/013meh722"}],"full_name":"Miguel, Filipe S.","last_name":"Miguel","ids":[{"schema":"ORCID","value":"0000-0001-7702-966X"},{"schema":"INSPIRE BAI","value":"F.S.Miguel.1"}],"first_name":"Filipe S.","recid":1701376},"control_number":1837621,"dois":[{"source":"bibmatch","value":"10.1103/PhysRevD.103.064077"},{"material":"publication","source":"arXiv","value":"10.1103/PhysRevD.103.064077"}],"document_type":["article"],"texkeys":["Miguel:2020uln"],"abstracts":[{"source":"APS","value":"Recent work has argued that the strong cosmic censorship conjecture is violated by near-extremal Reissner-Nordström–de Sitter (RNdS) black holes but respected by Kerr–de Sitter (Kerr-dS) black holes. It has also been shown that the conjecture is violated by near-extremal Bañados-Teitelboim-Zanelli (BTZ) black holes. The latter result relies on a coincidence between “exterior” and “interior” quasinormal frequencies. If this coincidence were to occur also for RNdS or Kerr-dS, then it would significantly modify the conclusions of earlier work. In this paper, it is demonstrated that this coincidence does not occur for RNdS or Kerr-dS, and so the conclusions of the earlier work remain valid.","abstract_source_suggest":{"input":"APS"}},{"source":"arXiv","value":"Recent work has argued that the strong cosmic censorship (SCC) conjecture is violated by near-extremal Reissner-Nordstr\\\"om de Sitter (RNdS) black holes but respected by Kerr-de Sitter black holes. It has also been shown that the conjecture is violated by near-extremal BTZ black holes. The latter result relies on a coincidence between \"exterior\" and \"interior\" quasinormal frequencies. If this coincidence were to occur also for RNdS or Kerr-dS then it would significantly modify the conclusions of earlier work. In this paper, it is demonstrated that this coincidence does not occur for RNdS or Kerr-dS and so the conclusions of the earlier work remain valid.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"source":"arXiv","title":"Interior Quasinormal Modes and Strong Cosmic Censorship"}],"imprints":[{"date":"2021-03-30"}],"curated":false},"id":"1837621","created":"2020-12-22T00:00:00+00:00"},{"updated":"2025-10-24T12:02:17.605635+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/2708740?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/2708740?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/2708740?format=latex-us","json":"https://inspirehep.net/api/literature/2708740?format=json","json-expanded":"https://inspirehep.net/api/literature/2708740?format=json-expanded","cv":"https://inspirehep.net/api/literature/2708740?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2708740"},"metadata":{"authors":[{"full_name_unicode_normalized":"chrysostomou, anna","full_name":"Chrysostomou, Anna","record":{"$ref":"https://inspirehep.net/api/authors/1875636"},"ids":[{"schema":"INSPIRE BAI","value":"Anna.Chrysostomou.1"}],"affiliations":[{"curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/institutions/1743848"},"value":"IP2I, Lyon"},{"record":{"$ref":"https://inspirehep.net/api/institutions/911013"},"value":"Johannesburg U."}],"last_name":"Chrysostomou","first_name":"Anna","uuid":"21aaa0d8-7f8e-4e98-a6f3-70d52d0346e0","recid":1875636},{"full_name_unicode_normalized":"cornell, alan s.","full_name":"Cornell, Alan S.","record":{"$ref":"https://inspirehep.net/api/authors/1013026"},"ids":[{"schema":"INSPIRE BAI","value":"A.S.Cornell.1"}],"affiliations":[{"curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/institutions/1743848"},"value":"IP2I, Lyon"},{"record":{"$ref":"https://inspirehep.net/api/institutions/911013"},"value":"Johannesburg U."}],"last_name":"Cornell","first_name":"Alan S.","uuid":"b4071605-1b94-416d-af30-3de61c300da2","recid":1013026},{"full_name_unicode_normalized":"deandrea, aldo","full_name":"Deandrea, Aldo","record":{"$ref":"https://inspirehep.net/api/authors/1012237"},"ids":[{