{"metadata":{"citation_count_without_self_citations":110,"documents":[{"key":"342f732c3f1416d7251b7ee9cfcd670d","url":"https://inspirehep.net/files/342f732c3f1416d7251b7ee9cfcd670d","source":"SCOAP3","filename":"scoap","description":"Article from SCOAP3"}],"citation_count":122,"publication_info":[{"year":2018,"artid":"001","page_start":"001","journal_title":"JHEP","journal_record":{"$ref":"https://inspirehep.net/api/journals/1213103"},"journal_volume":"10"}],"core":true,"dois":[{"value":"10.1007/JHEP10(2018)001","source":"bibmatch"},{"value":"10.1007/JHEP10(2018)001","source":"arXiv","material":"publication"}],"titles":[{"title":"Strong cosmic censorship: taking the rough with the smooth","source":"arXiv"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"eb2d12e1-467f-45ea-8030-da85cc55cdf0","emails":["ojcd1r13@soton.ac.uk"],"record":{"$ref":"https://inspirehep.net/api/authors/1021407"},"full_name":"Dias, Oscar J.C.","affiliations":[{"value":"Southampton U.","record":{"$ref":"https://inspirehep.net/api/institutions/903212"}}],"signature_block":"Do","curated_relation":true,"raw_affiliations":[{"value":"STAG research centre U. and Mathematical Sciences - Southampton - Highfield Campus - Southampton - SO17 1BJ - U.K."}],"affiliations_identifiers":[{"value":"grid.5491.9","schema":"GRID"}]},{"uuid":"22b82766-12ae-49ea-a032-75d442f0da1a","emails":["hsr1000@cam.ac.uk"],"record":{"$ref":"https://inspirehep.net/api/authors/992144"},"full_name":"Reall, Harvey S.","affiliations":[{"value":"Cambridge U., DAMTP","record":{"$ref":"https://inspirehep.net/api/institutions/907623"}}],"signature_block":"RALh","raw_affiliations":[{"value":"Department of Applied Mathematics U. and Theoretical Physics - Cambridge - Wilberforce Road - Cambridge - CB3 0WA - U.K."}],"affiliations_identifiers":[{"value":"grid.5335.0","schema":"GRID"}]},{"uuid":"76306e8c-1b1f-4726-a228-0c919d7537bd","emails":["jss55@cam.ac.uk"],"record":{"$ref":"https://inspirehep.net/api/authors/1060716"},"full_name":"Santos, Jorge E.","affiliations":[{"value":"Cambridge U., DAMTP","record":{"$ref":"https://inspirehep.net/api/institutions/907623"}}],"signature_block":"SANTj","curated_relation":true,"raw_affiliations":[{"value":"Department of Applied Mathematics U. and Theoretical Physics - Cambridge - Wilberforce Road - Cambridge - CB3 0WA - U.K."}],"affiliations_identifiers":[{"value":"grid.5335.0","schema":"GRID"}]}],"curated":true,"license":[{"url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","license":"arXiv nonexclusive-distrib 1.0","material":"preprint"},{"license":"CC-BY-4.0","imposing":"Springer"}],"texkeys":["Dias:2018etb"],"citeable":true,"imprints":[{"date":"2018-10-01"}],"keywords":[{"value":"Black Holes","source":"author"},{"value":"Classical Theories of Gravity","source":"author"},{"value":"perturbation: electromagnetic","schema":"INSPIRE"},{"value":"gravitation: coupling","schema":"INSPIRE"},{"value":"field theory: scalar","schema":"INSPIRE"},{"value":"cosmic censorship: violation","schema":"INSPIRE"},{"value":"boundary condition","schema":"INSPIRE"},{"value":"black hole: Reissner-Nordstroem","schema":"INSPIRE"},{"value":"horizon","schema":"INSPIRE"},{"value":"background: de Sitter","schema":"INSPIRE"},{"value":"finite energy","schema":"INSPIRE"}],"refereed":true,"abstracts":[{"value":"It has been argued that the strong cosmic censorship conjecture is violated by Reissner-Nordström-de Sitter black holes: for near-extremal black holes, generic scalar field perturbations arising from smooth initial data have finite energy at the Cauchy horizon even though they are not continuously differentiable there. In this paper, we consider the analogous problem for coupled gravitational and electromagnetic perturbations. We find that such perturbations exhibit a much worse violation of strong cosmic censorship: for a sufficiently large near-extremal black hole, perturbations arising from smooth initial data can be extended through the Cauchy horizon in an arbitrarily smooth way. This is in apparent contradiction with an old argument in favour of strong cosmic censorship. We resolve this contradiction by showing that this old argument is valid only for initial data that is not smooth. This is in agreement with the recent proposal that, to recover strong cosmic censorship, one must allow rough initial data.","source":"Springer"},{"value":"It has been argued that the strong cosmic censorship conjecture is violated by Reissner-Nordstr\\\"om-de Sitter black holes: for near-extremal black holes, generic scalar field perturbations arising from smooth initial data have finite energy at the Cauchy horizon even though they are not continuously differentiable there. In this paper, we consider the analogous problem for coupled gravitational and electromagnetic perturbations. We find that such perturbations exhibit a much worse violation of strong cosmic censorship: for a sufficiently large near-extremal black hole, perturbations arising from smooth initial data can be extended through the Cauchy horizon in an arbitrarily smooth way. This is in apparent contradiction with an old argument in favour of strong cosmic censorship. We resolve this contradiction by showing that this old argument is valid only for initial data that is not smooth. This is in agreement with the recent proposal that, to recover strong cosmic censorship, one must allow rough initial data.","source":"arXiv"}],"references":[{"raw_refs":[{"value":"R. Penrose, Singularities of spacetime, in Theoretical principles in astrophysics and relativity W.R.N.R. Liebowitz and P.O.Vandervoort eds., Chicago University Press (1978), pp. 217-243.","schema":"text"}],"reference":{"misc":["Singularities of spacetime, in Theoretical principles in astrophysics and relativity W.R.N.R. Liebowitz and P.O.Vandervoort (eds.)","Chicago University Press , pp. 217-243"],"authors":[{"full_name":"Penrose, R."}],"publication_info":{"year":1978}}},{"record":{"$ref":"https://inspirehep.net/api/literature/87999"},"raw_refs":[{"value":"M. Simpson and R. Penrose, Internal instability in a Reissner-Nordstrom black hole, Int. J. Theor. Phys. 7 (1973) 183 [ INSPIRE ]., DOI: 10.1007/BF00792069","schema":"text"}],"reference":{"dois":["10.1007/BF00792069"],"misc":["Internal instability in a Reissner-Nordstrom black hole","[INSPIRE]"],"authors":[{"full_name":"Simpson, M."},{"full_name":"Penrose, R."}],"publication_info":{"year":1973,"artid":"183","page_start":"183","journal_title":"Int.J.Theor.Phys.","journal_volume":"7"}},"curated_relation":false},{"raw_refs":[{"value":"J. McNamara, Instability of black hole inner horizons, Proc. Roy. Soc. Lond. A 358 (1978) 499.","schema":"text"}],"reference":{"misc":["Instability of black hole inner horizons"],"authors":[{"full_name":"McNamara, J."}],"publication_info":{"year":1978,"artid":"499","page_start":"499","journal_title":"Proc.Roy.Soc.Lond.A","journal_volume":"358"}}},{"raw_refs":[{"value":"S. Chandrasekhar and J.B. Hartle, On crossing the cauchy horizon of a Reissner-Nordström black-hole, Proc. Roy. Soc. Lond. A 384 (1982) 301., DOI: 10.1098/rspa.1982.0160","schema":"text"}],"reference":{"dois":["10.1098/rspa.1982.0160"],"misc":["On crossing the cauchy horizon of a Reissner-Nordström black-hole"],"authors":[{"full_name":"Chandrasekhar, S."},{"full_name":"Hartle, J.B."}],"publication_info":{"year":1982,"artid":"301","page_start":"301","journal_title":"Proc.Roy.Soc.Lond.A","journal_volume":"384"}}},{"record":{"$ref":"https://inspirehep.net/api/literature/301259"},"raw_refs":[{"value":"E. Poisson and W. Israel, Internal structure of black holes, Phys. Rev. D 41 (1990) 1796 [ INSPIRE ].","schema":"text"}],"reference":{"misc":["Internal structure of black holes","[INSPIRE]"],"authors":[{"full_name":"Poisson, E."},{"full_name":"Israel, W."}],"publication_info":{"year":1990,"artid":"1796","page_start":"1796","journal_title":"Phys.Rev.D","journal_volume":"41"}},"curated_relation":false},{"record":{"$ref":"https: