:[{"full_name":"Penrose, R."}]},"raw_refs":[{"schema":"text","source":"arXiv","value":"[34] R. Penrose, Gravitational collapse: The role of general relativity, Riv. Nuovo Cim., 1:252–276, 1969."}],"record":{"$ref":"https://inspirehep.net/api/literature/54979"}},{"reference":{"label":"35","misc":["Naked Singularities for the Einstein Vacuum Equations: The Exterior Solution, to appear in Ann. of Math"],"authors":[{"full_name":"Rodnianski, I."},{"full_name":"Shlapentokh-Rothman, Y."}]},"raw_refs":[{"schema":"text","source":"arXiv","value":"[35] I. Rodnianski, Y. Shlapentokh-Rothman, Naked Singularities for the Einstein Vacuum Equations: The Exterior Solution, to appear in Ann. of Math."}]},{"reference":{"arxiv_eprint":"2204.09891","label":"36","misc":["Naked Singularities for the Einstein Vacuum Equations: The Interior Solution"],"authors":[{"full_name":"Shlapentokh-Rothman, Y."}]},"raw_refs":[{"schema":"text","source":"arXiv","value":"[36] Y. Shlapentokh-Rothman, Naked Singularities for the Einstein Vacuum Equations: The Interior Solution, arXiv:2204.09891."}],"record":{"$ref":"https://inspirehep.net/api/literature/2070677"}},{"reference":{"arxiv_eprint":"2210.11325","label":"37","misc":["A construction of approximately self-similar naked singularities for the spherically symmetric Einstein-scalar field system"],"authors":[{"full_name":"Singh, J."}]},"raw_refs":[{"schema":"text","source":"arXiv","value":"[37] J. Singh, A construction of approximately self-similar naked singularities for the spherically symmetric Einstein-scalar field system, arXiv:2210.11325."}],"record":{"$ref":"https://inspirehep.net/api/literature/2168006"}},{"reference":{"arxiv_eprint":"1105.5898","label":"38","publication_info":{"year":2011},"misc":["Dynamical Formation of black holes due to the condensation of matter field, preprint"],"authors":[{"full_name":"Yu, P."}]},"raw_refs":[{"schema":"text","source":"arXiv","value":"[38] P. Yu, Dynamical Formation of black holes due to the condensation of matter field, preprint (2011), arXiv:1105.5898."}],"record":{"$ref":"https://inspirehep.net/api/literature/901978"}},{"reference":{"arxiv_eprint":"2304.01695","label":"39","publication_info":{"year":2023},"misc":["Trapped surface formation for the Einstein-scalar system, preprint","Department of Mathematics, National University of Singapore, 10 Lower Kent Ridge Road, Singapore, 119076 Email address: matax@nus.edu.sg"],"authors":[{"full_name":"Zhao, P."},{"full_name":"Hilditch, D."},{"full_name":"Kroon, J."}]},"raw_refs":[{"schema":"text","source":"arXiv","value":"[39] P. Zhao, D. Hilditch, J. Kroon, Trapped surface formation for the Einstein-scalar system, preprint (2023), arXiv:2304.01695. Department of Mathematics, National University of Singapore, 10 Lower Kent Ridge Road, Singapore, 119076 Email address: matax@nus.edu.sg"}],"record":{"$ref":"https://inspirehep.net/api/literature/2648886"}}],"number_of_pages":90,"referenced_authors_bais":["D.Hilditch.1","J.Singh.8","J.Jang.5","J.A.Valiente.Kroon.1","J.Li.29","X.An.1","Lars.Andersson.1","Y.Guo.106","M.Hadzic.1","P.Yu.3","J.Liu.40","Marc.Mars.1","P.Zhao.17","Puskar.Mondal.1","Shing.Tung.Yau.1","J.Lopes.Costa.1","Demetrios.Christodoulou.1","J.Metzger.4","W.Simon.1","S.Klainerman.1","N.Athanasiou.1","J.Luk.1","I.Rodnianski.1","Y.Shlapentokh.Rothman.1","R.Penrose.1"],"inspire_categories":[{"term":"Gravitation and Cosmology","source":"arxiv"},{"term":"Math and Math Physics","source":"arxiv"}],"preprint_date":"2024-01-03","author_count":1,"first_author":{"full_name":"An, Xinliang","last_name":"An","first_name":"Xinliang","recid":1939597},"public_notes":[{"source":"arXiv","value":"90 pages, announced in December 2022"}],"control_number":2743272,"earliest_date":"2024-01-03","document_type":["article"],"texkeys":["An:2024jqn"],"abstracts":[{"source":"arXiv","value":"Employing the Einstein-scalar field system, we demonstrate an approach for proving high co-dimensional nonlinear instability of naked-singularity solutions as constructed by Christodoulou in [18]. We further investigate the censorship of Christodoulou's naked singularity and show that a tiny anisotropic perturbation arising from the outgoing characteristic initial data would lead to the emergence of an anisotropic apparent horizon, which covers and censors the naked singularity. Our approach advances the hyperbolic short-pulse method by not requiring the aid of additional large parameters, by permitting the use of initial perturbations for the shear tensor and the derivative of scalar field to be with finite $BV$ and $C^0$ norms, and by allowing the initial perturbation to be arbitrarily small in scale-critical norms. New elliptic arguments based on non-perturbative methods are also developed.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"source":"arXiv","title":"Naked Singularity Censoring with Anisotropic Apparent Horizon"}],"facet_author_name":["1939597_Xingtao An"],"license":[{"license":"CC BY 4.0","material":"preprint","url":"http://creativecommons.org/licenses/by/4.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:2743272","updated":"2025-05-20T04:10:38.827982"},"curated":false,"journal_title_variants":["Annals Math."],"arxiv_eprints":[{"categories":["gr-qc","math-ph","math.AP","math.DG","math.MP"],"value":"2401.02003"}]}},{"links":{"bibtex":"https://inspirehep.net/api/literature/2650751?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/2650751?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/2650751?format=latex-us","json":"https://inspirehep.net/api/literature/2650751?format=json","json-expanded":"https://inspirehep.net/api/literature/2650751?format=json-expanded","cv":"https://inspirehep.net/api/literature/2650751?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2650751"},"created":"2023-04-12T16:09:52.903367+00:00","updated":"2023-12-07T18:25:21.509345+00:00","id":"2650751","metadata":