<div class="special-issue-citation" >
  <h4><i class="bi bi-info-circle-fill" style="color: var(--color-primary);"></i></h4>
  <div style="padding-top: 5px; padding-left: 10px;">
    
      <!--We can get a ResourceInSpecialIssue (if article notice) object or a Container object (if issue items list )-->
      

