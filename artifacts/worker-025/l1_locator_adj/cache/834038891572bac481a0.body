_Ravindra V. Saraykar","1004099_Pankaj S. Joshi"],"core":true,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1122620","updated":"2025-08-13T07:23:45.697773"},"journal_title_variants":["Clifford Analysis, Clifford Algebras and their Applications (CACAA)"],"arxiv_eprints":[{"categories":["gr-qc"],"value":"1207.3469"}],"referenced_authors_bais":["I.H.Dwivedi.1","Kengo.Maeda.1","Demetrios.Christodoulou.1","G.T.Horowitz.1","R.V.Saraykar.4","J.M.Martin.Garcia.1","Stephen.W.Hawking.1","P.S.Joshi.1","D.Malafarina.1","C.Gundlach.1","S.B.Sarwe.1","R.V.Saraykar.2","T.Hertog.1"],"legacy_version":"20180602165223.0","inspire_categories":[{"term":"Astrophysics"},{"term":"Gravitation and Cosmology"},{"term":"Theory-HEP"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/04esgv207"}],"full_name":"Saraykar, Ravindra V.","last_name":"Saraykar","first_name":"Ravindra V.","recid":2329661},"control_number":1122620,"document_type":["article"],"texkeys":["Saraykar:2012vy"],"abstracts":[{"source":"arXiv","value":"We comment here on the results in Ref [4] that showed naked singularities in dynamical gravitational collapse of inhomogeneous dust to be stable but non-generic. The definition of genericity used there is reconsidered. We point out that genericity in terms of an open set, with a positive measure defined suitably on the space of initial data, is physically more appropriate compared to the dynamical systems theory definition used in [4] which makes both black holes and naked singularities non-generic as collapse outcomes.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"A Note on Genericity and Stability of Black Holes and Naked Singularities in Dust Collapse"},{"source":"arXiv","title":"A Note on Genericity and Stability of Black Holes and Naked Singularities in Dust Collapse"}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/1122620?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1122620?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1122620?format=latex-us","json":"https://inspirehep.net/api/literature/1122620?format=json","json-expanded":"https://inspirehep.net/api/literature/1122620?format=json-expanded","cv":"https://inspirehep.net/api/literature/1122620?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1122620"}},{"updated":"2023-03-06T23:48:30.810361+00:00","created":"2014-07-17T00:00:00+00:00","id":"1306607","metadata":{"publication_info":[{"journal_volume":"90","artid":"064034","year":2014,"journal_issue":"6","journal_title":"Phys.Rev.D"}],"citation_count_without_self_citations":61,"authors":[{"full_name_unicode_normalized":"mkenyeleye, maombi d.","full_name":"Mkenyeleye, Maombi D.","record":{"$ref":"https://inspirehep.net/api/authors/2070244"},"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/909823"},"value":"KwaZulu Natal U."}],"last_name":"Mkenyeleye","ids":[{"schema":"INSPIRE BAI","value":"M.D.Mkenyeleye.1"}],"signature_block":"MCANALYm","uuid":"843bf957-b532-483b-a84d-d558e28e8d81","first_name":"Maombi D.","recid":2070244},{"full_name_unicode_normalized":"goswami, rituparno","full_name":"Goswami, Rituparno","record":{"$ref":"https://inspirehep.net/api/authors/1041332"},"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/909823"},"value":"KwaZulu Natal U."}],"last_name":"Goswami","ids":[{"schema":"INSPIRE BAI","value":"R.Goswami.2"}],"signature_block":"GASWANr","uuid":"123355b6-bb29-45dd-a06c-567069471573","first_name":"Rituparno","recid":1041332},{"full_name_unicode_normalized":"maharaj, sunil d.","full_name":"Maharaj, Sunil D.","record":{"$ref":"https://inspirehep.net/api/authors/999229"},"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/909823"},"value":"KwaZulu Natal U."}],"last_name":"Maharaj","ids":[{"schema":"INSPIRE BAI","value":"S.D.Maharaj.1"}],"signature_blo