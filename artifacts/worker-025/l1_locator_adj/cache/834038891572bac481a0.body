ed_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/17941"}},{"reference":{"publication_info":{"journal_volume":"41","artid":"3866","page_start":"3866","journal_title":"Phys.Rev.D"}}},{"reference":{"publication_info":{"journal_volume":"2","artid":"127","page_start":"127","journal_title":"J.Geom.Phys."}}}],"number_of_pages":4,"referenced_authors_bais":["V.Moncrief.1","J.E.Marsden.1","B.Waugh.1","G.Williams.2","P.S.Joshi.1","S.Shapiro.1","T.Piran.1","E.Poisson.1","A.Ori.2","J.Isenberg.1","W.Israel.1","G.Grillo.2","W.A.Hiscock.1","Demetrios.Christodoulou.1","Hermann.Bondi.1","Krishna.Rajagopal.1","L.Smarr.1","S.A.Teukolsky.1","K.Lake.1","J.P.S.Lemos.1","V.Iyer.1","T.Zannias.1","D.M.Eardley.1","R.M.Wald.1","R.P.A.C.Newman.1","I.H.Dwivedi.1"],"legacy_version":"20160314165353.0","legacy_creation_date":"2008-06-17","preprint_date":"1992-05","author_count":1,"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/02y72wh86"}],"full_name":"Lake, Kayll","last_name":"Lake","first_name":"Kayll","recid":1001239},"control_number":351876,"dois":[{"value":"10.1103/PhysRevLett.68.3129"}],"earliest_date":"1992-05","document_type":["article"],"texkeys":["Lake:1992zz"],"abstracts":[{"source":"APS","value":"General conditions are developed for the formation of naked precursory (‘‘shell-focusing’’) singularities in spherical gravitational collapse. These singularities owe their nakedness to the fact that the gravitational potential fails to be single valued prior to the onset of a true gravitational singularity. It is argued that they do not violate the spirit of cosmic censorship. Rather, they may well be an essentially generic feature of relativistic gravitational collapse.","abstract_source_suggest":{"input":"APS"}}],"refereed":true,"titles":[{"title":"Precursory singularities in spherical gravitational collapse"}],"external_system_identifiers":[{"schema":"SPIRES","value":"SPIRES-7790856"},{"schema":"MSNET","value":"1163548"}],"facet