u","1014373_Roberto Casadio","1037241_Behrouz Mirza"],"core":true,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:865522","updated":"2023-03-07T03:20:05.325093"},"journal_title_variants":["Phys. Lett. B","Phys.Lett.B"],"arxiv_eprints":[{"categories":["gr-qc"],"value":"1008.2768"}],"referenced_authors_bais":["Steven.Weinberg.1","H.S.Snyder.1","S.D.H.Hsu.1","R.Percacci.1","Frank.A.Wilczek.1","D.A.Easson.1","S.P.Robinson.1","D.Perini.5","C.Wetterich.1","K.Falls.1","W.Souma.1","Yi.Fu.Cai.1","Subrahmanyan.Chandrasekhar.1","X.Calmet.1","D.F.Litim.1","M.R.Niedermaier.1","D.Reeb.1","A.Raghuraman.1","Martin.Reuter.1","J.Robert.Oppenheimer.1","Clifford.Martin.Will.1"],"legacy_version":"20160524191630.0","inspire_categories":[{"term":"Gravitation and Cosmology"},{"term":"Theory-HEP"}],"first_author":{"full_name":"Casadio, Roberto","last_name":"Casadio","first_name":"Roberto","recid":1014373},"control_number":865522,"dois":[{"value":"10.1016/j.physletb.2010.10.060"}],"document_type":["article"],"texkeys":["Casadio:2010fw"],"abstracts":[{"source":"arXiv","value":"Asymptotic safety (an ultraviolet fixed point with finite-dimensional critical surface) offers the possibility that a predictive theory of quantum gravity can be obtained from the quantization of classical general relativity. However, it is unclear what becomes of the singularities of classical general relativity, which, it is hoped, might be resolved by quantum effects. We study dust collapse with a running gravitational coupling and find that a future singularity can be avoided if the coupling becomes exactly zero at some finite energy scale. The singularity can also be avoided (pushed off to infinite proper time) if the coupling approaches zero sufficiently rapidly at high energies. However, the evolution deduced from perturbation theory still implies a singularity at finite proper time.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"Asymptotic Safety, Singularities, and Gravitational Collapse"},{"source":"arXiv","title":"Asymptotic Safety, Singularities, and Gravitational Collapse"}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/865522?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/865522?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/865522?format=latex-us","json":"https://inspirehep.net/api/literature/865522?format=json","json-expanded":"https://inspirehep.net/api/literature/865522?format=json-expanded","cv":"https://inspirehep.net/api/literature/865522?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A865522"}},{"updated":"2023-03-07T00:00:58.783630+00:00","created":"2002-11-07T00:00:00+00:00","id":"520848","metadata":{"publication_info":[{"journal_volume":"526","artid":"594","conference_record":{"$ref":"https://inspirehep.net/api/conferences/972340"},"year":2000,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1213302"},"page_start":"594","journal_issue":"1","journal_title":"AIP Conf.Proc.","parent_record":{"$ref":"https://inspirehep.net/api/literature/540706"},"cnum":"C99-10-18.1"}],"citation_count_without_self_citations":0,"authors":[{"full_name_unicode_normalized":"graber, james s.","full_name":"Graber, James S.","record":{"$ref":"https://inspirehep.net/api/authors/2195131"},"ids":[{"schema":"INSPIRE BAI","value":"J.S.Graber.2"}],"last_name":"Graber","signature_block":"GRABARj","uuid":"31ab447a-9f87-4c00-a81d-aeee731485da","first_name":"James S.","recid":2195131}],"citation_count":0,"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","keywords":[{"source":"author","value":"cosmology"},{"source":"author","value":"astrophysical jets"},{"source":"author","value":"astrophysical plasma"},{"source":"author","value":"gamma-ray sources (astronomical)"},{"source":"author","value":"gravitational collapse"},{"source":"author","value":"relativistic plasmas"},{"source":"author","value":"p