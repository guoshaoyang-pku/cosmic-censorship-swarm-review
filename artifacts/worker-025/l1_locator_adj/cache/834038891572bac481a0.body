ndquist, R.W."},{"full_name":"Schwartz, R.A."},{"full_name":"Misner, C.W."}]}},{"reference":{"label":"22","publication_info":{"journal_volume":"24","page_end":"186","year":1967,"page_start":"184","journal_title":"Phys.Lett.A"},"authors":[{"full_name":"Israel, W."}]}},{"reference":{"label":"23","publication_info":{"journal_volume":"52","page_end":"559","year":1999,"page_start":"553","journal_title":"Pramana"},"authors":[{"full_name":"Patil, K.D."},{"full_name":"Saraykar, R.V."},{"full_name":"Ghate, S.H."}]}},{"reference":{"label":"24","publication_info":{"journal_volume":"518","artid":"1","year":2001,"page_start":"1","journal_title":"Phys.Lett.B"},"misc":["Naresh Ghosh"],"authors":[{"full_name":"Dadhich, S.G."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/551851"}},{"reference":{"label":"25","publication_info":{"journal_volume":"12","artid":"801","year":2003,"page_start":"801","journal_title":"Int.J.Mod.Phys.D"},"authors":[{"full_name":"Beesham, A."},{"full_name":"Ghosh, S.G."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/524799"}},{"reference":{"label":"26","publication_info":{"year":2007},"misc":["Gravitational Collapse and Spacetime Singularities, Cambridge University Press"],"authors":[{"full_name":"Joshi, P.S."}]}},{"reference":{"label":"27","publication_info":{"journal_volume":"76","artid":"084026","year":2007,"journal_title":"Phys.Rev.D"},"authors":[{"full_name":"Goswami, R."},{"full_name":"Joshi, P.S."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/725086"}}],"number_of_pages":10,"legacy_creation_date":"2014-07-17","preprint_date":"2014-07-16","author_count":3,"public_notes":[{"source":"arXiv","value":"8 pages, 2 figures, Changes in the text, Matches the accepted version in Physical Review D"}],"earliest_date":"2014-07-16","refereed":true,"facet_author_name":["2070244_Maombi Daud. Mkenyeleye","999229_Sunil D. Maharaj","1041332_Rituparno Goswami"],"core":true,"license":[{"imposing":"arXiv","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1306607","updated":"2023-03-06T23:48:30.810361"},"journal_title_variants":["Phys.Rev.D","Phys. Rev. D"],"arxiv_eprints":[{"categories":["gr-qc","hep-th"],"value":"1407.4309"}],"referenced_authors_bais":["T.Zannias.1","M.Alishahiha.1","F.J.Tipler.1","M.Govender.2","D.Kothawala.1","I.H.Dwivedi.1","S.A.Hayward.1","P.C.Vaidya.1","S.G.Ghosh.1","A.F.Astaneh.1","S.D.Maharaj.1","E.D.Stewart.1","G.Govender.2","P.S.Joshi.1","Valeri.P.Frolov.1","R.Goswami.2","M.R.Mohammadi.Mozaffar.1","A.Beesham.1","N.Dadhich.1","W.Israel.1","An.Zhong.Wang.1","C.Barrabes.1","S.E.Hong.3","Dong.Han.Yeom.1","D.i.Hwang.3","Y.Wu.28","K.Lake.1"],"figures":[{"filename":"Variation_of_X0.png","caption":"Variation of $X_0$ (red and blue) and $\\left(\\frac{dv}{dr}\\right)_{AH}$ (green) with $m'_0$ at fixed value $\\dot{m}= 0.0015$","source":"arxiv","key":"562d2e1fcd0c6a496ce5531f434d6239","url":"https://inspirehep.net/files/562d2e1fcd0c6a496ce5531f434d6239"}],"legacy_version":"20170329084325.0","inspire_categories":[{"term":"Gravitation and Cosmology"},{"term":"Theory-HEP"},{"term":"Other"}],"first_author":{"full_name":"Mkenyeleye, Maombi D.","last_name":"Mkenyeleye","first_name":"Maombi D.","recid":2070244},"control_number":1306607,"dois":[{"source":"bibmatch","value":"10.1103/PhysRevD.90.064034"}],"document_type":["article"],"texkeys":["Mkenyeleye:2014dwa"],"abstracts":[{"source":"APS","value":"We study the gravitational collapse of a generalized Vaidya spacetime in the context of the cosmic censorship hypothesis. We develop a general mathematical framework to study the conditions on the mass function so that future directed nonspacelike geodesics can terminate at the singularity in the past. Thus our result generalizes earlier works on gravitational collapse of the combinations of Type-I and Type-II matter fields. Our analysis shows transparently that there exist classes of generalized Vaidya mass functions for which the collapse terminates with a locally naked central singularity. We calculate the strength of these singularities to show that they are strong curvature singularities and there can be no extension of spacetime through them.","abstract_source_suggest":{"input":"APS"}},{"source":"arXiv","value":"We study the gravitational collapse of a generalised Vaidya spacetime in the context of the Cosmic Censorship hypothesis. We develop a general mathematical framework to study the conditions on the mass function so that future directed non-spacelike geodesics can terminate at the singularity in the past. Thus our result generalises earlier works on gravitational collapse of the combinations of Type-I and Type-II matter fields. Our analysis shows transparently that there exist classes of generalised Vaidya mass functions for which the collapse terminates with a locally naked central singularity. We calculate the strength of the these singularities to show that they are strong curvature singularities and there can be no extension of spacetime through them.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"Gravitational collapse of generalized Vaidya spacetime"},{"source":"arXiv","title":"Gravitational collapse of generalised Vaidya spacetime"}],"imprints":[{"date":"2014-09-22"}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/1306607?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1306607?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1306607?format=latex-us","json":"https://inspirehep.net/api/literature/1306607?format=json","json-expanded":"https://inspirehep.net/api/literature/1306607?format=json-expanded","cv":"https://inspirehep.net/api/literature/1306607?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1306607"}},{"updated":"2023-03-10T15:38:00.702765+00:00","created":"2009-04-30T00:00:00+00:00","id":"819105","metadata":{"publication_info":[{"conference_record":{"$ref":"https://inspirehep.net/api/conferences/980393"},"cnum":"C06-11-20.4"}],"citation_count_without_self_citations":0,"authors":[{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/00x194q47"}],"full_name_unicode_normalized":"harada, tomohiro","full_name":"Harada, Tomohiro","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/1006719"},"last_name":"Harada","ids":[{"schema":"ORCID","value":"0000-0002-9085-9905"},{"schema":"INSPIRE BAI","value":"T.Harada.1"}],"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903157"},"value":"Rikkyo U."}],"signature_block":"HARADt","first_name":"Tomohiro","uuid":"a5e23c28-ac38-4dd9-8023-cac0b9d35c07","recid":1006719}],"citation_count":0,"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","keywords":[{"schema":"INSPIRE","value":"gravitation: collapse"},{"schema":"INSPIRE","value":"space-time: singularity"},{"schema":"INSPIRE","value":"cosmic censorship: violation"},{"schema":"INSPIRE","value":"self-similarity"},{"schema":"INSPIRE","value":"critical phenomena"},{"schema":"INSPIRE","value":"attractor"},{"schema":"INSPIRE","value":"renormalization group"},{"schema":"INSPIRE","value":"general relativity"},{"schema":"INSPIRE","value":"Einstein equation"},{"schema":"INSPIRE","value":"fluid"}],"references":[{"reference":{"publication_info":{"journal_volume":"19","artid":"525","page_start":"525","journal_title":"Adv.Phys."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/61185"}},{"reference":{"publication_info":{"journal_volume":"31","artid":"639","page_start":"639","journal_title":"Adv.Phys."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/185253"}},{"reference":{"arxiv_eprint":"gr-qc/0312117","publication_info":{"journal_volume":"93","artid":"161101","journal_title":"Phys