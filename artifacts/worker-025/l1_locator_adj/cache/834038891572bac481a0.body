https://inspirehep.net/api/literature/33714"}},{"reference":{"arxiv_eprint":"gr-qc/9812053","publication_info":{"journal_volume":"17","artid":"761","page_start":"761","journal_title":"Class.Quant.Grav."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/480995"}},{"reference":{"arxiv_eprint":"gr-qc/9402041","publication_info":{"journal_volume":"72","artid":"1782","page_start":"1782","journal_title":"Phys.Rev.Lett."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/371808"}},{"reference":{"arxiv_eprint":"gr-qc/0210101","publication_info":{"journal_volume":"376","artid":"339","page_start":"339","journal_title":"Phys.Rept."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/600812"}},{"reference":{"arxiv_eprint":"gr-qc/0304070","publication_info":{"journal_volume":"68","artid":"024011","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/617314"}},{"reference":{"publication_info":{"journal_volume":"145","artid":"271","page_start":"271","journal_title":"Mon.Not.Roy.Astron.Soc."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/57090"}},{"reference":{"publication_info":{"journal_volume":"144","artid":"425","page_start":"425","journal_title":"Mon.Not.Roy.Astron.Soc."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/59599"}},{"reference":{"publication_info":{"journal_volume":"218","artid":"834","page_start":"834","journal_title":"Astrophys.J."}}},{"reference":{"publication_info":{"journal_volume":"214","artid":"1","page_start":"1","journal_title":"Mon.Not.Roy.Astron.Soc."}}},{"reference":{"publication_info":{"journal_volume":"234","artid":"821","page_start":"821","journal_title":"Mon.Not.Roy.Astron.Soc."}}},{"reference":{"arxiv_eprint":"gr-qc/0109095","publication_info":{"journal_volume":"64","artid":"124024","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/563542"}},{"reference":{"arxiv_eprint":"gr-qc/0210027","publication_info":{"journal_volume":"67","artid":"084003","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/599275"}}],"number_of_pages":15,"legacy_creation_date":"2009-04-30","preprint_date":"2009-04","author_count":1,"public_notes":[{"value":"Submitted to Adv.Phys."}],"earliest_date":"2009-04","external_system_identifiers":[{"schema":"SPIRES","value":"SPIRES-8258007"}],"facet_author_name":["1006719_Tomohiro Harada"],"core":true,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:819105","updated":"2023-03-10T15:38:00.702765"},"arxiv_eprints":[{"categories":["gr-qc"],"value":"0904.4770"}],"referenced_authors_bais":["V.A.Belinsky.2","T.Hara.6","Tatsuhiko.Koike.1","M.W.Choptuik.1","P.S.Joshi.1","C.Gundlach.1","Stephen.James.Coleman.1","B.Semelin.1","A.Ori.2","K.I.Nakao.1","D.Garfinkle.1","J.M.Martin.Garcia.1","R.B.Larson.3","E.M.Lifshitz.1","T.Harada.1","D.Maison.1","M.V.Penston.1","H.Maeda.1","T.Piran.1","I.M.Khalatnikov.1","B.J.Carr.1","S.Adachi.5","P.R.Brady.1","Hideo.Iguchi.1","M.Snajdr.1","David.W.Neilsen.1","A.A.Coley.1","R.Penrose.1","C.R.Evans.1"],"figures":[{"filename":"schwarzschild_kruskal.png","caption":"The Penrose diagram ofthe Schwarzschild solution for $M>0$.","source":"arxiv","key":"b9bde31c467e27366ba76ebed67c02c3","url":"https://inspirehep.net/files/b9bde31c467e27366ba76ebed67c02c3"},{"filename":"friedmann.png","caption":"The left and right panels show the evolution of the scale factor for different spatial curvatures andthe Penrose diagram of the flat ($K=0$) Friedmann solution, respectively.","source":"arxiv","key":"98775d4dc926f2bc5df33d5ad7ed2e0b","url":"https://inspirehep.net/files/98775d4dc926f2bc5df33d5ad7ed2e0b"},{"filename":"flat_friedmann_penrose.png","caption":"The left and right panels show the evolution of the scale factor for different spatial curvatures andthe Penrose diagram of the flat ($K=0$) Friedmann solution, respectively.","source":"arxiv","key":"beaed7315659cca6d108052005d3b9e6","url":"https://inspirehep.net/files/beaed7315659cca6d108052005d3b9e6"},{"filename":"os.png","caption":"The Penrose diagram of the Oppenheimer-Snyder solution.","source":"arxiv","key":"2fd4a66276069015fdd67e52a977fa32","url":"https://inspirehep.net/files/2fd4a66276069015fdd67e52a977fa32"},{"filename":"penrose_grlp.png","caption":"The Penrose diagram of the GRLPsolution for $0<k<0.0105$. The dashed line denotes the event horizon.","source":"arxiv","key":"3cd04f9c1ecc2c3141704a479dc7716f","url":"https://inspirehep.net/files/3cd04f9c1ecc2c3141704a479dc7716f"},{"filename":"flow.png","caption":"The interplay of convergence andcritical phenomena.","source":"arxiv","key":"e89375e23004f10f8823f7fa3f939026","url":"https://inspirehep.net/files/e89375e23004f10f8823f7fa3f939026"}],"legacy_version":"20160326144358.0","inspire_categories":[{"term":"Gravitation and Cosmology"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/00x194q47"}],"full_name":"Harada, Tomohiro","last_name":"Harada","ids":[{"schema":"ORCID","value":"0000-0002-9085-9905"},{"schema":"INSPIRE BAI","value":"T.Harada.1"}],"first_name":"Tomohiro","recid":1006719},"control_number":819105,"document_type":["conference paper"],"texkeys":["Harada:2009sh"],"abstracts":[{"source":"arXiv","value":"Einstein's field equations in general relativity admit a variety of solutions with spacetime singularities. Numerical relativity has recently revealed the properties of somewhat generic spacetime singularities. It has been found that in a variety of systems self-similar solutions can describe asymptotic or intermediate behaviour of more general solutions in an approach to singularities. The typical example is the convergence to an attractor self-similar solution in gravitational collapse. This is closely related to the cosmic censorship violation in the spherically symmetric collapse of a perfect fluid. The self-similar solution also plays an important role in critical phenomena in gravitational collapse. The critical phenomena are understood as the intermediate behaviour around a critical self-similar solution. We see that the convergence and critical phenomena are understood in a unified manner in terms of attractors of codimension zero and one, respectively, in renormalisation group flow.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"Singularities and self-similarity in gravitational collapse"},{"source":"arXiv","title":"Singularities and self-similarity in gravitational collapse"}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/819105?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/819105?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/819105?format=latex-us","json":"https://inspirehep.net/api/literature/819105?format=json","json-expanded":"https://inspirehep.net/api/literature/819105?format=json-expanded","cv":"https://inspirehep.net/api/literature/819105?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A819105"}},{"updated":"2024-08-06T07:58:31.538687+00:00","created":"2023-07-10T10:35:50.735586+00:00","id":"2675514","metadata":{"publication_info":[{"year":2023}],"citation_count_without_self_citations":55,"authors":[{"raw_affiliations":[{"value":"Department of Physics, Fudan University, Shanghai, China"}],"full_name_unicode_normalized":"bambi, cosimo","full_name":"Bambi, Cosimo","record":{"$ref":"https://inspirehep.net/api/authors/1040537"},"last_name":"Bambi","ids":[{"schema":"INSPIRE BAI","value":"Cosimo.Bambi.1"}],"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903628"},"value":"Fudan U."}],"inspire_roles":["editor"],"uuid":"671dcb44-730d-4a5d-8e04-2006afb5401b","first_name":"Cosimo","recid":1040537}],"citation_count":56,"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","keywords":[{"source":"author","value":"Non-singular black holes"},{"source":"author","value":"Singularity free black holes"},{"source":"author","value":"Black holes beyond general relativity"},{"source":"author","value":"Geodesically complete black holes"},{"source":"author","value":"Geodesically complete spacetimes"},{"source":"author","value":"Non-singular gravitational collapse"},{"source":"author","value":"Resolution of spacetime singularities"},{"source":"author","value":"Black hole interior"},{"source":"author","value":"Baby universe"}],"number_of_pages":4,"preprint_date":"2023-07-25","author_count":1,"public_notes":[{"source":"arXiv","value":"4 pages, no figures. Preface and table of contents of the book\n \"Regular Black Holes: Towards a New Paradigm of Gravitational Collapse\"\n (Springer Singapore, 2023). ISBN: 978-981-99-1595-8 (Hardcover),\n 978-981-99-1596-5 (eBook)"}],"earliest_date":"2023-07-25","book_series":[{"title":"Springer Series in Astrophysics and Cosmology"}],"facet_author_name":["1040537_Cosimo Bambi"],"core":false,"license":[{"license":"arXiv nonexclusive-distrib 1.0","material":"preprint","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:2675514","updated":"2024-08-06T07:58:31.538687"},"arxiv_eprints":[{"categories":["gr-qc"],"value":"2307.13249"}],"isbns":[{"medium":"hardcover","value":"9789819915958"},{"medium":"softcover","value":"9789819915989"},{"medium":"online","value":"9789819915965"}],"inspire_categories":[{"term":"Astrophysics"},{"term":"Gravitation and Cosmology"}],"urls":[{"value":"https://link.springer.com/book/10.1007/978-981-99-1596-5"}],"first_author":{"emails":["bambi@fudan.edu.cn"],"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/013q1eq08"}],"full_name":"Bambi, Cosimo","last_name":"Bambi","first_name":"Cosimo","recid":1040537},"control_number":2675514,"dois":[{"source":"Springer","value":"10.1007/978-981-99-1596-5"},{"value":"10.1007/978-981-99-1596-5"},{"material":"publication","source":"arXiv","value":"10.1007/978-981-99-1596-5"}],"document_type":["book"],"texkeys":["Bambi:2023try"],"abstracts":[{"source":"Springer","value":"Black holes are one of the most fascinating predictions of general relativity. They are the natural product of the complete gravitational collapse of matter and today we have a body of observational evidence supporting the existence of black holes in the Universe. However, general relativity predicts that at the center of black holes there are spacetime singularities, where predictability is lost and standard physics breaks down. It is widely believed that spacetime singularities are a symptom of the limitations of general relativity and must be solved within a theory of quantum gravity. Since we do not have yet any mature and reliable candidate for a quantum gravity theory, researchers have studied toy-models of singularity-free black holes and of singularity-free gravitational collapses in order to explore possible implications of the yet unknown theory of quantum gravity. This book reviews all main models of regular black holes and non-singular gravitational collapses proposed in the literature, and discuss the theoretical and observational implications of these scenarios.","abstract_source_suggest":{"input":"Springer"}},{"source":"submitter","value":"Black holes are one of the most fascinating predictions of general relativity. They are the natural product of the complete gravitational collapse of matter and today we have a body of observational evidence supporting the existence of black holes in the Universe. However, general relativity predicts that at the center of black holes there are spacetime singularities, where predictability is lost and standard physics breaks down. It is widely believed that spacetime singularities are a symptom of the limitations of general relativity and must be solved within a theory of quantum gravity. Since we do not have yet any mature and reliable candidate for a quantum gravity theory, researchers have studied toy-models of singularity-free black holes and of singularity-free gravitational collapses in order to explore possible implications of the yet unknown theory of quantum gravity. This book reviews all main models of regular black holes and non-singular gravitational collapses proposed in the literature, and discuss the theoretical and observational implications of these scenarios.","abstract_source_suggest":{"input":"submitter"}},{"source":"arXiv","value":"Black holes are one of the most fascinating predictions of general relativity. They are the natural product of the complete gravitational collapse of matter and today we have a body of observational evidence supporting the existence of black holes in the Universe. However, general relativity predicts that at the center of black holes there are spacetime singularities, where predictability is lost and standard physics breaks down. It is widely believed that spacetime singularities are a symptom of the limitations of general relativity and must be solved within a theory of quantum gravity. Since we do not have yet any mature and reliable candidate for a quantum gravity theory, researchers have studied toy-models of singularity-free black holes and of singularity-free gravitational collapses in order to explore possible implications of the yet unknown theory of quantum gravity. This book reviews all main models of regular black holes and non-singular gravitational collapses proposed in the literature, and discuss the theoretical and observational implications of these scenarios.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"source":"Springer","title":"Regular Black Holes. Towards a New Paradigm of Gravitational Collapse"},{"source":"submitter","title":"Regular Black Holes"},{"source":"arXiv","title":"Regular Black Holes: Towards a New Paradigm of Gravitational Collapse"}],"imprints":[{"date":"2023","publisher":"Springer"},{"date":"2023","publisher":"Springer Singapore"}],"curated":false},"links":{"bibtex":"https://inspirehep.net/api/literature/2675514?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/2675514?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/2675514?format=latex-us","json":"https://inspirehep.net/api/literature/2675514?format=json","json-expanded":"https://inspirehep.net/api/literature/2675514?format=json-expanded","cv":"https://inspirehep.net/api/literature/2675514?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2675514"}}],"total":616},"links":{"self":"https://inspirehep.net/api/literature/?q=...singularities%20of%20gravitational%20collapse...&size=10&page=1","next":"https://inspirehep.net/api/literature/?q=...singularities%20of%20gravitational%20collapse...&size=10&page=2","bibtex":"https://inspirehep.net/api/literature/?q=...singularities%20of%20gravitational%20collapse...&size=10&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=...singularities%20of%20gravitational%20collapse...&size=10&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=...singularities%20of%20gravitational%20collapse...&size=10&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=...singularities%20of%20gravitational%20collapse...&size=10&page=1&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=...singularities%20of%20gravitational%20collapse...&size=10&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=...singularities%20of%20gravitational%20collapse...&size=10&page=1&format=cv"}}