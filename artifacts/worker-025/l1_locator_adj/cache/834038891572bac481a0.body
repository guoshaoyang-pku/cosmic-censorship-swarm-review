ce":{"arxiv_eprint":"gr-qc/0010101","publication_info":{"journal_volume":"64","artid":"041501","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/535744"}}],"number_of_pages":12,"legacy_creation_date":"2004-07-30","preprint_date":"1999","author_count":1,"public_notes":[{"source":"arXiv","value":"12 pages, to appear in the Proceedings of the International Conference on Gravitation and Cosmology (ICGC-2004), ed. by B.R. Iyer, V. Kuriakose and C.V. Vishveshwara, published by Pramana, minor corrections Journal-ref: Pramana 63(4) (2004) 741"}],"earliest_date":"1999","external_system_identifiers":[{"schema":"ADS","value":"2004Prama..63..741H"},{"schema":"SPIRES","value":"SPIRES-5940788"}],"facet_author_name":["1006719_Tomohiro Harada"],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:521617","updated":"2023-03-10T09:44:42.817948"},"journal_title_variants":["Pramana"],"arxiv_eprints":[{"categories":["gr-qc"],"value":"gr-qc/0407109"}],"referenced_authors_bais":["S.Adachi.5","An.Zhong.Wang.1","Demetrios.Christodoulou.1","Kip.S.Thorne.1","Hermann.Bondi.1","F.C.Mena.1","Hideo.Iguchi.1","L.Smarr.1","S.S.Deshingkar.2","T.P.Singh.1","David.W.Neilsen.1","A.A.Coley.1","R.Penrose.1","F.Echeverria.1","R.P.A.C.Newman.1","C.R.Evans.1","I.H.Dwivedi.1","S.A.Hayward.1","H.S.Snyder.1","T.Hara.6","Tatsuhiko.Koike.1","M.W.Choptuik.1","P.S.Joshi.1","T.A.Apostolatos.1","J.Robert.Oppenheimer.1","C.Gundlach.1","L.Witten.1","S.S.Deshingkar.3","Stephen.James.Coleman.1","A.Ori.2","R.C.Tolman.1","K.I.Nakao.1","S.A.Teukolsky.1","J.M.Martin.Garcia.1","A.M.Abrahams.1","C.Vaz.1","T.Harada.1","Takahiro.Tanaka.1","G.Lemaitre.1","D.M.Eardley.1","B.C.Nolan.1","S.Barve.1","S.Shapiro.1","Paulo.R.C.T.Pereira.1","T.Chiba.1","H.Maeda.1","T.Piran.1","B.J.Carr.1"],"legacy_version":"20160621164424.0","inspire_categories":[{"term":"Gravitation and Cosmology"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/026zzn846"}],"full_name":"Harada, Tomohiro","last_name":"Harada","ids":[{"schema":"ORCID","value":"0000-0002-9085-9905"},{"schema":"INSPIRE BAI","value":"T.Harada.1"}],"first_name":"Tomohiro","recid":1006719},"control_number":521617,"dois":[{"value":"10.1007/BF02705196"}],"document_type":["conference paper"],"texkeys":["Harada:1999jf"],"abstracts":[{"source":"arXiv","value":"Gravitational collapse is one of the most striking phenomena in gravitational physics. The cosmic censorship conjecture has provided strong motivation for researches in this field. In the absence of general proof for the censorship, many examples have been proposed, in which naked singularity is the outcome of gravitational collapse. Recent development has revealed that there are examples of naked singularity formation in the collapse of physically reasonable matter fields, although the stability of these examples is still uncertain. We propose the concept of ``effective naked singularities'', which will be quite helpful because general relativity has the limitation of its application for high-energy end. The appearance of naked singularities is not detestable but can open a window for new physics of strongly curved spacetimes.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"Gravitational collapse and naked singularities"},{"source":"arXiv","title":"Gravitational collapse and naked singularities"}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/521617?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/521617?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/521617?format=latex-us","json":"https://inspirehep.net/api/literature/521617?format=json","json-expanded":"https://inspirehep.net/api/literature/521617?format=json-expanded","cv":"https://inspirehep.net/api/literature/521617?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A521617"}},{"updated":"2025-08-13