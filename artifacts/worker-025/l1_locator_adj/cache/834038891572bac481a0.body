":"20180614230052.0","inspire_categories":[{"term":"Gravitation and Cosmology"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/03v76x132"}],"full_name":"Goncalves, Sergio M.C.V.","last_name":"Goncalves","first_name":"Sergio M.C.V.","recid":2261140},"control_number":636509,"dois":[{"value":"10.1103/PhysRevD.69.021502"}],"document_type":["article"],"texkeys":["Goncalves:2003ew"],"abstracts":[{"source":"arXiv","value":"We consider spherically symmetric spacetimes with matter whose timelike flow is assumed to be shear-free. A number of results on the formation and visibility of spacetime singularities is proven, with the main one being that shear-free collapse cannot admit locally naked singularities (which implies absence of globally naked singularities). We conjecture that shear is a necessary condition for the occurrence of locally naked singularities in generic gravitational collapse.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"Shear free gravitational collapse is strongly censored"},{"source":"arXiv","title":"Shear-free gravitational collapse is strongly censored."}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/636509?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/636509?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/636509?format=latex-us","json":"https://inspirehep.net/api/literature/636509?format=json","json-expanded":"https://inspirehep.net/api/literature/636509?format=json-expanded","cv":"https://inspirehep.net/api/literature/636509?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A636509"}},{"updated":"2023-03-07T03:20:05.325093+00:00","created":"2010-08-17T00:00:00+00:00","id":"865522","metadata":{"publication_info":[{"journal_volume":"695","page_end":"319","year":2011,"page_start":"317","journal_title":"Phys.Lett.B"}],"citation_count_without_self_citations":52,"au