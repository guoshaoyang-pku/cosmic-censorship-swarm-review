15:48:29.737125"},"journal_title_variants":["Pramana"],"arxiv_eprints":[{"categories":["gr-qc"],"value":"gr-qc/0702116"}],"referenced_authors_bais":["H.S.Snyder.1","Stephen.W.Hawking.1","M.N.Celerier.1","R.Maartens.1","Andrzej.Krolak.1","Martin.Bojowald.1","J.M.M.Senovilla.1","G.Magli.1","P.Singh.4","F.Giannoni.2","N.Dadhich.1","R.Penrose.1","R.Giambo.2","A.K.Raychaudhuri.1","Amalkumar.Raychaudhuri.1","P.Szekeres.1","I.H.Dwivedi.1","J.Robert.Oppenheimer.1","P.S.Joshi.1","P.Piccione.2","R.Goswami.2"],"legacy_version":"20161012024136.0","inspire_categories":[{"term":"Gravitation and Cosmology"}],"first_author":{"full_name":"Joshi, Pankaj S.","last_name":"Joshi","first_name":"Pankaj S.","recid":1004099},"control_number":744982,"dois":[{"value":"10.1007/s12043-007-0114-5"}],"document_type":["article"],"texkeys":["Joshi:2007hq"],"abstracts":[{"source":"arXiv","value":"We consider here the genericity aspects of spacetime singularities that occur in cosmology and in gravitational collapse. The singularity theorems (that predict the occurrence of singularities in general relativity) allow the singularities of gravitational collapse to be either visible to external observers or covered by an event horizon of gravity. It is shown that the visible singularities that develop as final states of spherical collapse are generic. Some consequences of this fact are discussed.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"On the genericity of spacetime singularities"},{"title":"SPACE-TIME"},{"source":"arXiv","title":"On the genericity of spacetime singularities"}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/744982?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/744982?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/744982?format=latex-us","json":"https://inspirehep.net/api/literature/744982?format=json","json-expanded":"https://inspirehep.net/api/literature/744982?f