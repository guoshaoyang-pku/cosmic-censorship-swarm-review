elation":false,"record":{"$ref":"https://inspirehep.net/api/literature/472464"}},{"reference":{"publication_info":{"journal_volume":"13","artid":"789","page_start":"789","journal_title":"Phys.Rev.Lett."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/45148"}},{"reference":{"publication_info":{"journal_volume":"11","artid":"237","page_start":"237","journal_title":"Phys.Rev.Lett."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/3897"}}],"number_of_pages":5,"legacy_creation_date":"2002-11-07","preprint_date":"1999-12","author_count":1,"earliest_date":"1999-12","external_system_identifiers":[{"schema":"ADS","value":"2000AIPC..526..594G"},{"schema":"SPIRES","value":"SPIRES-5372062"}],"facet_author_name":["2195131_James S. Graber"],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:520848","updated":"2023-03-07T00:00:58.783630"},"journal_title_variants":["AIP Conf. Proc.","AIP Conf.Proc."],"arxiv_eprints":[{"categories":["astro-ph"],"value":"astro-ph/9912322"}],"referenced_authors_bais":["P.Meszaros.1","M.W.Choptuik.1","Mario.Livio.1","Juan.M.Maldacena.1","D.N.Schramm.1","J.S.Graber.2","Robert.Rathbun.Wilson.1","J.L.Matteson.1","S.A.Teukolsky.1","Y.Itin.1","D.L.Band.1","B.J.Teegarden.2","C.G.Callan.1","M.S.Briggs.1","D.Eichler.1","S.Shapiro.1","J.P.Lestrade.2","T.Piran.1","T.L.Cline.1","Cumrun.Vafa.1","B.Paczynski.1","I.I.Shapiro.1","H.Yilmaz.4","Demetrios.Christodoulou.1","G.N.Pendleton.1","G.Fishman.1","Nathan.Rosen.1","S.E.Woosley.1","J.E.Rhoads.1","Lawrence.H.Ford.1","M.J.Rees.1","C.Meegan.4","W.S.Paciesas.1","R.S.Mallozzi.1","Roy.P.Kerr.1","G.N.Pendleton.2","R.D.Preece.1","A.Strominger.1","C.Kouveliotou.1","B.Schaefer.10","D.M.Palmer.1"],"legacy_version":"20180119103445.0","inspire_categories":[{"term":"Astrophysics"}],"first_author":{"full_name":"Graber, James S.","last_name":"Graber","first_name":"James S.","recid":2195131},"control_number":520848,"dois":[{"source":"ADS","value":"10.1063/1.1361606"}],"document_type":["conference paper"],"texkeys":["Graber:1999rp"],"abstracts":[{"source":"AIP","value":"Gamma-ray bursts (GRBs) are still an enigma. In particular, the central engine, the total energy, and the very narrow distribution of peak energies challenge model builders. Motivated by recent theoretical developments (string theory, quantum gravity, critical collapse), which suggest that complete gravitational collapse can occur without singularities or event horizons, we explore how red-hole models (which lack singularities or event horizons) can solve these problems better than black-hole models.","abstract_source_suggest":{"input":"AIP"}},{"source":"arXiv","value":"Gamma-ray bursts (GRBs) are still an enigma. In particular the central engine, the total energy, and the very narrow distribution of peak energies challenge model builders. Motivated by recent theoretical developments (string theory, quantum gravity, critical collapse), which suggest that complete gravitational collapse can occur without singularities or event horizons, we explore how red-hole models (which lack singularities or event horizons) can solve these problems better than black-hole models.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["astro-ph"],"titles":[{"title":"Red hole gamma-ray bursts: a new gravitational collapse paradigm explains the peak energy distribution and solves the grb energy crisis"},{"title":"GAMMA-RAY BURST"},{"source":"arXiv","title":"Red Hole Gamma-Ray Bursts: A New Gravitational Collapse Paradigm Explains the Peak Energy Distribution and Solves the GRB Energy Crisis"}],"imprints":[{"date":"2000-09-08"}],"curated":false},"links":{"bibtex":"https://inspirehep.net/api/literature/520848?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/520848?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/520848?format=latex-us","json":"https://inspirehep.net/api/literature/520848?format=json","json-expanded":"https:/