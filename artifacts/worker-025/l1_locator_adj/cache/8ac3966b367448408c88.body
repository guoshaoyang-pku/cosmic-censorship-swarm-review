{"full_name":"Araneda, B."}]},"raw_refs":[{"schema":"text","value":"Araneda, B. Symmetry operators and decoupled equations for linear fields on black hole spacetimes. Class. Quantum Gravity 2017, 34, 035002, doi: 10.1088/1361-6382/aa51ff"}],"record":{"$ref":"https://inspirehep.net/api/literature/1489324"}},{"reference":{"dois":["10.1088/1361-6382/aab06a"],"publication_info":{"journal_volume":"35","artid":"075015","year":2018,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214779"},"journal_title":"Class.Quant.Grav."},"misc":["Generalized wave operators, weighted Killing fields, and perturbations of higher dimensional spacetimes"],"authors":[{"full_name":"Araneda, B."}]},"raw_refs":[{"schema":"text","value":"Araneda, B. Generalized wave operators, weighted Killing fields, and perturbations of higher dimensional spacetimes. Class. Quantum Gravity 2018, 35, 075015, doi: 10.1088/1361-6382/aab06a"}],"record":{"$ref":"https://inspirehep.net/api/literature/1638987"}},{"reference":{"dois":["10.1088/1361-6382/aad13b"],"publication_info":{"journal_volume":"35","artid":"175001","year":2018,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214779"},"journal_title":"Class.Quant.Grav."},"misc":["Conformal invariance, complex structures and the Teukolsky connection"],"authors":[{"full_name":"Araneda, B."}]},"raw_refs":[{"schema":"text","value":"Araneda, B. Conformal invariance, complex structures and the Teukolsky connection. Class. Quantum Gravity 2018, 35, 175001, doi: 10.1088/1361-6382/aad13b"}],"record":{"$ref":"https://inspirehep.net/api/literature/1675304"}},{"reference":{"dois":["10.1007/s11005-020-01307-8"],"publication_info":{"journal_volume":"110","page_end":"2638","year":2020,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214594"},"page_start":"2603","journal_title":"Lett.Math.Phys."},"misc":["Two-dimensional twistor manifolds and Teukolsky operators"],"authors":[{"full_name":"Araneda, B."}]},"raw_refs":[{"schema":"text","value":"Araneda, B. Two-dimensional twistor manifolds and Teukolsky operators. Lett. Math. Phys. 2020, 110, 2603–2638, doi: 10.1007/s11005-020-01307-8"}],"record":{"$ref":"https://inspirehep.net/api/literature/1742648"}}],"preprint_date":"2022-01-10","author_count":1,"public_notes":[{"source":"arXiv","value":"Lecture notes delivered at the V José Plínio Baptista School\n of Cosmology (Guarapari (Espírito Santo) Brazil, September 30th to\n October 5th, 2021)"}],"earliest_date":"2022-01-10","refereed":true,"publication_type":["review"],"facet_author_name":["1011485_Gustavo Daniel Dotti"],"license":[{"license":"CC-BY-3.0","imposing":"MDPI","url":"http://creativecommons.org/licenses/by/3.0"},{"license":"arXiv nonexclusive-distrib 1.0","material":"preprint","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:2008924","updated":"2026-02-09T12:12:00.476773"},"journal_title_variants":["Universe"],"arxiv_eprints":[{"categories":["gr-qc"],"value":"2201.03640"}],"referenced_authors_bais":["B.F.Whiting.1","R.M.Wald.1","R.H.Price.1","Marco.Bruni.1","J.A.Wheeler.1","Emanuele.Berti.1","E.Seidel.7","A.Ishibashi.1","G.W.Gibbons.1","Valeri.P.Frolov.1","T.Regge.1","B.S.Kay.1","P.Blue.2","David.Kubiznak.1","Subrahmanyan.Chandrasekhar.1","F.J.Zerilli.1","D.C.Robinson.1","S.A.Teukolsky.1","G.Holzegel.1","V.Cardoso.1","Z.Perjes.1","S.A.Hartnoll.1","A.Vasy.1","M.Cavaglia.1","L.S.Kegeles.1","R.J.Gleiser.1","B.Araneda.1","C.Cherubini.3","M.Dafermos.1","A.M.Taylor.1","Si.Yuan.Ma.1","I.F.Ranea.Sandoval.1","J.A.Pullin.1","J.M.Cohen.4","Lars.Andersson.1","G.D.Dotti.1","M.Heusler.1","P.Hintz.1","Shijun.Yoshida.1","Helmut.Friedrich.1","H.Vucetich.1","D.Bini.1","T.Backdahl.1","P.Krtous.1","I.Rodnianski.1","M.Casals.2"],"figures":[{"filename":"Inter.png","material":"preprint","caption":"Intersection of the numerically generated curves $E_{(\\ell=2)}(\\w=ik/a)$ and $\\epsilon_o(\\w=ik/a)$ for $a/M=1.4$. Note the agreement with the results in \\cite{doglepu}, according to which for $a=1.4$ the intersection occurs at $k \\simeq 7.07 \\times 1.4 = 9898$.","source":"arxiv","key":"7cb738d4de25c7a03754b66cd4960f67","url":"https://inspirehep.net/files/7cb738d4de25c7a03754b66cd4960f67"}],"inspire_categories":[{"term":"Gravitation and Cosmology","source":"arxiv"}],"first_author":{"emails":["gdotti@famaf.unc.edu.ar"],"full_name":"Dotti, Gustavo","last_name":"Dotti","first_name":"Gustavo","recid":1011485},"control_number":2008924,"dois":[{"source":"MDPI","value":"10.3390/universe8010038"},{"material":"publication","source":"arXiv","value":"10.3390/universe8010038"}],"document_type":["conference paper"],"texkeys":["Dotti:2022djh"],"abstracts":[{"source":"MDPI","value":"A review of the current status of the linear stability of black holes and naked singularities is given. The standard modal approach, that takes advantage of the background symmetries and analyze separately the harmonic components of linear perturbations, is briefly introduced and used to prove that the naked singularities in the Kerr&ndash;Newman family, as well as the inner black hole regions beyond Cauchy horizons, are unstable and therefore unphysical. The proofs require a treatment of the boundary condition at the timelike boundary, which is given in detail. The nonmodal linear stability concept is then introduced, and used to prove that the domain of outer communications of a Schwarzschild black hole with a non-negative cosmological constant satisfies this stronger stability condition, which rules out transient growths of perturbations, and also to show that the perturbed black hole settles into a slowly rotating Kerr black hole. The encoding of the perturbation fields in gauge invariant curvature scalars and the effects of the perturbation on the geometry of the spacetime is discussed. These notes follow from a course delivered at the V Jos&eacute; Pl&iacute;nio Baptista School of Cosmology, held at Guarapari (Esp&iacute;rito Santo) Brazil, from 30 September to 5 October 2021.","abstract_source_suggest":{"input":"MDPI"}},{"source":"arXiv","value":"These notes follow from a course delivered at the V José Plínio Baptista School of Cosmology, held at Guarapari (Espírito Santo) Brazil, from 30 September to 5 October 2021. A review of the current status of the linear stability of black holes and naked singularities is given. The standard modal approach, that takes advantage of the background symmetries and analyze separately the harmonic components of linear perturbations, is briefly introduced and used to prove that the naked singularities in the Kerr--Newman family, as well as the inner black hole regions beyond Cauchy horizons, are unstable and therefore unphysical. The proofs require a treatment of the boundary condition at the timelike boundary, which is given in detail. The nonmodal linear stability concept is then introduced, and used to prove that the domain of outer communications of a Schwarzschild black hole with a non-negative cosmological constant satisfies this stronger stability condition, which rules out transient growths of perturbations, and also to show that the perturbed black hole settles into a slowly rotating Kerr black hole. The encoding of the perturbation fields in gauge invariant curvature scalars and the effects of the perturbation on the geometry of the spacetime is discussed.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"source":"MDPI","title":"Linear Stability of Black Holes and Naked Singularities"},{"source":"arXiv","title":"Linear Stability of Black Holes and Naked Singularities"}],"imprints":[{"date":"2022-01-10"}],"curated":false},"links":{"bibtex":"https://inspirehep.net/api/literature/2008924?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/2008924?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/2008924?format=latex-us","json":"https://inspirehep.net/api/literature/2008924?format=json","js