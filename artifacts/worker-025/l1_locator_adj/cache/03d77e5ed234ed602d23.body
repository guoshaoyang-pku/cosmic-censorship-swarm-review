r3.pdf","source":"arxiv","key":"8d2e4bf34137dbe7cf12a53541ea4b06","url":"https://inspirehep.net/files/8d2e4bf34137dbe7cf12a53541ea4b06"},{"filename":"ekerr4.png","caption":"ekerr4.pdf","source":"arxiv","key":"249cb7ddaee5baf84a5bbdd6345c4629","url":"https://inspirehep.net/files/249cb7ddaee5baf84a5bbdd6345c4629"},{"filename":"mregion.png","caption":"mregion.pdf","source":"arxiv","key":"fc246232cf91de6df3930d5b6cd775fb","url":"https://inspirehep.net/files/fc246232cf91de6df3930d5b6cd775fb"},{"filename":"xicut.png","caption":"xicut.pdf","source":"arxiv","key":"a9ebf9c595d739a2414aa13a27996506","url":"https://inspirehep.net/files/a9ebf9c595d739a2414aa13a27996506"},{"filename":"vgeneral.png","caption":"vgeneral.pdf","source":"arxiv","key":"164cb897fe27ea498a679a2df7332bec","url":"https://inspirehep.net/files/164cb897fe27ea498a679a2df7332bec"},{"filename":"vtonos.png","caption":"vtonos.pdf","source":"arxiv","key":"806f32ab77cac4bf821c19a9d7fc9539","url":"https://inspirehep.net/files/806f32ab77cac4bf821c19a9d7fc9539"},{"filename":"f11.png","caption":"f11.pdf","source":"arxiv","key":"c1cc37ca000bedb047af690ac7aafaf6","url":"https://inspirehep.net/files/c1cc37ca000bedb047af690ac7aafaf6"},{"filename":"yexpnewnew.png","caption":"yexpnewnew.pdf","source":"arxiv","key":"fb6216ca2e8c5c5c8a25500174e5445a","url":"https://inspirehep.net/files/fb6216ca2e8c5c5c8a25500174e5445a"},{"filename":"ftrap.png","caption":"ftrap.pdf","source":"arxiv","key":"4e0525f956366c832971221fed553867","url":"https://inspirehep.net/files/4e0525f956366c832971221fed553867"},{"filename":"hcutftrap.png","caption":"hcutftrap.pdf","source":"arxiv","key":"1b6abc0ed65f70f83708a76ce4714b4b","url":"https://inspirehep.net/files/1b6abc0ed65f70f83708a76ce4714b4b"},{"filename":"yaux.png","caption":"yaux.pdf","source":"arxiv","key":"bf31fac4618f3382e3b425aec2ac7c08","url":"https://inspirehep.net/files/bf31fac4618f3382e3b425aec2ac7c08"},{"filename":"ekerr5.png","caption":"ekerr5.pdf","source":"arxiv","key":"042c4c72f6e1188204881c2563abf3f1","url":"https://inspirehep.net/files/042c4c72f6e1188204881c2563abf3f1"},{"filename":"xiaver.png","caption":"xiaver.pdf","source":"arxiv","key":"ecc24a9b1c50a1957e92f13c7b725e28","url":"https://inspirehep.net/files/ecc24a9b1c50a1957e92f13c7b725e28"},{"filename":"1pointdecay.png","caption":"1pointdecay.pdf","source":"arxiv","key":"6cce77f8488b87e780be803ac4ade5fa","url":"https://inspirehep.net/files/6cce77f8488b87e780be803ac4ade5fa"},{"filename":"2decaypoint.png","caption":"2decaypoint.pdf","source":"arxiv","key":"12114e9b1b7cd6a9cd7870e1f84537a4","url":"https://inspirehep.net/files/12114e9b1b7cd6a9cd7870e1f84537a4"}],"legacy_version":"20160326185307.0","inspire_categories":[{"term":"Gravitation and Cosmology"},{"term":"Math and Math Physics"}],"first_author":{"full_name":"Aretakis, Stefanos","last_name":"Aretakis","first_name":"Stefanos","recid":1069808},"control_number":931177,"dois":[{"value":"10.1016/j.jfa.2012.08.015"}],"document_type":["article"],"texkeys":["Aretakis:2011gz"],"abstracts":[{"source":"arXiv","value":"We study the Cauchy problem for the wave equation on extreme Kerr backgrounds under axisymmetry. Specifically, we consider regular axisymmetric initial data prescribed on a Cauchy hypersurface S which connects the future event horizon with spacelike or null infinity, and we solve the linear wave equation on the domain of dependence of S. We show that the spacetime integral of an energy-type density is bounded by the initial conserved flux corresponding to the stationary Killing field T, and we derive boundedness of the non-degenerate energy flux corresponding to a globally timelike vector field N. Finally, we prove uniform pointwise boundedness and power-law decay for solutions to the wave equation. Our estimates hold up to and including the event horizon. We remark that these results do not yield decay for the derivatives transversal to the horizon, and this is suggestive that these derivatives may satisfy instability properties analogous to those shown in our previous work on extreme Reissner-Nordstrom backgrounds.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"Decay of Axisymmetric Solutions of the Wave Equation on Extreme Kerr Backgrounds"},{"source":"arXiv","title":"Decay of Axisymmetric Solutions of the Wave Equation on Extreme Kerr Backgrounds"}],"curated":true},"id":"931177"},{"updated":"2023-03-06T13:49:07.984911+00:00","created":"1992-12-28T00:00:00+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/341698?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/341698?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/341698?format=latex-us","json":"https://inspirehep.net/api/literature/341698?format=json","json-expanded":"https://inspirehep.net/api/literature/341698?format=json-expanded","cv":"https://inspirehep.net/api/literature/341698?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A341698"},"metadata":{"citation_count":26,"authors":[{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/02t274463"}],"full_name_unicode_normalized":"yurtsever, ulvi","full_name":"Yurtsever, Ulvi","record":{"$ref":"https://inspirehep.net/api/authors/982471"},"ids":[{"schema":"INSPIRE BAI","value":"U.Yurtsever.1"}],"last_name":"Yurtsever","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903307"},"value":"UC, Santa Barbara"}],"signature_block":"YARTSAFARu","first_name":"Ulvi","uuid":"1e1792a0-3a36-48da-a68e-2d90bd94e9e8","recid":982471}],"citation_count_without_self_citations":26,"report_numbers":[{"value":"FPRINT-92-41"}],"publication_info":[{"journal_volume":"10","artid":"L17","year":1993,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214779"},"page_start":"L17","journal_title":"Class.Quant.Grav."}],"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","number_of_pages":10,"legacy_version":"20160616110509.0","legacy_creation_date":"1992-12-28","preprint_date":"1992-08","author_count":1,"first_author":{"full_name":"Yurtsever, Ulvi","last_name":"Yurtsever","first_name":"Ulvi","recid":982471},"public_notes":[{"value":"Fermilab Library Only"}],"control_number":341698,"dois":[{"value":"10.1088/0264-9381/10/1/004"}],"earliest_date":"1992-08","document_type":["article"],"texkeys":["Yurtsever:1992th"],"abstracts":[{"source":"IOP","value":"The inner (Cauchy) horizons of Kerr and Reissner-Nordstrom black-hole solutions are unstable against generic, linearized perturbations. Understanding the precise nature of these instabilities is clearly important for cosmic censorship, and a number of recent studies have addressed this issue. In particular, some of the recent papers have challenged the widely accepted view that the instabilities would, in the generic case, turn the Cauchy horizon into a spacelike curvature singularity. Instead, the new results appear to support an alternative picture of the generic black-hole interior in which the perturbed Cauchy horizon is replaced by a null singularity, and one with weaker strength (tidal forces) than was previously believed. To prove these recent conclusions rigorously would require the difficult analysis of the full non-linear perturbation equations in an interior black-hole background. A similar but somewhat simpler model problem to study is perturbations of the Cauchy horizon of a plane-symmetric spacetime; this model, as the authors comment on is not only more tractable, but also provides some interesting formal pointers to the original black-hole inner-horizon problem. They make a number of comments, based entirely on previous work on the dynamics of plane-symmetric spacetimes, that exploit the analogy between these two problems. A straightforward exploration of this analogy appears to support the older picture where a spacelike curvature singularity. rather than a weaker, null one, replaces the inner horizon of a black hole under generic nonlinear perturbations. Their arguments are not conclusive, but they might yield further more rigorous insights when combined with the new techniques other authors use in their analyses.","abstract_source_suggest":{"input":"IOP"}}],"refereed":true,"titles":[{"title":"Comments on the instability of black hole inner horizons"}],"external_system_identifiers":[{"schema":"ADS","value":"1993CQGra..10L..17Y"},{"schema":"SPIRES","value":"SPIRES-2665280"}],"facet_author_name":["982471_Ulvi Yurtsever"],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:341698","updated":"2023-03-06T13:49:07.984911"},"curated":true,"journal_title_variants":["Class.Quant.Grav.","Class. Quant. Grav."]},"id":"341698"},{"updated":"2023-03-06T17:00:28.695809+00:00","created":"2014-08-21T00:00:00+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/1311597?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1311597?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1311597?format=latex-us","json":"https://inspirehep.net/api/literature/1311597?format=json","json-expanded":"https://inspirehep.net/api/literature/1311597?format=json-expanded","cv":"https://inspirehep.net/api/literature/1311597?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1311597"},"metadata":{"citation_count":2,"authors":[{"full_name_unicode_normalized":"angelopoulos, yannis","full_name":"Angelopoulos, Yannis","record":{"$ref":"https://inspirehep.net/api/authors/2284706"},"ids":[{"schema":"INSPIRE BAI","value":"Y.Angelopoulos.1"}],"last_name":"Angelopoulos","signature_block":"ANGALAPALy","first_name":"Yannis","uuid":"3a9fb525-81a3-4ff5-877d-3cf3434110e9","recid":2284706}],"citation_count_without_self_citations":1,"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","references":[{"reference":{"label":"1","misc":["Nonlinear wave equations with null condition on extremal Reissner-Nordström spacetimes II: The general case. in preparation"],"authors":[{"full_name":"Angelopoulos, Y."}]}},{"reference":{"label":"2","publication_info":{"journal_volume":"307","page_end":"63","year":2011,"page_start":"17","journal_title":"Commun.Math.Phys."},"misc":["Stability and instability of extreme Reissner-Nordström black hole spacetimes for linear scalar perturbations I"],"authors":[{"full_name":"Aretakis, S."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/931178"}},{"reference":{"label":"3","publication_info":{"year":2011},"misc":["Stability and instability of extreme Reissner-Nordström black hole spacetimes for linear scalar perturbations II. Ann. Henri Poincaré 12 , 1491-1538"],"authors":[{"full_name":"Aretakis, S."}]}},{"reference":{"label":"4","publication_info":{"journal_volume":"263","page_end":"2831","year":2012,"page_start":"2770","journal_title":"J.Funct.Anal."},"misc":["Decay of axisymmetric solutions of the wave equation on extreme Kerr backgrounds"],"authors":[{"full_name":"Aretakis, S."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/931177"}},{"reference":{"label":"5","publication_info":{"year":2012},"misc":["Horizon instability of extremal black holes. To appear in ATMP"],"authors":[{"full_name":"Aretakis, S."}]}},{"reference":{"arxiv_eprint":"1212.1103","label":"6","publication_info":{"year":2012},"misc":["note on instabilities of extremal black holes from afar"],"authors":[{"full_name":"Aretakis, S.A"}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1205642"}},{"reference":{"arxiv_eprint":"1310.1365","label":"7","publication_info":{"year":2013},"misc":["The characteristic gluing problem and conservation laws for the wave equation on null hypersurfaces"],"authors":[{"full_name":"Aretakis, S."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/1256932"}},{"reference":{"label":"8","publication_info":{"journal_volume":"87","artid":"084052","ye