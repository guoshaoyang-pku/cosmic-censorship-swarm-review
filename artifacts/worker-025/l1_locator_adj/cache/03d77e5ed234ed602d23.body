"}],"facet_author_name":["1069808_Stefanos Aretakis"],"license":[{"imposing":"arXiv","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:931178","updated":"2026-02-06T10:43:22.076378"},"journal_title_variants":["Commun. Math. Phys.","Commun.Math.Phys."],"arxiv_eprints":[{"categories":["gr-qc"],"value":"1110.2007"}],"referenced_authors_bais":["M.Dafermos.1","J.Luk.1","Lars.Andersson.1","B.S.Kay.1","J.A.Wheeler.1","R.M.Wald.1","J.Speck.3","A.Soffer.3","A.Soffer.1","Demetrios.Christodoulou.1","W.Schlag.2","T.Regge.1","R.H.Price.1","L.Nguyen.1","R.Donninger.5","J.Kronthaler.1","P.Tod.2","I.Rodnianski.1","P.T.Chrusciel.1","P.Blue.2","D.M.Marolf.1"],"figures":[{"filename":"ern001.png","caption":"ern001.pdf","source":"arxiv","key":"553192e9b7834d907fad4e121cb82bbd","url":"https://inspirehep.net/files/553192e9b7834d907fad4e121cb82bbd"},{"filename":"exrnw1.png","caption":"exrnw1.pdf","source":"arxiv","key":"2117894f878975b60d7217ca249b8f3a","url":"https://inspirehep.net/files/2117894f878975b60d7217ca249b8f3a"},{"filename":"ernt1.png","caption":"ernt1.pdf","source":"arxiv","key":"e288d9ea307cd4669a40b5764e3beebb","url":"https://inspirehep.net/files/e288d9ea307cd4669a40b5764e3beebb"},{"filename":"ernt2.png","caption":"ernt2.pdf","source":"arxiv","key":"650157802aa7b85f53d36b1c672b375f","url":"https://inspirehep.net/files/650157802aa7b85f53d36b1c672b375f"},{"filename":"ernt3.png","caption":"ernt3.pdf","source":"arxiv","key":"ef6799d77127a2c1de47c52d015e7b97","url":"https://inspirehep.net/files/ef6799d77127a2c1de47c52d015e7b97"},{"filename":"ps1.png","caption":"ps1.pdf","source":"arxiv","key":"ae8a7b7a6b98c4d51b22ed3a2a071952","url":"https://inspirehep.net/files/ae8a7b7a6b98c4d51b22ed3a2a071952"},{"filename":"ernt4.png","caption":"ernt4.pdf","source":"arxiv","key":"53325f5f848ae38c94c5295e3b4df50d","url":"https://inspirehep.net/files/53325f5f848ae38c94c5295e3b4df50d"},{"filename":"ernt5.png","caption":"ernt5.pdf","source":"arxiv","key":"eeb35a183684334aa22f2ef5bfb00432","url":"https://inspirehep.net/files/eeb35a183684334aa22f2ef5bfb00432"},{"filename":"ernt6.png","caption":"ernt6.pdf","source":"arxiv","key":"4ac68164cfda77f3cdae5672c6c09552","url":"https://inspirehep.net/files/4ac68164cfda77f3cdae5672c6c09552"},{"filename":"ernt7.png","caption":"ernt7.pdf","source":"arxiv","key":"2e7e607eced361321921cb37490ce87a","url":"https://inspirehep.net/files/2e7e607eced361321921cb37490ce87a"},{"filename":"appendix.png","caption":"appendix.pdf","source":"arxiv","key":"768082d21149b93bbd88a9513ec059d7","url":"https://inspirehep.net/files/768082d21149b93bbd88a9513ec059d7"}],"legacy_version":"20210316095423.0","inspire_categories":[{"term":"Gravitation and Cosmology"},{"term":"Math and Math Physics"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/013meh722"}],"full_name":"Aretakis, Stefanos","last_name":"Aretakis","first_name":"Stefanos","recid":1069808},"control_number":931178,"dois":[{"value":"10.1007/s00220-011-1254-5"}],"document_type":["article"],"texkeys":["Aretakis:2011ha"],"abstracts":[{"source":"arXiv","value":"We study the problem of stability and instability of extreme Reissner-Nordstrom spacetimes for linear scalar perturbations. Specifically, we consider solutions to the linear wave equation on a suitable globally hyperbolic subset of such a spacetime, arising from regular initial data prescribed on a Cauchy hypersurface crossing the future event horizon. We obtain boundedness, decay and non-decay results. Our estimates hold up to and including the horizon. The fundamental new aspect of this problem is the degeneracy of the redshift on the event horizon. Several new analytical features of degenerate horizons are also presented.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["gr-qc"],"titles":[{"title":"Stability and Instability of Extreme Reissner-Nordström Black Hole Spacetimes for Linear Scalar Perturbations I"