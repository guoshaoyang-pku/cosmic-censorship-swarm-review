{"hits":{"hits":[{"updated":"2024-10-15T18:52:39.481268+00:00","created":"2019-12-03T00:00:00+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/1768142?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1768142?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1768142?format=latex-us","json":"https://inspirehep.net/api/literature/1768142?format=json","json-expanded":"https://inspirehep.net/api/literature/1768142?format=json-expanded","cv":"https://inspirehep.net/api/literature/1768142?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1768142"},"metadata":{"citation_count":61,"authors":[{"full_name_unicode_normalized":"gnedin, m.l.","full_name":"Gnedin, M.L.","record":{"$ref":"https://inspirehep.net/api/authors/2538588"},"ids":[{"schema":"INSPIRE BAI","value":"M.L.Gnedin.1"}],"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903404"},"value":"Rutgers U., Piscataway"}],"last_name":"Gnedin","signature_block":"GNADANm","uuid":"f164491f-0b20-4de9-9d6b-d48de21896b2","first_name":"M.L.","recid":2538588},{"full_name_unicode_normalized":"gnedin, n.y.","full_name":"Gnedin, N.Y.","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/1023505"},"ids":[{"schema":"INSPIRE BAI","value":"Nickolay.Y.Gnedin.1"}],"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903404"},"value":"Rutgers U., Piscataway"}],"last_name":"Gnedin","signature_block":"GNADANn","uuid":"af9c5653-bb5a-46f3-8222-426629bf33d6","first_name":"N.Y.","recid":1023505}],"citation_count_without_self_citations":61,"publication_info":[{"journal_volume":"10","page_end":"1102","year":1993,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214779"},"page_start":"1083","journal_issue":"6","journal_title":"Class.Quant.Grav."}],"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","number_of_pages":20,"legacy_version":"20191203194051.0","inspire_categories":[{"term":"Gravitation and Cosmology"}],"legacy_creation_date":"2019-12-03","author_count":2,"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/05vt9qd57"}],"full_name":"Gnedin, M.L.","last_name":"Gnedin","first_name":"M.L.","recid":2538588},"control_number":1768142,"dois":[{"value":"10.1088/0264-9381/10/6/006"}],"earliest_date":"1993-06-01","document_type":["article"],"texkeys":["Gnedin:1993nau"],"abstracts":[{"value":"The Cauchy horizon instability in the Reissner-Nordstrom solution is investigated numerically using (2+2) formalism. The formalism is based on the metric decomposition along two null coordinates parallel to the black hole horizons. The authors show that a spacelike singularity forms to prevent an observer's reaching the Cauchy horizon and the properties of the singularity are discussed in detail. They found that if the mass of the perturbation is of an order of or greater than the mass of the initial Reissner-Nordstrom black hole, the position of the singularity tends to those in the Schwarzschild solution. They also present a highly reliable numerical scheme based on the (2+2) formalism and discuss the properties of the initial value equations which in (2+2) formalism are reduced to linear equations."}],"titles":[{"source":"submitter","title":"Destruction of the Cauchy horizon in the Reissner-Nordstrom black hole"}],"facet_author_name":["1023505_Nickolay Y. Gnedin","2538588_M.L. Gnedin"],"core":false,"imprints":[{"date":"1993-06-01"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1768142","updated":"2024-10-15T18:52:39.481268"},"curated":true,"journal_title_variants":["Class. Quant. Grav.","Class.Quant.Grav."]},"id":"1768142"},{"updated":"2026-02-06T10:43:20.528104+00:00","created":"2011-10-10T00:00:00+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/931179?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/931179?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/931179?format=latex-us","json":"https://inspirehep.net/api/literature/931179?format=json","json-expanded":"https://inspirehep.net/api/literature/931179?format=json-expanded","cv":"https://inspirehep.net/api/literature/931179?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A931179"},"metadata":{"citation_count":127,"authors":[{"full_name_unicode_normalized":"aretakis, stefanos","full_name":"Aretakis, Stefanos","record":{"$ref":"https://inspirehep.net/api/authors/1069808"},"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/902712"},"value":"Cambridge U."}],"last_name":"Aretakis","ids":[{"schema":"INSPIRE BAI","value":"S.Aretakis.1"}],"signature_block":"ARATACs","uuid":"b07af8e8-4282-4d2b-b15e-01cc9dd88e96","first_name":"Stefanos","recid":1069808}],"citation_count_without_self_citations":113,"publication_info":[{"journal_volume":"12","page_end":"1538","year":2011,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1212474"},"page_start":"1491","journal_title":"Annales Henri Poincare"}],"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","keywords":[{"schema":"INSPIRE","value":"perturbation: scalar"},{"schema":"INSPIRE","value":"space-time: Reissner-Nordstroem"},{"schema":"INSPIRE","value":"black hole: Reissner-Nordstroem"},{"schema":"INSPIRE","value":"conservation law: hierarchy"},{"schema":"INSPIRE","value":"perturbation: linear"},{"schema":"INSPIRE","value":"space-time: stability"},{"schema":"INSPIRE","value":"horizon"},{"schema":"INSPIRE","value":"crossing"}],"references":[{"reference":{"publication_info":{"journal_volume":"256","artid":"1","page_start":"1","journal_title":"J.Funct.Anal."}}},{"reference":{"publication_info":{"journal_volume":"16","artid":"A23","page_start":"A23","journal_title":"Class.Quant.Grav."}}},{"reference":{"publication_info":{"journal_volume":"149","artid":"183","page_start":"183","journal_title":"Annals Math."}},"record":{"$ref":"https: