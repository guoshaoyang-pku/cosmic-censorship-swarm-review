{"metadata":{"publication_info":[{"cnum":"C09-07-12","page_end":"34","page_start":"24","parent_record":{"$ref":"https://inspirehep.net/api/literature/1197687"},"conference_record":{"$ref":"https://inspirehep.net/api/conferences/978993"}}],"citation_count":102,"citation_count_without_self_citations":102,"core":true,"dois":[{"value":"10.1142/9789814374552_0002"}],"titles":[{"title":"The Formation of Black Holes in General Relativity"},{"title":"The Formation of Black Holes in General Relativity","source":"arXiv"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"5bbc4a10-430d-4bb2-9655-82da74c663a6","record":{"$ref":"https://inspirehep.net/api/authors/1057433"},"full_name":"Christodoulou, Demetrios","affiliations":[{"value":"Zurich, ETH","record":{"$ref":"https://inspirehep.net/api/institutions/903369"}}],"signature_block":"CHRASTADALd"}],"curated":true,"texkeys":["Christodoulou:2008nj"],"citeable":true,"keywords":[{"value":"book","schema":"INSPIRE"},{"value":"gravitation: collapse","schema":"INSPIRE"},{"value":"field theory: scalar","schema":"INSPIRE"},{"value":"space-time: Minkowski","schema":"INSPIRE"},{"value":"space-time: curvature","schema":"INSPIRE"},{"value":"black hole: formation","schema":"INSPIRE"},{"value":"boundary condition","schema":"INSPIRE"},{"value":"general relativity","schema":"INSPIRE"},{"value":"current: Weyl","schema":"INSPIRE"},{"value":"geometry","schema":"INSPIRE"},{"value":"Einstein equation","schema":"INSPIRE"}],"abstracts":[{"value":"The subject of this work is the formation of black holes in pure general relativity, by the focusing of incoming gravitational waves. The theorems established in this monograph constitute the first foray into the long time dynamics of general relativity in the large, that is, when the initial data are no longer confined to a suitably small neighborhood of Minkowskian data. The theorems are general, no symmetry conditions on the initial data being imposed.","source":"arXiv"}],"ref