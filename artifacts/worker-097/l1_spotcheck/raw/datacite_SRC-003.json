{"data":{"id":"10.48550/arxiv.2204.09891","type":"dois","attributes":{"doi":"10.48550/arxiv.2204.09891","prefix":"10.48550","suffix":"arxiv.2204.09891","identifiers":[{"identifier":"2204.09891","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2204.09891"}],"creators":[{"name":"Shlapentokh-Rothman, Yakov","nameType":"Personal","givenName":"Yakov","familyName":"Shlapentokh-Rothman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Naked Singularities for the Einstein Vacuum Equations: The Interior Solution"}],"publisher":"arXiv","container":{},"publicationYear":2022,"subjects":[{"lang":"en","subject":"General Relativity and Quantum Cosmology (gr-qc)","subjectScheme":"arXiv"},{"lang":"en","subject":"Mathematical Physics (math-ph)","subjectScheme":"arXiv"},{"lang":"en","subject":"Analysis of PDEs (math.AP)","subjectScheme":"arXiv"},{"lang":"en","subject":"Differential Geometry (math.DG)","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2022-04-21T05:34:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2022-04-22T00:16:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2022-04","dateType":"Available","dateInformation":"v1"},{"date":"2022","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"In a previous work [I. Rodnianski and Y. Shlapentokh-Rothman, Naked Singularities for the Einstein Vacuum Equations: The Exterior Solution, arXiv:1912.08478] we constructed solutions to the Einstein vacuum equations in 3+1 dimensions which corresponded to the exterior region of a naked singularity. In this work we construct solutions which correspond to the interior region and show that the two solutions may be glued together to produce a naked singularity. Fundamental to our construction is the novel type of self-similarity for the Einstein vacuum equations that we introduced in our previous work and also the study of a new class of quasilinear PDE's of mixed degenerate elliptic-hyperbolic type.","descriptionType":"Abstract"},{"description":"166 pages, 5 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2204.09891","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2022-04-22T01:22:59.000Z","registered":"2022-04-22T01:23:00.000Z","published":"2022","updated":"2022-04-22T01:23:00.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2204.09891","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}