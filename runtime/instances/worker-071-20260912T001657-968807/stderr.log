def line_map(path):
    node = yaml.compose(Path(path).read_text())
    m={}
    def walk(n, p):
        if isinstance(n, yaml.MappingNode):
            for k,v in n.value:
                key = k.value
                path2 = f"{p}.{key}" if p else key
                m[path2] = v.start_mark.line+1
                walk(v, path2)
        elif isinstance(n, yaml.SequenceNode):
            for i,v in enumerate(n.value):
                walk(v, f"{p}[{i}]")
    walk(node, "")
    return m
```
