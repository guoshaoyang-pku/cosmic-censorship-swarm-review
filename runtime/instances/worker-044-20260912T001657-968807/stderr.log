```python
#!/usr/bin/env python3
"""Supplement to W044-F2B-INDEP-VERDICT-01: YAML document-integrity + cross-artifact binding
checks on the pinned snapshot, appended to report.json before events are emitted."""
import json, sys, hashlib
from pathlib import Path
import yaml

ROOT=parents[3]; OUT=...
rep=json.loads((OUT/'report.json').read_text())
snap = ROOT/rep['settled_revision']['snapshot_path']
text = snap.read_text()
checks = []

def duplicate_keys(text):
    """Find duplicate mapping keys per YAML mapping scope using a compose-based walk."""
    class DupLoader(yaml.SafeLoader): pass
    dups=[]
    def construct_mapping(loader, node, deep=False):
        keys=[]
        for k,v in node.value:
            key = loader.construct_object(k, deep=deep)
            if key in keys:
                dups.append((key, k.start_mark.line+1))
            else:
                keys.append(key)
        return yaml.SafeLoader.construct_mapping(loader, node, deep=deep)
    DupLoader.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, construct_mapping)
    yaml.load(text, Loader=DupLoader)
    return dups
```
