And add the function `file_prose_definition(doc, sym)`:
```python
def file_prose_definition(doc, sym):
    base = sym.split("_{")[0].split("^{")[0].lower()
    if len(base) < 5 or not re.fullmatch(r"[a-z][a-z_0-9']*", base):
        return None
    hits = []
    def walk(o, p):
        if isinstance(o, dict):
            for k, v in o.items():
                kl = str(k).lower()
                if ("definition" in kl or "meaning" in kl) and base in kl and isinstance(v, str) and len(v) > 10:
                    hits.append(f"{p}.{k}")
                walk(v, f"{p}.{k}")
        elif isinstance(o, list):
            for i, v in enumerate(o):
                walk(v, f"{p}[{i}]")
    walk(doc, "$")
    return hits[0] if hits else None
```
