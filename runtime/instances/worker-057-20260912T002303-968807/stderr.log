```python
def symbol_class(sym, local_defs, bound, taxonomy_text, file_raw):
    if sym in local_defs: return 'local_definition', local_defs[sym]
    if sym in bound: return 'bound_binder', None
    # taxonomy occurrence
    base = sym.split('_{')[0].split('^{')[0]
    if re.search(r'\b'+re.escape(base)+r'\b', taxonomy_text): 
        # find definition-ish context: line with 'maximal globally hyperbolic development (MGHD)'
        return 'taxonomy_prose_only', line
    return 'nowhere', None
```
