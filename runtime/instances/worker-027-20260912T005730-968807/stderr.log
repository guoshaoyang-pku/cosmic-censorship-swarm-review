def window_at(lines, needle, before=0, after=400):
    text = "\n".join(lines)
    i = text.find(needle)
    if i < 0: return None, None, None
    start = max(0, i - before)
    win = text[start:i+after]
    lineno = text.count("\n", 0, i) + 1
    return win, lineno, text
```
