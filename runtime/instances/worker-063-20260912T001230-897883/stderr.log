Registry resolution:
```python
def registry_match(token):
    tu=token.upper()
    for v in variants:
        parent=v['parent_class'].upper(); vid=v['variant_id'].upper()
        # exact
        if tu==f"{parent}-{vid}": return v,'exact'
        # delta stem
        dr=v.get('delta_ref');
        if dr:
            stem=Path(dr).stem.upper()  # AF-WCC-VAC-GEN-SET.delta
            stem=stem[:-5] if stem.endswith('.DELTA') else stem
            if tu==stem: return v,'delta_stem'
        # inserted
        parts=parent.split('-')
        for i in range(2,len(parts)):
            cand='-'.join(parts[:i]+[vid]+parts[i:])
            if tu==cand: return v,'inserted'
    return None
```
