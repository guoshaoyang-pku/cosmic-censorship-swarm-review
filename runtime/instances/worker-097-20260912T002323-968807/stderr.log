```python
def _resolve_one(doc, path):
    segs = path.split('.')
    return _resolve_segs(doc, segs)

def _resolve_segs(cur, segs):
    if not segs:
        return (True, cur)
    head, rest = segs[0], segs[1:]
    star = head.endswith('[*]')
    name = head[:-3] if star else head
    if star:
        if not isinstance(cur, list): return (False, None)
        vals=[]
        for item in cur:
            if isinstance(item, dict) and name in item:
                ok,v=_resolve_segs(item[name], rest)
                if ok: vals.append(v)
        if vals: return (True, vals)
        # also allow name=='' 
        return (False,None)
    if isinstance(cur, dict) and name in cur:
        return _resolve_segs(cur[name], rest)
    return (False, None)
```

