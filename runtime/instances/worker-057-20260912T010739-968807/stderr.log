def collect_py_paths(d):
    out=set()
    for path,v in walk(d):
        if isinstance(v,str):
            m=re.findall(r'[A-Za-z0-9_][A-Za-z0-9_./-]*\.py', v)
            score = 2 if any(t in path.lower() for t in ('instrument','harness','check','script','runner','method','tool')) else 1
            for p in m: out.add((score,p))
    return sorted(out, key=lambda x:(-x[0],x[1]))
```
