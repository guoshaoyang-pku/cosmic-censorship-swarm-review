Implementation of current-file enrichment:
```python
def _find_current_file(row):
    for p in sorted((ROOT/'reviews').glob('*.json')):
        try: d=json.loads(p.read_text())
        except: continue
        if not isinstance(d,dict) or d.get('reviewer')!=row['reviewer']: continue
        rid = d.get('review_id') or d.get('event_id')
        same_id = rid and row.get('review_id') and str(rid)==str(row['review_id'])
        same_ts = str(d.get('created_at') or '')==str(row.get('created_at') or '')
        same_tgt = str(d.get('target_id'))==str(row.get('target_id'))
        if same_id or (same_ts and same_tgt):
            return {'path':'reviews/'+p.name,'verdict':d.get('verdict'),'score':d.get('score'),
                    'sha256':sha256_file(p),'mtime':...}
    return None
```
