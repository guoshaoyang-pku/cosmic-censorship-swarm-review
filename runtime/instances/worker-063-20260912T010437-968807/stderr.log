```python
def key_paths(lines):
    # returns list of (path, indent, text)
    stack = []  # list of (indent, key)
    out = []
    for raw in lines:
        if not raw.strip() or raw.lstrip().startswith('#'):
            out.append(None); continue
        indent = len(raw) - len(raw.lstrip(' '))
        stripped = raw.strip()
        # pop stack while stack top indent >= indent
        while stack and stack[-1][0] >= indent:
            stack.pop()
        # determine key
        key, is_item = None, False
        if stripped.startswith('- '):
            body = stripped[2:].strip()
            if ':' in body:
                key = body.split(':',1)[0].strip().strip('"\'')
            else:
                # list scalar item; use index within parent list
                key = f"[{...}]"
                is_item = True
        elif ':' in stripped:
            key = stripped.split(':',1)[0].strip().strip('"\'')
        if key and not is_item:
            stack.append((indent, key))
            out.append('.'.join(k for _,k in stack))
        elif is_item:
            out.append('.'.join(k for _,k in stack))
        else:
            out.append('.'.join(k for _,k in stack) if stack else None)
    return out
```
