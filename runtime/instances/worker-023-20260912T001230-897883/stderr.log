#!/usr/bin/env python3
"""Independent N0 order-evidence reproduction (worker-023, unassigned bounded task)."""
from __future__ import annotations
import hashlib, json, math, os, platform, struct, subprocess, sys, time
from pathlib import Path
import numpy as np

ROOT = Path(__file__).resolve().parents[3]
HERE = Path(__file__).resolve().parent
REPL = ROOT / "numerics/tests/flat_wave_replication.py"
PINNED = ROOT / "numerics/tests/n0_order_4rung.json"
PRODUCER = ROOT / "numerics/tests/n0_order_4rung_addendum.py"
GUARD = ROOT / "numerics/tests/selfgravity_lock_guard.py"
DR = [0.2, 0.1, 0.05, 0.025]
SCHEMES = ["lffd", "cnfd", "cnfem"]
P_DECL = 2.0
TOL = 0.30
PINNED_REPL_SHA = "8ade1cdc163ea420790b9fdfdab41157b4f3d4219d6a0bcf827baafe69a6f422"
OUT = HERE / "n0_reproduction_report.json"

def sha256(p): ...
def bits(x): return struct.pack(">d", float(x)).hex()

def fit_and_delta(drs, errs):
    x = np.log(np.asarray(drs,float)); y = np.log(np.asarray(errs,float))
    slope, intercept = np.polyfit(x,y,1)
    pair=[]
    for i in range(len(drs)-1):
        pair.append(math.log(errs[i]/errs[i+1])/math.log(drs[i]/drs[i+1]))
    half=(max(pair)-min(pair))/2.0
    resid = y - (slope*x+intercept)
    dof=len(x)-2; sxx=float(np.sum((x-x.mean())**2))
    se=math.sqrt(float(np.sum(resid**2))/dof/sxx) if dof>0 and sxx>0 else float('nan')
    return {"fit_order":float(slope),"pair_orders":pair,"pair_half_range":half,"least_squares_se":se,"delta":max(half,se)}
```

