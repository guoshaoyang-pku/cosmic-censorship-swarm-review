`pair_row(...)`:
```python
def pair_row(path, *, kind, name, **meta):
    a = run_stage_a(path)
    fz = run_stage_b(FROZEN_B, path)
    fx = run_stage_b(FIXED_B, path)
    lost = (not fz["escaped"]) and fx["escaped"]
    gained = fz["escaped"] and (not fx["escaped"])
    row = {"fixture": name, "path": rel(path), "sha256": sha(path), "kind": kind,
           "stage_a": a, "stage_b_frozen": fz, "stage_b_fixed": fx,
           "frozen_union_caught": (not a["escaped"]) or (not fz["escaped"]),
           "fixed_union_caught": (not a["escaped"]) or (not fx["escaped"]),
           "lost_semantic_catch": lost, "gained_semantic_catch": gained,
           "frozen_failed_rules": fz["failed_rules"], "fixed_failed_rules": fx["failed_rules"],
           "rule_delta": sorted(set(fz["failed_rules"]) ^ set(fx["failed_rules"]))}
    row.update(meta)
    return row
```

