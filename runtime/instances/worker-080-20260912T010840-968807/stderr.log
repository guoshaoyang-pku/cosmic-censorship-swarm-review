```python
REGISTRY_CLAIM_RE = re.compile(r"VARIANT_REGISTRY|variant_id|parent_class|registered VARIANT", re.I)
def registry_claim(doc, variant_registry):
    text = str(doc.get('regularity',{}).get('must_not_conflate',[''])[0])
    if not REGISTRY_CLAIM_RE.search(text): return {'referenced': False, 'ok': None}
    own = doc.get('class_id')
    hits=[v for v in variant_registry.get('variants',[]) if v.get('variant_id')=='H2LOC' and v.get('parent_class')==own]
    return {'referenced': True, 'ok': bool(hits), 'matched': hits[0].get('variant_id') if hits else None}
```
