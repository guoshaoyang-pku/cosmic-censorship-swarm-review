```python
#!/usr/bin/env python3
"""W025-F0-BIND-01: independent G-F0 class-binding verification at the declared canonical F0.
Read-only. No artifact writes outside artifacts/worker-025/f0_binding_review/.
"""
import hashlib, json, re, subprocess, sys, time
from pathlib import Path
import yaml

ROOT = Path(__file__).resolve().parents[3]
OUT = Path(__file__).resolve().parent
RAW = OUT/'raw'; RAW.mkdir(parents=True, exist_ok=True)
CTRL = OUT/'controls'; CTRL.mkdir(parents=True, exist_ok=True)

CANON = ROOT/'research_map/formulation_taxonomy.yaml'
SUPP  = ROOT/'artifacts/formulation/formulation_taxonomy.yaml'
FROZEN= ROOT/'artifacts/formulation/FROZEN.json'
SCHEMAS = [ROOT/'schemas/af_wcc_vacuum.yaml', ROOT/'schemas/af_scc_c2_vacuum.yaml', ROOT/'schemas/af_scc_c0_vacuum.yaml']

def sha(p): return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def stat_rec(p):
    st=Path(p).stat(); return {'sha256':sha(p),'bytes':st.st_size,'mtime':time.strftime('%Y-%m-%dT%H:%M:%S%z',time.localtime(st.st_mtime))}

pins_before = {str(p.relative_to(ROOT)): stat_rec(p) for p in [CANON,SUPP,FROZEN]+SCHEMAS}

# strict duplicate-key loader
class DupLoader(yaml.SafeLoader): pass
def _construct_mapping(loader, node, deep=False):
    keys=[]
    for k_node,_ in node.value:
        k=loader.construct_object(k_node, deep=True)
        keys.append((k, k_node.start_mark.line+1))
    seen={}; dups=[]
    for k,ln in keys:
        if k in seen: dups.append({'key':str(k),'first_line':seen[k],'dup_line':ln})
        else: seen[k]=ln
    loader.dups=list(getattr(loader,'dups',[]))+dups
    return yaml.SafeLoader.construct_mapping(loader,node,deep)
DupLoader.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG,_construct_mapping)
def strict_load(text):
    ldr=DupLoader(text); ldr.dups=[]
    obj=yaml.load(text, Loader=DupLoader)  # hmm loader instance
```

Careful: `yaml.load(text, Loader=DupLoader)` creates an instance internally. To collect dups, I need to construct the loader myself:
```python
def strict_load(text):
    ldr=DupLoader(text)
    try:
        obj=ldr.get_single_data()
    finally:
        ldr.dispose()
    return obj, getattr(ldr,'dups',[])
```
DupLoader.__init__ sets self.dups? SafeLoader __init__ doesn't. I'll set ldr.dups=[] after creation. But _construct_mapping sets loader.dups = list(getattr(loader,'dups',[])) + dups — good.

