Let me implement using a line-index approach:
```python
def bump_header(text, now, note, cid, problems):
    lines = text.split("\n")
    # revision
    idx = [i for i,l in enumerate(lines) if l.strip()=="revision: 13"]
    if len(idx)!=1: problems.append(...); return text
    lines[idx[0]] = "revision: 14"
    # revised_at
    idx = [i for i,l in enumerate(lines) if l.startswith("revised_at:")]
    if len(idx)!=1: problems.append(...); return text
    lines[idx[0]] = f'revised_at: "{now}"'
    # revision_history append after last index: 11 entry
    idx = [i for i,l in enumerate(lines) if l.lstrip().startswith("- {index: 11,")]
    if len(idx)!=1: problems.append(...); return text
    newline = f'  - {{index: 12, at: "{now}", unused: false, notes: ["{note}"] }}'
    lines.insert(idx[0]+1, newline)
    return "\n".join(lines)
```
