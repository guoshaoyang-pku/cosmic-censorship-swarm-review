```python
def _in_brackets(text, start):
    # find nearest '[' before start without intervening ']'
    lb = text.rfind('[', 0, start)
    rb = text.rfind(']', 0, start)
    return lb > rb
```
And quote check with a heuristic quote-state machine:
```python
def _in_single_quotes(text, start):
    state=False
    i=0
    while i < start:
        c=text[i]
        if c=="'":
            # opening if next char is not space and prev char is space/(/[/:/start
            prev=text[i-1] if i>0 else ' '
            nxt=text[i+1] if i+1<len(text) else ' '
            if not state and (prev.isspace() or prev in "([{:" ) and not nxt.isspace():
                state=True
            elif state and (nxt.isspace() or nxt in ".,;:)]}" or nxt==''):
                state=False
        i+=1
    return state
```
