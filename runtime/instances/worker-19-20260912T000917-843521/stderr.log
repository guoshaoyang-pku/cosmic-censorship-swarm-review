def context_label(field, snippet):
    s = snippet.lower()
    if "must not be cited" in s or "assessed_no_binding" in s or "not attached" in s or "nor as class evidence" in s:
        return "negative_no_binding"
    if field in ("next_action",) and "bind to" in s: return "forward_reference_shorthand"
    if "should count" in s or "provisional" in s: return "open_question_shorthand"
    return "unclassified_shorthand"
```

