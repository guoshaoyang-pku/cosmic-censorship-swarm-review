#!/usr/bin/env python3
"""class_token_census.py — independent machine census of class tokens in the L0 ledger.

Assignment: astra-indep-1-CF5-ledger-verify (node L0, gate G-LIT)
...
"""
from __future__ import annotations
import csv, hashlib, json, re, sys, unicodedata
from datetime import datetime, timezone, timedelta
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
THEOREMS = ROOT/"ledger"/"theorems.jsonl"
CITATIONS = ROOT/"ledger"/"citation_audit.csv"
OUT = ROOT/"artifacts"/"flash-19"/"class_token_census.json"
FROZEN = ["AF-WCC-VAC-GEN","AF-SCC-C2-VAC-GEN","AF-SCC-C0-VAC-GEN","AF-WCC-SCALAR-SPH"]
CST = timezone(timedelta(hours=8))
TOKEN_RE = re.compile(r"AF-[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*", re.I)
SUP = {"⁰":"0","¹":"1","²":"2","³":"3"}
VARIANT_RE = re.compile(r"AF-[A-Za-z0-9^⁰¹²³{}-]*[⁰¹²³^][A-Za-z0-9^⁰¹²³{}-]*")
```

