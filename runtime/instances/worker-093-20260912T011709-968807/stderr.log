Strict binder implementation:

```python
VERDICTS={"accept","revise","reject","inconclusive"}
ALIASES={"F2B":"F2b","F2":"F2b","AF-SCC-C0-VAC-GEN":"F2b","F2b":"F2b"}
def targets(d):
    out=set()
    for k in ("target_id","target","target_subnode"):
        v=d.get(k)
        if isinstance(v,str): out.add(v)
        elif isinstance(v,dict):
            for k2 in ("target_id","target_subnode","subnode","node_id"):
                if isinstance(v.get(k2),str): out.add(v[k2])
    res=set()
    for t in out:
        u=t.strip()
        if u in ALIASES: res.add(ALIASES[u])
        elif u.upper() in ALIASES: res.add(ALIASES[u.upper()])
        elif "af_scc_c0" in u.lower(): res.add("F2b")
    return res
def pins(d):
    out=[]
    for k in ("artifact_sha256","reviewed_sha256","sha256","cited_sha256"):
        v=d.get(k)
        if isinstance(v,str): out.append(v.lower())
    for k in ("target","artifact"):
        v=d.get(k)
        if isinstance(v,dict):
            for k2 in ("sha256","artifact_sha256","reviewed_sha256"):
                if isinstance(v.get(k2),str): out.append(v[k2].lower())
    return out
def binds(d, h):
    h12=h[:12]
    return any(p[:12]==h12 or h.startswith(p[:12]) for p in pins(d))
def full(d): return d.get("counts_as_full_schema_verdict") is not False
```

