Enumeration: replicate `_scan_composite` for a claim statement in prose mode:
```python
def enumerate_claim_findings(mod, stmt):
    t = mod.norm(stmt)
    out=[]
    for m in mod._MERGE_PAT.finditer(t):
        lo,hi = max(0,m.start()-60), min(len(t), m.end()+60)
        ctx = t[lo:hi]
        if mod._BENIGN.search(t[max(0,m.start()-8):m.end()+8]):
            continue
        am = mod._MERGE_ASSERT.search(ctx)
        if am:
            before = ctx[:am.start()]
            if mod._NEG_BEFORE_ASSERT.search(before):
                continue
            out.append(dict(finding=f"CLASSSEP: composite C0/C2 asserted as one class in claims[?].statement: ...{ctx.strip()!r}", trigger=(m.start(),m.end()), window=(lo,hi), assert_span=(am.start()+lo, am.end()+lo), ctx=ctx))
        elif mod._PROHIBIT.search(ctx):
            continue
        elif mod._SPLIT.search(ctx):
            continue
        else:
            out.append(dict(finding=f"CLASSSEP: bare composite C0/C2 expression in claims[?].statement: ...{ctx.strip()!r}", ...))
    return out
```
