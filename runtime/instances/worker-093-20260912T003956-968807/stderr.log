```python
def enum_findings(mod, obj, where):
    out=[]
    if not isinstance(obj,dict): return out
    class_id=str(obj.get("class_id") or "")
    for key,val in obj.items():
        if key in ("class_id","class_ids"):
            ids=[]; mod._scan_class_ids(val,f"{where}.{key}",ids)
            for s in ids: out.append({"finding":s,"kind":"classid","trigger":None})
            continue
        if key not in mod.DECLARATION_KEYS: continue
        if isinstance(val,str):
            out += enum_composite(mod,val,f"{where}.{key}",mode="prose")
            if key in ("conclusion","conclusion_type","scope","scope_statement"):
                c=[]; mod._scan_conclusion(val,class_id,f"{where}.{key}",c)
                for s in c: out.append({"finding":s,"kind":"conclusion","trigger":None})
        elif isinstance(val,list):
            for i,v in enumerate(val):
                if isinstance(v,str):
                    out += enum_composite(mod,v,f"{where}.{key}[{i}]",mode="prose")
    return out
```
