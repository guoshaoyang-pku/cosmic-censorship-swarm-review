```python
def run_tool_json(sandbox, rel_tool, args, out_path):
    rec = cmd([...], cwd=sandbox)
    outp = Path(out_path)
    rec["output_path"] = str(outp.relative_to(ROOT)) if outp.is_absolute() and str(outp).startswith(str(ROOT)) else str(outp)
    rec["output_exists"] = outp.exists()
    rec["output"] = json.loads(outp.read_text()) if outp.exists() else None
    return rec
```
