import argparse, importlib.util, json, hashlib, os, sys
from pathlib import Path
from datetime import datetime, timezone, timedelta

ROOT = Path(__file__).resolve().parents[3]  # artifacts/worker-028/review_accept_census -> repo root
CST = timezone(timedelta(hours=8))
def now(): return datetime.now(CST).isoformat(timespec="seconds")
def sha256_file(p): ...

def load_lifecycle():
    spec = importlib.util.spec_from_file_location("astra_lifecycle_for_census", ROOT/"research_map"/"astra_lifecycle.py")
    mod = importlib.util.module_from_spec(spec); spec.loader.exec_module(mod); return mod

AL = load_lifecycle()
VERDICT_KINDS = AL.VERDICT_KINDS

def parse_ts(s):  # None-safe ISO parse
def file_entry(rp):  # {"file","path","sha256","mtime","bytes"}

def scan_corpus(reviews_dir, measured, include_files=None):
    """Re-implementation of AL.review_coverage's file loop, returning rich entries."""
    entries=[]
    for rp in sorted(reviews_dir.glob("*.json")):
        try: d=json.loads(rp.read_text())
        except: continue
        v=str(d.get("verdict","")).lower()
        if v not in VERDICT_KINDS: continue
        reviewer=str(d.get("reviewer") or d.get("actor") or "?")
        full=d.get("counts_as_full_schema_verdict") is not False
        pins=AL._explicit_pins(d)
        for t in AL._targets_in_review(d):
            if t not in measured: continue
            h=(measured.get(t,{}).get("sha256") or "")
            if h and any(p.startswith(h[:12]) or h.startswith(p[:12]) for p in pins):
                entries.append({... target:t, ...})
    return entries
