- supersession resolution:
  ```
  def resolve(entries):
      # index by basename
      byname = {e['file']: e for e in entries}
      withdrawn = {}  # file -> record
      # explicit pointers
      for e in entries:
          sup = e.get('supersedes')
          targets = []
          if isinstance(sup, dict):
              if isinstance(sup.get('path'), str): targets.append(basename(sup['path']))
              # also list-valued path
          elif isinstance(sup, str): targets.append(basename(sup))
          elif isinstance(sup, list): ...
          for name in targets:
              a = byname.get(name)
              if a and a['verdict']=='accept' and e['verdict']!='accept' and a['target']==e['target'] and a['reviewer']==e['reviewer']:
                  withdrawn[a['file']] = {rule:'explicit-supersedes-path', by: e['file']}
      # implicit same reviewer+target later non-accept
      groups = group by (target, reviewer)
      for g in groups:
          accepts = [e for e in g if e['verdict']=='accept' and full]
          for a in accepts:
              later = [e for e in g if e is not a and e['verdict']!='accept' and order_key(e) > order_key(a)]
              if later and a['file'] not in withdrawn:
                  withdrawn[a['file']] = {rule:'same-reviewer-later-non-accept', by: min(later, key=order_key)['file']}
  ```
