class Snapshot:
    def __init__(self):
        self.at = datetime.now(CST).isoformat(timespec="seconds")
        self._b = {}
    def read(self, rel):
        if rel not in self._b:
            p = ROOT/rel
            if p.is_file():
                b = p.read_bytes()
                self._b[rel] = {"exists": True, "bytes": b, "sha256": hashlib.sha256(b).hexdigest(),
                                "bytes_len": len(b), "mtime": datetime.fromtimestamp(p.stat().st_mtime, CST).isoformat(timespec="seconds")}
            else:
                self._b[rel] = {"exists": False, "bytes": None, "sha256": None, "bytes_len": None, "mtime": None}
        return self._b[rel]
    def text(self, rel): r=self.read(rel); return r["bytes"].decode("utf-8", "replace") if r["exists"] else None
    def yaml(self, rel): ...
