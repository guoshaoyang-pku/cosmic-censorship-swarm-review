Anchor resolver:
```python
def resolve_anchor(rel, anchor, snap):
    r = snap.read(rel)
    if not r["exists"]: return False, "file missing"
    txt = snap.text(rel)
    if anchor is None: return True, "no anchor"
    suffix = Path(rel).suffix.lower()
    if suffix in (".yaml",".yml",".json"):
        try: obj=yaml.safe_load(txt) if suffix!=".json" else json.loads(txt)
        except Exception as e: return False, f"parse error {e}"
        cur=obj
        for part in anchor.split("."):
            if isinstance(cur,dict) and part in cur: cur=cur[part]
            elif isinstance(cur,list):
                # numeric index
                try: cur=cur[int(part)]
                except: return False, f"anchor segment {part!r} not found"
            else: return False, f"anchor segment {part!r} not found"
        return True, "anchor resolves"
    if suffix==".jsonl":
        for line in txt.splitlines():
            try: o=json.loads(line)
            except: continue
            if str(o.get("theorem_id") or o.get("id") or "")==anchor: return True,"row found"
        return False,"no jsonl row with id"
    if suffix==".csv":
        rd=csv.reader(io.StringIO(txt))
        for row in rd:
            if anchor in row: return True,"value found"
        return False,"no csv cell with value"
    # fallback: literal
    return (anchor in txt), "literal substring" if anchor in txt else "anchor not found"
```

