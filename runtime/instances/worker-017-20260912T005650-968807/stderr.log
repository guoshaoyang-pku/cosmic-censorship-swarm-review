```python
def drop_line(text, needle, newline):
    lines = text.splitlines()
    out=[]
    hit=0
    for l in lines:
        if needle in l and hit==0:
            out.append(newline); hit+=1
        else:
            out.append(l)
    assert hit==1
    return "\n".join(out)+"\n"
```
