def parse_chain(text):
    # returns list of (superset, subset) pairs for "E_A contains E_B" and "E_A subset of E_B"
    pairs=[]
    t=text.replace("{","").replace("}","")
    for m in re.finditer(r"E_([A-Za-z0-9^,]+)\s+contains\s+E_([A-Za-z0-9^,]+)", t):
        pairs.append((norm(m.group(1)), norm(m.group(2))))
    for m in re.finditer(r"E_([A-Za-z0-9^,]+)\s+subset(?:\s+of)?\s+E_([A-Za-z0-9^,]+)", t):
        pairs.append((norm(m.group(2)), norm(m.group(1))))
    return pairs
```
