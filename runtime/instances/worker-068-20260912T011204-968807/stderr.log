def flatten(doc, prefix=""):
  out={}
  if isinstance(doc, dict):
    if not doc: out[prefix]= "<empty-map>"  # hmm, empty containers as leaves
    for k,v in doc.items(): out.update(flatten(v, f"{prefix}.{k}" if prefix else str(k)))
  elif isinstance(doc, list):
    if not doc: out[prefix]="<empty-list>"
    for i,v in enumerate(doc): out.update(flatten(v, f"{prefix}[{i}]"))
  else:
    out[prefix]=doc
  return out
