```python
#!/usr/bin/env python3
"""W092-A0-HF03-STAGING-RECOUNT-01 ..."""
import json, hashlib, re
from pathlib import Path

ROOT = Path('/data3/guoshaoyang/workdir/ai4math-swarm')  # or derive from __file__
ART = ROOT/'evaluation/A0_detector_scope_adjudication.json'
SCAN = ['artifacts','comms/outbox','ledger']

SCOPE_KEYS = ('matter_model','cosmological_constant','dimension','symmetry')

def iter_json_objects(p):
    # JSONL: one object per line; JSON: whole doc (list or dict)
    text = p.read_text(errors='replace')
    if p.suffix == '.jsonl':
        for line in text.splitlines():
            line=line.strip()
            if not line: continue
            try: yield json.loads(line)
            except: continue
    else:
        try: obj=json.loads(text)
        except: return
        if isinstance(obj, list): yield from (x for x in obj if isinstance(x,dict))
        elif isinstance(obj,dict): yield obj
```

