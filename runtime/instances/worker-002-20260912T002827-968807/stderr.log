Fix as planned: determine set-based first, and only treat `jminus_q` as single-q evidence when not preceded by "union of" / "over all q". Implementation:

```python
def visibility_reading(text):
    t = normalize(text)
    union = bool(re.search(r"union of (the sets )?j|over all q( in i\+)?|jminus_iplus", t))
    single = bool(re.search(r"single-q|tail predicate|tail gamma|contained in j\^?-\(q|jminus_q", t))
    variant_note = bool(re.search(r"registered as variant|is variant|set-based reading|superseded|strictly stronger", t))
    if union and single and variant_note: return "single_q_with_set_based_variant_note"
    if union and single:
        # ambiguous: union phrase is the asserted predicate unless a tail marker is explicit
        if re.search(r"single-q|tail predicate|tail gamma", t): return "single_q_tail"
        return "set_based"
    if union: return "set_based"
    if single: return "single_q_tail"
    return "unspecified"
```

