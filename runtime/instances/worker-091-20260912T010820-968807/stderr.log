def flatten(obj, prefix=""):
    out={}
    if isinstance(obj, dict):
        for k,v in obj.items(): out.update(flatten(v, f"{prefix}.{k}" if prefix else str(k)))
    elif isinstance(obj, list):
        for i,v in enumerate(obj): out.update(flatten(v, f"{prefix}[{i}]"))
    else: out[prefix]=obj
    return out
```
