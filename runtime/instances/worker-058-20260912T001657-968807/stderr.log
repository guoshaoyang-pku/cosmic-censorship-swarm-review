Kahn:
```python
def close_rank(edges):
    nodes = sorted({n for e in edges for n in e})
    es = sorted(set(edges))
    problems=[]
    for a,b in es:
        if a==b: problems.append(self)
        if (b,a) in set(es): problems.append(contradictory)
    adj={n:set() for n in nodes}; indeg={n:0 for n in nodes}
    for a,b in es:
        if a==b: continue
        if b not in adj[a]:
            adj[a].add(b); indeg[b]+=1
    from collections import deque
    q=deque(sorted(n for n in nodes if indeg[n]==0))
    topo=[]
    while q:
        n=q.popleft(); topo.append(n)
        for m in sorted(adj[n]):
            indeg[m]-=1
            if indeg[m]==0: q.append(m)
    if len(topo)!=len(nodes):
        problems.append("containment cycle involving: "+", ".join(sorted(set(nodes)-set(topo))))
    rank={n:0 for n in nodes}
    for n in topo:
        for m in adj[n]:
            rank[m]=max(rank[m], rank[n]+1)
    return rank, problems
```
