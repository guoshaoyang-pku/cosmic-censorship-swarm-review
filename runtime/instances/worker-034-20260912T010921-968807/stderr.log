Leaf diff:
```python
def leaf_diff(a, b, ptr=""):
    out=[]
    if type(a)!=type(b):
        out.append((ptr, a, b)); return out
    if isinstance(a, dict):
        for k in sorted(set(a)|set(b)):
            if k not in a: out.append((ptr+"/"+k, "<missing>", b[k]))
            elif k not in b: out.append((ptr+"/"+k, a[k], "<missing>"))
            else: out += leaf_diff(a[k], b[k], ptr+"/"+k)
    elif isinstance(a, list):
        if len(a)!=len(b): out.append((ptr+"/<len>", len(a), len(b)))
        for i in range(min(len(a),len(b))):
            out += leaf_diff(a[i], b[i], ptr+"/"+str(i))
    else:
        if a!=b: out.append((ptr, a, b))
    return out
```
