```python
def symbol_fits():
    th = np.linspace(0.02,0.2,400)
    fd = -4*np.sin(th/2)**2/th**2       # normalized by h^2
    fem = -6*(1-np.cos(th))/(th**2*(2+np.cos(th)))
    # r = symbol/(-k^2) - 1 where -k^2 = -(th/h)^2 -> symbol_h2/(-th^2) - 1
    r_fd = fd/(-th**2) - 1
    r_fem = fem/(-th**2) - 1
    slope_fd = float(np.polyfit(th**2, r_fd, 1)[0])
    slope_fem = float(np.polyfit(th**2, r_fem, 1)[0])
```
