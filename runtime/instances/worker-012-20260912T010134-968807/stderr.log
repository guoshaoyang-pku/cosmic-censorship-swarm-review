#!/usr/bin/env python3
from __future__ import annotations
import hashlib, importlib.util, json, math, platform, sys, time
from pathlib import Path
import numpy as np

HERE = Path(__file__).resolve().parent
REPO = HERE.parents[2]   # .../ai4math-swarm
sys.dont_write_bytecode = True

PINS = {...}
CASES_DECLARED = [(0.2,1e-3),(0.1,1e-3)]
CASES_CERTIFIED = [(0.2,1e-4),(0.1,1e-4),(0.05,1e-4)]
R_MAX, T_END = 30.0, 6.0
FROZEN_REL = 'numerics/tests/flat_wave_replication.py'
FROZEN_SHA = '8ade1cdc...'

def sha256_file(p): return hashlib.sha256(p.read_bytes()).hexdigest()

def load_frozen():
    src = REPO/FROZEN_REL
    measured = sha256_file(src)
    snap = HERE/'raw'/f'frozen_flat_wave_replication_{FROZEN_SHA[:12]}.py'
    snap.write_bytes(src.read_bytes())
    assert sha256_file(snap)==FROZEN_SHA==measured
    spec = importlib.util.spec_from_file_location('frozen_flat_wave_replication_snapshot', snap)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod, measured, snap

def corr(a,b):
    # Pearson via np.corrcoef (independent of the generator's centered-sum code)
    return float(np.corrcoef(a,b)[0,1])

def sign_agree(a,b):
    w = np.abs(a)+np.abs(b)
    tot = float(w.sum())
    return float(w[np.sign(a)==np.sign(b)].sum()/tot) if tot>0 else float('nan')

def case_stats(mod, dr, dt):
    pulse = mod.PulseExact()
    fields, errs, final_t, steps = {}, {}, None, None
    for s in ('lffd','cnfd','cnfem'):
        case = mod.run_case(mod.make_factory(s, pulse=pulse), dr, dt/dr, R_MAX, T_END)
        r = case['r']; exact = pulse.psi(r, case['t'][-1]); e = case['psi'][-1]-exact
        fields[s]=e; errs[s]=float(np.sqrt(np.sum(e*e)*dr)); final_t=float(case['t'][-1]); steps=int(case['steps'])
    pairs={}
    for a,b in (('lffd','cnfd'),('cnfd','cnfem'),('lffd','cnfem')):
        pairs[f'{a}_vs_{b}']={'corr':corr(fields[a],fields[b]),
                              'cosine':float(np.dot(fields[a],fields[b])/(np.linalg.norm(fields[a])*np.linalg.norm(fields[b]))),
                              'sign_agreement_mass_fraction':sign_agree(fields[a],fields[b]),
                              'norm_ratio':errs[a]/errs[b]}
    spread=float((max(errs.values())-min(errs.values()))/np.mean(list(errs.values())))
    return {'dr':dr,'dt':dt,'final_t':final_t,'steps':steps,'l2_error':errs,'spread_relative':spread,'pairwise':pairs}, fields
```

