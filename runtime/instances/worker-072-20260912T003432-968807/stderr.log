Strict loader:
```python
def strict_yaml_load(path):
    dups=[]
    class L(yaml.SafeLoader): pass
    def cm(loader,node,deep=False):
        keys=[]
        for k,v in node.value:
            key=loader.construct_object(k,deep=deep)
            if key in keys: dups.append(str(key))
            keys.append(key)
        return yaml.SafeLoader.construct_mapping(loader,node,deep)
    L.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, cm)
    return yaml.load(open(path,encoding='utf-8'), Loader=L), dups
```

