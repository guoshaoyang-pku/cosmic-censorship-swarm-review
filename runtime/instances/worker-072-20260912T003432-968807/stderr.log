def predicate_flavor(text):
    t=text.lower()
    tail=all(re.search(m,t) for m in [r"future-inextendible causal geodesic", r"tail", r"not contained"]) 
    setonly = bool(re.search(r"j\^?-?\s*\(?\s*i\+", t)) and not tail
    return {"tail_predicate": tail, "set_only": setonly}
