```python
def _tainted_names(scope, src):
    t = set()
    for node in ast.walk(scope):
        if isinstance(node, ast.Assign):
            val = _src(src, node.value)
            for tgt in node.targets:
                if isinstance(tgt, ast.Name):
                    if HASHISH.search(tgt.id) or HASHISH.search(val) or re.search(r'\b[0-9a-f]{64}\b', val):
                        t.add(tgt.id)
        elif isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name):
            val = _src(src, node.value) if node.value is not None else ""
            if HASHISH.search(node.target.id) or HASHISH.search(val) or re.search(r'\b[0-9a-f]{64}\b', val):
                t.add(node.target.id)
        elif isinstance(node, ast.arg) and HASHISH.search(node.arg):
            t.add(node.arg)
    return t
```
