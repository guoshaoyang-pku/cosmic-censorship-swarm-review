def run_checker(checker: Path, root: Path, selftest=False, cwd=REPO):
    cmd = [sys.executable, str(checker), '--root', str(root)] if not selftest else [sys.executable, str(checker), '--selftest']
    cp = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    out = parse(cp.stdout)
    return {'exit': cp.returncode, 'stdout_tail': ..., 'verdict': out.get('verdict'), 'classes': {c['class_id']: {'verdict':..., 'B7':...,'hard_failures':[...]} }}
```
