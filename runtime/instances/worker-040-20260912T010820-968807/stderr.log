def quoted_spans(t):
    spans=[]
    for a,b in (('"','"'),("'","'"),("“","”"),("‘","’"),("«","»")):
        for m in re.finditer(re.escape(a)+r"(.*?)"+re.escape(b), t, re.S):
            spans.append((m.start(), m.end()))
    return spans
```
