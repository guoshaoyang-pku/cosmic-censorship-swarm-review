Clause splitting:
```python
def split_clauses(sent):
    # tokenize with quote awareness
    parts=[]; buf=[]; depth=0; quote=None; i=0
    while i < len(sent):
        ch=sent[i]
        if quote:
            buf.append(ch)
            if ch==quote: quote=None
            i+=1; continue
        if ch in "\"'“‘«":
            quote = {'"':'"',"'":"'","“":"”","‘":"’","«":"»"}[ch]
            buf.append(ch); i+=1; continue
        if ch in "([": depth+=1
        if ch in ")]": depth=max(0,depth-1)
        if depth==0 and ch in ";:!?":
            parts.append("".join(buf)); buf=[]; i+=1; continue
        if depth==0 and ch==".":
            # sentence end if followed by space+capital or end
            if i+1>=len(sent) or (sent[i+1]==" " and i+2<len(sent) and sent[i+2].isupper()):
                parts.append("".join(buf)); buf=[]; i+=1; continue
        if depth==0 and sent.startswith(" -- ",i):
            parts.append("".join(buf)); buf=[]; i+=4; continue
        # comma before contrastive conjunction
        if depth==0 and ch==",":
            rest=sent[i+1:].lstrip()
            if re.match(r"(?:but|yet|so|whereas|while|although|though|then|and\s+(?:then|now|we|the|C0|c0|adopted|one))\b", rest, re.I):
                parts.append("".join(buf)); buf=[]; i+=1; continue
        buf.append(ch); i+=1
    parts.append("".join(buf))
    return [p.strip() for p in parts if p.strip()]
```

