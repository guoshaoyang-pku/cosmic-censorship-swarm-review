_JOIN = r"(?:or|and|/|,|\+|&|vs\.?|\s)"
COMPOSITE_RE = re.compile(rf"(?:{_C0}\s*{_JOIN}\s*{_C2}|{_C2}\s*{_JOIN}\s*{_C0}|c0c2|c2c0)", re.I)
MERGE_ADJ = r"(?:merged|unified|combined|single|one|joint)"
MERGE_NOUN = r"(?:class|classes|schema|schemas|regularit(?:y|ies)|label|labels|unit|composite|family|families|table|bookkeeping)"
MERGE_HEAD_RE = re.compile(rf"(?:{COMPOSITE_RE.pattern})\s*(?:{MERGE_ADJ}\s*)?{MERGE_NOUN}|{MERGE_ADJ}\s+(?:{COMPOSITE_RE.pattern})\s*{MERGE_NOUN}", re.I)
