Generic parse:
```python
def parse_generic(body, ctype):
    text = body.decode('utf-8','replace')
    out={}
    if 'json' in ctype or text.lstrip()[:1] in '[{':
        try:
            j=json.loads(text)
        except: j=None
        if isinstance(j,dict):
            md = j.get('metadata') if isinstance(j.get('metadata'),dict) else j
            # inspire
            t = md.get('titles')
            if isinstance(t,list) and t: out['title']=t[0].get('title','')
            if not out.get('title') and isinstance(md.get('title'),list) and md['title']: out['title']=md['title'][0]
            if not out.get('title') and isinstance(md.get('title'),str): out['title']=md['title']
            abs_ = md.get('abstracts')
            if isinstance(abs_,list) and abs_: out['abstract']=re.sub('<[^>]+>',' ',abs_[0].get('value',''))
            if not out.get('abstract') and isinstance(md.get('abstract'),str): out['abstract']=re.sub('<[^>]+>',' ',md['abstract'])
            au = md.get('authors')
            if isinstance(au,list):
                names=[]
                for a in au:
                    if isinstance(a,dict):
                        names.append(a.get('full_name') or a.get('name') or f"{a.get('given','')} {a.get('family','')}".strip())
                    elif isinstance(a,str): names.append(a)
                out['authors']=[n for n in names if n]
            dates=[]
            for k in ('earliest_date','date','published'):
                v=md.get(k)
                if isinstance(v,str) and v[:4].isdigit(): dates.append(int(v[:4]))
            for pi in (md.get('publication_info') or []):
                if isinstance(pi,dict) and isinstance(pi.get('year'),int): dates.append(pi['year'])
            out['years']=sorted(set(dates))
    if not out.get('title'):
        # HTML meta
        html=text
        def meta(name):
            m=re.search(rf'<meta\s+(?:name|property)="{re.escape(name)}"\s+content="([^"]*)"', html, re.I)
            return m.group(1) if m else ""
        out['title']=meta('citation_title') or meta('og:title') or (re.search(r'<title[^>]*>(.*?)</title>',html,re.S|re.I).group(1).strip() if re.search(...) else '')
        out['authors']=re.findall(r'<meta\s+name="citation_author"\s+content="([^"]*)"',html,re.I)
        m=re.search(r'<blockquote class="abstract[^"]*">(.*?)</blockquote>',html,re.S)
        ab = re.sub('<[^>]+>',' ',m.group(1)) if m else (meta('description') or meta('og:description'))
        out['abstract']=' '.join(ab.split())
        d=meta('citation_date') or meta('citation_online_date')
        out['years']=[int(d[:4])] if d[:4].isdigit() else []
    return out
```

