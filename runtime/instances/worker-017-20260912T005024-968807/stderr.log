#!/usr/bin/env python3
"""Independent bounded check of F2a (AF-SCC-C2-VAC-GEN) at the measured canonical hash.
Read-only on canonical paths. Writes only the report under its own --out path.
"""
import argparse, copy, hashlib, json, re, sys
from datetime import datetime, timezone, timedelta
from pathlib import Path
import yaml

ROOT = Path(__file__).resolve().parents[3]   # artifacts/worker-017/f2a_review/check_f2a.py -> swarm root
TZ = timezone(timedelta(hours=8))
def now(): return datetime.now(TZ).isoformat(timespec="seconds")
def sha(p): return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def load_yaml(p): return yaml.safe_load(Path(p).read_text())
def load_json(p): return json.loads(Path(p).read_text())
```

