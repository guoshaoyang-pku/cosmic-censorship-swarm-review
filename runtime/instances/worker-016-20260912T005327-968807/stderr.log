#!/usr/bin/env python3
"""W16-REV29-CORPUS-REBIND-01 ..."""
from __future__ import annotations
import hashlib, json, shutil, subprocess, sys, time
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[2]
STAGE = HERE / "stage"
OUT = HERE / "out"
SNAP = HERE / "snapshot_at_start.json"

def sha256(p): ...
def read_json(p): ...
def run(cmd, cwd): ...

INPUTS = [...list of 20 paths...]

# load pins from snapshot
snap = json.loads(SNAP.read_text())
PINNED = {p: v["sha256"] for p,v in snap["paths"].items()}
FROZEN_SHA = snap["frozen"]["self_sha256"]

def live_hash(relpath): return sha256(ROOT/relpath)

def check_snapshot():
    drift = []
    for p,h in PINNED.items():
        lh = live_hash(p)
        if lh != h: drift.append({"path":p,"snapshot":h,"live":lh})
    return drift
```

