```python
def line_of(raw_lines, text, start=1):
    frag = re.sub(r'\s+',' ',text.strip())[:48]
    for i,l in enumerate(raw_lines,1):
        if frag and frag in re.sub(r'\s+',' ',l): return i
    frag2 = re.sub(r'\s+',' ',text.strip())[:24]
    for i,l in enumerate(raw_lines,1):
        if frag2 and frag2 in re.sub(r'\s+',' ',l): return i
    return None
```

