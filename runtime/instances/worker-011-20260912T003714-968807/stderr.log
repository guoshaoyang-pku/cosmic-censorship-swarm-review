Preorder enumeration:
```python
def preorders(n):
    # matrices as tuple of rows bitmask
    out=[]
    bits = [(i,j) for i in range(n) for j in range(n) if i!=j]
    # reflexive; enumerate off-diagonal
    for mask in range(1<<len(bits)):
        R=[[False]*n for _ in range(n)]
        for i in range(n): R[i][i]=True
        for k,(i,j) in enumerate(bits):
            if mask>>k & 1: R[i][j]=True
        # transitivity
        ok=True
        for i in range(n):
            for j in range(n):
                if R[i][j]:
                    for k in range(n):
                        if R[j][k] and not R[i][k]: ok=False;break
                    if not ok: break
            if not ok: break
        if ok:
            out.append(tuple(sum((1<<k) for k in range(n) if R[i][k]) for i in range(n)))
    return out
```
