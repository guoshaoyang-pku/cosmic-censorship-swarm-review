#!/usr/bin/env python3
"""..."""
from __future__ import annotations
import argparse, hashlib, json, re, sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
PIN_GATES = "fcd1d70991b6eade..."
PIN_PROTOCOL = "1e6cdf04..."
WITHDRAW_RE = re.compile(r'withdraw|retract', re.I)
HEX_RE = re.compile(r'\b[0-9a-f]{12,64}\b', re.I)

def sha256_bytes(b): ...
def sha256_file(p): ...
def canon(o): return json.dumps(o, sort_keys=True, separators=(',',':'), default=str)

def parse_ts(s): ...

def load_snapshot():
    sys.path.insert(0,str(ROOT))
    import numerics.gates as G
    gates_sha = sha256_file(ROOT/'numerics/gates.py')
    protocol_sha = sha256_file(ROOT/'numerics/CONVERGENCE_PROTOCOL.md')
    events = G.load_event_stream(ROOT)
    # dedup by event_id keeping first occurrence (evaluator dedups inside _protocol_review)
    return G, gates_sha, protocol_sha, events

def protocol_review_events(G, events):
    out=[]
    for i,e in enumerate(events):
        if e.get('event_type')!='review': continue
        if e.get('verdict') not in ('accept','revise','reject'): continue
        if not G._targets_protocol(str(e.get('target_id',''))): continue
        if e.get('reviewer')==G.PROTOCOL_REVIEW_SELF: continue
        out.append((i,e))
    # dedup event_id
    seen=set(); ded=[]
    for i,e in out:
        eid=str(e.get('event_id') or '')
        if eid and eid in seen: continue
        if eid: seen.add(eid)
        ded.append((i,e))
    return ded

def cited_prose_hashes(e):
    # fields that carry prose
    prose=[]
    for k in ('summary','statement','description','findings'):
        v=e.get(k)
        if isinstance(v,str): prose.append(v)
        elif isinstance(v,(list,dict)): prose.append(json.dumps(v))
    txt=' '.join(prose)
    return [h.lower() for h in HEX_RE.findall(txt)]

def bind(G,e,protocol_sha):
    cited=[c.lower() for c in G._review_cited_hashes(e)]
    return any(protocol_sha.startswith(c) or c.startswith(protocol_sha) for c in cited), cited

def binds_with_prose(e,protocol_sha):
    b,cited=bind(G,e,protocol_sha)
    prose=cited_prose_hashes(e)
    pb=any(protocol_sha.startswith(c) or c.startswith(protocol_sha) for c in prose)
    return (b or pb), cited, prose, pb
```

