```python
# --- clause-scoped mention frames (candidate guard) ---
_CLAUSE_END = re.compile(r"[.;:!?\n]")

def _clause_bounds(t, i):
    """[start,end) of the clause containing position i (boundaries at . ; : ! ? newline)."""
    start = 0
    for m in _CLAUSE_END.finditer(t, 0, i):
        start = m.end()
    m = _CLAUSE_END.search(t, i)
    end = m.start() if m else len(t)
    return start, end

def _same_clause(t, i, j):
    si, ei = _clause_bounds(t, i)  # hmm, easier: no boundary strictly between i and j
    return _CLAUSE_END.search(t, min(i,j), max(i,j)) is None
```

