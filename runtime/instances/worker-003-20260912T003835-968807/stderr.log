        s = lines[j]
        if not s.strip() or s.lstrip().startswith("#"): continue
        m = KEY_RE.match(s)
        if m and len(m.group(1)) < ind:
            return m.group(2)
    return None

def live(line):
    s = re.sub(r"\[[^\]]*\]", " ", line)
    s = re.sub(r"'[^']*'", " ", s)
    return s

def chain_desc(text):
    """Parse 'E_A contains E_B contains ...' or 'E_X subset of E_Y ...' (0-based arg: text)"""
    m = re.search(r"E_C0 contains E_H2loc contains E_\{?C\^?1,1\}? contains E_C2", text)
    if m: return ["C0","H2LOC","C11","C2"]
    m = re.search(r"E_C2 subset of E_\{?C\^?1,1\}? subset of E_H2loc subset of E_C0", text)
    if m: return ["C2","C11","H2LOC","C0"]  # ascending
    return None
```

