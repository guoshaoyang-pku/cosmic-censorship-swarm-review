```python
def check_buckets(text):
    lines=text.splitlines()
    buckets={"forbidden_strengthenings":[],"forbidden_strengthenings_addition":[],"forbidden_weakenings":[]}
    for i,l in enumerate(lines):
        s=section_of(lines,i)
        if s in buckets and l.strip().startswith("-"):
            buckets[s].append({"line":i+1,"text":l.strip()})
    # collision predicate: shared normalized direction key
    keys = {"two-sided": r"two-sided|two sided|TWOSIDED"}
    collisions=[]
    for k,pat in keys.items():
        in_s=[b for b in buckets["forbidden_strengthenings"]+buckets["forbidden_strengthenings_addition"] if re.search(pat,b["text"],re.I)]
        in_w=[b for b in buckets["forbidden_weakenings"] if re.search(pat,b["text"],re.I)]
        if in_s and in_w:
            collisions.append({"key":k,"strengthening_lines":[b["line"] for b in in_s],"weakening_lines":[b["line"] for b in in_w]})
    return buckets, collisions
```
