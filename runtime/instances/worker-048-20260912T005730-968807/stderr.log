def _hash_set(v):
    out = set()
    if isinstance(v, str):
        out.add(v)
    elif isinstance(v, dict):
        for vv in v.values():
            out |= _hash_set(vv)
    elif isinstance(v, (list, tuple, set)):
        for vv in v:
            out |= _hash_set(vv)
    return out

