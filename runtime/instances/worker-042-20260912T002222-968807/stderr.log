After `targets_out` built, build `review_files_at_hash` table:
```python
def files_at_measured_hash(reviews_dir, hashes):
    rows = {t: [] for t in TARGETS}
    for rp in sorted(reviews_dir.glob("*.json")):
        try: d = json.loads(rp.read_text())
        except: continue
        v = str(d.get("verdict","")).lower()
        if v not in VERDICT_KINDS: continue
        reviewer = str(d.get("reviewer") or d.get("actor") or "?")
        pins = explicit_pins(d)
        for t in sorted(targets_in_review(d)):
            if t in rows and pin_matches(pins, hashes[t]):
                live = repo/"reviews"/rp.name
                rows[t].append({"file": rp.name, "reviewer": reviewer, "verdict": v,
                                "counts_as_full_schema_verdict": d.get("counts_as_full_schema_verdict"),
                                "live_mtime": datetime.fromtimestamp(live.stat().st_mtime, CST).isoformat(timespec="seconds") if live.is_file() else None})
    return rows
```
