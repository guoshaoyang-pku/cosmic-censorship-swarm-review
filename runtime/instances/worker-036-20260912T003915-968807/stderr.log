```python
def reverse_apply(canon_text, cand_text):
    diff = list(difflib.unified_diff(canon_text.splitlines(keepends=True), cand_text.splitlines(keepends=True), n=0))
    added = [ln[1:] for ln in diff if ln.startswith('+') and not ln.startswith('+++')]
    # verify each added line appears in candidate and that deleted lines exist in canonical
    cur = cand_text
    for ln in added:
        if ln not in cur: return None
        cur = cur.replace(ln, '', 1)
    return cur
```
