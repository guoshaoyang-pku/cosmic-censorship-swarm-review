def binder_census(doc):
    q=doc['quantifiers']; ordered=q['ordered']; formal=q['formal']
    return [{"index":i,"kind":e.get('kind'),"binder":e.get('binder'),"domain_id":e.get('domain_id'),
             "literal_in_formal": str(e.get('binder')) in formal} for i,e in enumerate(ordered)]

def tuple_components(b):
    if b.startswith('(') and b.endswith(')'):
        return [c.strip() for c in b[1:-1].split(',') if c.strip()]
    return None

def tuple_aware_containment(binder, formal):
    comps = tuple_components(binder)
    if comps is None:
        return binder in formal, {"mode":"literal"}
    pos=[]
    for c in comps:
        m=re.search(r'(?<![A-Za-z0-9_])'+re.escape(c)+r'(?![A-Za-z0-9_])', formal)
        if not m: return False, {"mode":"tuple","missing_component":c}
        pos.append(m.start())
    ok = all(pos[i]<pos[i+1] for i in range(len(pos)-1))
    return ok, {"mode":"tuple","component_positions":pos,"ordered":ok}
```

