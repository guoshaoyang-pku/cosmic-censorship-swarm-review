Independent classifier (my own, from the documented rule):
```python
VERDICTS=('accept','revise','reject','inconclusive')
ALIASES={...}
def norm_targets(doc):
    out=set()
    for key in ('target_id','target','target_subnode'):
        v=doc.get(key)
        if isinstance(v,str): out.add(v)
        elif isinstance(v,dict):
            for k2 in ('target_id','target_subnode','subnode','node_id'):
                if isinstance(v.get(k2),str): out.add(v[k2])
    return {ALIASES.get(t, ALIASES.get(t.upper(), t)) for t in out}
def pins(doc): ...
def binds(doc, target, measured):
    if doc.get('verdict') not in VERDICTS: return False
    h = measured.get(target,{}).get('sha256') or ''
    if not h: return False
    return any(p.startswith(h[:12]) or h.startswith(p[:12]) for p in pins(doc))
```

