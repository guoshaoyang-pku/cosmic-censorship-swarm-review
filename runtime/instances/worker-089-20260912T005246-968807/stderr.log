def c01_duplicate_keys(ctx):
    counts = Counter(top_level_keys(ctx["raw"]))
    dups = {k: v for k, v in counts.items() if v > 1}
    idx = [e.get("index") for e in ctx["doc"].get("revision_history", [])]
    idx_dups = {k: v for k, v in Counter(idx).items() if v > 1}
    ok = not dups and not idx_dups
    return ("pass" if ok else "fail",
            {"top_level_duplicates": dups, "revision_index_duplicates": idx_dups, "n_top_level": len(counts)},
            "no duplicate top-level keys or revision indices" if ok else f"dups={dups} idx={idx_dups}")
```

C02:
```python
def c02_revised_at(ctx):
    stamp = parse_iso(ctx["doc"].get("revised_at"))
    now = ctx["now"]; mtime = dt.datetime.fromtimestamp(ctx["mtime"]).astimezone()
    if stamp is None: fail
    d_now=(stamp-now).total_seconds(); d_mt=(stamp-mtime).total_seconds()
    ok = -60 <= d_now <= 3600 and abs(d_mt) <= 120
```
