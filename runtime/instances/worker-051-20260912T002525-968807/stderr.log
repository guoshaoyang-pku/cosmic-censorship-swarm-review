Isolated-order driver:
```python
def isolated_orders(scheme, drs, cfls=(0.5,0.25,0.125), r_max=30.0, t_end=6.0):
    pulse = pub.PulseExact()
    out = {"scheme": scheme, "rungs": []}
    e0s = []
    for dr in drs:
        errs = []
        for cfl in cfls:
            case = pub.run_case(pub.make_factory(scheme, pulse=pulse), dr, cfl, r_max, t_end)
            err = pub.l2_error(case["psi"][-1], pulse.psi(case["r"], case["t"][-1]), dr)
            errs.append({"cfl": cfl, "dt": case["dt"], "steps": case["steps"], "l2_error": err})
        dt2 = np.array([e["dt"]**2 for e in errs]); ee = np.array([e["l2_error"] for e in errs])
        slope, intercept = np.polyfit(dt2, ee, 1)
        e0 = float(intercept)
        pred = np.polyval([slope, intercept], dt2)
        resid = float(np.max(np.abs(pred - ee) / ee))
        e0s.append(e0)
        out["rungs"].append({"dr": dr, "runs": errs, "temporal_slope": float(slope), "temporal_intercept_e0": e0, "fit_max_rel_resid": resid})
    p = pub.fit_order(drs, e0s)
    out["spatial_order_dt0"] = float(p)
    out["pair_orders_dt0"] = pub.pair_orders(drs, e0s)
    out["e0_by_dr"] = [{"dr": dr, "e0": e0} for dr, e0 in zip(drs, e0s)]
    out["monotone"] = all(e0s[i+1] < e0s[i] for i in range(len(e0s)-1))
    out["within_band"] = bool(abs(p - 2.0) <= 0.3)
    return out
```

