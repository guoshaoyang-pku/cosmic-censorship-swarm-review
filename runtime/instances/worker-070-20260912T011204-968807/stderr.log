Hash index builder:
```python
INDEX_ROOTS = ["artifacts","schemas","research_map","ledger","numerics","evaluation","reviews","comms"]
def build_hash_index(root, max_bytes=8*1024*1024):
    idx={}
    for r in INDEX_ROOTS:
        base=root/r
        if not base.exists(): continue
        for dp,dn,fn in os.walk(base):
            dn[:] = [d for d in dn if d not in ('.git','__pycache__','node_modules')]
            for f in fn:
                p=Path(dp)/f
                try:
                    if p.stat().st_size>max_bytes: continue
                    h=sha256_file(p)
                except OSError: continue
                idx.setdefault(h,[]).append(str(p.relative_to(root)))
    return idx
```
