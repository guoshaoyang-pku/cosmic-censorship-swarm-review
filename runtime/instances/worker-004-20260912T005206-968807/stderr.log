```
def omega_chain_witness(N=64):
    def le(a,b):
        if a==b: return True
        ta,ia=a; tb,ib=b
        if tb=="q": return ta=="p" and ia<=ib
        if ta=="q": return False
        return ia<=ib
    k=N//2
    # representative finite checks of a uniform infinite family
    set_holds = all(le(("p",j),("q",j)) for j in range(N+1))
    # every q_m fails the tail: witness j=max(k,m+1)
    every_q_fails = all(not le(("p",max(k,m+1)),("q",m)) for m in range(N+1))
    single_holds = not every_q_fails  # no q sees the whole (infinite) tail
    # no causal maximum: for each n, p_{n+1} is strictly above
    no_max = all(le(("p",n),("p",n+1)) and not le(("p",n+1),("p",n)) for n in range(N))
    reflexive = all(le(x,x) for x in [("p",i) for i in range(N+1)]+[("q",m) for m in range(N+1)])
    # transitivity on representative triples
    transitive = all((not(le(x,y) and le(y,z))) or le(x,z) for x in ... for y in ... for z in ...)  # O(N^3)=274k fine
    strict = set_holds and every_q_fails and no_max
```
