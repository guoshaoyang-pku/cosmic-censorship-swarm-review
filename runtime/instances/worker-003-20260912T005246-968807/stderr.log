```python
def preorders(n=4):
    # enumerate reflexive transitive relations on n labeled points
    elems=range(n)
    pairs=[(i,j) for i in elems for j in elems]
    for mask in range(1<<len(pairs)):
        rel=set(pairs[k] for k in range(len(pairs)) if mask>>k & 1)
        if any((i,i) not in rel for i in elems): continue
        # transitivity
        ok=True
        for a in elems:
            for b in elems:
                if (a,b) in rel:
                    for c in elems:
                        if (b,c) in rel and (a,c) not in rel: ok=False;break
                    if not ok: break
            if not ok: break
        if ok: yield rel
```
