#!/usr/bin/env python3
"""Rephrase/supersede claim[36] ... """
import hashlib, importlib.util, json, shutil, sys
from datetime import datetime, timezone, timedelta
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
OUT = Path(__file__).resolve().parent
MAP = ROOT/'research_map/research_map.json'
LIVE = ROOT/'research_map/class_separation.py'
CAND = ROOT/'proposed/class_separation.py'
OLD_EID = 'flash02-opencase-claim-0010b-20260912T0015'

def sha(p, n=12): return hashlib.sha256(Path(p).read_bytes()).hexdigest()

def load_mod(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m); return m

def findings_attributed(cs, map_obj):
    """Return per-claim findings dict and total hard findings list (prose mode like audit_evidence)."""
    live = cs.findings_for_map(map_obj)  # list of strings
    per_claim = {}
    for i,c in enumerate(map_obj.get('claims',[])):
        f = cs.findings(c, f'claims[{i}]', mode='prose')
        if f: per_claim[i]=f
    ... also non-claim findings from groups/portfolio_events
```

