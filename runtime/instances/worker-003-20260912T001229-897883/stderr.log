def sample_state():
    frozen = json.loads((ROOT / FROZEN_MANIFEST).read_text())
    pin = frozen.get("files",{}).get(CANONICAL_F1,{}).get("sha256")
    return {"t": now(), "f1_sha256": sha256(CANONICAL_F1), "f1_mtime": ..., "manifest_revision": frozen.get("revision"), "manifest_pin": pin}

def wait_quiescent(max_seconds=150, interval=4, need=3):
    samples=[sample_state()]
    deadline=time.time()+max_seconds
    while time.time()<deadline:
        time.sleep(interval)
        samples.append(sample_state())
        tail=samples[-need:]
        if len(tail)==need and len({(s['f1_sha256'], s['manifest_pin'], s['manifest_revision']) for s in tail})==1 and tail[-1]['f1_sha256']==tail[-1]['manifest_pin']:
            return True, samples
    return False, samples
```
