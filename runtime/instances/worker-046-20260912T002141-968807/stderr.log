```
def run_pulse_variant(r0, sigma, dr):
    """Post-hoc robustness probe: same FV scheme, different pulse family member."""
    global R0, SIGMA
    old = (R0, SIGMA)
    R0, SIGMA = float(r0), float(sigma)
