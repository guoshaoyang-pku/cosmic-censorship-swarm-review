Classification procedure:
```python
def classify(subject, tail_text, token_dir):
    text = subject + " || " + tail_text
    ev = {"predicate": [e for e in PREDICATE_EV if e in text.lower()],
          "conclusion": [e for e in CONCLUSION_EV if e in text.lower()],
          "untyped_noun": [e for e in UNTYPED_NOUNS if e in subject.lower()]}
    if ev["predicate"] and ev["conclusion"]:
        sense = "ambiguous"
    elif ev["predicate"]:
        sense = "predicate"
    elif ev["conclusion"]:
        sense = "conclusion"
    elif ev["untyped_noun"]:
        sense = "untyped"
    else:
        sense = "untyped"
    return sense, ev
```

