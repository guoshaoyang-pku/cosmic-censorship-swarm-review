Let me write the tracer as a separate small file `trace_run.py` (cleaner) that:
```python
import sys, os, json, runpy
ROOT = sys.argv[1]; out = sys.argv[2]; target = sys.argv[3]; args = sys.argv[4:]
seen=set()
def hook(event, eargs):
    if event == 'open':
        p = eargs[0]
        if isinstance(p,(str,bytes,os.PathLike)):
            seen.add(str(p))
    elif event == 'exec':
        co = eargs[0]
        f = getattr(co,'co_filename',None)
        if f: seen.add(f)
sys.addaudithook(hook)
sys.argv=[target]+args
try:
    runpy.run_path(target, run_name='__main__')
    rc=0
except SystemExit as e:
    rc = e.code if isinstance(e.code,int) else 0
finally:
    ...
json.dump(sorted(seen), open(out,'w'))
sys.exit(rc)
```
