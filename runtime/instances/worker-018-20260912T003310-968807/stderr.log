```python
class DupCheckLoader(yaml.SafeLoader): pass
def _map(loader, node, deep=False):
    mapping={}
    for k,v in node.value:
        key=loader.construct_object(k, deep=deep)
        if key in mapping: raise ValueError(f"duplicate key {key!r} at line {k.start_mark.line+1}")
        mapping[key]=loader.construct_object(v, deep=deep)
    return mapping
DupCheckLoader.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, _map)
```
