```
def strip_quoted(s):
    out=[]; i=0; n=len(s)
    while i<n:
        c=s[i]
        if c=="'":
            prev = s[i-1] if i>0 else ' '
            if prev in " \t([{\"'":
                # opening quote: skip to closing
                j=s.find("'", i+1)
                if j!=-1:
                    i=j+1; continue
        out.append(c); i+=1
    return ''.join(out)
```
