Implementation:

```python
PROTOCOL_REVIEW_TARGETS = (
    "numerics/CONVERGENCE_PROTOCOL.md",
    "G-NUM-protocol",
    "N0",
)
PROTOCOL_REVIEW_SELF = "astra-lead-numerics"


def _review_hash(e: dict) -> str | None:
    for k in ("reviewed_sha256", "artifact_sha256", "reviewed_protocol_hash"):
        v = e.get(k)
        if isinstance(v, str) and len(v) >= 12:
            return v.strip().lower()
    return None


def _targets_protocol(target: str) -> bool:
    t = target.strip()
    for cand in PROTOCOL_REVIEW_TARGETS:
        if t == cand or t.startswith(cand + "#") or t.startswith(cand + "@"):
            return True
    return False


def _protocol_review(events, protocol_sha=None):
    """Independent accepting review(s) of the protocol of record.

    A review counts only if:
      * event_type == review and verdict in {accept, revise, reject}
      * target_id names the protocol (path, G-NUM-protocol, or N0), with or without a #/@ pin
      * the reviewer cites a hash that PREFIX-MATCHES the protocol currently on disk
        (a verdict at a superseded pin is advisory only), and
      * the reviewer is not the protocol author (astra-lead-numerics): no self-review.

    Accepts and dissents are reported separately; `contest` is True when a revise/reject at the
    current hash exists.  This is fail-closed: an uncited or stale verdict never turns the
    criterion green.
    """
```

