Independent checker `independent_budget_check(rep, tol)`:
```python
def independent_check(rep, tol):
    arms = rep["arms"]
    prim = [a for a in arms if a["is_primary"]]
    v = []
    caps = {(a["token_budget"], a["wall_budget"]) for a in prim}
    if len(caps) > 1: v.append("different enforced caps")
    for a in arms:
        if a["tokens_consumed"] > a["token_budget"] + 1e-9: v.append(f"{a['arm']}: overspent tokens")
        if a["wall_consumed"] > a["wall_budget"] + 1e-9: v.append(f"{a['arm']}: overspent wall clock")
        if a["is_primary"] and a["stop_reason"] == "wall_clock": v.append(f"{a['arm']}: wall-clock-limited")
    if prim:
        consumed=[a["tokens_consumed"] for a in prim]
        spread=(max(consumed)-min(consumed))/max(1.0, prim[0]["token_budget"])
    else: spread=None
    if spread is not None and spread > tol: v.append("spread")
    for a in prim:
        if a["stop_reason"]=="call_budget": v.append(f"{a['arm']}: call-count-limited")
        residual=a["token_budget"]-a["tokens_consumed"]
        if residual > a["max_episode_cost"] + 1e-9: v.append(f"{a['arm']}: residual")
    return {...}
```
