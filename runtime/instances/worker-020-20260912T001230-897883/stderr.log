#!/usr/bin/env python3
"""A2 wall-clock-binding falsifier probe (worker-020).

Bounded probe for assignment asg-2026-09-11-A2-deepseek-flash-20-29.
Executes the map-declared A2 next_falsifier:
  "Re-run the harness with a config where wall clock binds (small --wall-budget) and
   verify the budget checker marks primary arms wall-clock-limited as unmatched;
   or diff report generator_sha256 against the harness bytes."

No model calls, synthetic proposers only.  Reads the frozen canonical harness but
never writes to it.  Writes only under artifacts/worker-020/.
"""
from __future__ import annotations
import hashlib, importlib.util, json, subprocess, sys, time
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent.parent
HARNESS = ROOT / "evaluation" / "ablation_harness.py"
DESIGN = ROOT / "evaluation" / "ablation_design.yaml"
MAP = ROOT / "research_map" / "research_map.json"

def sha256(p): return hashlib.sha256(Path(p).read_bytes()).hexdigest()

def load_harness():
    spec = importlib.util.spec_from_file_location("a2_harness_frozen", HARNESS)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod
...
```

