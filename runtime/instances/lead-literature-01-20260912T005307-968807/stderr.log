```python
def base_target(e):
    t = str(e.get('target_id') or '')
    return t.split(':')[0].strip()

def l0_scope(e):
    bt = base_target(e)
    if bt in INCLUDE_TARGETS: return True
    if bt.startswith('ledger/theorems.jsonl'): return True
    return False

def excluded(e):
    t = str(e.get('target_id') or '')
    bt = base_target(e)
    # out of scope: target not L0 at all
    if not l0_scope(e): return 'target is not the L0 ledger'
    # spot check: sample-based, not ledger-wide
    eid = str(e.get('event_id') or '').lower()
    art = str(e.get('artifact') or '').lower()
    scope = str(e.get('scope') or '').lower()
    if ('spotcheck' in eid or 'spot check' in eid or 'spotcheck' in art) and e.get('counts_as_full_schema_verdict') is not True:
        return 'sample spot check, not a ledger-wide verdict'
    if 'build_literature' in t or 'build_literature' in art:
        return 'builder/tooling review, not ledger content'
    return None
```
