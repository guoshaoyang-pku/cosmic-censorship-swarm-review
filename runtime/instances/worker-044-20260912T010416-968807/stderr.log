#!/usr/bin/env python3
"""W044-GFORM-ACCEPT-SCOPE-AUDIT-01 ..."""
ROOT = Path(__file__).resolve().parents[3]  # artifacts/worker-044/gform_accept_scope/scope_audit.py -> repo root
