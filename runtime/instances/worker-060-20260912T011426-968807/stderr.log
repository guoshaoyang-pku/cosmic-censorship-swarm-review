def rule_containment(fx, base):
    b = get(base,'implication_ledger.extension_class_containment')
    f = get(fx,'implication_ledger.extension_class_containment')
    if not isinstance(f,str) or not isinstance(b,str): return [['missing','...']]
    lab = lambda s: [re.sub(r'[{}]','',m) for m in re.findall(r'E_\{?[A-Za-z0-9^,\.\s]+\}?', s)]
    # careful regex greediness; use: r'E_(?:\{[^}]*\}|[A-Za-z0-9_^,\.]+)'
    bl, fl = lab(b), lab(f)
    if [x.strip() for x in bl] != [x.strip() for x in fl]: flag
```
