```python
import subprocess, shlex
def run_w068(tool, fixture, base, variant="freeze_statements"):
    cp = subprocess.run([sys.executable, tool, "--fixture", fixture, "--base", base, "--variant", variant, "--json"], capture_output=True, text=True, timeout=120)
    out = cp.stdout.strip()
    try: j=json.loads(out)
    except: j={"raw":out[:400],"stderr":cp.stderr[-200:],"exit":cp.returncode}
    return {"exit": cp.returncode, "verdict": j.get("verdict") if isinstance(j,dict) else None, "json": j}
```
