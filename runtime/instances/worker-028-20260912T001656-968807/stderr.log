```python
def clean_excerpt(s):
    s = re.sub(r'^(?:[A-Za-z]+ )?abstract\s*:\s*', '', s.strip(), flags=re.I)
    s = re.sub(r'^INSPIRE recid \d+\s*:\s*', '', s, flags=re.I)
    s = re.sub(r'^\W+','',s)
    return s.strip().strip('"\'').strip()
```
