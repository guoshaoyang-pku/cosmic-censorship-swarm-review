```python
def author_candidates(authors):
    out=set()
    for a in authors or []:
        n=norm(a)
        if not n: continue
        toks=n.split()
        if len(toks)>=2 and ',' in a:   # "Costa, João L."
            out.add(toks[0]); out.add(toks[-1])
        else:
            out.add(toks[-1]); out.add(toks[0])
    return out

def author_state(row, fetches):
    led = ledger_surnames(row.get('authors',''))
    got=set()
    for f in fetches:
        if f.get('ok'): got |= author_candidates(f.get('authors'))
    return bool(led) and led[0] in got
```
