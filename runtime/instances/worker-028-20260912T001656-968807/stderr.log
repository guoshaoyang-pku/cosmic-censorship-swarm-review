Excerpt comparison:
```python
def excerpt_state(excerpt, abstract):
    if not excerpt: return "missing_in_ledger"
    if not abstract: return "not_available"
    ce=norm(clean_excerpt(excerpt))
    ab=norm(abstract)
    if not ce: return "unverifiable"
    if ce[:120] and ce[:120] in ab: return "match"
    # try a mid fragment
    frag=ce[:200]
    r=SequenceMatcher(None,frag[:400],ab[:400],autojunk=False).ratio()
    r2=SequenceMatcher(None,ce[-200:],ab,autojunk=False).ratio()
    best=max(r,r2)
    return "match" if best>=0.5 else "partial" if best>=0.3 else "mismatch"
```
