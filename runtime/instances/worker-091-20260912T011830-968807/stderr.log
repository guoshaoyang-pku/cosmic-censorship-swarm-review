def split_clauses(defn):
    idx = {}
    for letter in 'abcdef':
        m = re.search(r'\(%s\)\s*' % letter, defn)
        if m: idx[letter]=m.start()
    order = sorted(idx.items(), key=lambda kv: kv[1])
    out={}
    for i,(letter,pos) in enumerate(order):
        end = order[i+1][1] if i+1<len(order) else len(defn)
        out[letter]=defn[pos:end].strip()
    return out
```
