```python
def _known_class_tokens(value) -> list:
    """Distinct frozen class tokens declared in one class_id/class_ids container."""
    if isinstance(value, str):
        toks = [t for t in re.split(r"[;,]", value) if t.strip()]
    elif isinstance(value, list):
        toks = [str(x) for x in value]
    else:
        return []
    known: list = []
    for tok in toks:
        u = tok.strip().strip("'\"").upper()
        if u in KNOWN_CLASSES and u not in known:
            known.append(u)
    return known


def _scan_class_ids_disjunction(value, where: str, out: list):
    """HF-02 'disjunction of class_ids' on an ASSERTED container (>=2 distinct frozen
    class ids bound to one row/declaration).  Scope note: map scope/coverage lists are
    deliberately not routed through this rule; see README (measured blast radius)."""
    known = _known_class_tokens(value)
    if len(known) >= 2:
        out.append(f"CLASSSEP: disjunction of class_ids in {where}: {known!r}")


def disjunction_findings(obj, where: str) -> list:
    """Structured-row scan (ledger rows, claim-like records)."""
    out: list = []
    if not isinstance(obj, dict):
        return out
    for key in ("class_id", "class_ids"):
        if key in obj:
            _scan_class_ids_disjunction(obj[key], f"{where}.{key}", out)
    return out


def findings_for_ledger(rows, where_prefix: str = "ledger") -> list:
    out: list = []
    for i, row in enumerate(rows):
        if not isinstance(row, dict):
            continue
        rid = row.get("theorem_id") or row.get("id")
        where = f"{where_prefix}[{i}]" + (f":{rid}" if rid else "")
        out += disjunction_findings(row, where)
    return out
```
