    known = []
    for tok in toks:
        u = tok.strip().strip('"\'').upper()
        if u in KNOWN_CLASSES and u not in known:
            known.append(u)
    return known

def _scan_class_ids_disjunction(value, where, out):
    known = _known_class_tokens(value)
    if len(known) >= 2:
        out.append(f"CLASSSEP: disjunction of class_ids in {where}: {known!r}")

def disjunction_findings(obj, where):
    out=[]
    if not isinstance(obj, dict): return out
    for key in ("class_id","class_ids"):
        if key in obj: _scan_class_ids_disjunction(obj[key], f"{where}.{key}", out)
    return out

def findings_for_ledger(rows, where_prefix="ledger"):
    out=[]
    for i,row in enumerate(rows):
        if isinstance(row,dict):
            out += disjunction_findings(row, f"{where_prefix}[{i}]" + (f":{row.get('theorem_id')}" if row.get('theorem_id') else ""))
    return out
```
