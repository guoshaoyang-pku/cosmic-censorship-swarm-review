def classify_relation(text):
    tl = text.lower()
    # comparison target level
    if "single-q tail predicate" in tl: level="predicate"
    elif "negation" in tl: level="negation"
    elif "af-wcc-vac-gen" in tl: level="class"
    else: level="unclear"
    # direction token
    if "strictly stronger" in tl: direction="stronger"
    elif "strictly weaker" in tl: direction="weaker"
    elif "equivalent" in tl: direction="equivalent"
    else: direction="unclear"
    # support clause: "non-containment in the union implies no single q sees a tail"
    support = ("non-containment in the union" in tl and "implies no single q" in tl)
    # expected derived direction
    if level=="predicate": expected = "weaker"   # S weaker than T
    elif level=="negation" or level=="class": expected="stronger"  # variant negation/class stronger
    ...
    status = "consistent" if direction==expected else ("inverted" if direction in ("stronger","weaker") else "unsupported")
    if support and level=="predicate" and direction=="stronger": status="inverted_with_contradictory_support"
    return {...}
```

