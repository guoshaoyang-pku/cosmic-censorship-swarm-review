class DupLoader(yaml.SafeLoader): pass
def _construct_mapping(loader, node, deep=False):
    keys=[]
    for k,_ in node.value:
        try: kk=loader.construct_object(k, deep=deep)
        except: kk=str(k)
        keys.append(kk)
    dups=[k for k in set(keys) if keys.count(k)>1]
    ...
```
