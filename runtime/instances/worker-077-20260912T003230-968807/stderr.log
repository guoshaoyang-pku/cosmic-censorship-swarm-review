```python
import yaml
from yaml.nodes import MappingNode, SequenceNode
def walk(node, path=()):
    if isinstance(node, MappingNode):
        seen={}
        for k,v in node.value:
            key = k.value  # scalar
            if key in seen: dup.append((path,key,node.start_mark.line+1))
            seen[key]=v
            walk(v, path+(str(key),))
        ...
```
