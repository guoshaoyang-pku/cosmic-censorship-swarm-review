```python
def classes_of(ev):
    cs=set()
    for k in ('class_id','class_ids'):
        v=ev.get(k)
        if isinstance(v,str): cs.update(x.strip() for x in re.split(r'[;,]',v) if x.strip())
        elif isinstance(v,list): cs.update(str(x).strip() for x in v if str(x).strip())
    return cs & FROZEN
```
