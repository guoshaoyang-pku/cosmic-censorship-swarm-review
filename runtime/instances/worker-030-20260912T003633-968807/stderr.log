def make_tree(name):
    d = KIT/"sandbox"/name
    (d/"research_map").mkdir(parents=True, exist_ok=True)
    (d/"artifacts/formulation/tools").mkdir(parents=True, exist_ok=True)
    (d/"artifacts/formulation/evidence").mkdir(parents=True, exist_ok=True)
    shutil.copy2(REPO/"research_map/formulation_taxonomy.yaml", d/"research_map/formulation_taxonomy.yaml")
    shutil.copy2(REPO/"artifacts/formulation/formulation_taxonomy.yaml", d/"artifacts/formulation/formulation_taxonomy.yaml")
    shutil.copy2(REPO/"artifacts/formulation/VOCAB_ALIASES.json", d/"artifacts/formulation/VOCAB_ALIASES.json")
    shutil.copy2(REPO/"artifacts/formulation/tools/check_taxonomy_consistency.py", d/"artifacts/formulation/tools/check_taxonomy_consistency.py")
    shutil.copy2(KIT/"patched_check_taxonomy_consistency.py", d/"artifacts/formulation/tools/patched_check_taxonomy_consistency.py")
    return d
```
