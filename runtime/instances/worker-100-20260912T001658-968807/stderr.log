```python
STOP = {"the","a","an","of","and","or","in","on","for","to","with","by","is","are","was","were","as","at","from","this","that","these","those","it","its","which","who","whom","be","been","has","have","had","not","no","than","then","also","into","over","under","after","before","during","between","within","without","via","per","see","e.g","i.e"}

def token_coverage(seg, hay):
    toks = [t for t in seg.split() if len(t) >= 3 and t not in STOP]
    if not toks: 
        # allow short numeric tokens
        toks = [t for t in seg.split() if t]
    if not toks: return 1.0, 0, 0
    hit = sum(1 for t in toks if t in hay)
    return hit/len(toks), hit, len(toks)
```
