```python
def excerpt_segments(excerpt):
    s = excerpt or ""
    s = re.sub(r'^\s*(arXiv abstract(?: \(exact excerpt\))?|Abstract|Crossref record|INSPIRE record)\s*:?\s*', '', s, flags=re.I)
    s = s.strip().strip("'\"\u2018\u2019\u201c\u201d ")
    segs=[]
    for chunk in re.split(r'\.\.\.|\u2026', s):
        n=norm(chunk)
        if len(n)>=25: segs.append(n)
    return segs
```
