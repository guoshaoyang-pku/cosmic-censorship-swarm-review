Let me write the new `quoted_spans`:

```python
QUOTE_PAIRS = {"'": "'", "\u2018": "\u2019", '"': '"', "\u201c": "\u201d"}

def quoted_spans(excerpt: str):
    spans, outside = [], []
    i, n = 0, len(excerpt)
    while i < n:
        c = excerpt[i]
        if c in QUOTE_PAIRS:
            prev = excerpt[i-1] if i > 0 else " "
            if not prev.isalnum():
                close = QUOTE_PAIRS[c]
                j = i + 1
                while j < n:
                    if excerpt[j] == close:
                        after = excerpt[j+1] if j+1 < n else " "
                        if not after.isalpha():
                            break
                    j += 1
                if j < n and j - i - 1 >= 25:
                    spans.append(excerpt[i+1:j])
                    outside.append("\u0000")
                    i = j + 1
                    continue
        outside.append(c)
        i += 1
    notes = [p.strip() for p in "".join(outside).split("\u0000") if p.strip()]
    return spans, notes
```

