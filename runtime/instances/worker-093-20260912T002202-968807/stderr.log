```python
# --- CF-16 calibration (worker-093, W093-CF16-CALIBRATION-01) -----------------
# A composite immediately followed by a *label noun* ("... C0/C2 merge, ...")
# and sitting in a case-label context -- a case id adjacent before it, or a
# parenthesised list carrying a case id -- names a test case; it does not
# assert that C0 and C2 are one class.  The mention reading is abandoned when
# the label noun is itself predicated ("... C0/C2 merge is our design") or when
# any non-label merge assertion appears in the same window.
_CASE_ID = re.compile(r"\b(?:TC|FX|CASE|ROW|FIXTURE)-[A-Za-z0-9-]+\b")
_CASE_ID_BEFORE = re.compile(r"(?:^|[\s(\[,;])(?:TC|FX|CASE|ROW|FIXTURE)-[A-Za-z0-9-]+\s*$", re.I)
_LABEL_NOUN_AFTER = re.compile(
    r"^\s*(?:merge|merger|case|fixture|row|label|name|test|disposition|request)\b", re.I)
_LABEL_PREDICATED_AFTER = re.compile(
    r"^\s*(?:merge|merger|case|fixture|row|label|name|test|disposition|request)\b"
    r"[\s,:-]{0,4}(?:\w+\s+){0,2}?(?:is|are|was|were|be|becomes?|means?|entails?|"
    r"adopts?|adopted|requires?|required|declares?|declared|asserts?|asserted|"
    r"as\s+one|into\s+(?:one|a\s+single))\b", re.I)


def _in_case_label_list(t: str, pos: int) -> bool:
    open_idx = t.rfind("(", 0, pos)
    if open_idx == -1:
        return False
    close_idx = t.find(")", pos)
    if close_idx == -1:
        return False
    return bool(_CASE_ID.search(t[open_idx:close_idx]))


def _is_case_label_mention(t: str, start: int, end: int) -> bool:
    """True iff the merge word at t[start:end] is part of a case/fixture label."""
    after = t[end:]
    if not _LABEL_NOUN_AFTER.match(after):
        return False
    if _LABEL_PREDICATED_AFTER.match(after):
        return False
    return bool(_CASE_ID_BEFORE.search(t[:start]) or _in_case_label_list(t, start))
```

