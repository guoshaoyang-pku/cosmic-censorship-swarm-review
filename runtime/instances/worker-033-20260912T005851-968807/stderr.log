- Add `declared_ref_hashes` via recursive scan (keys containing "sha256" and starting with "declared"/"consistency"). Implementation:
```python
def declared_ref_hashes(rec):
    out=set()
    def walk(o):
        if isinstance(o,dict):
            for k,v in o.items():
                kl=k.lower()
                if isinstance(v,str) and ("sha256" in kl) and ("declared" in kl or "consistency" in kl):
                    out.update(h for h in HEX_RE.findall(v.lower()) if len(h)>=12)
                walk(v)
        elif isinstance(o,list):
            for x in o: walk(x)
    walk(rec)
    return sorted(out)
```
