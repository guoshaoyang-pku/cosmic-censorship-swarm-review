controller_scan(records, asof=None):
```python
def controller_scan(records, asof=None, epoch=None):
    epoch = epoch or EPOCH
    out={t:{"verdicts":[],"full_accepts":[],"distinct_accept_reviewers":[]} for t in epoch}
    for r in records:
        if r["channel"] != "reviews_file": continue
        if asof is not None and not (r["time"] is None or r["time"]<=asof): continue
        for t in (set(r["ctrl_targets"]) & set(epoch)):
            h=epoch[t]
            if any(prefix_match(p,h) for p in r["ctrl_pins"]):
                e={"rid":r["rid"],"reviewer":r["reviewer"],"verdict":r["verdict"],"full":r["ctrl_full"]}
                out[t]["verdicts"].append(e)
                if r["verdict"]=="accept" and r["ctrl_full"]:
                    out[t]["full_accepts"].append(e)
    for t,c in out.items():
        c["distinct_accept_reviewers"]=sorted({a["reviewer"] for a in c["full_accepts"]})
        c["two_distinct_accepts"]=len(c["distinct_accept_reviewers"])>=2
    return out
```

