Let me restructure the fetch loop:

```python
def candidates_for(row):
    out=[]
    if row.get('arxiv_id'):
        out.append(('arxiv-api', f"https://export.arxiv.org/api/query?id_list={row['arxiv_id'].strip()}"))
    if row.get('doi'):
        d=row['doi'].strip()
        if not d.startswith('10.48550'):
            out.append(('crossref-api', f"https://api.crossref.org/works/{d}"))
        out.append(('openalex-api', f"https://api.openalex.org/works/doi:{d}"))
    if row.get('arxiv_id'):
        out.append(('arxiv-abs-html', f"https://arxiv.org/abs/{row['arxiv_id'].strip()}"))
    ev=(row.get('evidence_url') or row.get('url') or '').strip()
    if ev:
        out.append(('page-fetch', ev))
    return out
```

