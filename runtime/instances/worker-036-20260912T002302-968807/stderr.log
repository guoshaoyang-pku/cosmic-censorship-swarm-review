Implementation detail: `_resolve_refs`:
```python
def check_evidence_refs(root, reviews, hashes):
    rows=[]
    for r in reviews:
        if str(r.get('verdict','')).lower()!='accept': continue
        for t in _targets_in_review(r):
            if t not in hashes: continue
            pins = [...] # same as event scan
            if not any(_pin_matches(p,h) for p in pins): continue
            for ref in r.get('evidence_refs') or []:
                if '#' not in ref: continue
                path, frag = ref.rsplit('#',1)
                if not re.fullmatch(r'[0-9a-f]{12,64}', frag.lower()): continue
                fp = root/path
                if not fp.is_file(): rows.append({...'status':'missing'}); continue
                cur=_sha256_file(fp)
                ok = cur.startswith(frag[:12].lower())
                rows.append({'status':'match' if ok else 'stale', ...})
    return rows
```
