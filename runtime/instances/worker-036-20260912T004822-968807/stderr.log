def rebase_blocks(new_base_lines, old_base_lines, blocks):
    sm = SequenceMatcher(a=old_base_lines, b=new_base_lines, autojunk=False)
    pos = {}
    changed = []
    for tag,i1,i2,j1,j2 in sm.get_opcodes():
        if tag=='equal':
            for k in range(i2-i1): pos[i1+k]=j1+k
        else:
            changed.append((i1,i2))
    out=[]; conflicts=[]
    def overlaps_changed(i1,i2):
        for c1,c2 in changed:
            # empty changed range (insertion at c1) occupies point c1
            cc1, cc2 = (c1,c1+1) if c1==c2 else (c1,c2)
            b1,b2 = (i1,i1+1) if i1==i2 else (i1,i2)
            if b1 < cc2 and cc1 < b2: return (c1,c2)
        return None
    for i1,i2,rep in blocks:
        ov = overlaps_changed(i1,i2)
        if ov: conflicts.append({...}); continue
        # translate
        if i1==i2:
            if i1-1 in pos and i1 in pos and pos[i1]==pos[i1-1]+1:
                out.append((pos[i1], pos[i1], rep))
            elif i1==0 and 0 in pos: out.append((pos[0],pos[0],rep))
            elif i1==len(old_base_lines) and i1-1 in pos: out.append((pos[i1-1]+1,)*2 + (rep,))
            else: conflicts...
        else:
            if i1 in pos and (i2 in pos or i2==len(old_base_lines)):
                j1 = pos[i1]
                j2 = pos[i2] if i2 in pos else len(new_base_lines)
                if new_base_lines[j1:j2] == old_base_lines[i1:i2]:
                    out.append((j1,j2,rep))
                else: conflicts...
            else: conflicts...
    return out, conflicts
```
