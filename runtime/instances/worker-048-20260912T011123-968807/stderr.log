def _norm_target(t: str) -> str | None:
    """Normalize one target string to a node id (R3)."""
    for piece in t.split(","):
        piece = piece.strip()
        if not piece:
            continue
        if piece in TARGET_ALIASES:
            return TARGET_ALIASES[piece]
        if piece.upper() in TARGET_ALIASES:
            return TARGET_ALIASES[piece.upper()]
        base = piece.split("#", 1)[0].split("@", 1)[0].strip()
        if base in TARGET_ALIASES:
            return TARGET_ALIASES[base]
        if base.upper() in TARGET_ALIASES:
            return TARGET_ALIASES[base.upper()]
        if base in TARGET_PATH_ALIASES:
            return TARGET_PATH_ALIASES[base]
        name = base.rsplit("/", 1)[-1]
        if name in TARGET_PATH_ALIASES:
            return TARGET_PATH_ALIASES[name]
    return None
```

