```python
def load_rule(instrument_path: Path, root: Path):
    tree = ast.parse(instrument_path.read_text())
    seg = {}
    consts = {}
    wanted_f = {"_targets_in_review", "_explicit_pins", "review_coverage"}
    wanted_c = {"TARGET_ALIASES", "TARGET_PATH_ALIASES", "VERDICT_KINDS"}
    src_lines = instrument_path.read_text().splitlines(keepends=True)
    for node in tree.body:
        if isinstance(node, ast.FunctionDef) and node.name in wanted_f:
            seg[node.name] = ast.get_source_segment("".join(src_lines), node)
        if isinstance(node, ast.Assign) and len(node.targets)==1 and isinstance(node.targets[0], ast.Name) and node.targets[0].id in wanted_c:
            consts[node.targets[0].id] = ast.literal_eval(node.value)
    ...
```
