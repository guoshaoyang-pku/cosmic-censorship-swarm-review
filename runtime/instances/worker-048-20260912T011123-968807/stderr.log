def _collect_hash_strings(v, out=None):
    """Recursively collect hash-like strings from str/dict/list values (R3)."""
    if out is None: out=[]
    if isinstance(v,str): out.append(v.lower())
    elif isinstance(v,dict):
        for vv in v.values(): _collect_hash_strings(vv,out)
    elif isinstance(v,list):
        for vv in v: _collect_hash_strings(vv,out)
    return out
