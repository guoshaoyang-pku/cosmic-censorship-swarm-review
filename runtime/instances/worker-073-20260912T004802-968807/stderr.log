```python
def line_in_range(text, needle, start_marker, end_marker):
    lines = text.splitlines()
    start = next((i for i,l in enumerate(lines) if start_marker in l), 0)
    end = next((i for i,l in enumerate(lines) if i>start and end_marker in l), len(lines))
    for i in range(start, end):
        if needle in lines[i]: return i+1
    return None
```
