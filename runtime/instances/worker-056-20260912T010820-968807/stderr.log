def snapshot_sources(sources) -> dict:
    pins = {}
    for rel in sorted(sources):
        if not rel: continue
        src = ROOT / rel
        dst = RAW / "sources" / rel.replace("/", "__")
        if src.is_file():
            dst.write_bytes(src.read_bytes())
            pins[rel] = {"snapshot": f"raw/sources/{rel.replace('/','__')}", "sha256": sha256_file(dst)}
        else:
            pins[rel] = {"snapshot": None, "sha256": None}
    return pins
```

