Edit 1: after REPAIR_MAP closing brace, add:

```python
# Rule tier for tokens not in the explicit table (the live stream invents them faster
# than a static list can track). Rules are suffix/pattern based, auditable, and still
# constrained by I1: they can only emit numerical_evidence or open_problem.
MEASUREMENT_PATTERNS = ("measurement", "observation", "replication", "calibration",
                        "empirical", "evidence", "result")
FINDING_PATTERNS = ("finding", "proposal", "diagnosis", "verdict", "input", "adjudication")


def resolve_token(token: str) -> tuple[str, str, str] | None:
    """Return (target, rationale, source) or None if the token cannot be mapped safely."""
    if token in REPAIR_MAP:
        t, why = REPAIR_MAP[token]
        return t, why, "explicit"
    if not isinstance(token, str) or not token:
        return None
    low = token.lower()
    if any(p in low for p in MEASUREMENT_PATTERNS):
        return "numerical_evidence", f"rule:measurement-family token {token!r}", "rule:measurement"
    if any(p in low for p in FINDING_PATTERNS):
        return "open_problem", f"rule:finding-family token {token!r}", "rule:finding"
    return None
```

