import sys, re
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "research_map"))
import class_separation as cs

ASSERTED = set(cs.ASSERTED_LINE_KEYS)
_VARIANT_ASSERT = re.compile(r"own\s+class|new\s+class|independent\s+class|as\s+a\s+class|as\s+its\s+class|second\s+class|separate\s+class", re.I)
_PATHLIKE = re.compile(r"[\w./-]*AF-[A-Z0-9-]+\.(?:json|ya?ml|md)")

def registered_variant_tokens(taxonomy: dict) -> set[str]:
    toks=set()
    for v in taxonomy.get("variants",[]) or []:
        parent=v.get("parent_class",""); vid=v.get("variant_id","")
        if parent and vid: toks.add(f"{parent}-{vid}")
        for ev in v.get("evidence",[]) or []:
            for m in re.findall(r"AF-[A-Z0-9]+-[A-Z0-9]+-[A-Z0-9]+-[A-Z0-9]+", str(ev).upper()):
                toks.add(m)
    return toks
```
