```python
def review_coverage(hashes: dict) -> dict:
    """Advisory scan of reviews/*.json: which verdicts cite a measured canonical hash."""
    cov = {t: {"verdicts": [], "accepts": [], "distinct_accept_reviewers": []} for t in hashes}
    for rp in sorted((ROOT / "reviews").glob("*.json")):
        try:
            text = rp.read_text()
            d = json.loads(text)
        except Exception:
            continue
        v = str(d.get("verdict", "")).lower()
        if v not in VERDICT_KINDS:
            continue
        reviewer = str(d.get("reviewer") or d.get("actor") or "?")
        for t in _targets_in_review(d):
            if t not in cov:
                continue
            h = (hashes.get(t, {}).get("sha256") or "")
            if h and h[:12] in text:
                cov[t]["verdicts"].append({"file": rp.name, "reviewer": reviewer, "verdict": v})
                if v == "accept":
                    cov[t]["accepts"].append({"file": rp.name, "reviewer": reviewer})
    for t, c in cov.items():
        c["distinct_accept_reviewers"] = sorted({a["reviewer"] for a in c["accepts"]})
        c["two_distinct_accepts"] = len(c["distinct_accept_reviewers"]) >= 2
        c["note"] = "advisory controller scan; binding coverage is adjudicated by the audit lead"
    return cov
```

