```python
def gate_audit(m, hashes, pub, soft, cov):
    gates = {g["gate_id"]: g for g in m.get("gates", [])}
    div = {p["canonical"]: p for p in pub["pairs"]}
    ledger_flags = [s for s in soft if "ledger/" in s]
    f0_flags = [s for s in soft if "F0 artifact" in s]
    f1_flags = [s for s in soft if "F1 artifact" in s]
    f2b_flags = [s for s in soft if "F2b artifact" in s]

    def h(nid): return (hashes.get(nid, {}).get("sha256") or "absent")[:12]
    def acc(t): return cov.get(t, {}).get("distinct_accept_reviewers", [])
    def accs(t):
        a = acc(t); return f"{len(a)} distinct accept reviewer(s)" + (f" {a}" if a else "")
    def verd(t): return [f"{x['reviewer']}:{x['verdict']}" for x in cov.get(t, {}).get("verdicts", [])]

    audit = {
        "G-F0": {
            "verdict": gates.get("G-F0", {}).get("verdict", "pending"),
            "checked_at": now(),
            "reason": (f"canonical taxonomy {h('F0')}; controller review scan: {accs('F0')}, "
                       f"verdicts at this hash {verd('F0') or 'none'}; two distinct independent accepts "
                       f"required. Publication pair F0 is {div.get('research_map/formulation_taxonomy.yaml', {}).get('status','unknown')}"
                       + (f"; {len(f0_flags)} class-separation soft flag(s) on F0 await disposition" if f0_flags else "")
                       + "."),
        },
        "G-FORM": {
            "verdict": ...,
            "reason": (f"F1/F2a/F2b measured canonical hashes {h('F1')}, {h('F2a')}, {h('F2b')}; "
                       f"publication: " + ", ".join(f"{p['canonical'].split('/')[-1]}={p['status']}" for p in pub['pairs'] if 'schemas/' in p['canonical']) +
                       f". Review scan at these hashes: F1 [{accs('F1')}], F2a [{accs('F2a')}], F2b [{accs('F2b')}]; "
                       "verdicts bound to superseded hashes are advisory only."
                       + (f" {len(f1_flags)} class-separation soft flag(s) on F1 await disposition." if f1_flags else "")
                       + (f" {len(f2b_flags)} ..." if f2b_flags else "")),
        },
        "G-LIT": ...,
        "G-NUM": ...,
        "G-AUDIT": ...,
    }
