def run_gate(path):
    p=subprocess.run([sys.executable, str(GATE), "--json", str(path)], capture_output=True, text=True)
    try: j=json.loads(p.stdout)
    except: j={"raw":p.stdout[:200]}
    return {"exit":p.returncode,"verdict":j.get("verdict"), "failed_rules":j.get("failed_rules")}
```

