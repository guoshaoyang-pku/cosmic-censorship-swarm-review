For `first_order_flag`, implement:
```python
_QUOTED = re.compile(r"'[^']{0,300}'|\"[^\"]{0,300}\"|‘[^’]{0,300}’|“([^”]{0,300})”")
_META = re.compile(r"\b(detector|pattern|regex|scanner|flag(?:s|ged)?|quote[sd]?|quoting|case label|fixture|corpus|probe|test|split|non-?merge|false[- ]positive|retired|moved|audit)\b", re.I)
_NEG = re.compile(r"\b(no|not|never|nor|without|rather than|0|zero)\b", re.I)
_ASSERT = re.compile(r"\b(is|are|as|form|forms|treat|treats|cover|covers|use|regard|merge[sd]?|unif(?:y|ied)|single class|one class)\b", re.I)
_COMPOSITE = re.compile(r"c\s*0\s*(?:/|or|and|,|\+)\s*c\s*2|c\s*2\s*(?:/|or|and|,|\+)\s*c\s*0", re.I)
def first_order_flag(text):
    t = _QUOTED.sub(" ", text)
    if not _COMPOSITE.search(t): return False
    if _META.search(t): return False
    # window around composite
    for m in _COMPOSITE.finditer(t):
        lo, hi = max(0,m.start()-120), min(len(t), m.end()+120)
        win = t[lo:hi]
        if _NEG.search(win): continue
        if _ASSERT.search(win): return True
    return False
```
