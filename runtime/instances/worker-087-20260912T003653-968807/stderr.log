def _iter_strings(obj, path=()):
    if isinstance(obj,str): yield path, obj
    elif isinstance(obj,dict):
        for k,v in obj.items(): yield from _iter_strings(v, path+(str(k),))
    elif isinstance(obj,list):
        for i,v in enumerate(obj): yield from _iter_strings(v, path+(str(i),))
```

