Implement:
```python
def semantic_diff(a, b, path="") -> list[str]:
    changed=[]
    if type(a) is not type(b):
        return [path or "$"]
    if isinstance(a, dict):
        for k in sorted(set(a)|set(b)):
            if k not in a or k not in b:
                changed.append(f"{path}.{k}")
            else:
                changed += semantic_diff(a[k], b[k], f"{path}.{k}")
    elif isinstance(a, list):
        if len(a)!=len(b): changed.append(path)
        else:
            for i,(x,y) in enumerate(zip(a,b)):
                changed += semantic_diff(x,y,f"{path}[{i}]")
    else:
        if a != b: changed.append(path)
    return changed
```
Assert set(changed) == EXPECTED_CHANGED_PATHS. If extra paths → abort exit 1.

