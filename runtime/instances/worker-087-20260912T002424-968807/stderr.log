```python
class StrictLoader(yaml.SafeLoader): pass
def _no_dup(loader, node, deep=False):
    mapping=set()
    for k,v in node.value:
        key=loader.construct_object(k, deep=deep)
        if key in mapping:
            raise yaml.constructor.ConstructorError(None,None,f"duplicate key {key!r}", k.start_mark)
        mapping.add(key)
    return loader.construct_mapping(node, deep=deep)
StrictLoader.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, _no_dup)
```
Careful: construct_mapping with deep. Standard recipe:
```python
def _construct_mapping(loader, node, deep=False):
    loader.flatten_mapping(node)
    pairs = []
    seen = set()
    for key_node, value_node in node.value:
        key = loader.construct_object(key_node, deep=deep)
        if key in seen:
            raise ConstructorError(...)
        seen.add(key)
        pairs.append((key, loader.construct_object(value_node, deep=deep)))
    return dict(pairs)
```
Hmm, `loader.construct_object` memoization can interfere. The common recipe uses `loader.construct_object(key_node, deep=deep)` and then calls construct_mapping on the original node... Simpler robust approach: scan lines with a regex for duplicate top-level and second-level keys like worker-16 did. But that's brittle. Alternative: use `yaml.compose_all` to get nodes, then walk mapping nodes checking duplicate scalar keys — no construction issues:
```python
def find_duplicate_keys(node, path=''):
    dups=[]
    if isinstance(node, yaml.MappingNode):
        seen={}
        for k,v in node.value:
            key = getattr(k,'value',None)
            if key in seen: dups.append((path, key, k.start_mark.line+1))
            else: seen[key]=v
            dups += find_duplicate_keys(v, path+'/'+str(key))
    elif isinstance(node, yaml.SequenceNode):
        for i,v in enumerate(node.value):
            dups += find_duplicate_keys(v, f'{path}[{i}]')
    return dups
```
Good, robust.

