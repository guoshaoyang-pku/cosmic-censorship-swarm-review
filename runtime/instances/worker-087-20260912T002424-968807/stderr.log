Strict duplicate key scan via yaml.compose.

```python
def duplicate_keys(text):
    dups=[]
    def walk(node, path):
        if isinstance(node, yaml.MappingNode):
            seen=set()
            for k,v in node.value:
                if isinstance(k, yaml.ScalarNode):
                    key=k.value
                    if key in seen:
                        dups.append({"path":path,"key":key,"line":k.start_mark.line+1})
                    seen.add(key)
                walk(v, path+"."+str(getattr(k,'value','?')))
        elif isinstance(node, yaml.SequenceNode):
            for i,v in enumerate(node.value):
                walk(v, f"{path}[{i}]")
    for doc in yaml.compose_all(text):
        walk(doc, "$")
    return dups
```

Detectors:

```python
SETBASED_RE = re.compile(r"contained in J\s*\^?\s*-?\s*\(?\s*I\s*\+|union of J", re.I)
DISOWN_RE = re.compile(r"set-based|variant|registered|strictly stronger|not a predicate|never be interchanged|must never|is not a predicate", re.I)
EQUIV_RE = re.compile(r"\bequivalently\b|\bequivalence\b|\bis equivalent to\b", re.I)
EQUIV_DISCLAIM_RE = re.compile(r"not an asserted equivalence|not equivalent|does not assert|no claim of equivalence|never be interchanged|not an equivalence", re.I)
BARE_GENERIC_RE = re.compile(r"\bfor generic data\b|\bfor a generic\b|\bgeneric data in the class\b", re.I)
TAIL_RE = re.compile(r"single-q\s+TAIL|tail\s+gamma|\bTAIL predicate\b", re.I)
COMEAGER_RE = re.compile(r"comeager", re.I)
```

```python
def sentences(text):
    t = " ".join(text.split())
    return [s for s in re.split(r"(?<=[.;])\s+", t) if s.strip()]

def assertive_setbased(text):
    return any(SETBASED_RE.search(s) and not DISOWN_RE.search(s) for s in sentences(text))

def asserted_equivalence(text):
    return any(EQUIV_RE.search(s) and not EQUIV_DISCLAIM_RE.search(s) for s in sentences(text))

def bare_generic(text, genericity_kind):
    if genericity_kind != "unresolved": return False
    return bool(BARE_GENERIC_RE.search(text)) and "unresolved" not in text.lower()
```

