```python
#!/usr/bin/env python3
"""make_regression.py -- build the negative-control fixture: current canonical F0 with the
historical (pre-rev5) AF-WCC-SCALAR-SPH conclusion text restored.

Used by run_all.py: the closure verifier must report CL1/CL2/CL3 OPEN on this fixture.
Writes only inside this artifact directory. Exit 0 ok, 1 verification failed, 2 anchor/abort.
"""
import ...
CLASS_KEY = '  "AF-WCC-SCALAR-SPH":'
BAD = fixtures/conclusion_bad_setbased.txt

def replace_conclusion_text(lines, bad_text):
    start = index of CLASS_KEY line (must be exactly 1)
    end = next line index > start where line starts with '  "' and index>start (next class) else len
    # find conclusion text block within [start,end)
    text_i = first i in range(start,end) where lines[i].rstrip()=='      text: >-'
    # text block ends at next line matching re ^      \S+:
    j = text_i+1
    while j<end and not re.match(r'^      [A-Za-z_][A-Za-z0-9_]*:', lines[j]): j+=1
    new_block = ['      text: >-\n'] + ['        '+l+'\n' for l in bad_text.rstrip('\n').split('\n')]
    return lines[:text_i] + new_block + lines[j:], (text_i+1, j)  # 1-based lines
```
