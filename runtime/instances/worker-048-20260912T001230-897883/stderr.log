```python
def key_before(line: str, col: int):
    best=None
    for m in KEY_RE.finditer(line):
        if m.start() < col: best=m.group(1)
        else: break
    return best

def block_key_for(lines, idx, indent):
    j=idx-1
    while j>=0:
        l=lines[j]
        if not l.strip() or l.lstrip().startswith("#"):
            j-=1; continue
        ind=len(l)-len(l.lstrip())
        if ind < indent:
            m=KEY_RE.match(l.lstrip())
            if m: return m.group(1), ind
            return None, ind
        j-=1
    return None, -1
```
