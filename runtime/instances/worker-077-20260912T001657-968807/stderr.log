Let me implement with html.parser for robustness:

```python
from html.parser import HTMLParser

class MetaParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.meta = {}
        self.authors = []
    def handle_starttag(self, tag, attrs):
        if tag != 'meta': return
        d = dict(attrs)
        name = d.get('name') or d.get('property')
        content = d.get('content')
        if not name or content is None: return
        name = name.lower()
        if name == 'citation_author':
            self.authors.append(content)
        elif name.startswith('citation_') or name in ('og:description','description'):
            self.meta.setdefault(name, content)

def parse_arxiv_abs(body):
    p = MetaParser(); p.feed(body.decode('utf-8','replace'))
    m = p.meta
    title = m.get('citation_title','')
    authors = p.authors
    date = m.get('citation_date') or m.get('citation_online_date') or ''
    abstract = m.get('citation_abstract') or m.get('og:description') or ''
    doi = m.get('citation_doi','')
    return {'title': unescape(title), 'authors':[unescape(a) for a in authors], 'year': date[:4], 'journal_ref':'', 'doi':doi, 'abstract': unescape(abstract), 'id': m.get('citation_arxiv_id','')}
```

