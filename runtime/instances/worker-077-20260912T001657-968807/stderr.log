```python
def first_family(authors):
    for a in authors:
        raw = str(a)
        if "," in raw:
            fam = raw.split(",")[0]
            fam = norm(fam)
            parts = fam.split()
            if parts: return parts[-1]
        parts = [p for p in norm(raw).split() if p]
        if parts: return parts[-1]
    return ""
```

