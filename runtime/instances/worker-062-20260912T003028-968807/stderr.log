CANDIDATE_SOURCES = ("evidence_url","doi","arxiv_id","url")
def candidates_for(row):
    out=[]
    for src in CANDIDATE_SOURCES:
        v=(row.get(src) or "").strip()
        if not v: continue
        if src=="doi": v="https://doi.org/"+v
