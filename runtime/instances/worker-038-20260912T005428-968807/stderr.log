K11 replacement with classification:

```python
SET_SUBJECT = re.compile(r"\bSET\b|union|outside J\^?-\(I\+\)|J\^?-\(I\+\) as a set", re.I)
HISTORICAL = re.compile(r"corrected from|was stronger|F0 was|pre-adjudication|earlier|prior|rev13 direction|historical", re.I)
NEGATION = re.compile(r"negation|NOT contained in the union|no such visible", re.I)

def _classify_mentions(text, label):
    pat = re.compile(r"strictly\s+(STRONGER|WEAKER)", re.I)
    out=[]
    for i,line in enumerate(text.splitlines(),1):
        for m in pat.finditer(line):
            s=max(0,m.start()-240); e=min(len(line),m.end()+240)
            window=line[s:e]
            subject = bool(SET_SUBJECT.search(window))
            historical = bool(HISTORICAL.search(window))
            negation = bool(NEGATION.search(window))
            direction = m.group(1).upper()
            operative = subject and not historical
            # The SET variant's NEGATION being stronger is consistent with the predicate being weaker.
            kind = ("historical" if historical else
                    "negation_consistent" if (negation and direction=="STRONGER") else
                    "operative" if subject else "other")
            out.append({... "direction":direction, "kind":kind, "operative_contradiction": kind=="operative" and direction=="STRONGER"})
    return out
```

