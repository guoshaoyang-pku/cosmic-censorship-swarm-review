K05 replacement:

```python
def check_k05_history(ctx):
    d = ctx.f1_yaml or {}
    hist = d.get("revision_history") or []
    problems=[]; notes=[]
    idx=[h.get("index") for h in hist]
    if idx != list(range(1,len(idx)+1)): problems.append(f"history indices {idx} are not 1..{len(idx)} unique-contiguous")
    if len(hist) < 11: problems.append(f"only {len(hist)} history entries")
    revised=str(d.get("revised_at",""))
    if not revised: problems.append("revised_at missing")
    allnotes=" || ".join(" ".join(h.get("notes") or []) for h in hist)
    for tag in ("rev12","rev13"):
        if tag not in allnotes: problems.append(f"history carries no {tag} delta note")
    if hist and "rev13" not in " ".join(hist[-1].get("notes") or []):
        problems.append("last history entry is not the rev13 delta")
    for h in hist:
        at=str(h.get("at",""))
        if revised and at > revised: problems.append(f"history entry {h.get('index')} dated after revised_at")
    ats=[h.get("at") for h in hist]
    monotone = ats == sorted(ats)
    return result("K05", not problems, ... ), {"monotone": monotone}
```

