def reproduce_claim(c, idx):
    out=[]  # (key, kind, detail)
    for key,val in c.items():
        if key in ('class_id','class_ids'):
            tmp=[]
            cs._scan_class_ids(val, f'claims[{idx}].{key}', tmp)
            for t in tmp: out.append({'key':key,'kind':'class_ids','finding':t})
            continue
        if key not in cs.DECLARATION_KEYS: continue
        vals=[]
        if isinstance(val,str): vals=[(key,val)]
        elif isinstance(val,list): vals=[(f'{key}[{i}]',v) for i,v in enumerate(val) if isinstance(v,str)]
        for k2,v2 in vals:
            for d in scan_text(v2,'prose'):
                out.append({'key':k2,'kind':'composite','detail':d,'value':v2})
    return out
```
