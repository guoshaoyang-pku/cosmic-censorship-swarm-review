```python
#!/usr/bin/env python3
"""W053-GCLASSBIND-INFOARM-REPRO-01 ..."""
import hashlib, json, subprocess, sys, time
from datetime import datetime, timezone, timedelta
from pathlib import Path

TZ = timezone(timedelta(hours=8))
def now(): return datetime.now(TZ).strftime('%Y-%m-%dT%H:%M:%S+08:00')

def sha256_file(p):
    h=hashlib.sha256()
    with open(p,'rb') as f:
        for c in iter(lambda: f.read(1<<20), b''): h.update(c)
    return h.hexdigest()

def find_root(start):
    p = start.resolve()
    for cand in [p, *p.parents]:
        if (cand/'research_map'/'schemas.py').exists() and (cand/'artifacts').is_dir():
            return cand
    raise SystemExit('root not found')

ROOT = find_root(Path(__file__).parent)
HERE = Path(__file__).parent
OUT = HERE
```

Stage runner replicating run_acceptance.run exactly, with timeout:

```python
def run_stage(tool, path, json_flag, timeout=60):
    args=[sys.executable, str(tool)] + (["--json", str(path)] if json_flag else [str(path)])
    t0=time.time()
    try:
        r=subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        rc=r.returncode; so=r.stdout; se=r.stderr
        crashed=False
    except subprocess.TimeoutExpired:
        return {"tool":str(tool.relative_to(ROOT)),"exit":None,"verdict":"timeout","failed_rules":[],"crash":True,"seconds":round(time.time()-t0,3),"stderr":"timeout"}
    if json_flag:
        try:
            d=json.loads(so); v=d.get("verdict","?"); fr=d.get("failed_rules",[])
        except Exception:
            v=f"crash(exit{rc})"; fr=[]; crashed=True
    else:
        try:
            d=json.loads(so); v=d.get("verdict")
            if v is None: v = "pass" if rc==0 else "fail"
            else: v = "pass" if str(v).lower() in ("accept","pass","ok") else "fail"
            fr=d.get("failed_rules",[])
        except Exception:
            v="pass" if rc==0 else "fail"; fr=[]; crashed=False
    return {...}
```

