Let me implement:
```python
def metadata_excerpt_support(excerpt, parsed_list):
    # returns dict with doi_match, quoted_title_sim
    dois = set(re.findall(r'10\.\d{4,9}/[^\s;,)\]]+', excerpt or ''))
    fetched_dois = set()
    for x in parsed_list:
        if x.get('doi'): fetched_dois.add(x['doi'].lower().rstrip('.'))
    doi_match = bool(dois) and any(d.lower().rstrip('.') in fetched_dois or any(d.lower().rstrip('.') in fd for fd in fetched_dois) for d in dois)
    qt = re.findall(r"'([^']{15,})'", excerpt or '')
    qsim = max((title_sim(q, x.get('title','')) for q in qt for x in parsed_list if x.get('title')), default=None)
    return {"dois_in_excerpt": sorted(dois), "fetched_dois": sorted(fetched_dois), "doi_match": doi_match, "quoted_title_similarities": [...], "quoted_title_max_sim": qsim}
```
