def build_farm(tmp: Path, map_mutator=None, extra_files=None, pin_override=None) -> Path:
    # symlink every top-level entry
    for child in ROOT.iterdir():
        if child.name in ('research_map',):
            continue
        os.symlink(child, tmp/child.name)
    # research_map real dir with symlinks except research_map.json copied+mutated
    (tmp/'research_map').mkdir()
    for f in (ROOT/'research_map').iterdir():
        if f.name == 'research_map.json': continue
        os.symlink(f, tmp/'research_map'/f.name)
    m = json.load(open(ROOT/'research_map/research_map.json'))
    if map_mutator: map_mutator(m)
    (tmp/'research_map'/'research_map.json').write_text(json.dumps(m))
```

