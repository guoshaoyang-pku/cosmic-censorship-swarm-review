```python
if isinstance(node, ast.Subscript):
    base = node.value
    if isinstance(base, ast.Attribute) and base.attr == "parents":
        n = node.slice.value if isinstance(node.slice, ast.Constant) else None
        inner = self.strip_resolve_chain(base.value)
