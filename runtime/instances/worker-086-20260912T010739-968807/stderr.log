```python
def _hits(path, patterns):
    lines = path.read_text().splitlines()
    out=[]
    for i,ln in enumerate(lines,1):
        for p in patterns:
            if re.search(p, ln, re.I):
                out.append({"line":i,"pattern":p,"text":ln.strip()[:220]})
                break
    return out

def external_discharge():
    canon = ROOT/"research_map"/"formulation_taxonomy.yaml"
    supp = ROOT/"artifacts"/"formulation"/"formulation_taxonomy.yaml"
    cclass = json.dumps((yaml.safe_load(canon.read_text()).get("classes") or {}).get("AF-SCC-C2-VAC-GEN") or {})
    pats = {...}
    out={}
    for axis,ps in pats.items():
        ch=_hits(canon,ps); sh=_hits(supp,ps)
        out[axis]={
          "class_contract_hits":[p for p in ps if re.search(p,cclass,re.I)],
          "f0_canonical_lines":ch,
          "f0_supplement_lines":sh,
          "explicit_unresolved_flag": any("unresolved" in h["text"].lower() for h in ch+sh),
          "fixing_statement_found": False,  # none of the hits states a convention for AF-SCC-C2-VAC-GEN
        }
    return out
```
