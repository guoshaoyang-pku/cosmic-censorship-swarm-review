```python
def publication_status() -> dict:
    pairs = []
    for entry in MIRRORS:
        canonical, authoring, mode = entry
        ...
        if cp.is_file() and ap.is_file():
            ch, ah = sha256(cp), sha256(ap)
            if mode == "mirror":
                status = "aligned" if ch == ah else "divergent"
            else:
                status = "companion-pinned" if (ch and ah) else "missing"
            rec.update(canonical_sha256=ch, authoring_sha256=ah, status=status)
        rec["classification"] = mode
        if mode == "companion":
            rec["note"] = ("distinct artifacts per FROZEN.logical_artifacts: the canonical path is "
                           "the declared F0 taxonomy, the authoring path is the class-contract "
                           "supplement (F0-R). Byte-identity is not a publication requirement for "
                           "this pair (astra-life04 adjudication REC-3); each path must be pinned and "
                           "consistency-checked.")
        pairs.append(rec)
    return {"checked_at": now(), "policy": "... mirror pairs byte-identical; companion pairs are distinct artifacts pinned + consistency-checked ...",
            "pairs": pairs,
            "divergent": sum(1 for p in pairs if p["status"] == "divergent"),
            "companion_pairs": sum(1 for p in pairs if p.get("classification") == "companion")}
```

