def judge_record(ledger_title, ledger_year, rec, basis):
    c = containment(...)
    ys = rec.get('year_candidates') or ([rec['year']] if rec.get('year') else [])
    deltas = [abs(int(ledger_year)-y) for y in ys if y and str(ledger_year).isdigit()]
    best = min(deltas) if deltas else None
    if c >= 0.75:
        if basis == 'arxiv':
            verdict = 'MATCH'  # identity rests on title for preprint-year sources
            year_advisory = best is not None and best > 1
        else:
            if best is None or best <= 1: verdict='MATCH'
            elif best <= 2: verdict='PARTIAL'
            else: verdict='MISMATCH'
    elif c >= 0.45: verdict='PARTIAL'
    else: verdict='MISMATCH'
```
