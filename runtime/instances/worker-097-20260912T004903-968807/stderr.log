def parse_ref(s):
    s = s.strip().strip('`').strip()
    if not s or s.startswith(('http://','https://')): return None
    # fragments
    frag = None
    if '#' in s:
        path, frag = s.split('#',1)
    else:
        path = s
    # line refs: trailing :N or :N-M  (only if path not exists as-is)
    m = re.search(r':(\d+)(?:-(\d+))?$', path)
    line = None
    if m and not (ROOT/path).exists():
        line = m.group(1); path = path[:m.start()]
    return path, frag, line
```
