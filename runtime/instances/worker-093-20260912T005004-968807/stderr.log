Extraction:

```python
VERDICT_KEYS=("verdict","verdict_recommendation","review_verdict","disposition")
def normalize_verdict(v):
    if not isinstance(v,str): return None
    s=v.strip().lower().replace("-","_").replace(" ","_")
    syn={"accepted":"accept","accepts":"accept","revision":"revise","revise_required":"revise","rejected":"reject","inconclusive_":"inconclusive","inconclusive_verdict":"inconclusive","no_verdict":None}
    s=syn.get(s,s)
    return s if s in VERDICTS else None

def pick_verdict(d):
    for k in VERDICT_KEYS:
        n=normalize_verdict(d.get(k))
        if n: return n,k,"top"
    rec=d.get("recommendation")
    if isinstance(rec,dict):
        for k in VERDICT_KEYS+("ruling",):
            n=normalize_verdict(rec.get(k))
            if n: return n,"recommendation."+k,"nested"
    if isinstance(rec,str):
        n=normalize_verdict(rec)
        if n: return n,"recommendation","top"
    return None,None,None
```

