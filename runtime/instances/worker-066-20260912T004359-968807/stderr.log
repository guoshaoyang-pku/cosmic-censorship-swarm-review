def norm_token(s):
  t=s.strip()
  tl=t.lower().replace('{','').replace('}','').replace('^','').replace('_','').replace(' ','')
  if tl in ('c0','c0metric','c0distributionalvacuum'): return 'C0'
  if tl.startswith('c2'): return 'C2'
  if tl in ('h2loc','h2locmetric'): return 'H2LOC'
  if tl in ('c11','c11metric'): return 'C11'
  return None

