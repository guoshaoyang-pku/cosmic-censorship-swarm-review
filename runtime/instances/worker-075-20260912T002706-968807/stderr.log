```
def disjoint_decompositions(target, max_parts=9, limit=10):
    names = [n for n in counts if counts[n]>0]
    # compatibility: pair (a,b) disjoint if ids_a & ids_b == empty
    compat = {a: set(b for b in names if b!=a and not (ids[a]&ids[b])) for a in names}
    results=[]
    def bk(R, P):
        if len(results)>=limit: return
        # check sum pruning: current sum
        s=sum(counts[n] for n in R)
        if s==target:
            results.append(tuple(sorted(R))); # continue? adding more files would exceed target since counts>0
            return
        if s>target or len(R)>=max_parts: return
        # bound: max possible additional sum from P
        if s + sum(sorted((counts[n] for n in P), reverse=True)[:max_parts-len(R)]) < target: return
        for n in sorted(P):
            bk(R|{n}, P & compat[n] & {m for m in names if m>n})
    ...
```
Simpler standard Bron-Kerbosch with pivot not needed; use the sum bound to prune heavily.

