```
def disjoint_sums(target, max_parts=9, limit=5):
    items = sorted(counts.items(), key=lambda kv: -kv[1])
    found=[]
    def rec(i, rem, chosen):
        if len(found)>=limit: return
        if rem==0:
            ids=set()
            for c in chosen: ids|=file_ids.get(c,set())
            if len(ids)==target: found.append(tuple(chosen))
            return
        if i>=len(items) or len(chosen)>=max_parts: return
        name,val=items[i]
        if val<=rem:
            chosen.append(name); rec(i+1, rem-val, chosen); chosen.pop()
        rec(i+1, rem, chosen)
    rec(0,target,[])
    return found
```
