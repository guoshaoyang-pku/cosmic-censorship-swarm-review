Memory-safe final-state runner:
```python
def run_final(scheme, dr, dt, r_max=30.0, t_end=6.0, pulse=None):
    pulse = pulse or rep.PulseExact()
    r = rep.grid(r_max, dr)
    factory = rep.make_factory(scheme, pulse=pulse)
    solver = factory(r, dt)
    steps = 0
    cap = int(math.ceil(t_end / dt)) * 10 + 100
    while solver.t < t_end - 1e-12:
        solver.step(); steps += 1
        if steps > cap:
            raise RuntimeError(...)
    return {"r": r, "solver": solver, "steps": steps, "t": float(solver.t)}
```

