Implement controls via a generic `run_control(name, mutate_fn, expect)`:
```
def run_control(name, mutate, expect_fail_ids, expect_live_check):
    d = os.path.join(SANDBOX, name)
    if os.path.exists(d): shutil.rmtree(d)
    build_sandbox(d)              # copies baseline files
    mutate(d)                     # mutate copies
    liveness, live_detail = expect_live_check(d)   # e.g. assert mutation present
    res = evaluate(d, enforce_pins=False)
    fails = sorted(f['id'] for f in res['findings'] if not f['ok'])
    ok = (fails == sorted(expect_fail_ids)) and liveness
```
