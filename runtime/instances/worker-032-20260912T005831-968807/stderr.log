```python
_CASE_LABEL_BIND = re.compile(r"(?:TC-[A-Z0-9]+(?:-[A-Z0-9]+)*|SPLIT_REQUIRED|NEW_CLASS_REQUIRED)\s*\(?\s*(?:merged\s+|unified\s+)?$", re.I)
_NEG_SEPARATE = re.compile(r"\b(?:not|never|no\s+longer)\s+(?:separate[ds]?|distinct|split)\b", re.I)
_PROHIBIT_MERGE = re.compile(r"\b(?:do\s+not|don'?t|never|must\s+not|should\s+not|avoid|no\s+\w+\s+may)\s+(?:\w+\s+){0,2}(?:merge|merging|merged|combine|combined|unify|unified|conflate)\b", re.I)
_NEG_MERGE_POST = re.compile(r"\bnot\s+(?:a\s+|the\s+)?(?:merged|unified|single|combined|one)\b", re.I)
_REJECT_FRAME = re.compile(r"\b(?:rejects?|rejected|denies|denied|refuses?|refused|refutes?|refuted)\s+(?:(?:\w+\s+){0,2}(?:claim|assertion|reading|proposal|statement)s?\s+)?that\b", re.I)
_WHETHER = re.compile(r"\bwhether\b", re.I)
_APPOSITIVE_BIND = re.compile(r"\b(?:are|is|were|was)\s+(?:one|the\s+same|a\s+single)\s*[:;,]\s*$", re.I)
```
