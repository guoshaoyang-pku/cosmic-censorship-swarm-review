def _scan_composite(text, where, out, mode="declaration"):
    t = norm(text)
    for m in _MERGE_PAT.finditer(t):
        if _BENIGN.search(...): continue
        # clause-local scope: boundaries . ! ? ; : and em-dash; take clause containing the match
