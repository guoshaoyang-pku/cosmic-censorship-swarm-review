```python
def raw_definition_block(raw_text, indent_anchor="extension_predicate:"):
    lines = raw_text.splitlines()
    start = None
    for i,l in enumerate(lines):
        if re.match(r'^\s*' + re.escape(indent_anchor) + r'\s*$', l):
            for j in range(i+1, len(lines)):
                m = re.match(r'^(\s*)definition:\s*>[-+]?\s*$', lines[j])
                if m:
                    base = len(m.group(1))
                    block = []
                    k = j+1
                    while k < len(lines):
                        l2 = lines[k]
                        if l2.strip() == "":
                            block.append("")
                            k += 1
                            continue
                        ind = len(l2) - len(l2.lstrip())
                        if ind <= base:
                            break
                        block.append(l2)
                        k += 1
                    return "\n".join(block)
    return None
```

