For containment parsing:
```python
def parse_containment(text):
    # returns set of (subset, superset) pairs
    edges=set()
    for m in re.finditer(r'(E_\{?[^,;\s]+\}?)\s+contains\s+(E_\{?[^,;\s]+\}?)', text):
        a=norm(m.group(1)); b=norm(m.group(2)); edges.add((b,a))  # b subset a
    for m in re.finditer(r'(E_\{?[^,;\s]+\}?)\s+(?:is\s+)?(?:a\s+)?subset\s+of\s+(E_\{?[^,;\s]+\}?)', text):
        a=norm(m.group(1)); b=norm(m.group(2)); edges.add((a,b))
    return edges
```
