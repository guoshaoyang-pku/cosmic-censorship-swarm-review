Implement:
```python
def containment_edges(text):
    matches = list(TOKEN_RE.finditer(text))
    edges=set()
    for m1,m2 in zip(matches, matches[1:]):
        between = text[m1.end():m2.start()]
        if re.search(r"\bcontains\b", between): edges.add((norm_token(m2.group(0)), norm_token(m1.group(0))))
        elif re.search(r"subset\s+of", between): edges.add((norm_token(m1.group(0)), norm_token(m2.group(0))))
    return edges
```
