```python
METADATA_LABEL_RE = re.compile(r"\s*\b(?:journal[- ]ref|journal reference|journal|venue|doi|arxiv(?:\s*id)?|publisher|comments|url)\s*[:\-]", re.I)

def clean_excerpt(evidence_excerpt: str) -> str:
    q = strip_quotes(LABEL_RE.sub("", (evidence_excerpt or "").strip()))
    q = re.sub(r"[\u2026]\s*$", "", q)
    m = METADATA_LABEL_RE.search(q)
    if m and m.start() > 40:
        q = q[:m.start()].strip()
    return q
```
Then quote_check uses `q = clean_excerpt(...)`; quote_contradiction uses `q = norm(clean_excerpt(...))`.

