Quote grounding function:
```
LABEL_RE = re.compile(r'^\s*(?:arxiv\s+abstract(?:\s*\(exact excerpt\))?|springer\s+abstract|international\s+press\s+abstract|crossref\s+record|abstract|excerpt)\s*[:\-]\s*', re.I)
def norm(s):
    s = unicodedata.normalize('NFKD', s)
    s = s.encode('ascii','ignore').decode()
    s = re.sub(r'\$[^$]*\$', ' ', s)  # drop inline math
    s = re.sub(r'\\[a-zA-Z]+', ' ', s)
    s = s.lower()
    s = re.sub(r'[^a-z0-9]+', ' ', s)
    return re.sub(r'\s+', ' ', s).strip()
def strip_wrapping_quotes(s): ...
def quote_check(ledger_excerpt, abstract):
    if not abstract: return 'no_abstract_available'
    if not ledger_excerpt: return 'not_checked'
    q = LABEL_RE.sub('', ledger_excerpt.strip())
    q = strip_wrapping_quotes(q)
    # remove trailing truncation marker
    q = re.sub(r'[\u2026]\s*$','', q)
    segs = [s for s in re.split(r'\s*(?:\.\.\.|\u2026)\s*', q) if len(norm(s).split())>=3]
    if not segs: return 'not_found_in_abstract'
    a = norm(abstract)
    hits = [norm(s) in a for s in segs]
    frac = sum(hits)/len(segs)
    if frac >= 0.8 and any(len(norm(s).split())>=6 for s,h in zip(segs,hits) if h):
        return 'grounded_in_abstract'
    sm = difflib.SequenceMatcher(None, norm(q), a)
    if sm.ratio() >= 0.6: return 'close_paraphrase'
    return 'not_found_in_abstract'
```
Careful: `norm(s) in a` for short segments may match trivially, but we require ≥3 tokens and a ≥6-token hit for grounding.

