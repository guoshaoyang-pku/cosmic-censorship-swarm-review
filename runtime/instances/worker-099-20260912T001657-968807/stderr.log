For http_get:
```python
LAST_CALL = {}
MIN_INTERVAL = {"export.arxiv.org": 4.0, "api.crossref.org": 2.0, "inspirehep.net": 1.0}

def http_get(url, attempts=5):
    host = urllib.parse.urlparse(url).netloc
    delay = MIN_INTERVAL.get(host, 1.0)
    last = 0.0
    for k in range(attempts):
        wait = delay - (time.time() - last)
        if wait > 0: time.sleep(wait)
        req = urllib.request.Request(url, headers=UA)
        try:
            with urllib.request.urlopen(req, timeout=45) as r:
                LAST_CALL[host] = time.time()
                return r.status, r.read()
        except urllib.error.HTTPError as e:
            LAST_CALL[host] = time.time()
            if e.code in (429, 500, 502, 503, 504) and k < attempts-1:
                ra = e.headers.get("Retry-After") if e.headers else None
                back = float(ra) if (ra and str(ra).isdigit()) else min(60.0, 6.0 * (2 ** k))
                time.sleep(back)
                continue
            raise
    raise RuntimeError("unreachable")
```
Need `import urllib.error, urllib.parse`.

