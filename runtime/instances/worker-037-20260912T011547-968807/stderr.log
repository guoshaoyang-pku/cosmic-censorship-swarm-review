def live_instrument_control():
    import importlib.util
    p = ROOT / LIFECYCLE
    spec = importlib.util.spec_from_file_location("w037_live_astra", p)
    mod = importlib.util.module_from_spec(spec)
    sys.path.insert(0, str(ROOT / "research_map"))
    spec.loader.exec_module(mod)
    cov = mod.review_coverage({"F2b": {"sha256": EXPECTED_F2B}})
    f2b = cov.get("F2b", {})
    live_files = sorted(e["file"] for e in f2b.get("verdicts", []))
    return {"pass": f2b.get("distinct_accept_reviewers") == ["worker-052","worker-071","worker-090"]
                    and live_files == sorted(scan_rule(rows)["files"]),
            "live_files": live_files, "live_accepts": f2b.get("distinct_accept_reviewers"),
            "instrument_sha256": sha256_file(p)}
```

