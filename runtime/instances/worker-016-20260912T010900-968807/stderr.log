H2 check:
```python
def check_h2(doc, raw):
    mnc = doc['regularity']['must_not_conflate']
    entries = [e for e in mnc if isinstance(e,str) and 'H2_loc' in e]
    denial = None
    for e in entries:
        stripped = re.sub(r'\[[^\]]*\]','',e)  # drop bracketed historical notes
        if re.search(r'no\s+containment\s+with\s+(C2|C0)', stripped, re.I):
            denial = e
    chain = doc['implication_ledger']['extension_class_containment']
    entail = doc['implication_ledger']['one_way_entailments']
    containment_asserted = ('E_H2loc' in chain) or any('H2_loc' in str(r.get('from',''))+str(r.get('to','')) for r in entail)
    fires = denial is not None and containment_asserted
```
