#!/usr/bin/env python3
"""..."""
import datetime, hashlib, json, os, re, sys
import yaml

ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", ".."))
OUT = os.path.dirname(os.path.abspath(__file__))
