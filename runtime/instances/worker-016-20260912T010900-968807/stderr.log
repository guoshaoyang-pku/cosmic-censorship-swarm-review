def flatten(o, prefix=""):
    out={}
    if isinstance(o,dict):
        for k,v in o.items(): out.update(flatten(v, f"{prefix}.{k}" if prefix else str(k)))
    elif isinstance(o,list):
        for i,v in enumerate(o): out.update(flatten(v, f"{prefix}[{i}]"))
    else: out[prefix]=o
    return out
```
