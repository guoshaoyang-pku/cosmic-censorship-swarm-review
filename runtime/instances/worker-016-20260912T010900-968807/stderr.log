```python
def check_h1(doc, raw):
    row = [r for r in doc['implication_ledger']['forbidden_transfers'] if r.get('from')=='no proper future C2 extension' and r.get('to')=='this class']
    ...
    reason = row[0]['reason']
    chain = doc['implication_ledger']['extension_class_containment']
    toks, rank = e_c2_position(chain)
    says_larger = bool(re.search(r'\blarger\b', reason))
    says_smaller = bool(re.search(r'\bsmaller\b', reason))
    inverted = (says_larger and rank=='smallest') or (says_smaller and rank=='largest')
    premise_word = 'larger' if says_larger else ('smaller' if says_smaller else None)
    repaired = (premise_word=='smaller' and rank=='smallest') or (premise_word=='larger' and rank=='largest')
    fires = inverted
```
