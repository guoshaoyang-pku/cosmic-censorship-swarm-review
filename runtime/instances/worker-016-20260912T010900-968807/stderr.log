DECLARED = {...}
CANDIDATES = {"candidate_84b5d3fa": {...}, "candidate_98f9ec83": {...}}

def sha256_path(rel): ...
def line_of(text, needle): ...

def flatten(o, prefix=""): -> dict path->scalar (for diff)
def diff_paths(a,b): ...

def chain_info(text):
    toks = re.findall(r"E_(?:\{[^}]*\}|[A-Za-z0-9_]+)", text)
    # joiners
    return toks

def e_c2_position(chain_text):
    toks = chain_info(chain_text)
    # find index of E_C2 and whether chain uses 'contains' or 'subset of'
    contains = 'contains' in chain_text.lower()
    subset = 'subset' in chain_text.lower()
    idx = next(i for i,t in enumerate(toks) if t=='E_C2')
    if contains and not subset: rank = 'smallest' if idx==len(toks)-1 else ('largest' if idx==0 else 'middle')
    elif subset and not contains: rank = 'smallest' if idx==0 else ('largest' if idx==len(toks)-1 else 'middle')
    else: rank='ambiguous'
    return toks, rank
```

