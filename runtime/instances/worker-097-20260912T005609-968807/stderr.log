Implementation:
```python
def h3b_containment_denial(d, raw, ctx):
    reg=d.get('regularity') or {}
    clauses=[c for c in (reg.get('must_not_conflate') or [])]
    denial=re.compile(r'no\s+containment\s+with\s+(C2|C0|C2 or C0)', re.I)
    repair_marker=re.compile(r'was wrong|corrected|repaired', re.I)
    hits=[]
    for i,c in enumerate(clauses):
        if denial.search(c):
            if repair_marker.search(c):
                continue
            hits.append({'path':f'regularity.must_not_conflate[{i}]','text':c})
    # positive: the artifact asserts containment
    cont=(d.get('implication_ledger') or {}).get('extension_class_containment','')
    asserts = ('E_C0 contains' in cont) and ('E_C2' in cont)
    problems=[]
    if hits and asserts:
        problems.append(f"{len(hits)} live containment-denial clause(s) contradict extension_class_containment")
    return {...}
```
