    # declaration style + line spans
    style={}
    for name,(cls,p) in SCHEMAS.items():
        text=open(p).read(); lines=text.splitlines()
        block=[i+1 for i,l in enumerate(lines) if re.match(r'^\s+s:\s',l)]  # block-style s line
        flow=[i+1 for i,l in enumerate(lines) if re.search(r'\{[^}]*\bs:\s',l)]
        style[name]={"block_style_s_lines":block,"flow_style_lines":flow}
    out["declaration_style"]=style
    # competing values scan
    values={"s":{}, "delta":{}}
    for name,(cls,p) in SCHEMAS.items():
        text=open(p).read()
        for axis,rx in (("s",r'\bs\s*>\s*[0-9]+(?:\s*/\s*[0-9]+)?'),("delta",r'delta\s+in\s*\([^)]*\)')):
            vals=sorted(set(re.findall(rx,text)))
            values[axis][name]=vals
    out["distinct_spec_values"]=values
    out["competing_specs"]={
       "s": sorted(set(v for per in values["s"].values() for v in per)),
       "delta": sorted(set(v for per in values["delta"].values() for v in per)),
    }
    # canonical values
    out["canonical_values"]={a: out[a]["F1"] for a in ("s","delta","spaces")}
    ...
```
