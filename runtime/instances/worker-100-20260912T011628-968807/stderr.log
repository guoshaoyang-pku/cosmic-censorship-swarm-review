def axis_hits(obj, max_depth=2):
    # BFS over dict values with depth counting: record itself depth 0; keys of nested dicts at depth d are checked when d<=max_depth
    hits=set()
    def walk(o, depth):
        if isinstance(o,dict):
            for k,v in o.items():
                if k in AXES: hits.add(k)
                if isinstance(v,dict) and depth+1<=max_depth: walk(v,depth+1)
    walk(obj,0)
