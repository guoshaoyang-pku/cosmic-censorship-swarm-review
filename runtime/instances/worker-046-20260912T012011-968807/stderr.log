```python
def clause_map(defn):
    # split folded block into clauses (a)..(f)
    txt = re.sub(r'\s+', ' ', defn)
    marks = list(re.finditer(r'\(([a-f])\)\s', txt))
    out={}
    for i,m in enumerate(marks):
        end = marks[i+1].start() if i+1<len(marks) else len(txt)
        out[m.group(1)] = txt[m.end():end].strip()
    return out
```

