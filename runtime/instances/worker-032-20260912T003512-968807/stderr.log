Evaluation semantics — mirror the author's:
```python
def getpath(doc, path):
    cur=doc
    for name,idx in TOKEN.findall(path):
        if name:
            if isinstance(cur,dict) and name in cur: cur=cur[name]
            else: return False,None
        else:
            if isinstance(cur,list) and int(idx)<len(cur): cur=cur[int(idx)]
            else: return False,None
    return True,cur

def flat(v): return json.dumps(v, default=str, ensure_ascii=False)

def evaluate(doc,spec):
    found,value=getpath(doc,spec['path']); kind=spec['kind']; needle=spec.get('value',spec.get('expected'))
    if kind in ('path_exists','nonnull'): ok=found and value is not None
    elif kind=='is_none': ok=(not found) or value is None
    elif kind=='is_true': ok=value is True
    elif kind=='equals': ok=found and value==needle
    elif kind=='contains': ok=found and value is not None and needle in flat(value)
    else: raise ValueError(kind)
    return {'found':found,'pass':bool(ok),'value_norm': None if not found else flat(value)}
```

