def _construct_mapping(loader, node, deep=False):
    keys=[]
    for k in node.value:
        key = loader.construct_object(k[0], deep=deep)
        if key in keys: raise yaml.constructor.ConstructorError(None,None,f"duplicate key {key!r}", k[0].start_mark)
        keys.append(key)
