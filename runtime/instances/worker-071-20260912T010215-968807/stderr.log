def walk(obj, path=""):
    if isinstance(obj, dict):
        for k,v in obj.items(): yield from walk(v, f"{path}.{k}" if path else str(k))
    elif isinstance(obj, list):
        for i,v in enumerate(obj): yield from walk(v, f"{path}[{i}]")
    else: yield path, obj
```

