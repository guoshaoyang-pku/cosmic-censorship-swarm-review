Implementation of step A:
```python
def nest_revised_at_unused(text):
    lines = text.splitlines(keepends=True)
    idx = None
    for i,l in enumerate(lines):
        m = re.match(r"^revised_at_unused:\s*(.*)$", l)
        if m: idx=i; break
    if idx is None: return text, None
    value = lines[idx].rstrip("\n")
    if value.endswith("\n"): ...
    # find top-level extensions:
    ext = None
    for i,l in enumerate(lines):
        if re.match(r"^extensions:\s*$", l): ext=i; break
    if ext is not None:
        new_lines = lines[:idx] + lines[idx+1:]
        # insert after ext line
        new_lines.insert(ext+1, "  revised_at_unused: " + value.split(":",1)[1].strip() + "\n")
    else:
        new_lines = lines[:idx] + ["extensions:\n", "  revised_at_unused:" + value.split(":",1)[1] + "\n"] + lines[idx+1:]
    return "".join(new_lines), info
```
Careful with value formatting: original line `revised_at_unused: '2026-09-11T23:30:35+08:00'` → new `  revised_at_unused: '2026-09-11T23:30:35+08:00'`.

