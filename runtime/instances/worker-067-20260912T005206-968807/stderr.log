```python
def step(self):
    if not self._started:
        self.psi_prev, self.psi, self._started = self.psi, self.psi1, True
        self.t += self.dt
        return
    rhs = 2.0*self.M.matvec(self.psi[1:-1]) - self.B_wrong.matvec(self.psi_prev[1:-1])
    nxt = np.zeros_like(self.psi)
    nxt[1:-1] = self.B.solve(rhs)
    self.psi_prev, self.psi = self.psi, nxt
    self.t += self.dt
```

Order study function:
```python
def order_for(factory, drs, cfl=0.5, r_max=30.0, t_end=6.0):
    pulse=mod.PulseExact(); rows=[]
    for dr in drs:
        case = mod.run_case(factory, dr, cfl, r_max, t_end)
        err = mod.l2_error(case['psi'][-1], pulse.psi(case['r'], case['t'][-1]), dr)
        rows.append({'dr':dr,'dt':case['dt'],'steps':case['steps'],'l2_error':err})
    errs=[x['l2_error'] for x in rows]
    return {'rows':rows,'fit_order':mod.fit_order(drs,errs),'pair_orders':mod.pair_orders(drs,errs),'monotone':all(errs[i+1]<errs[i] for i in range(len(errs)-1))}
```
