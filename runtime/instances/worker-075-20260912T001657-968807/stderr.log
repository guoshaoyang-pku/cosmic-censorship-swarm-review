def norm_tokens(s):
    s = unicodedata.normalize('NFKD', s or '')
    s = re.sub(r'\$[^$]*\$',' ',s)
    s = re.sub(r'\\[a-zA-Z]+',' ',s)
    s = s.lower()
    toks = re.findall(r'[a-z0-9]+', s)
    return toks
```

