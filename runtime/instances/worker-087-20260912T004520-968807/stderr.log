freeze_state:
```python
def freeze_state(root, records, doc_index, rev28_measured):
    frozen_path = root/FROZEN_PATH
    frozen = json.loads(frozen_path.read_text())
    files = frozen.get("files") or {}
    state = {"frozen_manifest": {"path":..., "revision": frozen.get("revision"), "frozen_at":..., "measured_sha256":..., "expected_sha256": FROZEN_SHA, "self_match": ...}, "targets": {}}
    for node, spec in PINS.items():
        mp = root/spec["path"]; mt = mp.stat().st_mtime
        cur = sha256_file(mp)
        ap = root/AUTHORING_PATHS[node]; a_cur = sha256_file(ap) if exists
        fentry = files.get(spec["path"], {})
        aentry = files.get(AUTHORING_PATHS[node], {})
        text = mp.read_text()
        rev = re.search(r"^revision:\s*(\d+)", text, re.M)
        rev_at = re.search(r'^revised_at:\s*"([^"]+)"', text, re.M)
        ev = re.search(r'consistency_evidence_sha256:\s*"([0-9a-f]{64})"', text)
        ann = announcement_events(records, spec["path"], cur[:12])
        state["targets"][node] = {
          "canonical_path":..., "rev28_pin": spec["sha256"], "measured_sha256": cur, "matches_rev28_pin": cur==spec["sha256"],
          "mtime": datetime.fromtimestamp(mt, CST).isoformat(),
          "authoring_path":..., "authoring_sha256": a_cur, "mirror_equal_to_canonical": a_cur==cur,
          "frozen_files_entry_sha256": fentry.get("sha256"), "frozen_entry_matches_disk": fentry.get("sha256")==cur,
          "authoring_frozen_entry_matches_disk": aentry.get("sha256")==a_cur,
          "declared_revision": int(rev.group(1)) if rev else None,
          "declared_revised_at": rev_at.group(1) if rev_at else None,
          "f0_binding_consistency_evidence_sha256": ev.group(1) if ev else None,
          "consistency_evidence_pin_refreshed": bool(ev and ev.group(1)==EXPECTED_EVIDENCE_SHA),
          "announcing_artifact_events": ann,
          "owner_announcement_present": len(ann)>0,
        }
    state["evidence_artifact"] = {"path":..., "measured_sha256": ..., "expected": EXPECTED_EVIDENCE_SHA, "match": ...}
    state["breach_summary"] = {...counts...}
    return state
```

announcement_events(records, path, pin12): iterate records (deduped), event_type artifact, str(path)==path, and (sha256 startswith pin12 or pin12 in json dump) → list of {event_id, actor, created_at, sha256} sorted by created_at.

