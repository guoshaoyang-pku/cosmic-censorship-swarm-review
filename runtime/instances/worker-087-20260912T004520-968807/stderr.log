CLASS_TOKENS = {"af-wcc-vac-gen","af-scc-c2-vac-gen","af-scc-c0-vac-gen","af-wcc-scalar-sph"}

def _is_node_target(head, spec):
    if not head: return False
    if Path(head).name == Path(spec["path"]).name: return True
    parts = [p for p in re.split(r"[,;/+ ]+", head.lower()) if p]
    if parts and all(p in NODE_TOKENS | CLASS_TOKENS for p in parts):
        return any(p == spec["tokens"][0] or p in spec["tokens"] for p in parts)
    return False
```
