Implementation:
```python
def is_full_schema_verdict(rec, spec):
    cf = rec.get("counts_as_full_schema_verdict")
    if cf is False: return False, "declared_false"
    tid = str(rec.get("target_id") or "")
    head = tid.split("#")[0].strip()
    base = Path(head).name if head else ""
    if _word_hit(head, spec["tokens"][0]) or _word_hit(head, spec["tokens"][1]) or (base and base == Path(spec["path"]).name):
        return True, "target_id_names_schema"
    art = str(rec.get("artifact") or rec.get("artifact_path") or rec.get("path") or "")
    if Path(art.split("#")[0]).name == Path(spec["path"]).name:
        return True, "artifact_names_schema"
    if head.startswith(("reviews/", "artifacts/", "runtime/", "ledger/", "research_map/")):
        return False, "target_is_secondary_document"
    nid = str(rec.get("node_id") or rec.get("node") or "")
    if _word_hit(nid, spec["tokens"][0]):
        return True, "node_id_names_schema"
    if cf is True: return True, "declared_true"
    return False, "no_schema_target"
```
