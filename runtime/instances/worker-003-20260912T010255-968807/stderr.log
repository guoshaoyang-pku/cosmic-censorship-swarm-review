Details on mention-aware normalization:
def strip_mentions(s):
    # remove bracketed erratum segments (nested brackets simple) and single-quoted spans
    prev=None
    t=s
    while prev!=t:
        prev=t
        t=re.sub(r"\[[^\[\]]*\]"," ",t)
    t=re.sub(r"'[^']*'"," ",t)
    t=re.sub(r'"[^"]*"'," ",t)
    return re.sub(r"\s+"," ",t).strip()

