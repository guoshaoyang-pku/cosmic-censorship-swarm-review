def controller_repairs(m, hashes, cov, guard):
    """Bounded, idempotent controller repairs recorded in m["controller_repairs"]."""
    reps = m.setdefault("controller_repairs", [])
    ts = now()
    def rec(kind, target, detail, evidence):
        # idempotent: one record per (kind,target)
        if not any(r.get("kind")==kind and r.get("target")==target for r in reps):
            reps.append({"at": ts, "by": "astra", "kind": kind, "target": target,
                         "detail": detail, "evidence": evidence})
    # 1. F0 promotion: gate pass + >=2 distinct accepts at the measured hash
    gates = {g["gate_id"]: g for g in m.get("gates",[])}
    f0h = hashes.get("F0",{}).get("sha256")
    acc = cov.get("F0",{}).get("distinct_accept_reviewers",[])
    if gates.get("G-F0",{}).get("verdict")=="pass" and f0h and len(acc)>=2:
        for n in nodes:
            if n["id"]=="F0":
                n["status"]="done"; n["validation_status"]="passed"
                n["evidence_refs"]=sorted(set(n.get("evidence_refs") or [] + [...4 reviews, FROZEN, decisions...]))
                n["artifact_sha256"]=f0h
                rec(...)
    # 2. N0 status restore
    ...
    # 3. G-NUM stale evidence ref replacement
    ...
```
