def snapshot_corpus():
    files = sorted((ROOT/"reviews").glob("*.json"))
    snap = {}
    for f in files:
        raw = f.read_bytes()
        snap[f.name] = raw
    digest = hashlib.sha256("\n".join(f"{n}:{hashlib.sha256(b).hexdigest()}" for n,b in sorted(snap.items())).encode()).hexdigest()
    return snap, digest
```
