def classify_hf(hf_text):
    axes = []
    if any(m in hf_text for m in ("No containment with C2","containment denial",":152","line 152","must_not_conflate")): axes.append("C1_text")
    if any(m in hf_text for m in ("strictly larger",":246","line 246","size premise")): axes.append("C2_text")
    if any(m in hf_text for m in ("sha256",".sha256","declared","stale pin","entry_hashes","canonical_gate")): axes.append("D_hash_layer")
    if any(m in hf_text for m in ("VOCAB","vocab","alias")): axes.append("V_vocab")
    return axes or ["other"]
