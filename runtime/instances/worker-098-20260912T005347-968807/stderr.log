def _w098_skip(t, m, assert_start):
    """Prose-only narrow mention/negation/split guard. Returns True to suppress."""
    a, b = m.start(), m.end()
    lo = _w098_clause_lo(t, a)
    hi = _w098_clause_hi(t, b)
    clause = t[lo:hi]
    # position of the assertion word inside the clause (absolute)
    ap = assert_start if assert_start is not None and lo <= assert_start < hi else a
    pre = t[lo:ap]
    # 1) negation anywhere in the clause before the assertion, unless cancelled
    for nm in re.finditer(r"(?<![A-Za-z])(?:no|not|never|without|zero|absent|nor|none)(?![A-Za-z])", pre, re.I):
        tail = pre[nm.end():]
        if re.match(r"\s*,\s*\S", tail):   # interjection "No, ..." -> affirmation
            continue
        if re.match(r"\s*(?:only|just|merely|doubt|question|surprise|accident|wonder|longer|yet)\b", tail, re.I):
            continue
        if re.search(r"\b(?:but|however|yet|although|though|nevertheless|instead|rather|on\s+the\s+contrary|in\s+fact)\b", tail, re.I):
            continue
        return True
    # 2) split/diagnosis cue inside the composite's own clause (FP2)
    sm = _SPLIT.search(clause)
    if sm:
        tail = clause[sm.end():]
        if not re.search(r"\b(?:but|however|yet|although|though|nevertheless|instead|rather|on\s+the\s+contrary)\b", tail, re.I):
            return True
    # 3) mention frame: text about the token/pattern/regex, not a merge proposal
    if _W098_MENTION_OBJ.search(clause[:max(0, a - lo)]):
        return True
    if _W098_MENTION_FRAME.search(clause):
        return True
    return False
```

