Corrected helper block (v2):

```python
_W098_TERM = ".!?;"
_W098_SENT = ".!?"
_W098_NEG = re.compile(r"(?<![A-Za-z])(?:no|not|never|without|zero|absent|nor|none)(?![A-Za-z])", re.I)
_W098_ZERO = re.compile(r"\b0\s+(?:of|out\s+of)\b|\b0\s+(?:\w+\s+){0,2}(?:assertions?|claims?|declarations?|statements?|findings?)\b", re.I)
_W098_CANCEL = ...
_W098_IDIOM = re.compile(r"(?:\s*,\s*\S|only\b|just\b|merely\b|doubt\b|question\b|surprise\b|accident\b|wonder\b|longer\b)", re.I)
_W098_CONTRAST_TAIL = re.compile(r"(?:rather\s+than|instead\s+of|as\s+opposed\s+to|not\s+(?:only|just|merely))\s+(?:\S+\s+){0,5}$", re.I)
_W098_SPLIT_FIX = ...
_W098_REJECT = ...
_W098_MENTION_OBJ = ...
_W098_MENTION_FRAME = ...
_W098_ASSERT_TAIL = ...

def _w098_span(t, a, b, terms):
    lo = 0
    for c in terms:
        i = t.rfind(c, 0, a)
        if i + 1 > lo: lo = i + 1
    hi = len(t)
    for c in terms:
        i = t.find(c, b)
        if i != -1 and i < hi: hi = i
    return lo, hi

def _w098_clause_of(t,a,b): return _w098_span(t,a,b,_W098_TERM)
def _w098_sentence_of(t,a,b): return _w098_span(t,a,b,_W098_SENT)

def _w098_quoted(pre, post): ... same ...

def _w098_prose_skip(t, m, assert_abs):
    clo, chi = _w098_clause_of(t, m.start(), m.end())
    slo, shi = _w098_sentence_of(t, m.start(), m.end())
    in_sent = assert_abs is not None and slo <= assert_abs < shi
    ap = assert_abs if in_sent else m.start()
    if not in_sent:
        return True   # the only assertion word found is outside this sentence: prose mention
    pre_comp = t[clo:m.start()]
    clause = t[clo:chi]
    pre = t[clo:ap]
    post_comp = t[m.end():shi]
    if _w098_quoted(t[slo:m.start()], post_comp):
        return True
    if _W098_CONTRAST_TAIL.search(pre):
        return True
    if _W098_ZERO.search(pre):
        return True
    for nm in _W098_NEG.finditer(pre):
        tail = pre[nm.end():]
        if _W098_IDIOM.match(tail) or _W098_CANCEL.search(tail):
            continue
        return True
    sm = _W098_SPLIT_FIX.search(clause)
    if sm and not _W098_CANCEL.search(clause[sm.end():]):
        return True
    rm = _W098_REJECT.search(clause)
    if rm and not _W098_CANCEL.search(clause[rm.end():]):
        return True
    if _W098_MENTION_OBJ.search(pre_comp):
        return True
    fm = _W098_MENTION_FRAME.search(clause)
    if fm and not _W098_ASSERT_TAIL.search(clause[fm.end():]):
        return True
    return False

def _w098_force_assert(t, m, assert_abs):
    if _w098_prose_skip(t, m, assert_abs):
        return False
    slo, shi = _w098_sentence_of(t, m.start(), m.end())
    ap = assert_abs if (assert_abs is not None and slo <= assert_abs < shi) else m.start()
    return bool(_W098_ASSERT_TAIL.search(t[ap:shi]))
```

