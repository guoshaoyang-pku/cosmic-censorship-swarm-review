_W098_NEG = re.compile(r"(?<![A-Za-z])(?:no|not|never|without|zero|absent|nor|none)(?![A-Za-z])", re.I)
_W098_CANCEL = re.compile(r"\b(?:but|however|yet|although|though|nevertheless|instead|rather|on\s+the\s+contrary|in\s+fact)\b", re.I)
_W098_IDIOM = re.compile(r"\s*(?:,\s*\S|only|just|merely|doubt|question|surprise|accident|wonder|longer)\b", re.I)
_W098_REJECT = re.compile(r"\b(?:rejected|hypothetical|as\s+a\s+hypothesis|not\s+proposed|never\s+proposed|no\s+longer|superseded|retired|withdrawn|abandoned|only\s+as\s+a)\b", re.I)
_W098_MENTION_OBJ = re.compile(r"(?:bare|literal|quoted|token|pattern|regex|regexp|phrase|expression|string|label|mention|discussion|occurrence|instance|use)s?\s+(?:of\s+)?(?:the\s+)?(?:\S+\s+){0,1}$", re.I)
_W098_MENTION_FRAME = re.compile(r"(?:pattern|regex|regexp|scanner|detector|matcher|token|string|phrase|expression|label)\b[^.;!?]{0,48}?\b(?:match(?:es|ed|ing)?|flag(?:s|ged|ging)?|scan(?:s|ned|ning)?|detect(?:s|ed|ing)?|covers?|covered|recogni[sz]e[sd]?|spell(?:s|ed|ing)?|looks?\s+for|searches?\s+for|appears?|occurs?|shows?\s+up)\b", re.I)
_W098_ASSERT_TAIL = re.compile(r"\b(?:are|is|as)\s+one\b|one\s+class|single\s+class|same\s+class|merged\s+into|unified\s+into|treat(?:s|ed)?\s+as\s+one|chosen\s+unit|right\s+unit|unit\s+of\s+analysis", re.I)

def _w098_prose_skip(t, m, assert_abs):
    lo, hi = _w098_clause_of(t, m.start(), m.end())
    clause = t[lo:hi]
    ap = assert_abs if (assert_abs is not None and lo <= assert_abs < hi) else m.start()
    pre = t[lo:ap]
    for nm in _W098_NEG.finditer(pre):
        tail = pre[nm.end():]
        if _W098_IDIOM.match(tail):
            continue
        if _W098_CANCEL.search(tail):
            continue
        return True
    sm = _SPLIT.search(clause)
    if sm and not _W098_CANCEL.search(clause[sm.end():]):
        return True
    if _W098_REJECT.search(clause):
        return True
    if _W098_MENTION_OBJ.search(pre):
        return True
    fm = _W098_MENTION_FRAME.search(clause)
    if fm and not _W098_ASSERT_TAIL.search(clause[fm.end():]):
        return True
    return False
