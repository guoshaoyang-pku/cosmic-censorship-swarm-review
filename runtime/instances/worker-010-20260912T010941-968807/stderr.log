Fetch targets:
```python
def fetch_target(row):
    arxiv = (row['arxiv_id'] or '').strip()
    url = row['evidence_url'] or row['url']
    doi = row['doi'].strip()
    if arxiv:
        return ('arxiv-api', f'https://export.arxiv.org/api/query?id_list={urllib.parse.quote(arxiv)}')
    m = re.search(r'arxiv\.org/abs/([^/?#]+)', url)
    if m: return ('arxiv-api', f'https://export.arxiv.org/api/query?id_list={m.group(1)}')
    m = re.search(r'inspirehep\.net/api/literature/(\d+)', url) or re.search(r'inspirehep\.net/api/literature/(\d+)', row['exact_locator'])
    if m: return ('inspire-api', f'https://inspirehep.net/api/literature/{m.group(1)}')
    if doi and not doi.startswith('10.48550'):  # 10.48550 = arXiv DOI, prefer arxiv
        return ('crossref-api', f'https://api.crossref.org/works/{urllib.parse.quote(doi)}')
    if doi:
        return ('crossref-doi', f'https://api.crossref.org/works/{urllib.parse.quote(doi)}')
    return ('direct', url)
```

