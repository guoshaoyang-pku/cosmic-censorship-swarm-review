```python
# IND-08 — independent merged-regularity scan (G3), own normalization.
def _merged_hits(text):
    norm = re.sub(r"[\^{}_\s]", "", text)
    out = []
    for m in re.finditer(r"C[0-9](?:or|and|/|\+|,)?C[0-9]", norm):
        out.append(m.group(0))
    return out
class_text = yaml.safe_dump(tax.get("classes") or {}, sort_keys=False)
class_hits = _merged_hits(class_text)
file_hits = []
for i, ln in enumerate(lines, 1):
    if _merged_hits(ln):
        file_hits.append({"line": i, "text": ln.strip()[:160]})
res.add(... class_hits ...)
res.add("IND-08-OBS", "whole-file merged-token occurrences are prohibitions/guards, not asserted classes", "NOTE", ...)
```
