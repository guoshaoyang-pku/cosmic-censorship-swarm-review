Classification function:
```python
def classify(rel):
    if rel == "ledger/theorems.jsonl": return "CANONICAL"
    if rel.startswith("artifacts/literature/theorems/batch-") and rel.endswith(".jsonl"): return "LIVE_BUILD_INPUT"
    if rel.startswith("artifacts/literature/archive/"): return "ARCHIVE"
    if rel.startswith("artifacts/literature/incoming/"): return "INCOMING"
    if "/snapshot" in rel or "pre_rev3_snapshot" in rel or rel.endswith("ledger_theorems_snapshot.jsonl"): return "SNAPSHOT"
    if "/proposed/" in rel: return "PROPOSED"
    if rel.startswith("artifacts/worker-07/ledger_contribution/batches/"): return "WORKER_BATCH"
    return "UNCLASSIFIED"
```
