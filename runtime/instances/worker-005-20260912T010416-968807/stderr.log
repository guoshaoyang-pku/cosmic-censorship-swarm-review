def verify_record(record_path, canonical_path, supplement_path):
    rec = json.loads(record_path.read_text())
    canon_sha = sha256_file(canonical_path); supp_sha = sha256_file(supplement_path)
    blob = json.dumps(rec)
    declared = (rec.get('binding') or {}).get('declared_f0_sha256')
    inputs = rec.get('input_sha256') or {}
    checks = {
      'V1_canonical_input_matches_measured': inputs.get(CANONICAL_REL) == canon_sha,
      'V2_supplement_input_matches_measured': inputs.get(SUPPLEMENT_REL) == supp_sha,
      'V3_declared_f0_matches_measured_canonical': declared == canon_sha,
      'V4_declared_hash_present_in_bytes': bool(declared) and (declared in blob or declared[:16] in blob),
    }
    return {'checks':..., 'verdict': 'pass' if all else 'fail', 'hard_failures':[...], 'record_sha256':..., 'measured': {...}}
```

