Implementation:

```python
def historical_hashes() -> dict:
    hist = {t: set() for t in TARGETS}
    paths = {t: (TARGETS[t]["canonical"], TARGETS[t]["mirror"]) for t in TARGETS}
    ref_re = {t: re.compile(r"^(?:" + "|".join(re.escape(p) for p in paths[t]) + r")#([0-9a-f]{12,64})$")
              for t in TARGETS}
    if EVENTS.is_file():
        with EVENTS.open(errors="replace") as fh:
            for line in fh:
                try:
                    ev = json.loads(line)
                except Exception:
                    continue
                for t in TARGETS:
                    # path+sha256 pairs on the event
                    for key in ("path",):
                        p = ev.get(key); h = ev.get("sha256")
                        if isinstance(p,str) and isinstance(h,str) and p in paths[t]:
                            hist[t].add(h.lower())
                    # refs
                    for key in ("evidence_refs","artifact_refs"):
                        for ref in ev.get(key) or []:
                            if isinstance(ref,str):
                                m = ref_re[t].match(ref)
                                if m: hist[t].add(m.group(1))
                            elif isinstance(ref,dict):
                                p = ref.get("path"); h = ref.get("sha256")
                                if isinstance(p,str) and isinstance(h,str) and p in paths[t]:
                                    hist[t].add(str(h).lower())
                    # direct pin fields
                    for key in ("artifact_sha256","reviewed_sha256","sha256","cited_sha256"):
                        h = ev.get(key)
                        if isinstance(h,str) and isinstance(ev.get("target_id"),str):
                            # only if target resolves to t
                            if TARGET_ALIASES.get(ev["target_id"], TARGET_ALIASES.get(ev["target_id"].upper(), ev["target_id"])) == t:
                                hist[t].add(h.lower())
    if REV12_ARCHIVE.is_file(): hist["F2b"].add(sha256_file(REV12_ARCHIVE))
    ...
```

