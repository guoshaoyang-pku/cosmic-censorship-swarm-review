#!/usr/bin/env python3
"""W080-FSYM-01: independent formal-surface symbol and quantifier audit ..."""
import argparse, hashlib, json, re, sys, datetime
from pathlib import Path
import yaml

REPO = Path(__file__).resolve().parents[3]   # artifacts/worker-080/formal_symbol_audit/audit_formal_symbols.py -> repo root
