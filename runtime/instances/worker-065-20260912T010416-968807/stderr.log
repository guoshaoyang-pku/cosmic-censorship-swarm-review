```python
#!/usr/bin/env python3
"""Fail-closed checker: every hash side-pin that advertises a canonical gate artifact
must equal the artifact's live sha256 (and, where a FROZEN pin exists, the FROZEN pin).

W065-CANON-SIDEPIN-CENSUS-04. Read-only: opens files for reading only.

Exit codes: 0 = no defect, 2 = defect(s) found (fail-closed), 1 = instrument error.
"""
from __future__ import annotations
import argparse, hashlib, json, re, sys
from pathlib import Path

HEX = re.compile(r"^[0-9a-f]{64}$")

GATE_TARGETS = (...)
MOVING_TARGETS = {...}
CONTESTED_FROZEN_PINS = {...}
MIRROR_PAIRS = {...}

def sha256_file(p):
    h=hashlib.sha256()
    with open(p,'rb') as f:
        for chunk in iter(lambda: f.read(1<<20), b''):
            h.update(chunk)
    return h.hexdigest()

def parse_registries(root: Path):
    pins=[]
    # 1. entry_hashes.json
    eh = root/'entry_hashes.json'
    if eh.is_file():
        doc=json.loads(eh.read_text())
        for k,v in doc.items():
            if isinstance(v,str) and HEX.match(v):
                pins.append(dict(source='entry_hashes.json', source_kind='json_registry', target=k, advertised=v))
    # 2. FROZEN.json
    fz = root/'artifacts/formulation/FROZEN.json'
    if fz.is_file():
        doc=json.loads(fz.read_text())
        for k,v in (doc.get('files') or {}).items():
            if isinstance(v,dict) and isinstance(v.get('sha256'),str):
                pins.append(dict(source='artifacts/formulation/FROZEN.json', source_kind='frozen_authority', target=k, advertised=v['sha256']))
    # 3. *.sha256 sidecars
    side_dirs = ['', 'schemas', 'ledger', 'artifacts/formulation', 'artifacts/formulation/schemas', 'artifacts/flash-04', 'artifacts/flash-04/f1_ambiguity']
    seen=set()
    for d in side_dirs:
        base = root/d
        if not base.is_dir(): continue
        for f in sorted(base.glob('*.sha256')):
            if f in seen: continue
            seen.add(f)
            for line in f.read_text(errors='replace').splitlines():
                m=re.match(r'^([0-9a-f]{64})\s+\*?(\S+)\s*$', line.strip())
                if not m: continue
                adv,name=m.group(1),m.group(2)
                # resolution rule: repo-root-relative first, else sidecar-dir-relative
                pins.append(dict(source=str(f.relative_to(root)), source_kind='sha256_sidecar', target=name, advertised=adv, sidecar_dir=str(f.parent.relative_to(root))))
    # 4. aggregator components
    agg = root/'schemas/af_scc_regularities.yaml'
    if agg.is_file():
        text=agg.read_text()
        try:
            import yaml
            doc=yaml.safe_load(text)
            comps=doc.get('components') or []
        except Exception:
            comps=[]
        for c in comps:
            if isinstance(c,dict) and isinstance(c.get('sha256'),str) and isinstance(c.get('path'),str):
                pins.append(dict(source='schemas/af_scc_regularities.yaml', source_kind='aggregator_component', target=c['path'], advertised=c['sha256'], role=c.get('role')))
    return pins
```

