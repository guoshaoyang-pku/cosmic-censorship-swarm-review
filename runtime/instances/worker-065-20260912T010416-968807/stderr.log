Classification function:
```
def classify(pin, targets_root, frozen_pins, history):
    target=pin['target']; adv=pin['advertised']
    path = resolve(...)
    if path is None: return 'TARGET_MISSING', None
    live = sha256_file(path)
    if target in MOVING_TARGETS: cat='MOVING_TARGET_EXEMPT'
    elif adv==live:
        if target in frozen_pins:
            cat = 'OK_FROZEN_AND_LIVE' if frozen_pins[target]==live else 'OK_LIVE_FROZEN_STALE'
        else: cat='OK_LIVE'
    else:
        if target in CONTESTED_FROZEN_PINS and adv==CONTESTED_FROZEN_PINS[target]: cat='DRIFT_CONTESTED'
        elif pin['source_kind']=='frozen_authority': cat='FREEZE_DRIFT'
        elif adv in history: cat='STALE_REVOKED'
        else: cat='STALE'
    return cat, live
```
