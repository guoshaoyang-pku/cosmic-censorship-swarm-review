def detect_reason(text):
    d=yaml.safe_load(text)
    reason = d['implication_ledger']['forbidden_transfers'][0]['reason']
    chain = d['implication_ledger']['extension_class_containment']
    toks = ['E_C0','E_H2loc','E_{C^1,1}','E_C2']
