def reviewer_predicates(text):
    doc = load_doc(text)
    mnc = doc.get('regularity',{}).get('must_not_conflate',[]) or []
    fts = doc.get('implication_ledger',{}).get('forbidden_transfers',[]) or []
    h2_row = str(mnc[0]) if mnc else ''
    h1_row = str(fts[0].get('reason','')) if fts else ''
    out = {}
    # w017 CHK-09/CHK-10 (artifacts/worker-017/f2b_rev13_containment/verify.py:203,213)
    out['w017-CHK-09'] = {"fires": "strictly larger extension class" in h1_row, "type":"naive_substring", "source":"artifacts/worker-017/f2b_rev13_containment/verify.py:203"}
    out['w017-CHK-10'] = {"fires": "No containment with C2 or C0 is asserted here" in h2_row, ...:213}
    # w018 B1/B2 (check_f2b_rev13.py:194,204)
    out['w018-B1'] = {"fires": any("No containment with C2 or C0 is asserted here" in str(s) for s in mnc), ...:194}
    out['w018-B2'] = {"fires": any("strictly larger extension class" in str(r.get('reason','')) for r in fts), ...:204}
    # w053 C10 order-relative (check_f2b_rev29.py:412-463): reason claims larger/smaller vs chain ranks
    order = chain_ranks(doc)
    reason=fts[0].get('reason','')
    m=re.search(r'strictly\s+(larger|smaller)\s+extension\s+class',reason)
    fires=False
    if m and order:
        claimed=m.group(1)=='larger'  # from=C2, to=this class C0
        # claims: E_C2 larger than E_C0?
        fires = (claimed and order['C2']>order['C0']) or ((not claimed) and order['C2']<order['C0'])
    out['w053-C10'] = {...}
    # w066 detect_h2 mention-aware (rebind.py:150-160): strip [..] then search
    stripped=re.sub(r'\[[^\]]*\]','',h2_row)
    out['w066-H2'] = {"fires": bool(re.search(r'No\s+containment\s+with\s+.{0,80}?\s+is\s+asserted',stripped,re.I)), "type":"mention_aware", ...}
    out['w066-H1'] = order-relative same as 053 (their detect_h1) → include.
