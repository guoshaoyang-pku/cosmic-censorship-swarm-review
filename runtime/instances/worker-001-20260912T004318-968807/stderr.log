Let me redo resolve_nodes:
```python
def resolve_nodes(d, path_to_node):
    toks = target tokens (str or dict fields)
    out = set()
    for t in toks:
        base=t.split('#')[0]
        if base in path_to_node: out.add(path_to_node[base])
        for cand in (t, t.upper(), base, base.upper()):
            if cand in al.TARGET_ALIASES: out.add(al.TARGET_ALIASES[cand])
    if not out and isinstance(d.get('artifact'), str):
        base=d['artifact'].split('#')[0]
        if base in path_to_node: out.add(path_to_node[base])
    return out & set(TARGET_NODES)
```

