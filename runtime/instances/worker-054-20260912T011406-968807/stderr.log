Design (v2):

```python
def declared_for(doc, leg, refs):
    meta=LEGS[leg]; decl=set(); reasons=[]
    rsha=doc.get('reviewed_sha256')
    if isinstance(rsha,str) and re.fullmatch(...): decl.add(rsha.lower()); reasons.append('reviewed_sha256')
    for key in ('artifact_sha256','artifact_sha256_prefix'):
        v=doc.get(key) ... decl.add; reasons.append(key)
    tid=str(doc.get('target_id') or '')
    if '#' in tid: decl.add(tid.rsplit('#',1)[1].lower()); reasons.append('target_id')
    tgt=doc.get('target')
    if isinstance(tgt,dict):
        for k,v in tgt.items():
            if any(t in k.lower() for t in ('sha','pin','digest')) and full-hex: decl.add(v); reasons.append('target.'+k)
    for path,prefs in refs.items():
        if Path(path).name==Path(meta['canonical']).name: decl |= prefs; reasons.append('ref:'+path)
    return decl, reasons
```

scope_for(doc, leg, refs):
```python
node=str(doc.get('node_id') or ''); tid=str(doc.get('target_id') or '')
