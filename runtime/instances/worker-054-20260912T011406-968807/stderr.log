rev_path=str(doc.get('reviewed_path') or '')
canon_name=Path(meta['canonical']).name
if node==leg or tid.startswith(leg): return 'node'
if canon_name in tid or rev_path.endswith(canon_name): return 'target_path'
if meta['class_id'] in cls_str and (node==leg or not node): return 'class'
# 072 case: node_id == leg already covered; a doc with target_id==leg covers
return None
```
