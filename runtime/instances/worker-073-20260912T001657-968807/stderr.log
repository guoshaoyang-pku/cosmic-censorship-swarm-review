```python
def norm_text(s):
    s = html.unescape(s or "")
    s = s.replace('\\', ' ')          # LaTeX commands
    s = re.sub(r'\$[^$]*\$', ' ', s)  # math
    s = re.sub(r'[^0-9A-Za-z]+', ' ', s)
    return re.sub(r'\s+', ' ', s).strip().lower()

def token_set(s): return set(norm_text(s).split())

def title_in(title, text):
    nt, nx = norm_text(title), norm_text(text)
    if not nt: return False
    if nt in nx: return True
    a,b = token_set(title), token_set(text)
    if not a: return False
    return len(a & b)/len(a) >= 0.92   # coverage of title tokens
```

