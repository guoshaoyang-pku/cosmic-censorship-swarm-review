```python
def fetch(url):
    fd, path = tempfile.mkstemp(dir=OUTDIR, prefix='.fetch_'); os.close(fd)
    try:
        p = subprocess.run(['curl','-sS','-L','--max-time','45','-A',UA,'-o',path,'-w','%{http_code}\t%{url_effective}\t%{size_download}\t%{content_type}', url], capture_output=True, text=True)
        parts = (p.stdout.strip().split('\t') + ['','','',''])[:4]
        code = int(parts[0]) if parts[0].isdigit() else 0
        final_url, size, ctype = parts[1], parts[2], parts[3]
        data = open(path,'rb').read()
        return {'ok': code==200 and len(data)>0, 'http_status': code, 'final_url': final_url, 'content_type': ctype, 'bytes': len(data), 'sha256': sha256_bytes(data), 'data': data, 'curl_rc': p.returncode, 'curl_err': p.stderr.strip()[:300]}
    finally:
        os.unlink(path)
```

Metadata extraction:

```python
def meta_tags(text):
    out={}
    for m in re.finditer(r'<meta\s+([^>]+)>', text, re.I):
        attrs=dict(re.findall(r'([a-zA-Z:_-]+)\s*=\s*"([^"]*)"', m.group(1)))
        name=(attrs.get('name') or attrs.get('property') or '').lower()
        if name: out.setdefault(name, []).append(html.unescape(attrs.get('content','')))
    return out
```

arXiv Atom parse:

```python
def parse_arxiv_atom(text):
    ns={'a':'http://www.w3.org/2005/Atom','arxiv':'http://arxiv.org/schemas/atom'}
    try: root=ET.fromstring(text)
    except Exception: return None
    entries=[]
    for e in root.findall('a:entry',ns):
        t=' '.join((e.findtext('a:title',default='',namespaces=ns) or '').split())
        names=[n.findtext('a:name',default='',namespaces=ns) for n in e.findall('a:author',ns)]
        idu=e.findtext('a:id',default='',namespaces=ns)
        pub=e.findtext('a:published',default='',namespaces=ns)
        summ=' '.join((e.findtext('a:summary',default='',namespaces=ns) or '').split())
        entries.append({'title':t,'authors':names,'id':idu,'published':pub,'summary':summ})
    return entries
```

inspirehep JSON parse:

```python
def parse_inspire(text):
    try: d=json.loads(text)
    except Exception: return []
    hits=d.get('hits',{}).get('hits',[])
    out=[]
    for h in hits:
        md=h.get('metadata',{})
        titles=[t.get('title','') for t in md.get('titles',[])]
        authors=[a.get('full_name','') for a in md.get('authors',[])]
        year=None
        if md.get('earliest_date'): year=md['earliest_date'][:4]
        elif md.get('publication_info'): year=str(md['publication_info'][0].get('year','') or '')
        abstracts=[a.get('value','') for a in md.get('abstracts',[])]
        out.append({'title':titles[0] if titles else '','authors':authors,'year':year,
                    'abstract':' '.join(abstracts),'recid':md.get('control_number'),
                    'dois':[x.get('value') for x in md.get('dois',[])], 'arxiv':md.get('arxiv_eprints',[{}])[0].get('value') if md.get('arxiv_eprints') else None})
    return out
```

