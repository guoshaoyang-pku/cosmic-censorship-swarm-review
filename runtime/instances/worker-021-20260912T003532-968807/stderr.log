def quoted_spans(t):
    spans=[]; stack=[]
    for i,ch in enumerate(t):
        if ch in "\"'‘’“”":
            if stack and ((stack[-1][1] in "\"“”" and ch in "\"“”") or (stack[-1][1] in "'‘’" and ch in "'‘’")):
