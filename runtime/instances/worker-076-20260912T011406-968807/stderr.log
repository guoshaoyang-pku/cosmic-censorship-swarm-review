```python
def path_like(s):
    if not s or len(s) > 200: return False
    if any(c in s for c in "\n\t"): return False
    if " " in s: return False
    if "*" in s or "\\" in s: return False
    return any(s.endswith(e) for e in KS) or (s.endswith("/") and "." not in s)
```

Extraction:
```python
def refs_from_python(p):
    try: tree = ast.parse(p.read_text(errors="replace"))
    except SyntaxError: return set()
    out=set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Constant) and isinstance(node.value, str) and path_like(node.value):
            out.add(node.value)
    return out
```

