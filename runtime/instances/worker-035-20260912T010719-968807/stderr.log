def extract_defects(canon_text):
    # parse yaml
    doc = yaml.safe_load(canon_text)
    led = doc['implication_ledger']
    chain = led['extension_class_containment']
    fts = led['forbidden_transfers']
    inv_reason = None; inv_row = None
    for row in fts:
        if row.get('from') == 'no proper future C2 extension' and row.get('to') == 'this class':
            inv_reason = row.get('reason'); inv_row = row
    d1 = bool(inv_reason) and ('strictly larger' in inv_reason) and ('E_C0 contains E_H2loc contains E_{C^1,1} contains E_C2' in chain)
    # note: chain uses E_{C^1,1}
    mnc = doc['regularity']['must_not_conflate']
    d2_entries = [s for s in mnc if 'No containment with C2 or C0' in str(s)]
    d2 = bool(d2_entries) and ('contains E_C2' in chain)
    return {...}
```

