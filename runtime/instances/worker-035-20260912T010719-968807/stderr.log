    findings = json.dumps(r.get('findings'), ensure_ascii=False)
    target = json.dumps(r.get('target_id'), ensure_ascii=False)
    hashes = r.get('reviewed_sha256')
    bound = isinstance(hashes,str) and hashes.startswith(PIN) or (isinstance(hashes,dict) and PIN in json.dumps(hashes))
