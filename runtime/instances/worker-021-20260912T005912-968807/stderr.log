Now I need to define `_author_context(p)`. It should return (declares_role: bool/str, checksums_pin: hash or None). Let me add it near `sha256_file`.

```python
def _author_context(p: Path):
    """Independent context probe: does the author's own task directory declare this file's role
    (report/controls text) and pin its hash (SHA256SUMS)?"""
    if not p.exists():
        return False, None
    task = p.parents[1]
    base = p.name
    rel = str(p.relative_to(ROOT))
    declares = False
    for name in ("REPORT.md", "report.json", "controls.json", "README.md"):
        q = task / name
        if q.exists():
            t = q.read_text(errors="replace")
            if base in t or rel in t:
                declares = True
                break
    pin = None
    for sums in sorted(task.glob("SHA256SUMS*")):
        for line in sums.read_text(errors="replace").splitlines():
            parts = line.split(None, 1)
            if len(parts) == 2 and parts[1].strip().lstrip("*") == rel:
                pin = parts[0]
    return declares, pin
```

