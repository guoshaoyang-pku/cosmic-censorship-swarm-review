```python
NEG_GUARD = re.compile(r"(?:no|not|never|without|absent|forbidden|must\s+not|do\s+not|don't|nor|zero)\s+(?:\w+[\s-]+){0,4}$", re.I)

def _asserted(pat, low):
    for m in re.finditer(pat, low):
        before = low[max(0,m.start()-50):m.start()]
        if NEG_GUARD.search(before):
            continue
        after = low[m.end():m.end()+30]
        if re.match(r"\s*(?:split|separate|distinct|vs\b|leakage|hygiene)", after):
            continue
        return m
    return None
```

