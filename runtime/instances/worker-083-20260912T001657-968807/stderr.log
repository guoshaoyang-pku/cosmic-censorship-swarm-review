```python
def expectation_agreement(case, out):
    exp = str(case.get("expected_resolution") or "")
    d = out["disposition"]
    if exp.startswith("unique_class:"):
        return d == "HOLDS_AS_FILED" and exp.split(":",1)[1] == case["as_filed_class_id"]
    if exp.startswith("reject_misfiled:target="):
        tgt = exp.split("=",1)[1]
        return d == "MISFILED_REFILE" and out.get("target_class_ids") == [tgt]
    if exp.startswith("reject_new_class_required"):
        return d == "NEW_CLASS_REQUIRED"
    if exp.startswith("reject_split_required"):
        return d == "SPLIT_REQUIRED"
    if exp.startswith("reject_leak"):
        # vocabulary note: a leak whose semantic witness is a regularity merge (X5/G3) is
        # classified SPLIT_REQUIRED here because the repair is a split; both are rejections.
        if d == "REJECT_LEAK_ONLY":
            return True
        if d == "NEEDS_MANUAL_REVIEW":
            return "review"
        if d == "SPLIT_REQUIRED" and case.get("expected_leak_rule","").startswith(("G3","X5")):
            return "repair-level"
        return False
    return "unmapped"
```

