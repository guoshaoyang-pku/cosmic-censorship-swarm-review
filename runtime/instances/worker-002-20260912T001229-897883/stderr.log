def classify_context(line, token, key=None):
    low=line.lower()
    if key in ("class_id","class_ids"): return "class_field"
    if re.search(r'["\'][^"\']*\.(json|yaml)["\']', line) or "variants/" in line: return "path_reference"
    if any(w in low for w in ("leakage","must not","never ","not a class","prohibit","forbidden")): return "prohibition_or_rule_note"
    if "parent_class" in line or "variant_id" in line: return "registry_binding"
    return "prose"
```

