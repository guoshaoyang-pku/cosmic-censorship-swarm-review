```python
def _find_key(node, wanted, depth=0, maxdepth=3):
    if depth > maxdepth: return None
    if isinstance(node, dict):
        lower = {norm(k).replace(...): (k,v) for k,v in node.items()}
        for a in wanted:
            if a in lower: return lower[a]
        for k,v in node.items():
            if isinstance(v,(dict,list)):
                found = _find_key(v, wanted, depth+1, maxdepth)
                if found is not None: return found
    elif isinstance(node, list):
        for v in node:
            found = _find_key(v, wanted, depth+1, maxdepth)
            if found is not None: return found
    return None
```

But then for `conclusion`, we'd find the first alias match; alias order is preferred within a level, and we search levels in insertion order, not strictly depth-first-by-depth. BFS would be better to prefer shallow. Let me implement BFS over (key,value) pairs up to depth 3:

Actually simpler: collect all matching (depth, pointer, key, value) and pick min depth, then alias order. Let me do a BFS queue:

```python
def get_field(section, field):
    wanted = [a.replace("_"," ").replace("-"," ") for a in FIELD_ALIASES[field]]
    queue = [(section, 0)]
    best = None
    while queue:
        node, depth = queue.pop(0)
        if depth > 3: continue
        if isinstance(node, dict):
            lower = {}
            for k,v in node.items():
                lower.setdefault(norm(k).replace("_"," ").replace("-"," "), (k,v))
            for i,a in enumerate(wanted):
                if a in lower:
                    cand = (depth, i, lower[a])
                    if best is None or (cand[0], cand[1]) < (best[0], best[1]):
                        best = cand
            if best is not None and best[0] == depth:
                return best[2]   # shallowest level had a match; alias order resolved
            for k,v in node.items():
                if isinstance(v,(dict,list)): queue.append((v, depth+1))
        elif isinstance(node, list):
            for v in node:
                if isinstance(v,(dict,list)): queue.append((v, depth+1))
    return best[2] if best else (None,None)
```

