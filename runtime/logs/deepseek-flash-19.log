Artifact gate:
```python
def artifact_gate(node_id, gid, n):
    status = n.get("status")
    severity = "hard" if status=="done" else "warn"
    art = n.get("artifact")
    if not art:  # C0
        add("C0", severity, ...)
        return False
    rel, err = norm_rel(root, art)
    if err:
        add("C0b","hard", ..., f"invalid artifact path {art!r}: {err}")
        return False
    ap = root/rel
    if not ap.exists():
        add("C1", severity, ..., "does not exist" + ("" if done else f" (status={status}; expected until the node completes)"))
        return False
    if ap.is_dir():
        if not real_content(ap): add("C1", severity, "empty directory"); return False
        evs=[e for e in art_events.get(rel,[]) if e.get("validation_status")=="passed"]
        if not evs:
            add("C3", severity, "no passed artifact event for directory"); return False
        # hash unverifiable for dirs; if event has sha256 => warn
        return True
    # file
    evs=[e for e in art_events.get(rel,[]) if e.get("sha256")]
    if not evs: add("C3", severity, ...); return False
    actual=sha256_file(ap)
    if not any(str(e["sha256"]).lower()==actual for e in evs): add("C3", severity, mismatch); return False
    return True
```

