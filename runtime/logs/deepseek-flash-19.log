Key structures:

```python
JUNK = {".DS_Store"}
def is_junk(name): return name in JUNK or name.startswith("._")

def real_content(p: Path) -> bool:  # recursive
    if p.is_file(): return not is_junk(p.name)
    for c in p.iterdir():
        if is_junk(c.name): continue
        if c.is_dir():
            if real_content(c): return True
        else: return True
    return False

def norm_rel(root: Path, raw) -> tuple[str|None, str|None]:
    """Return (canonical posix rel path, error). Rejects absolute and escapes."""
    try: s = str(raw)
    except: return None, "not a string"
    if not s.strip(): return None, "empty"
    p = Path(s)
    if p.is_absolute(): return None, "absolute path not allowed"
    q = (root / p)
    try: rq = q.resolve()
    except OSError as e: return None, f"unresolvable: {e}"
    rr = root.resolve()
    if rq != rr and rr not in rq.parents: return None, "escapes repo root"
    return rq.relative_to(rr).as_posix(), None
```

But for artifacts that don't exist, `.resolve()` still works (non-strict). Good.

