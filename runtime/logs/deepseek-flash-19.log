Actually the cleanest integration: `validate_map(m, events=None)`: 
```python
def validate_map(m, events=None):
    ...
    # after building nodes and before cycle check:
    REPO = ROOT.parent
    def artifact_ok(path):
        p = REPO / path
        if not p.exists(): return False, "missing"
        if p.is_dir() and not [c for c in p.iterdir() if c.name != ".DS_Store" and not c.name.startswith("._")]:
            return False, "empty dir"
        return True, "ok"
    for nid,(gid,n) in nodes.items():
        if n.get("status")=="done":
            art = n.get("artifact")
            if art:
                ok, why = artifact_ok(art)
                if not ok: errors.append(f"{nid}: declared artifact {art} {why}")
            if not n.get("evidence_refs"): errors.append(f"{nid}: done node has no evidence_refs")
```
