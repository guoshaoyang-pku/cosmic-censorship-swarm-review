            if f.suffix == ".jsonl":
                for i, line in enumerate(raw.splitlines(), 1):
                    ...
            else:
                try: obj = json.loads(raw)
                except: append parse error; continue
                if isinstance(obj, list): events.extend(x for x in obj if isinstance(x, dict))
                elif isinstance(obj, dict): events.append(obj)
                else: parse error
    return events
```
