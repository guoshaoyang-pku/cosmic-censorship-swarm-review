Now the checker implementation. It must be robust, deterministic, no network. Let me write it.

```python
#!/usr/bin/env python3
from __future__ import annotations
import argparse, json, re, sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
RULES = json.loads((HERE/"class_binding_rules.json").read_text())

def flatten(doc, prefix=""):
    """Return (dict of dotted key -> value, lowercase text blob)."""
    items={}
    def rec(x, p):
        if isinstance(x, dict):
            for k,v in x.items(): rec(v, f"{p}.{k}" if p else str(k))
        elif isinstance(x, list):
            for i,v in enumerate(x): rec(v, f"{p}[{i}]")
        else:
            items[p]=x
    rec(doc,"")
    text=json.dumps(doc, ensure_ascii=False).lower()
    return items, text
```

