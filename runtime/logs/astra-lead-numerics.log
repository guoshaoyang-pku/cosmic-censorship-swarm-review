```python
def _apply_stencil(u, h, table, order, ghost_l, ghost_r, half):
    c, den = table[order]
    m = (len(c)-1)//2
    ue = np.concatenate([ghost_l, u, ghost_r])  # len m each side
    out = np.zeros_like(u)
    for j in range(-m, m+1):
        out += c[j+m]*ue[m+j : m+j+len(u)]
    return out/(den*h**half)
```
