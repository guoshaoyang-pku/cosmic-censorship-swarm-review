"""Finite-difference operators on uniform grids.

All operators are returned as dense 2-D arrays so that convergence and
dispersion tests can use exact linear algebra (no roll-based bookkeeping).
Stencils are standard central differences of order 2, 4 and 6.
"""
from __future__ import annotations
import numpy as np

# stencil coefficients (numerator) for first derivative: u' ~ sum c_k u_{i+k} / (h * den)
_D1 = {
    2: (np.array([-1.0, 0.0, 1.0]), 2.0),
    4: (np.array([1.0, -8.0, 0.0, 8.0, -1.0]), 12.0),
    6: (np.array([-1.0, 9.0, -45.0, 0.0, 45.0, -9.0, 1.0]), 60.0),
}
_D2 = {
    2: (np.array([1.0, -2.0, 1.0]), 1.0),
    4: (np.array([-1.0, 16.0, -30.0, 16.0, -1.0]), 12.0),
    6: (np.array([2.0, -27.0, 270.0, -490.0, 270.0, -27.0, 2.0]), 180.0),
}

def periodic_d1(n, h, order=2):
    c, den = _D1[order]
    m = len(c)//2
    A = np.zeros((n,n))
    for k in range(-m, m+1):
        A[np.arange(n), (np.arange(n)+k) % n] += c[k+m]
    return A/(den*h)
...
```

