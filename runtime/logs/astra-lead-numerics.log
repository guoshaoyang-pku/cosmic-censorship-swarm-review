```python
def _extract_orders(doc):
    orders=[]
    def add(v):
        if isinstance(v,(int,float)) and v==v: orders.append(float(v))
    if not isinstance(doc, dict): return orders
    for key in ("studies",):
        node=doc.get(key)
        items=[]
        if isinstance(node, dict):
            for v in node.values():
                items.extend(v if isinstance(v,list) else [v])
        elif isinstance(node,list): items=node
        for st in items:
            if isinstance(st,dict):
                for v in st.get("order_l2",[]) or []: add(v)
                if isinstance(st.get("fit_order"),(int,float)): add(st["fit_order"])
                if isinstance(st.get("measured_order"),(int,float)): add(st["measured_order"])
    for st in doc.get("order_studies",[]) or []:
        if isinstance(st,dict):
            for key in ("fit_order","measured_order","order"):
                add(st.get(key))
            for v in st.get("pair_orders",[]) or []: add(v)
    res=doc.get("result")
    if isinstance(res,dict):
        ind=res.get("independent_orders")
        if isinstance(ind,dict):
            for v in ind.values(): add(v)
        add(res.get("reference_measured_order"))
    return orders
```
