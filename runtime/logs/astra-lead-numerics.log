def lock_guard(root=None):
    """N1 production lock guard: refuse self-gravitating work while numerics_lock.state == 'locked'."""
    root = Path(root or Path(__file__).resolve().parents[2])
    import importlib.util
    gates_path = root / "numerics" / "gates.py"
    if gates_path.exists():
        spec = importlib.util.spec_from_file_location("numerics_gates", gates_path)
        mod = importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)
        rep = mod.evaluate(root)
        return {"verdict": rep["verdict"], "blocked": ...}
    # fallback: parse map
```
