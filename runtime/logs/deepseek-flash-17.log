```python
RE_DISJUNCTION = re.compile(r"\bC\s*\^?\s*0\s*(?:or|/|\|)\s*C\s*\^?\s*2\b|\bC\s*\^?\s*2\s*(?:or|/|\|)\s*C\s*\^?\s*0\b", re.I)
RE_C0 = re.compile(r"\bC\s*\^?\s*0\b")
RE_C2 = re.compile(r"\bC\s*\^?\s*2\b")
RE_SCC = re.compile(r"AF-SCC|strong[\s_-]*cosmic[\s_-]*censorship|inextendib", re.I)
RE_WCC = re.compile(r"AF-WCC|weak[\s_-]*cosmic[\s_-]*censorship", re.I)
RE_WEIGHTED = re.compile(r"\bH\b|H\s*\^|weight|δ|delta", re.I)
RE_GENERIC = re.compile(r"measure|full|open|dense|residual|baire|meagre|meager|generic set", re.I)
RE_WITNESS = re.compile(r"\bdata\b|\bdatum\b|initial data set", re.I)
RE_VISIBLE_CONC = re.compile(r"visible|asymptotic.{0,20}predictab|predictab", re.I)
RE_INEXT_CONC = re.compile(r"inextendib", re.I)
RE_CONSTRAINT = re.compile(r"constraint", re.I)
