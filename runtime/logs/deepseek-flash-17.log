```python
#!/usr/bin/env python3
"""Build MANIFEST.json: sha256 per file plus a bundle digest (excluding the manifest)."""
import hashlib, json
from pathlib import Path
HERE = Path(__file__).resolve().parent
def sha(p): ...
files = sorted(p for p in HERE.rglob("*") if p.is_file() and p.name != "MANIFEST.json")
entries = [{"path": str(p.relative_to(HERE)), "bytes": p.stat().st_size, "sha256": sha(p)} for p in files]
digest = hashlib.sha256("\n".join(f"{e['path']} {e['sha256']}" for e in entries).encode()).hexdigest()
manifest = {"bundle": "artifacts/worker-17/class_binding_gate", "file_count": len(entries), "bundle_digest_sha256": digest, "digest_definition": "sha256 of '<relpath> <sha256>' lines, sorted by path, MANIFEST.json excluded", "files": entries}
(HERE/"MANIFEST.json").write_text(json.dumps(manifest, indent=2)+"\n")
```

