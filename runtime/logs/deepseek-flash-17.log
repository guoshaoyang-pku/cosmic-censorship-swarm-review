def check(doc, source="<memory>"):
    violations = []
    def add(code, message, path=""):
        violations.append({"code": code, "message": message, "path": path, "source": source})

    if not isinstance(doc, dict):
        add("R_PARSE", "top-level document is not a mapping", "")
        return violations

    cid = doc.get("class_id")
    if cid not in CLASS_IDS:
        add("R_CLASS", f"class_id {cid!r} is not exactly one frozen class of {list(CLASS_IDS)}", "class_id")
        return violations
    fam = FAMILY[cid]

    # 1. presence / non-emptiness
    for slot in CORE_SLOTS:
        if slot not in doc:
            add("R_REQUIRED", f"missing required top-level slot {slot!r}", slot)
    for p in BASE_PATHS:
        exists, val = _get(doc, p)
        if not exists:
            add("R_REQUIRED", f"missing required slot {p!r}", p)
        elif _is_empty(val):
            add("R_EMPTY", f"required slot {p!r} is empty", p)

    # 2. matter model / symmetry
    exists, mm = _get(doc, "matter_model")
    if exists and not _is_empty(mm):
        text = _as_text(mm).lower()
        if cid == "AF-WCC-SCALAR-SPH":
            if "scalar" not in text:
                add("R_MATTER", f"AF-WCC-SCALAR-SPH requires a scalar matter model, got {mm!r}", "matter_model")
            exists2, sym = _get(doc, "symmetry")
            if not exists2:
                add("R_REQUIRED", "AF-WCC-SCALAR-SPH requires 'symmetry'", "symmetry")
            elif _is_empty(sym) or "spherical" not in _as_text(sym).lower():
                add("R_MATTER", "AF-WCC-SCALAR-SPH requires spherical symmetry", "symmetry")
        else:
            if text not in {"vacuum"}:
                add("R_MATTER", f"class {cid} is a vacuum class, matter_model must be 'vacuum', got {mm!r}", "matter_model")
