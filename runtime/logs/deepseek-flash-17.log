CLI:
```python
def main(argv=None):
    ap = argparse.ArgumentParser(description=...)
    ap.add_argument("paths", nargs="+")
    ap.add_argument("--json", action="store_true", help="print machine-readable report")
    ap.add_argument("--quiet", action="store_true")
    a = ap.parse_args(argv)
    reports = []
    for p in a.paths:
        try:
            doc = load_document(p)
        except Exception as e:
            reports.append({"source": p, "violations": [{"code":"R_PARSE","message":f"{type(e).__name__}: {e}","path":"","source":p}], "ok": False})
            continue
        vs = check(doc, source=p)
        reports.append({"source": p, "class_id": doc.get("class_id") if isinstance(doc, dict) else None, "violations": vs, "ok": not vs})
    ...
    overall = all(r["ok"] for r in reports)
    if a.json: print(json.dumps({"overall_ok": overall, "reports": reports}, indent=2, ensure_ascii=False))
    else: pretty print
    return 0 if overall else 1
```

