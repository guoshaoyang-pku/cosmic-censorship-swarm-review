```python
#!/usr/bin/env python3
"""Class-binding acceptance gate (form-only) for cosmic-censorship formulation schemas.

Task: worker-17 proposed subtask under F1/F2 (formulation group).
Decision: given a schema document (YAML or JSON), is it a well-formed, class-bound
specification for exactly one frozen class, with exact quantifiers, topology,
regularity, weighted data class, genericity, I+, visibility, and conclusion type,
and with no cross-class leakage?

It does NOT decide whether the formulation is physically correct, whether the
conjecture is true, or whether any theorem is proved. Form only.
"""
from __future__ import annotations
import argparse, json, re, sys
from pathlib import Path

try:
    import yaml
except ImportError:
    yaml = None

CLASS_IDS = ("AF-WCC-VAC-GEN", "AF-SCC-C2-VAC-GEN", "AF-SCC-C0-VAC-GEN", "AF-WCC-SCALAR-SPH")
FAMILY = {"AF-WCC-VAC-GEN": "WCC", "AF-WCC-SCALAR-SPH": "WCC",
          "AF-SCC-C2-VAC-GEN": "SCC", "AF-SCC-C0-VAC-GEN": "SCC"}
REGULARITY = {"AF-SCC-C2-VAC-GEN": "C2", "AF-SCC-C0-VAC-GEN": "C0"}

CORE = ("schema_version","class_id","quantifiers","topology","data_class",
        "regularity_of_solution","constraints","genericity","visibility",
        "conclusion","falsifier","source_refs")

DISJUNCTION = re.compile(r"\bC\s*\^?\s*0\s*(?:or|/|\|)\s*C\s*\^?\s*2\b|\bC\s*\^?\s*2\s*(?:or|/|\|)\s*C\s*\^?\s*0\b", re.I)
C0 = re.compile(r"\bC\s*\^?\s*0\b")
C2 = re.compile(r"\bC\s*\^?\s*2\b")
SCC = re.compile(r"AF-SCC|strong[ _-]?cosmic[ _-]?censorship|inextendib", re.I)
WCC = re.compile(r"AF-WCC|weak[ _-]?cosmic[ _-]?censorship", re.I)
