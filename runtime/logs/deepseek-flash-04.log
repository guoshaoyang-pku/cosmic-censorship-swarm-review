class GaussianPulse:
    def __init__(self, r0=10.0, sigma=1.5):
    def F(self,s): return np.exp(-(s-self.r0)**2/(2*self.sigma**2))
    def Fp(self,s): return -(s-self.r0)/self.sigma**2 * self.F(s)
    def Fpp(self,s): return ((s-self.r0)**2/self.sigma**4 - 1/self.sigma**2)*self.F(s)
    def psi(self,r,t): return self.F(r-t) - self.F(-r-t)
    def psi_t(self,r,t): return -self.Fp(r-t) + self.Fp(-r-t)
    def psi_tt(self,r,t): return self.Fpp(r-t) - self.Fpp(-r-t)
