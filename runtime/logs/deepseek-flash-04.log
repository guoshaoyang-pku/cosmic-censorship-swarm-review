#!/usr/bin/env python3
"""Cross-check schemas/f1_falsifier_tests.jsonl against the schema's adjudication_queue."""
import json, sys, hashlib, yaml
from pathlib import Path
HERE=...; ROOT=...
def main():
    tests = [json.loads(l) for l in TESTS.read_text().splitlines() if l.strip()]
    doc = yaml.safe_load(SNAPSHOT.read_text())
    q = doc.get("adjudication_queue") or {}
    items = {x["test"]: x for x in q.get("items", []) if isinstance(x, dict) and x.get("test")}
    rows=[]
    for t in tests:
        tid=t["test_id"]; qi=items.get(tid)
        if qi is None:
            rows.append({"test_id":tid,"in_queue":False,"queue_leaf":None,"suite_leaf":t["deciding_field"],
                         "leaf_match":None,"leaf_match_via_alternate":False,"schema_decision":None,
                         "review_question":None,"action":"add_to_queue" if t["falsifier_strength"]!="decided" else "not_required"})
        else:
            leaf=qi.get("deciding_leaf")
            match = leaf==t["deciding_field"]
            alt = leaf in (t.get("deciding_field_alternates") or [])
            rows.append({... "action": "" if match or alt else "name_both_leaves"})
    summary={...}
    report={... "digest": ...}
```
