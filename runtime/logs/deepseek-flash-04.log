class RadialLeapfrog:
    """2nd-order explicit leapfrog for psi_tt = psi_rr, Dirichlet psi(0)=psi(R)=0."""
    def __init__(self, r, dt, psi0, psi_t0, psi_tt0):
        self.r, self.dt = r, dt
        self.psi = psi0.copy()
        self.psi_prev = None
        self.t = 0.0
        # Taylor start: psi^1 = psi^0 + dt psi_t0 + 0.5 dt^2 psi_tt0
        self._psi_next = psi0 + dt*psi_t0 + 0.5*dt*dt*psi_tt0
        self._psi_next[0]=0; self._psi_next[-1]=0
    def step(self):
        lam2 = (self.dt/dr)**2
        lap = self._psi_next[1:-1]*... 
```

