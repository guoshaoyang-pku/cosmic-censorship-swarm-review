            entries.append({"field": str(u["field"]), "why": str(u.get("why",""))[:200], "resolution_requires": str(u.get("resolution_requires",""))[:160]})
    return entries

def _unresolved_match(entry_field, deciding_paths):
    for p in deciding_paths:
        if not p: continue
        if entry_field == p: return p
        if entry_field.startswith(p + ".") or p.startswith(entry_field + "."): return p
        for alias in UNRESOLVED_ALIASES.get(entry_field, []):
            if alias == p: return p
    return None

def _resolve_with_aliases(doc, candidates):
    # exact first for all candidates, then aliases for all candidates
    for p in candidates:
        f,v = resolve(doc,p)
        if f: return p, f, v, classify_value(f,v), "exact"
    for p in candidates:
        for a in FIELD_ALIASES.get(p, []):
            f,v = resolve(doc,a)
            if f: return a, f, v, classify_value(f,v), f"alias_of:{p}"
    return (candidates[0] if candidates else None), False, None, "missing", "unresolved"
```
