```python
import sys, json, numpy as np
def main():
    req=json.load(sys.stdin)
    r=np.array(req["r"]); dt=req["dt"]; t_end=req["t_end"]
    psi0=np.array(req["psi0"]); psi_t0=np.array(req["psi_t0"])
    # need psi_tt0: compute from reference
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    from reference_solutions import GaussianPulse
    pulse=GaussianPulse()
    psi_tt0=pulse.psi_tt(r,0.0)
    from solvers import RadialLeapfrog
    sol=RadialLeapfrog(r,dt,psi0,psi_t0,psi_tt0)
    times=[0.0]; states=[sol.psi.tolist()]; prevs=[None]
    n=0; cap=int(t_end/dt)*10+100
    while sol.t < t_end - 1e-12:
        sol.step(); n+=1
        if n>cap: raise SystemExit("step cap")
        times.append(float(sol.t)); states.append(sol.psi.tolist()); prevs.append(sol.psi_prev.tolist())
    print(json.dumps({"t":times,"psi":states,"psi_prev":prevs}))
```
