def run_case(factory, dr, cfl, r_max, t_end, sample_every=4):
    r = grid(r_max, dr); dt = cfl*dr
    sol = factory(r, dt)
    times=[0.0]; states=[sol.psi.copy()]; prev=[None if sol.psi_prev is None else sol.psi_prev.copy()]
    n=0; max_steps=int(math.ceil(t_end/dt))+2
    while sol.t < t_end - 1e-12:
        sol.step(); n+=1
        if n>=max_steps: raise HarnessError("step cap")
        if n % sample_every == 0 or sol.t >= t_end-1e-12:
            times.append(sol.t); states.append(sol.psi.copy()); prev.append(None if sol.psi_prev is None else sol.psi_prev.copy())
    growth = max(abs(state)).max() / max(abs(states[0]).max(), tiny)
    return {"r": r, "dt": dt, "t": times, "psi": states, "psi_prev": prev, "growth": growth, "steps": n}
```
