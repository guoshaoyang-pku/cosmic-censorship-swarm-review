Watcher design (background, up to ~2h):
```bash
cd repo
LOG=runtime/logs/w10-ledger-rebuild.log
last=""
prev=""
for i in $(seq 1 200); do   # ~2h at 36s
  h=$(sha256sum ledger/theorems.jsonl ledger/citation_audit.csv | sha256sum | cut -c1-16)
  if [ "$h" != "$last" ] && [ "$h" == "$prev" ]; then
     # stable new snapshot -> rebuild
     echo "$(date -Is) stable $h rebuild" >> $LOG
     if python3 artifacts/flash-10/l1_class_coverage/build_ledger_class_coverage.py >> $LOG 2>&1 && python3 artifacts/flash-10/l1_class_coverage/validate_class_coverage.py >> $LOG 2>&1; then
        cs=$(sha256sum ledger/class_coverage.csv | cut -c1-16)
        echo "$(date -Is) rebuilt csv=$cs" >> $LOG
        # append checkpoint line
        ...
     else
        echo "$(date -Is) REBUILD FAILED" >> $LOG
     fi
     last="$h"
  else
     prev="$h"
  fi
  sleep 36
done
```
