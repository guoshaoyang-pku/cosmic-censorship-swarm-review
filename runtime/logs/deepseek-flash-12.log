```python
def convergence_study(...):
    ...
    pl2 = observed_order(rows, "l2_error")
    plinf = observed_order(rows, "linf_error")
    monotone = ...
    # protocol sec3.3/7: least-squares log-log fit over all resolutions
    hs = [max(r["dx"], 1e-300) for r in rows]
    es = [max(r["l2_error"], 1e-300) for r in rows]
    fitted = float(np.polyfit(np.log(hs), np.log(es), 1)[0])
    lo, hi = (1.8, 2.2) if order == 2 else (3.7, 4.3)   # sec3.6: +-0.3
    finite = [p for p in pl2 if not math.isnan(p)]
    at_least = all(p >= lo - 0.1 for p in finite)
    within = bool(finite) and all(lo <= p <= hi for p in finite)
    fit_ok = abs(fitted - order) <= 0.3
    return {
        "study": f"{family}_order{order}",           # sec7 required key
        "family": family, "order_scheme": order, "cfl": cfl, "R": R, "t_end": t_end,
        "rows": rows, "order_l2": pl2, "order_linf": plinf,
        "orders": pl2,                                # sec7 required key
        "fitted_order": fitted,                       # sec7 required key
        "monotone_decrease": bool(monotone),
        "order_gate": {"lo": lo, "hi": hi, "all_pairs_within_band": bool(within),
                       "fitted_order": fitted, "fitted_within_0p3": bool(fit_ok),
                       "pass": bool(monotone and at_least and within and fit_ok)},
        "gates": {"order_band": bool(within), "fitted_order": bool(fit_ok),
                  "monotone": bool(monotone)},       # sec7 required key
    }
```

