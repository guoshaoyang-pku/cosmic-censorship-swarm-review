```python
def lock_guard(root=None):
    """Fail-closed N1 self-gravity guard; see numerics/gates.py."""
    root_path = Path(root) if root is not None else Path(__file__).resolve().parents[2]
    try:
        import sys as _sys
        if str(root_path) not in _sys.path:
            _sys.path.insert(0, str(root_path))
        from numerics import gates
        rep = gates.evaluate(root_path)
        allowed = bool(rep.get("production_allowed"))
        return {
            "verdict": "N1_ALLOWED" if allowed else "N1_BLOCKED",
            "production_allowed": allowed,
            "blocking_reasons": list(rep.get("blocking_reasons", [])),
            "lock_state": (rep.get("lock") or {}).get("state"),
            "checked_at": rep.get("evaluated_at"),
            "spherical_solver_present": (root_path / "numerics" / "spherical_solver").exists(),
            "fail_closed": False,
        }
    except Exception as exc:
        return {
            "verdict": "N1_BLOCKED",
            "production_allowed": False,
            "blocking_reasons": [f"lock guard failed closed: {type(exc).__name__}: {exc}"],
            "lock_state": None,
            "spherical_solver_present": (root_path / "numerics" / "spherical_solver").exists(),
            "fail_closed": True,
        }
```
