```python
def order_uncertainty(rows, key="linf_error"):
    import numpy as np (already)
    h=np.array([r["h"] for r in rows]); e=np.array([r[key] for r in rows])
    x=np.log(h); y=np.log(e); n=len(x)
    slope, intercept = np.polyfit(x,y,1)
    resid = y-(slope*x+intercept)
    s2=float(np.sum(resid**2)/max(n-2,1)); sxx=float(np.sum((x-x.mean())**2))
    se=float(np.sqrt(s2/sxx)) if sxx>0 else float("inf")
    pairs=pair_orders(rows,key)
    half=(max(pairs)-min(pairs))/2 if pairs else float("inf")
    return {"fit_order": float(slope), "standard_error": se, "pair_spread_half_range": float(half)}
```

