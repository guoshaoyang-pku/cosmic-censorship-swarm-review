Implementation for the trajectory-level multi-functional analysis:
```python
def analyze(scheme, dr=0.05, cfl=0.5, r_max=30.0, t_end=6.0, sample_every=4):
    factory = rep.make_factory(scheme, cfl=cfl)
    case = rep.run_case(factory, dr, cfl, r_max, t_end, sample_every=sample_every)
    m = len(case['r'])-2
    s = 1.0/dr**2
    A = rep.Tridiagonal(s, -2.0*s, s, m)
    ser = {'leapfrog': [], 'symplectic': [], 'aa': []}
    for psi, prev in zip(case['psi'], case['psi_prev']):
        if prev is None: continue
        v = (psi[1:-1]-prev[1:-1])/case['dt']
        ser['leapfrog'].append(rep.leapfrog_energy(psi, prev, case['dt'], dr))
        ser['symplectic'].append(0.5*rep.inner(v,v,dr) - 0.5*rep.inner(psi[1:-1], A.matvec(prev[1:-1]), dr))
        ser['aa'].append(0.5*rep.inner(v,v,dr) - 0.25*rep.inner(psi[1:-1], A.matvec(psi[1:-1]), dr) - 0.25*rep.inner(prev[1:-1], A.matvec(prev[1:-1]), dr))
    def rel(vals): return max(abs(x-vals[0])/abs(vals[0]) for x in vals) if len(vals)>=3 and vals[0]!=0 else None
    return {k: rel(v) for k,v in ser.items()}, ser
```
