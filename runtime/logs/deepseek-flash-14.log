Now add the scaling study function and include it in run_all, plus a summary line. Let me add after analyze_scheme:

```python
def scaling_study(rep, scheme, drs=(0.2, 0.1, 0.05)):
    rows = []
    for dr in drs:
        a = analyze_scheme(rep, scheme, dr=dr)
        rows.append({"dr": dr, "dt": a["dt"],
                     **{f"drift_{k}": v for k, v in a["drift"].items()}})
    def orders(key):
        out = []
        for i in range(len(rows)-1):
            a, b = rows[i][key], rows[i+1][key]
            out.append(math.log(a/b)/math.log(rows[i]["dr"]/rows[i+1]["dr"]) if a>0 and b>0 else None)
        return out
    return {"scheme": scheme, "rows": rows,
            "orders": {k: orders(f"drift_{k}") for k in ("harness_leapfrog","average_acceleration")}}
```

