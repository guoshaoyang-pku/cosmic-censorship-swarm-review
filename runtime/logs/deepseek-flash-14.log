Design:
```python
#!/usr/bin/env python3
"""Build n0-convergence-report/v1 reports for lffd and cnfd from the replication
solvers (read-only), then they can be audited with audit_convergence_report.py."""
import sys, json, math, hashlib
from pathlib import Path
import numpy as np

REPO = ...
sys.path.insert(0, str(REPO/'numerics'))
import tests.flat_wave_replication as rep

DRS = [0.2, 0.1, 0.05]
CFL = 0.5; RMAX=30.0; TEND=6.0

def report_for(scheme):
    factory = rep.make_factory(scheme, cfl=CFL)
    pulse = rep.PulseExact()
    rows=[]; drifts=[]; states=[]
    for dr in DRS:
        case = rep.run_case(factory, dr, CFL, RMAX, TEND, sample_every=1)
        exact = pulse.psi(case['r'], case['t'][-1])
        err = case['psi'][-1][1:-1]-exact[1:-1]
        linf=float(np.max(np.abs(err))); l2=float(np.sqrt(np.sum(err**2)*dr))
        # scheme-appropriate drift series
        m=len(case['r'])-2; s=1/dr**2; A=rep.Tridiagonal(s,-2*s,s,m)
        series=[]
        for psi,prev in zip(case['psi'],case['psi_prev']):
            if prev is None: continue
            if scheme=='lffd':
                series.append(rep.leapfrog_energy(psi,prev,case['dt'],dr))
            else:
                v=(psi[1:-1]-prev[1:-1])/case['dt']
                series.append(0.5*rep.inner(v,v,dr)-0.25*rep.inner(psi[1:-1],A.matvec(psi[1:-1]),dr)-0.25*rep.inner(prev[1:-1],A.matvec(prev[1:-1]),dr))
        def rel(vals): return max(abs(x-vals[0])/abs(vals[0]) for x in vals) if len(vals)>=3 and vals[0]!=0 else None
        rows.append({"dr":dr,"dt":case['dt'],"n":int(round(RMAX/dr)),"linf":linf,"l2":l2})
        drifts.append(rel(series))
        states.append(case['psi'][-1])
    # residual order using 3-point d2 at a generic time t*=4.0 (before reflection? pulse center 10, at t=4 outgoing at 14, mirror at 6 -> fine, inside 30)
    tstar=4.0
    res=[]
    for dr in DRS:
        r=rep.grid(RMAX,dr)
        psi=pulse.psi(r,tstar); psi[0]=psi[-1]=0.0
        h=dr; d2=np.zeros_like(psi); d2[1:-1]=(psi[:-2]-2*psi[1:-1]+psi[2:])/h**2
        vtt=pulse.psi_tt(r,tstar)
        res.append(float(np.max(np.abs(vtt[1:-1]-d2[1:-1]))))
    res_orders=[math.log(a/b)/math.log(2) for a,b in zip(res,res[1:])]
    # Richardson on nested grids (coarse->fine): rows dr 0.2,0.1,0.05 -> states
    fine, mid, coarse = states[-1], states[-2], states[-3]
    d1=float(np.max(np.abs(mid[::2]-coarse))); d2=float(np.max(np.abs(fine[::2]-mid)))
    pR=math.log(d1/d2)/math.log(2)
    # uncertainty
    hs=np.array([r['dr'] for r in rows]); es=np.array([r['linf'] for r in rows])
    x,y=np.log(hs),np.log(es); n=len(x); slope,inter=np.polyfit(x,y,1)
    resid=y-(slope*x+inter); se=float(np.sqrt(np.sum(resid**2)/max(n-2,1))/np.sqrt(np.sum((x-x.mean())**2)))
    pairs=[math.log(rows[i]['linf']/rows[i+1]['linf'])/math.log(rows[i]['dr']/rows[i+1]['dr']) for i in range(len(rows)-1)]
    half=(max(pairs)-min(pairs))/2 if pairs else float('inf')
    func = {"name":"leapfrog_staggered_energy","structural_class":"exact_discrete","solver_tolerance":0.0} if scheme=='lffd' else {"name":"average_acceleration_invariant","structural_class":"exact_discrete","solver_tolerance":0.0}
    return {...report...}
```
