Let me now write the bridge `numerics/tests/flat_wave_protocol.py`:

```python
#!/usr/bin/env python3
"""Stdin/stdout bridge: expose numerics/tests/flat_wave.py to external acceptance harnesses.

Protocol (worker-04 n0_acceptance; docs in comms?):
 request: {"r":[...], "dt":..., "t_end":..., "sample_every":1, "psi0":[...], "psi_t0":[...]}
 response: {"t":[...], "psi":[[...]], "psi_prev":[[...] or null]}

RK4 with fixed dt on v_tt = d2 v, boundaries zero. No physics of its own:
all operators come from flat_wave.py. This file makes no claim beyond the
solver's numerical trace.
"""
import json, sys
from pathlib import Path
import numpy as np
sys.path.insert(0, str(Path(__file__).resolve().parent))
from flat_wave import d2

def main():
    req = json.load(sys.stdin)
    r = np.asarray(req["r"], float)
    dt = float(req["dt"]); t_end = float(req["t_end"])
    every = int(req.get("sample_every", 1))
    n = r.size - 1; h = float(r[1]-r[0])
    v = np.asarray(req["psi0"], float).copy(); w = np.asarray(req["psi_t0"], float).copy()
    v[0] = v[-1] = 0.0
    times=[0.0]; states=[v.tolist()]; prevs=[None]
    t = 0.0; steps = 0
    n_steps = max(1, int(round(t_end/dt)))
    dt = t_end / n_steps   # honor the requested t_end exactly
    for k in range(n_steps):
        vprev = v
        k1v, k1w = w, d2(v,h,2)
        k2v, k2w = w+0.5*dt*k1w, d2(v+0.5*dt*k1v,h,2)
        k3v, k3w = w+0.5*dt*k2w, d2(v+0.5*dt*k2v,h,2)
        k4v, k4w = w+dt*k3w, d2(v+dt*k3v,h,2)
        v = v + dt/6*(k1v+2*k2v+2*k3v+k4v)
        w = w + dt/6*(k1w+2*k2w+2*k3w+k4w)
        t += dt; steps += 1
        if steps % every == 0 or k == n_steps-1:
            times.append(t); states.append(v.tolist()); prevs.append(vprev.tolist())
    json.dump({"t": times, "psi": states, "psi_prev": prevs}, sys.stdout)
    return 0
```

