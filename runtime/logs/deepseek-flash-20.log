def propose(model: ModelSpec, ep: Episode, agent_id: int, seed: int, rng_key) -> dict | None:
    rng = random.Random(f"{seed}:{model.model_id}:{agent_id}:{ep.idx}")
    if rng.random() < model.failure_rate:
        return None  # invalid output
    p = model.accuracy
    if model.bias_label is not None and (ep.idx % model.bias_period == agent_id % model.bias_period):
        p = 1.0 - model.accuracy  # correlated error region: prefers bias_label instead
    correct = rng.random() < p
    label = ep.label if correct else rng.choice([l for l in LABELS if l != (ep.label if not (model.bias_label is not None and ep.idx % model.bias_period == agent_id % model.bias_period) else ep.label)])
