```python
CONTAMINATION_TOKENS = ["cubic graph","minimum degree","min degree","cap set","cap-set","erdos","erdős","funsearch","2^k cycle","eight-cycle","priority function"]
def check_contamination(text, where, path=""):
    out=[]
    skip = any(path.startswith(p) for p in ("data/","erdos64/","framework/","runs/","repro/","HANDOFF.md","README.md"))
    if skip: return out
    for t in CONTAMINATION_TOKENS:
        if re.search(r"\b"+re.escape(t), text, re.I):
            out.append(Violation("HF-13","major",where,f"base-project token {t!r} inside a cosmic-censorship artifact"))
    return out
```

