```python
def simulate(rng):
    rows=[]
    for arm in ARMS:
        cfg=SIM[arm]
        n_out = BUDGET_TOKENS // cfg["tokens_per_call"]
        # distribute n_out outputs across TASKS*SEEDS cells round-robin
        cells=[(s,t) for s in range(SEEDS) for t in range(TASKS)]
        counts={c:0 for c in cells}
        for i in range(n_out): counts[cells[i % len(cells)]] += 1
        for (seed,task),k in counts.items():
            for _ in range(k):
                accepted = 1 if rng.random()<cfg["p_accept"] else 0
                hf = 1 if rng.random() < hf_rate[arm] else 0
                rows.append({...})
    return rows
```
