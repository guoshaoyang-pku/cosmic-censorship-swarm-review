```python
#!/usr/bin/env python3
"""Acceptance test for the class-binding conformance linter (draft).
Runs every fixture in fixtures/ against check_schema.check and compares with EXPECTATIONS.json.
Exit 0 iff all non-escape expectations hold.
Writes evidence/results.json.
"""
import json, platform, subprocess, sys, hashlib, datetime
from pathlib import Path
import check_schema

HERE=...; FIX=HERE/'fixtures'; EV=HERE/'evidence'

def sha256(p): ...

def main():
    exp=json.loads((FIX/'EXPECTATIONS.json').read_text())
    records=[]; failures=[]
    for name in sorted(exp):
        p=FIX/name
        doc=check_schema.load_document(p)
        res=check_schema.check(doc,str(p)).to_dict()
        e=exp[name]
        if e.get('kind')=='expected_escape':
            outcome='escape_confirmed' if res['verdict']=='ACCEPT' else 'escape_closed'
            if res['verdict']=='REJECT':
                # bonus: check no missing must codes
                pass
        elif e['verdict']=='ACCEPT':
            ok = res['verdict']=='ACCEPT'
            outcome='pass' if ok else 'FAIL'
            if not ok: failures.append(...)
        else:
            ok = res['verdict']=='REJECT' and all(c in res['failed_codes'] for c in e.get('must_include',[]))
            outcome='pass' if ok else 'FAIL'
            if not ok: failures.append(...)
        records.append({...})
    # null controls: 100 deterministic random mapping docs (seed fixed) must all REJECT
    import random; rng=random.Random(11)
    null_fail=0; null_examples=[]
    alphabet=...
    for i in range(100):
        doc={ 'k%d'%j: rng.choice([...]) for j in range(rng.randint(1,6))}
        r=check_schema.check(doc, f'<null_{i}>')
        if r.verdict!='REJECT':
            null_fail+=1; null_examples.append(r.class_id)
    ...
```

