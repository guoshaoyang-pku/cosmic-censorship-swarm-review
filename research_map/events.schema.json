{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research map events",
  "oneOf": [
    {"$ref": "#/$defs/baseDirectionUpdate"},
    {"$ref": "#/$defs/baseClaim"},
    {"$ref": "#/$defs/baseArtifact"},
    {"$ref": "#/$defs/baseReview"},
    {"$ref": "#/$defs/baseResourceRequest"}
  ],
  "$defs": {
    "base": {"type":"object","required":["event_id","event_type","created_at","actor"],"properties":{"event_id":{"type":"string"},"event_type":{"type":"string"},"created_at":{"type":"string"},"actor":{"type":"string"}},"additionalProperties":true},
    "baseDirectionUpdate": {"allOf":[{"$ref":"#/$defs/base"},{"type":"object","properties":{"event_type":{"const":"direction_update"}},"required":["group_id","old_direction","new_direction","reason","evidence_refs","budget_delta_agent_hours"]}]},
    "baseClaim": {"allOf":[{"$ref":"#/$defs/base"},{"type":"object","properties":{"event_type":{"const":"claim"}},"required":["class_id","statement","conclusion_type","assumptions","falsifier","evidence_refs"]}]},
    "baseArtifact": {"allOf":[{"$ref":"#/$defs/base"},{"type":"object","properties":{"event_type":{"const":"artifact"}},"required":["node_id","artifact_type","path","sha256","validation_status"]}]},
    "baseReview": {"allOf":[{"$ref":"#/$defs/base"},{"type":"object","properties":{"event_type":{"const":"review"}},"required":["target_id","reviewer","verdict","score","hard_failures","findings"]}]},
    "baseResourceRequest": {"allOf":[{"$ref":"#/$defs/base"},{"type":"object","properties":{"event_type":{"const":"resource_request"}},"required":["group_id","requested_agents","requested_agent_hours","justification","expected_information_gain","stop_rule"]}]}
  }
}
